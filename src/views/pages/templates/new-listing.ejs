          <style>
                /* ========== NEW LISTING: STYLES ========== */
.listing-box {
  border: 1px solid #dedede !important;
  padding: 30px !important;
}

.listing-legend {
  font-size: 1.2rem;
  padding: 0 8px;
}

.listing-label {
  font-size: 0.95rem;
}

.listing-row {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.note-hint {
  font-size: 0.85rem;
  color: #6c757d;
}

.nav-link{
  color: #111;
}

.nav-link:hover{
  color: #111;
}

.bi-house-door-fill,
.bi-gem  {
  color: #c39052 !important;
}

/* Responsive (Mobile optimization) */
@media (max-width: 768px) {

  .listing-label {
    text-align: left !important;
    margin-bottom: 5px;
  }

  fieldset.listing-box {
    padding: 20px !important;
  }

  .note-hint {
    margin-left: 0 !important;
  }
}

.form-control:focus {
    color: var(--bs-body-color);
    border-color: #c99b5d;
    outline: 0;
    box-shadow: 0 0 0 .25rem rgba(238, 237, 237, 0.25);
}

.form-check-input:checked {
    background-color: #c99b5d;
    border-color: #c99b5d;
}

.form-check-input:focus {
    border-color: #c99b5d;
    outline: 0;
    box-shadow: 0 0 0 .25rem rgba(238, 237, 237, 0.25);
}

.form-select:focus {
    border-color: #c99b5d;
    outline: 0;
    box-shadow: 0 0 0 .25rem rgba(238, 237, 237, 0.25);
}

.form-check-label{
  margin-left: 5px;
}

.col-md-3 {
    flex: 0 0 auto;
    width: 10%;
}

/* Yacht speed fields: always one row, fixed alignment */
.yacht-speed-wrap {
  overflow-x: auto;
}

.yacht-speed-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(165px, 1fr));
  gap: 0.5rem;
  min-width: 700px;
}

.yacht-speed-label {
  min-height: 3.25rem;
  margin-bottom: 0.35rem;
  display: flex;
  align-items: flex-end;
}

@media (max-width: 1100px) {
  .yacht-speed-wrap {
    overflow-x: visible;
  }

  .yacht-speed-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
  }
}

               </style>

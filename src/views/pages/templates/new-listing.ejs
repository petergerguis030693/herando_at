<script>
document.addEventListener("DOMContentLoaded", () => {
  const cat = document.getElementById("brand_id");
  const subRow = document.getElementById("subcategory-row");
  const sub = document.getElementById("model_id");

  // Reset
  subRow.classList.add("d-none");
  sub.disabled = true;
  sub.value = "";

  cat.addEventListener("change", () => {
    const pid = cat.value;
    if (!pid) {
      subRow.classList.add("d-none");
      sub.disabled = true;
      sub.value = "";
      return;
    }

    // Show + enable
    sub.disabled = false;
    subRow.classList.remove("d-none");

    // Filter options
    Array.from(sub.options).forEach(o => {
      const parent = o.dataset.parent;
      if (!parent) return; // Skip first placeholder
      o.hidden = parent !== pid;
    });

    sub.value = "";
  });
});
</script>



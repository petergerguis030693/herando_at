    <script>
    document.addEventListener("DOMContentLoaded", function () {
      const select = document.getElementById("environmental_badge");
      if (!select) return;
      const firstOption = select.querySelector('option[value=""]');
      const options = Array.from(select.options).filter(o => o.value !== "");
      options.sort((a, b) => a.value.localeCompare(b.value, 'de', { numeric: true }));
      select.innerHTML = "";
      select.appendChild(firstOption);
      options.forEach(o => select.appendChild(o));
      select.value = "";
    });
    </script>

    <div class="col-md-4">
      <label for="pollution_class" class="form-label"><%= t('buyer.listing.car.consumption.pollution_class') %></label>

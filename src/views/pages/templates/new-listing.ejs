      <!-- === Formular ===================================================== -->
      <form action="/buyer/new-listing" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="ent_id" value="<%= ent.id %>">

<fieldset class="mb-4 p-4 border bg-white rounded shadow-sm listing-box">
  <legend class="fw-semibold px-2 listing-legend"><%= t('buyer.listing.general.title') %></legend>

  <!-- Titel -->
  <div class="row mb-4">
    <div class="col-md-7">
      <label for="name" class="form-label fw-semibold">
        <%= t('buyer.listing.general.title_input') %> *
      </label>
      <input id="name" name="name" type="text" class="form-control" required>
    </div>
  </div>

  <!-- Kaufpreis -->
  <div class="row mb-4 align-items-center">
    <label for="priceFormatted" class="col-md-3 col-form-label fw-semibold listing-label">
      * <%= t('buyer.listing.general.price') %>
    </label>

    <div class="col-md-7 d-flex align-items-center gap-3">
      <!-- Preisfeld -->
      <div style="width: 220px;">
        <input
          id="priceFormatted"
          type="text"
          class="form-control"
          inputmode="numeric"
          placeholder="">

        <input
          type="hidden"
          id="price"
          name="price"
          value="">
      </div>

      <!-- Toggle -->
      <div class="form-check form-switch m-0 d-flex align-items-center">
        <input
          class="form-check-input"
          type="checkbox"
          id="priceOnRequest"
          onchange="togglePriceState()">
        <label class="form-check-label fw-semibold ms-2" for="priceOnRequest">
          <%= t('buyer.listing.general.price_on_request') %>
        </label>
      </div>

      <!-- Währung -->
      <div style="width: 120px;">
        <select id="currency" name="currency" class="form-select">
          <% currencies.forEach(cur => { %>
            <option value="<%= cur %>" <%= cur === 'EUR' ? 'selected' : '' %>>
              <%= cur %>
            </option>
          <% }) %>
        </select>
      </div>

      <% if (user.registration_type === 'commercial') { %>
        <!-- MwSt -->
        <div class="form-check d-flex align-items-center gap-2 m-0">
          <input type="hidden" name="vat" value="0">
          <input
            id="vat"
            name="vat"
            type="checkbox"
            class="form-check-input"
            value="1">
          <label for="vat" class="form-check-label fw-semibold mb-0">
            <%= t('buyer.listing.general.vat_display') %>
          </label>
        </div>
      <% } %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-7">
      <p class="form-text">
        <%= t('buyer.listing.general.price_hint') %>
      </p>
    </div>
  </div>
</fieldset>


      <script>
        let lastPriceValue = '';

        function togglePriceState() {
          const checkbox = document.getElementById('priceOnRequest');
          const priceInput = document.getElementById('priceFormatted');
          const hidden = document.getElementById('price');

          if (checkbox.checked) {
            lastPriceValue = hidden.value;
            priceInput.value = '';
            priceInput.disabled = true;
            hidden.value = 0;
          } else {
            priceInput.disabled = false;
            if (lastPriceValue) {
              hidden.value = lastPriceValue;
              priceInput.value = new Intl.NumberFormat('de-DE')
                .format(lastPriceValue);
            }
          }
        }
      </script>
      <script>
        const formattedInput = document.getElementById('priceFormatted');
        const hiddenInput = document.getElementById('price');

        function formatNumberDE(value) {
          const num = value.replace(/\D/g, '');
          return num.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }

        formattedInput.addEventListener('input', function () {
          const cursorPos = this.selectionStart;
          const raw = this.value.replace(/\D/g, '');
          this.value = formatNumberDE(raw);
          hiddenInput.value = raw;
          this.setSelectionRange(cursorPos, cursorPos);
        });
      </script>







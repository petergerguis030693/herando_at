<script>
  const mainInput = document.getElementById('mainpicture');
  const mainPrev  = document.getElementById('mainpicture-preview');

  mainInput.addEventListener('change', () => {
    const file = mainInput.files[0];
    mainPrev.innerHTML = '';

    if (!file || !file.type.startsWith('image/')) return;

    const reader = new FileReader();
    reader.onload = e => {
      const wrap = document.createElement('div');
      wrap.style.position = 'relative';

      const img = document.createElement('img');
      img.src = e.target.result;
      img.className = 'img-thumbnail';
      img.style.width = '300px';
      wrap.appendChild(img);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerHTML = '&times;';
      btn.style.position = 'absolute';
      btn.style.top = '5px';
      btn.style.right = '5px';
      btn.style.background = 'rgba(0,0,0,0.55)';
      btn.style.color = '#fff';
      btn.style.border = 'none';
      btn.style.borderRadius = '50%';
      btn.style.width = '24px';
      btn.style.height = '24px';
      btn.style.cursor = 'pointer';

      btn.onclick = () => {
        mainInput.value = '';
        mainPrev.innerHTML = '';
      };

      wrap.appendChild(btn);
      mainPrev.appendChild(wrap);
    };

    reader.readAsDataURL(file);
  });
</script>



  <!-- Bootstrap JS -->
  <!-- CKEditor (CDN) -->
  <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

  <!-- Bild-Preview / FileList-Management -->
  <script>
    // Persistente FileList via DataTransfer
    const dt = new DataTransfer();

    function handleFiles(event) {
      const incoming = Array.from(event.target.files);
      const existingKeys = new Set(
        Array.from(dt.files).map(f => `${f.name}:${f.size}:${f.lastModified}`)
      );

      incoming.forEach(file => {
        const key = `${file.name}:${file.size}:${file.lastModified}`;
        if (!existingKeys.has(key)) {
          dt.items.add(file);
          existingKeys.add(key);
        }
      });

      try {
        event.target.files = dt.files;
      } catch (e) {
        // some browsers treat FileList as read-only
      }
      renderPreviews();
    }

    function renderPreviews() {
      const preview = document.getElementById('picture-preview');
      preview.innerHTML = '';
      Array.from(dt.files).forEach((file) => {
        if (!file.type.startsWith('image/')) return;
        const fileKey = `${file.name}:${file.size}:${file.lastModified}`;
        const reader = new FileReader();
        reader.onload = e => {
          const wrap = document.createElement('div');
          wrap.style.position = 'relative';
          wrap.className = 'border rounded overflow-hidden';
          wrap.dataset.fileKey = fileKey;

          const img = document.createElement('img');
          img.src = e.target.result;
          img.className = 'img-thumbnail';
          img.style.width = '300px';
          img.style.height = 'auto';
          wrap.appendChild(img);

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.innerHTML = '&times;';
          btn.ariaLabel = "<%= t('global.remove_image','Remove image') %>";
          btn.style.position = 'absolute';
          btn.style.top = '5px';
          btn.style.right = '5px';
          btn.style.background = 'rgba(0,0,0,0.55)';
          btn.style.color = '#fff';
          btn.style.border = 'none';
          btn.style.borderRadius = '50%';
          btn.style.width = '24px';
          btn.style.height = '24px';
          btn.style.lineHeight = '22px';
          btn.style.cursor = 'pointer';
          btn.onclick = () => removeFileByKey(fileKey);
          wrap.appendChild(btn);

          preview.appendChild(wrap);
        };
        reader.readAsDataURL(file);
      });
    }

    function removeFileByKey(fileKey) {
      const next = new DataTransfer();
      Array.from(dt.files).forEach((file) => {
        const key = `${file.name}:${file.size}:${file.lastModified}`;
        if (key !== fileKey) next.items.add(file);
      });
      dt.items.clear();
      Array.from(next.files).forEach(file => dt.items.add(file));
      try {
        document.getElementById('pictures').files = dt.files;
      } catch (e) {
        // ignore if FileList is read-only
      }
      renderPreviews();
    }

    // CKEditor initialisieren
    document.addEventListener('DOMContentLoaded', () => {
      const el = document.querySelector('#description');
      if (el && window.ClassicEditor) {
        ClassicEditor.create(el, {
          toolbar: ['heading','|','bold','italic','bulletedList','numberedList']
        }).catch(console.error);
      }
    });
  </script>




  

<script>
document.addEventListener("DOMContentLoaded", function () {
  const select = document.getElementById("engine");
  if (!select) return;

  // 🔹 Die "---"-Option sichern
  const firstOption = select.querySelector('option[value=""]');
  const options = Array.from(select.options).filter(o => o.value !== "");

  // 🔹 Werte mit "Zylinder" → führende Null im Sortierschlüssel
  options.forEach(o => {
    const match = o.text.trim().match(/^(\d+)\s*-?\s*Zylinder$/i);
    if (match) {
      const num = match[1].padStart(2, "0"); // z. B. "4" → "04"
      o.dataset.sortKey = num;
    } else {
      o.dataset.sortKey = o.text.trim(); // z. B. "Elektro"
    }
  });

  // 🔹 Nach sortKey alphabetisch & numerisch sortieren
  options.sort((a, b) => 
    a.dataset.sortKey.localeCompare(b.dataset.sortKey, "de", { numeric: true })
  );

  // 🔹 Neu aufbauen – "---" bleibt oben
  select.innerHTML = "";
  select.appendChild(firstOption);
  options.forEach(o => select.appendChild(o));

  // 🔹 Sicherstellen, dass "---" wieder aktiv ist
  select.value = "";
});
</script>



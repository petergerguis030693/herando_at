    <% if (extras.propertytype) { %>
    <div class="col-md-4">
      <label for="propertytype" class="form-label listing-label"><%= t('buyer.listing.property.type') %></label>
      <select id="propertytype" name="propertytype" class="form-select">
        <option value="" selected>---</option>
        <% extras.propertytype.forEach(o => { %>

        <% }) %>
      </select>
    </div>
    <% } %>

    <% if (extras.investmenttype) { %>
    <div class="col-md-4">
      <label for="investmenttype" class="form-label listing-label"><%= t('buyer.listing.property.investment') %></label>
      <select id="investmenttype" name="investmenttype" class="form-select">
        <option value="" selected>---</option>
        <% extras.investmenttype.forEach(o => { %>
          <option value="<%= o.value %>"><%= t('attribute.properties.investmenttype.' + o.value) %></option>
        <% }) %>
      </select>
    </div>
    <% } %>

    <div class="col-md-4">
      <div class="form-check mt-2">
        <input type="hidden" name="monument_protection" value="0">
        <input id="monument" name="monument_protection" type="checkbox" class="form-check-input" value="1">
        <label for="monument" class="form-check-label"><%= t('buyer.listing.property.monument') %></label>
      </div>
    </div>

  </div>

  <!-- JS (nicht verändern, nur behalten) -->
  <script>
  document.addEventListener("DOMContentLoaded", () => {
    const propertyType = document.querySelector("#propertytype");
    const investmentType = document.querySelector("#investmenttype");

    if (!propertyType || !investmentType) return;

    investmentType.addEventListener("change", () => {
      if (investmentType.value) {
        propertyType.value = "";
        propertyType.disabled = true;
        propertyType.classList.add("disabled");
      } else {
        propertyType.disabled = false;
        propertyType.classList.remove("disabled");
      }
    });
  });
  </script>


              <% (filters.brands||[]).forEach(b => { %>
                <option value="<%= b.id %>" <%= (selectedFilters.brand||[]).map(String).includes(String(b.id)) ? 'selected' : '' %>><%= b.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Modell -->
        <div class="md-col-4">
          <label class="md-label"><%= t('labels.common.model','Modell') %></label>
          <div class="md-select">
            <select name="model" id="fModel">
              <option value=""><%= t('labels.common.any','Beliebig') %></option>
              <% (filters.models||[]).forEach(m => { %>
                <option value="<%= m.id %>" <%= (selectedFilters.model||[]).map(String).includes(String(m.id)) ? 'selected' : '' %>><%= m.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Karosserie -->
<div class="md-col-12">
  <label class="md-label"><%= t('filters.cars.cartype','Karosserieform') %></label>
  <div class="bodytype-grid">
    <% (filters.cartypes || []).forEach(ct => {
        const checked = (selectedFilters.cartype||[]).map(String).includes(String(ct.id));
        // Dateiname immer aus deutschem Basislabel (unabhängig von aktiver Sprache)
        const baseLabel = String(ct.baseName || ct.name || '');
        const lowerBase = baseLabel.toLowerCase();
        const isOther = lowerBase.includes('sonstig');
        const isVanMinibus = lowerBase.includes('van') || lowerBase.includes('minibus') || String(ct.id) === '254';
        const fileBase = baseLabel.toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .trim();
        const rawFileName = fileBase
          .replace(/\s+/g, '_')     // Leerzeichen zu Unterstrich
          .replace(/ä/g, 'ae')
          .replace(/ö/g, 'oe')
          .replace(/ü/g, 'ue')
          .replace(/ß/g, 'ss')
          .replace(/[^a-z0-9_]/g, ''); // Nur sichere Zeichen
        const fileName = isVanMinibus ? 'sonstiges' : rawFileName;
    %>
      <label class="bodytype-card">
        <input type="checkbox" name="cartype" value="<%= ct.id %>" <%= checked ? 'checked' : '' %> />
        <% if (isOther) { %>
          <span class="bodytype-placeholder-icon" aria-hidden="true">...</span>
        <% } else { %>
          <img 
            src="/assets/<%= fileName %>.png" 
            alt="<%= ct.name %>" 
            style="width:auto; height:auto; margin-bottom:6px;">
        <% } %>
        <span style="width: 150px;" class="span"><%= ct.name %></span>
      </label>
    <% }) %>
  </div>
</div>



      <div class="md-select">
        <select name="brand" id="fBrand">
          <option value=""><%= t('common.any','Beliebig') %></option>
          <% (filters.brands||[]).forEach(b => { %>
            <option value="<%= b.id %>" <%= isSel(selectedFilters.brand, b.id) ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Modell -->
    <div class="md-col-4">
      <label class="md-label"><%= t('filters.watches.model','Modell') %></label>

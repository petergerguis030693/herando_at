<script>
document.addEventListener('change', e => {
  const input = e.target;
  if (!input.matches('.chip__control[type="radio"]')) return;

  const group = input.closest('.chip-row');
  if (!group) return;

  group.querySelectorAll('.chip-x').forEach(l =>
    l.classList.remove('active')
  );

  const checked = group.querySelector('input[type="radio"]:checked');
  if (checked) {
    checked.closest('.chip-x').classList.add('active');
  }
});
</script>

    

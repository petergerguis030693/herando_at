          <% (filters.models||[]).forEach(m => { %>
            <option value="<%= m.id %>" <%= isSel(selectedFilters.model, m.id) ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Uhrentyp -->
    <div class="md-col-4">
      <label class="md-label"><%= t('filters.watches.watchtype','Uhrentyp') %></label>
      <div class="md-select">
        <select name="watchtype" id="fWatchType">
          <option value=""><%= t('common.any','Beliebig') %></option>
          <% mergeById(filters.watchTypes, FB.watchTypes).forEach(o => { %>
            <option value="<%= o.id %>" <%= isSel(selectedFilters.watchtype, o.id) ? 'selected' : '' %>><%= o.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Geschlecht -->
    <div class="md-col-3">
      <label class="md-label"><%= t('filters.watches.gender','Geschlecht') %></label>
      <div class="md-select">
        <select name="gender" id="fGender">
          <option value=""><%= t('common.any','Beliebig') %></option>
          <% pick(filters.genders, FB.genders).forEach(o => { %>
            <option value="<%= o.id %>" <%= isSel(selectedFilters.gender, o.id) ? 'selected' : '' %>><%= o.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Land -->
    <div class="md-col-3">
      <label class="md-label"><%= t('filters.watches.country','Land') %></label>
      <div class="md-select">
        <select name="country" id="fCountry">
          <option value=""><%= t('common.any','Beliebig') %></option>
          <% (filters.countries||[]).forEach(c => { %>
            <option value="<%= c.id %>" <%= isSel(selectedFilters.country, c.id) ? 'selected' : '' %>><%= countryName(c) %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Baujahr -->
<div class="md-col-3">
  <label class="md-label"><%= t('buyer.listing.car.year','Baujahr') %></label>
  <div class="md-select d-flex gap-2">

    <!-- Von -->
    <select name="yearMin" id="fWatchYearMin">
      <option value=""><%= t('labels.common.from','von') %></option>
      <% const currentYearWMin = new Date().getFullYear();
         for (let y=currentYearWMin; y>=1900; y--) { %>
        <option value="<%= y %>" <%= (selectedFilters.yearMin||[]).map(String).includes(String(y)) ? 'selected' : '' %>>
          <%= y %>
        </option>
      <% } %>
    </select>

    <!-- Bis -->
    <select name="yearMax" id="fWatchYearMax">
      <option value=""><%= t('labels.common.to','bis') %></option>
      <% const currentYearWMax = new Date().getFullYear();
         for (let y=currentYearWMax; y>=1900; y--) { %>
        <option value="<%= y %>" <%= (selectedFilters.yearMax||[]).map(String).includes(String(y)) ? 'selected' : '' %>>
          <%= y %>
        </option>
      <% } %>
    </select>

  </div>
</div>


    <!-- Preis -->
    <div class="md-col-3">
      <label class="md-label"><%= t('filters.watches.price','Preis (€)') %></label>
      <div class="md-range">
        <input type="number" name="priceMin" min="0" step="100" 
          value="<%= (selectedFilters.priceMin||[])[0] || '' %>" 
          placeholder="<%= t('common.from','von') %>">
        <span class="sep"><%= t('common.to','bis') %></span>
        <input type="number" name="priceMax" min="0" step="100" 
          value="<%= (selectedFilters.priceMax||[])[0] || '' %>" 
          placeholder="<%= t('common.to','bis') %>">
      </div>
    </div>

    <!-- Ort/PLZ -->

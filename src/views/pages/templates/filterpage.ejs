<script>
(() => {
  const page     = document.getElementById('filterpage');
  const form     = document.getElementById('fp-form');
  const applyBtn = document.getElementById('fp-apply');
  const resetBtn = document.getElementById('fp-reset');
  const brandSel = document.getElementById('fBrand');
  const modelSel = document.getElementById('fModel');

  const entity =
    (page && page.dataset && page.dataset.entity) ||
    '<%= currentEntity.route %>' ||
    (location.pathname.split('/')[1] || 'cars');
    

  // KEYS: überall einheitlich brand/model
  const brandKey = 'brand';
  const modelKey = 'model';


  if (!form) return;

  const debounce = (fn, ms) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
  const KEY = `filters:${entity}`;

  function collectAllParams() {
    const fd = new FormData(form);
    const p  = new URLSearchParams();

    for (const [k, v] of fd.entries()) {
      if (v === '' || v == null) continue;
      p.append(k, v);
    }

    // Mehrfach-Selects normalisieren
    form.querySelectorAll('select[multiple]').forEach(sel => {
      const arr = [...sel.options].filter(o => o.selected).map(o => o.value).filter(Boolean);
      p.delete(sel.name);
      arr.forEach(v => p.append(sel.name, v));
    });

    // ----- Kompatibilitäts-Synonyme (nur Frontend) -----
    if (entity === 'watches') {
      // functions / functions[] beide füllen
      const fn1 = p.getAll('functions');
      const fn2 = p.getAll('functions[]');
      if (fn1.length && !fn2.length) fn1.forEach(v => p.append('functions[]', v));
      if (fn2.length && !fn1.length) fn2.forEach(v => p.append('functions', v));

      // delivery / delivery[] beide füllen
      const dl1 = p.getAll('delivery');
      const dl2 = p.getAll('delivery[]');
      if (dl1.length && !dl2.length) dl1.forEach(v => p.append('delivery[]', v));
      if (dl2.length && !dl1.length) dl2.forEach(v => p.append('delivery', v));
    }

    // Flag für „von Filterpage“
    p.set('hp', '1');
    return p;
  }

  function readQuery() {
    const out = {};
    const sp = new URLSearchParams(location.search);
    for (const [k, v] of sp.entries()) {
      if (out[k] === undefined) out[k] = v;
      else if (Array.isArray(out[k])) out[k].push(v);
      else out[k] = [out[k], v];
    }
    return out;
  }

  function applyState(f, state) {
    f.querySelectorAll('select:not([multiple]), input[type="text"], input[type="number"], input[type="date"]')
      .forEach(el => {
        if (el.name && state[el.name] != null && !Array.isArray(state[el.name])) {
          el.value = String(state[el.name]);
        }
      });

    const radiosByName = {};
    f.querySelectorAll('input[type="radio"][name]').forEach(r => (radiosByName[r.name] ||= []).push(r));
    Object.entries(radiosByName).forEach(([name, group]) => {
      const v = state[name];
      group.forEach(r => (r.checked = v != null && !Array.isArray(v) && String(v) === String(r.value)));
    });

    const checksByName = {};
    f.querySelectorAll('input[type="checkbox"][name]').forEach(cb => (checksByName[cb.name] ||= []).push(cb));
    Object.entries(checksByName).forEach(([name, group]) => {
      const arr = state[name];
      group.forEach(cb => (cb.checked = Array.isArray(arr) ? arr.map(String).includes(String(cb.value)) : false));
    });

    f.querySelectorAll('select[multiple]').forEach(sel => {
      const arr = state[sel.name];
      [...sel.options].forEach(o => (o.selected = Array.isArray(arr) ? arr.map(String).includes(String(o.value)) : false));
    });
  }

    const APPLY_LABEL = "<%= t('common.results.show','Ergebnisse anzeigen') %>";

function hasAnyFilterSelected() {
  const p = collectAllParams();

  // diese Keys setzt dein Code automatisch → zählen NICHT als Filter
  ['hp', 'page', 'limit', 'view'].forEach(k => p.delete(k));

  // wenn danach noch irgendwas übrig ist → Filter aktiv
  return [...p.keys()].length > 0;
}

  // ----- COUNT -----
async function updateCount() {
  if (!applyBtn) return;

  // ✅ NUR zeigen wenn wirklich Filter ausgewählt
  if (!hasAnyFilterSelected()) {
    applyBtn.textContent = APPLY_LABEL;
    return;
  }

  try {
    const p = collectAllParams();
    const res = await fetch(`/api/${entity}/count?` + p.toString());
    const { count = 0 } = res.ok ? await res.json() : { count: 0 };
    applyBtn.textContent = `${APPLY_LABEL} (${Number(count).toLocaleString('de-DE')})`;
  } catch {
    applyBtn.textContent = APPLY_LABEL;
  }
}

const updateCountDebounced = debounce(updateCount, 150);


    const LABEL_ANY = "<%= t('common.any','Beliebig') %>";

// ----- MODELS (abhängig von Entity) -----
async function loadModels(preselectValue) {
  if (!brandSel?.value || !modelSel) return;
  const qs = new URLSearchParams({ brand: brandSel.value });
  const rows = await fetch(`/api/${entity}/models?` + qs.toString())
                .then(r => r.ok ? r.json() : [])
                .catch(() => []);
  modelSel.innerHTML = `<option value="">${LABEL_ANY}</option>` +
    rows.map(r => `<option value="${r.id}">${r.name}</option>`).join('');
  if (preselectValue != null && preselectValue !== '') {
    modelSel.value = String(Array.isArray(preselectValue) ? preselectValue[0] : preselectValue);
  }
}

function syncModelEnabled() {
  if (!modelSel) return;

  // Wenn Yacht → nie deaktivieren
  if (entity === 'yachts') {
    modelSel.disabled = false;
    return;
  }

  if (!brandSel?.value) {
    modelSel.innerHTML = `<option value="">${LABEL_ANY}</option>`;
    modelSel.disabled = true;
  } else {
    modelSel.disabled = false;
  }
}

function initCountryRegionFilters() {
  const dataNode = document.getElementById('fp-country-tree-data');
  if (!dataNode) return;

  let countryTree = [];
  try {
    countryTree = JSON.parse(dataNode.textContent || '[]');
  } catch (_) {
    countryTree = [];
  }
  if (!Array.isArray(countryTree) || !countryTree.length) return;

  const regionLabel = "<%= t('filter.region', REGION_LABEL_FALLBACK) %>";
  const anyLabel = "<%= t('labels.common.any','Beliebig') %>";
  const chooseCountryLabel = "<%= t('buyer.listing.location.select_country_first', 'Bitte zuerst Land wählen') %>";

  const asId = (value) => {
    const parsed = Number.parseInt(String(value || ''), 10);
    return Number.isInteger(parsed) && parsed > 0 ? String(parsed) : '';
  };

  const byId = new Map();
  const byParentId = new Map();
  const parents = [];
  countryTree.forEach((entry) => {
    const id = asId(entry?.id);
    if (!id) return;
    const parentId = entry?.parentId == null ? '' : asId(entry.parentId);
    const label = String(entry?.label || id);
    const row = { id, parentId, label };
    byId.set(id, row);
    if (!parentId) {
      parents.push(row);
      return;
    }
    if (!byParentId.has(parentId)) byParentId.set(parentId, []);
    byParentId.get(parentId).push(row);
  });
  parents.sort((a, b) => a.label.localeCompare(b.label, 'de', { sensitivity: 'base' }));

  form.querySelectorAll('select[name="country"]').forEach((countrySelect) => {
    if (countrySelect.dataset.regionEnhanced === '1') return;
    countrySelect.dataset.regionEnhanced = '1';

    const selectedRaw = asId(countrySelect.value);
    const selectedRow = selectedRaw ? byId.get(selectedRaw) : null;
    const selectedParent = selectedRow && selectedRow.parentId ? selectedRow.parentId : selectedRaw;
    const selectedRegion = selectedRow && selectedRow.parentId ? selectedRaw : '';
    const countryCol = countrySelect.closest('div[class*="md-col-"]') || countrySelect.parentElement;
    if (!countryCol) return;

    const hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'country';
    hidden.value = selectedRaw || '';
    countrySelect.removeAttribute('name');

    const firstOptionText = String(countrySelect.querySelector('option')?.textContent || anyLabel).trim() || anyLabel;
    countrySelect.innerHTML = '';
    const countryPlaceholder = document.createElement('option');
    countryPlaceholder.value = '';
    countryPlaceholder.textContent = firstOptionText;
    countrySelect.appendChild(countryPlaceholder);
    parents.forEach((parent) => {
      const option = document.createElement('option');
      option.value = parent.id;
      option.textContent = parent.label;
      countrySelect.appendChild(option);
    });

    const regionCol = document.createElement('div');
    regionCol.className = countryCol.className;
    regionCol.style.display = 'none';
    const regionLabelEl = document.createElement('label');
    regionLabelEl.className = 'md-label';
    regionLabelEl.textContent = regionLabel;
    const regionSelectWrap = document.createElement('div');
    regionSelectWrap.className = 'md-select';
    const regionSelect = document.createElement('select');
    regionSelect.className = countrySelect.className;
    regionSelect.disabled = true;
    regionSelect.innerHTML = `<option value="">${anyLabel}</option>`;
    regionSelectWrap.appendChild(regionSelect);
    regionCol.appendChild(regionLabelEl);
    regionCol.appendChild(regionSelectWrap);

    countryCol.insertAdjacentElement('afterend', regionCol);
    countryCol.appendChild(hidden);

    function renderRegions(parentId, selectedRegionId) {
      const regions = parentId
        ? (byParentId.get(parentId) || [])
            .slice()
            .sort((a, b) => a.label.localeCompare(b.label, 'de', { sensitivity: 'base' }))
        : [];

      if (!regions.length) {
        regionCol.style.display = 'none';
        regionSelect.innerHTML = `<option value="">${chooseCountryLabel}</option>`;
        regionSelect.value = '';
        regionSelect.disabled = true;
        return;
      }

      regionCol.style.display = '';
      regionSelect.disabled = false;
      regionSelect.innerHTML = `<option value="">${anyLabel}</option>`;
      regions.forEach((region) => {
        const option = document.createElement('option');
        option.value = region.id;
        option.textContent = region.label;
        regionSelect.appendChild(option);
      });

      if (selectedRegionId && regions.some((region) => region.id === selectedRegionId)) {
        regionSelect.value = selectedRegionId;
      } else {
        regionSelect.value = '';
      }
    }

    function syncHiddenCountry() {
      const selectedParentId = asId(countrySelect.value);
      const selectedRegionId = asId(regionSelect.value);
      hidden.value = selectedRegionId || selectedParentId || '';
    }

    countrySelect.value = selectedParent || '';
    renderRegions(asId(countrySelect.value), selectedRegion);
    syncHiddenCountry();

    countrySelect.addEventListener('change', () => {
      renderRegions(asId(countrySelect.value), '');
      syncHiddenCountry();
      updateCountDebounced();
    });
    regionSelect.addEventListener('change', () => {
      syncHiddenCountry();
      updateCountDebounced();
    });
  });
}



  // ----- EVENTS -----
  form.addEventListener('change', (e) => {
    const t = e.target;
    if (t && (t.type === 'checkbox' || t.type === 'radio')) {
      const chip = t.closest('label.chip-x');
      if (chip) chip.classList.toggle('active', t.checked);
    }
    updateCountDebounced();
  });

  form.querySelectorAll('input[data-any]').forEach(any => {
    const name = any.getAttribute('data-any');
    any.addEventListener('change', () => {
      if (any.checked) form.querySelectorAll(`input[name="${name}"]`).forEach(r => (r.checked = false));
      updateCountDebounced();
    });
  });

  form.querySelectorAll('select, input[type="number"], input[type="text"], input[type="date"]').forEach(el => {
    el.addEventListener('input', updateCountDebounced);
    el.addEventListener('change', updateCountDebounced);
  });

  brandSel?.addEventListener('change', async () => {
    syncModelEnabled();
    await loadModels();
    updateCountDebounced();
  });
  modelSel?.addEventListener('change', updateCountDebounced);

  const actionPath = (() => {
    try {
      const action = form.getAttribute('action') || location.pathname;
      const u = new URL(action, location.origin);
      return (u.pathname || '/').replace(/\/+$/, '') || '/';
    } catch {
      return `/${entity}`;
    }
  })();

  form.addEventListener('submit', (e) => {
    e.preventDefault(); e.stopPropagation();
    const p = collectAllParams();
    location.href = `${actionPath}?` + p.toString();
  });

  applyBtn?.addEventListener('click', () => {
    const p = collectAllParams();
    location.href = `${actionPath}?` + p.toString();
  });

  resetBtn?.addEventListener('click', () => {
    localStorage.removeItem(KEY);
  });

  // ----- INIT -----
  (async function initState() {
    const fromQuery = readQuery();
    let state = null;

    if (Object.keys(fromQuery).length) {
      state = fromQuery;
      applyState(form, state);
      localStorage.setItem(KEY, JSON.stringify(state));
    } else {
      const saved = localStorage.getItem(KEY);
      if (saved) {
        state = JSON.parse(saved);
        applyState(form, state);
      }
    }

    initCountryRegionFilters();
    syncModelEnabled();

    if ((entity === 'watches' || entity === 'cars') && brandSel?.value) {
      const preModel = state ? state[modelKey] : null;
      await loadModels(preModel);
    }


    updateCount();
  })();

})();
</script>




<%- include('../../partials/footer', { footerColumns }) %>

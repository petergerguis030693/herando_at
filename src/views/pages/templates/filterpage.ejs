      <div class="md-select">
        <select name="propertytype" id="fPropertyType">
          <option value=""><%= t('labels.common.any','Beliebig') %></option>

          <% 
            // SAFETY: Normalize selectedFilters.propertytype to an array
            const propertyTypesSelected = Array.isArray(selectedFilters.propertytype)
              ? selectedFilters.propertytype.map(String)
              : selectedFilters.propertytype
                  ? [String(selectedFilters.propertytype)]
                  : [];
          %>

          <% (filters.propertyTypes || []).forEach(pt => { %>
            <option value="<%= pt.id %>" 
              <%= propertyTypesSelected.includes(String(pt.id)) ? 'selected' : '' %>
            >
              <%= pt.name %>
            </option>
          <% }) %>

        </select>
      </div>
    </div>

    <!-- Investmenttyp -->
    <div class="md-col-4">
      <label class="md-label"><%= t('filters.realestate.investmenttype','Investmenttyp') %></label>
      <div class="md-select">
        <select name="investmenttype" id="fInvestmentType">
          <option value=""><%= t('labels.common.any','Beliebig') %></option>
          <% (filters.investmentTypes || []).forEach(it => { %>
            <option value="<%= it.id %>" <%= (selectedFilters.investmenttype||[]).map(String).includes(String(it.id)) ? 'selected' : '' %>><%= it.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const propertySelect = document.getElementById("fPropertyType");
  const investmentSelect = document.getElementById("fInvestmentType");
  const TEXT_ANY = <%- JSON.stringify(t('labels.common.any', 'Beliebig')) %>;
  const TEXT_LOCKED_BY_PROPERTY = <%- JSON.stringify(t('filters.realestate.locked_by_propertytype', 'Auswahl durch Immobilienart eingeschränkt')) %>;
  const TEXT_LOCKED_BY_INVESTMENT = <%- JSON.stringify(t('filters.realestate.locked_by_investmenttype', 'Auswahl durch Investmenttyp eingeschränkt')) %>;

  // Hilfsfunktion: Placeholder-Text ändern
  function setPlaceholder(select, text) {
    const firstOption = select.querySelector("option[value='']");
    if (firstOption) firstOption.textContent = text;
  }

  function syncFilters() {
    // 1) Immobilienart → deaktiviert Investmenttyp
    if (propertySelect.value) {
      investmentSelect.value = "";
      investmentSelect.disabled = true;
      investmentSelect.classList.add("disabled-filter");

      setPlaceholder(investmentSelect, TEXT_LOCKED_BY_PROPERTY);
    } else {
      investmentSelect.disabled = false;
      investmentSelect.classList.remove("disabled-filter");

      setPlaceholder(investmentSelect, TEXT_ANY);
    }

    // 2) Investmenttyp → deaktiviert Immobilienart
    if (investmentSelect.value) {
      propertySelect.value = "";
      propertySelect.disabled = true;
      propertySelect.classList.add("disabled-filter");

      setPlaceholder(propertySelect, TEXT_LOCKED_BY_INVESTMENT);
    } else {
      propertySelect.disabled = false;
      propertySelect.classList.remove("disabled-filter");

      setPlaceholder(propertySelect, TEXT_ANY);
    }
  }

  propertySelect.addEventListener("change", syncFilters);
  investmentSelect.addEventListener("change", syncFilters);

  // Initial bei Seitenaufruf
  syncFilters();
});
</script>




    <% if (currentEntity.route === 'watches') { 
       const isSel = (arr, v) => (Array.isArray(arr) ? arr.map(String).includes(String(v)) : String(arr||'') === String(v));
       const pick = (arr, fb) => (Array.isArray(arr) && arr.length ? arr : fb);
       const mergeById = (arr, fb) => {
         const out = [];
         const seen = new Set();
         const pushItem = (item) => {
           const id = String(item?.id ?? '');
           if (!id || seen.has(id)) return;
           seen.add(id);
           out.push(item);
         };
         (Array.isArray(arr) ? arr : []).forEach(pushItem);
         (Array.isArray(fb) ? fb : []).forEach(pushItem);
         return out;
       };

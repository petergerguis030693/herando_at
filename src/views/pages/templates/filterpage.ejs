<%- include('../../partials/header') %>
<%
const activeLangCode = String(locals.activeLang || 'de').split('-')[0];
const REGION_LABEL_FALLBACKS = {
  de: 'Bundesland / Region',
  en: 'State / Region',
  fr: 'Region',
  it: 'Regione',
  tr: 'Bölge',
  ja: '地域',
  cs: 'Region',
  ru: 'Регион',
  es: 'Region',
  nl: 'Regio',
  pl: 'Region'
};
const REGION_LABEL_FALLBACK = REGION_LABEL_FALLBACKS[activeLangCode] || 'Region';

const toText = (value, fallback) => {
  if (value == null) return String(fallback ?? '');
  if (typeof value === 'string' || typeof value === 'number') return String(value);
  if (typeof value === 'object') {
    if (typeof value[activeLangCode] === 'string') return value[activeLangCode];
    if (typeof value.de === 'string') return value.de;
    if (typeof value.label === 'string') return value.label;
    if (typeof value.name === 'string') return value.name;
  }
  return String(fallback ?? '');
};

// t-Helper: nimmt deine i18n-Middleware aus res.locals.t und normalisiert Object-Returns zu Text
const t = (key, fb) => {
  const raw = (typeof locals.t === 'function')
    ? locals.t(key, { lng: activeLangCode, defaultValue: fb })
    : (fb ?? key);
  return toText(raw, fb ?? key);
};

// Bequemlichkeits-Konstanten
const ANY   = t('labels.common.any', 'Beliebig');
const BACK  = t('labels.common.back_to_list', 'Zurück zur Liste');
const SHOWR = t('filters.actions.show_results', 'Ergebnisse anzeigen');
%>

<link rel="stylesheet" href="/css/filterpage.css">
<style>
.disabled-filter {
  opacity: 0.65;
  background-color: #e6e6e6 !important;
  cursor: not-allowed;
}

.disabled-filter select,
.disabled-filter option {
  background-color: #e6e6e6 !important;
}

.md-input input,
.md-range input,
.md-input select,
.md-range select {
    width: 100%;
    border: 1px solid #cfd7e3;
    height: 48px; 
    background: #f7f9fc;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: .96rem;
    color: #0f172a;
    outline: 0;
}

/* Einheitliche Placeholder-Farbe überall */
::placeholder,
.md-input input::placeholder,
.md-range input::placeholder,
.md-select select:invalid {
    color: #0f172a !important;
    opacity: 1 !important;
}

.md-title {
    font-size: 26px;
}

.md-card > h3,
.fp-card > h3,
.fp-card__title {
    font-size: 26px;
}

.bodytype-placeholder-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 48px;
  margin-bottom: 6px;
  color: #64748b;
  font-size: 28px;
  line-height: 1;
  letter-spacing: 3px;
}

.bodytype-card input[type="checkbox"]:checked + .bodytype-placeholder-icon {
  color: #0f172a;
}

.btn-ghost:hover{
  color: white; 
}

.btn-dark:hover{
  transform: none !important;
}

/* Farbpunkt */
.chip-x .sw {
  box-sizing: border-box;
}

/* Weiße / sehr helle Farben → schwarze Umrandung */
.chip-x:not(.active) .sw[style*="#fff"],
.chip-x:not(.active) .sw[style*="rgb(255"] {
  border: 1.5px solid #111;
}

/* Wenn ausgewählt → keine extra Umrandung, Active-Style greift */
.chip-x.active .sw {
  border: none;
}

/* Grundsetup */
.chip-x .sw {
  box-sizing: border-box;
}

/* WEISS (nicht aktiv) → schwarze Umrandung */
.chip-x:not(.active) .sw[style*="#fff"],
.chip-x:not(.active) .sw[style*="rgb(255"] {
  border: 1.5px solid #111;
}

/* SCHWARZ + MATT (immer) → weiße Umrandung */
.chip-x .sw[style*="#111"],
.chip-x .sw[style*="rgb(17"],
.chip-x .sw[style*="#444"],
.chip-x .sw[style*="#222"],
.chip-x .sw[style*="linear-gradient"] {
  border: 1.5px solid #fff;
}

/* Optional: aktiv etwas stärker */
.chip-x.active .sw[style*="#111"],
.chip-x.active .sw[style*="#444"],
.chip-x.active .sw[style*="#222"],
.chip-x.active .sw[style*="linear-gradient"] {
  border-width: 2px;
}

/* ================================
   INNENAUSSTATTUNG – FARBCHIPS
   ================================ */

/* Grund */
.chip--color .chip-swatch{
  box-sizing: border-box;
}

/* WEISS (nicht aktiv) → schwarze Umrandung */
.chip--color:not(.active) .chip-swatch[style*="#fff"],
.chip--color:not(.active) .chip-swatch[style*="rgb(255"] {
  border: 1.5px solid #111;
}

/* SCHWARZ + MATT → weiße Umrandung (immer) */
.chip--color .chip-swatch[style*="#111"],
.chip--color .chip-swatch[style*="#444"],
.chip--color .chip-swatch[style*="#222"],
.chip--color .chip-swatch[style*="linear-gradient"] {
  border: 1.5px solid #fff;
}

/* Optional: aktiv stärker */
.chip--color.active .chip-swatch[style*="#111"],
.chip--color.active .chip-swatch[style*="#444"],
.chip--color.active .chip-swatch[style*="#222"],
.chip--color.active .chip-swatch[style*="linear-gradient"] {
  border-width: 2px;
}

</style>


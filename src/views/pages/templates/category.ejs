.entity-description .brand-taxonomy-section h3 {
  margin-bottom: 8px;
}
.entity-description .brand-taxonomy-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.entity-description .brand-taxonomy-list li {
  margin: 0 0 4px;
  line-height: 1.4;
}
</style>


<%- include('../../components/script') %>
<script>
(function () {
  const allowedLimits = new Set(['32', '60', '120']);
  const fallbackLimit = '32';
  const selectEl = document.getElementById('itemsPerPage');
  const setLimitCookie = (value) => {
    document.cookie = `itemsPerPage=${value}; Path=/; Max-Age=${60 * 60 * 24 * 180}; SameSite=Lax`;
  };

  const savedRaw = localStorage.getItem('itemsPerPage');
  const saved = (savedRaw && allowedLimits.has(savedRaw)) ? savedRaw : null;
  if (savedRaw && !saved) {
    localStorage.removeItem('itemsPerPage');
  }

  const url = new URL(window.location.href);
  const urlLimit = url.searchParams.get('limit');
  const hasValidUrlLimit = !!(urlLimit && allowedLimits.has(urlLimit));
  const renderedLimit = (selectEl && allowedLimits.has(selectEl.value)) ? selectEl.value : null;

  let effectiveLimit = fallbackLimit;
  if (hasValidUrlLimit) effectiveLimit = urlLimit;
  else if (saved) effectiveLimit = saved;
  else if (renderedLimit) effectiveLimit = renderedLimit;

  if (!hasValidUrlLimit) {
    url.searchParams.set('limit', effectiveLimit);
    if (!url.searchParams.get('hp')) url.searchParams.set('hp', '1');
    window.history.replaceState({}, '', url.toString());
  }

  if (selectEl) selectEl.value = effectiveLimit;
  localStorage.setItem('itemsPerPage', effectiveLimit);
  setLimitCookie(effectiveLimit);
})();
</script>

<script>
function updateLimit(limit){
  const allowedLimits = new Set(['32', '60', '120']);
  const safeLimit = allowedLimits.has(String(limit)) ? String(limit) : '32';
  localStorage.setItem('itemsPerPage', safeLimit);
  document.cookie = `itemsPerPage=${safeLimit}; Path=/; Max-Age=${60 * 60 * 24 * 180}; SameSite=Lax`;

  const url = new URL(window.location.href);
  url.searchParams.set('limit', safeLimit);
  url.searchParams.set('hp', '1');
  window.location.href = url.toString();
}
</script>

<script>
(() => {
  const root = document.querySelector('.entity-description');
  if (!root) return;

  const allNodes = Array.from(root.children || []);
  if (!allNodes.length) return;

  const startIndex = allNodes.findIndex((node) => {
    if (!node || !/^H[23]$/i.test(node.tagName || '')) return false;
    const text = String(node.textContent || '').trim().toLowerCase();
    return text.includes('alle') && text.includes('modelle') && text.includes('varianten');
  });
  if (startIndex < 0) return;

  const tail = allNodes.slice(startIndex);
  const groups = [];
  let current = null;

  for (const node of tail) {
    const tag = String(node.tagName || '').toUpperCase();
    if (tag === 'H2' || tag === 'H3') {
      current = { heading: node, items: [] };
      groups.push(current);
      continue;
    }
    if (!current) continue;
    if (tag !== 'P') continue;
    const text = String(node.textContent || '').replace(/\s+/g, ' ').trim();
    if (!text || text === '_') continue;
    current.items.push(text);
  }

  const validGroups = groups.filter((g) => g.heading && g.items.length);
  if (!validGroups.length) return;

  const wrapper = document.createElement('div');
  wrapper.className = 'brand-taxonomy-flex';

  validGroups.forEach((g) => {
    const section = document.createElement('section');
    section.className = 'brand-taxonomy-section';

    section.appendChild(g.heading.cloneNode(true));

    const ul = document.createElement('ul');
    ul.className = 'brand-taxonomy-list';
    g.items.forEach((itemText) => {
      const li = document.createElement('li');
      li.textContent = itemText;
      ul.appendChild(li);
    });

    section.appendChild(ul);
    wrapper.appendChild(section);
  });

  tail.forEach((node) => node.remove());
  root.appendChild(wrapper);
})();
</script>





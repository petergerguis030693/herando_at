<%
  const heroByEntity = {
    yachts: {
      img: "/assets/yachten.jpg",
      caption: "Luxury Yachts",
      text: "Discover luxury yachts & superyachts worldwide."
    },
    cars: {
      img: "/assets/cars.jpg",
      caption: "Luxury Cars",
      text: "Explore exclusive cars and supercars worldwide."
    },
    watches: {
      img: "/assets/watches.jpg",
      caption: "Luxury Watches",
      text: "Timeless elegance with exclusive watches."
    },
    properties: {
      img: "/assets/properties.jpg",
      caption: "Luxury Properties",
      text: "Find your dream property around the world."
    },
    lifestyles: {
      img: "/assets/lifestyle.png",
      caption: "Luxury Lifestyle",
      text: "Experience the world of luxury lifestyle."
    }
  };

  const heroKey = (currentEntity && currentEntity.route ? String(currentEntity.route).toLowerCase() : "");
  const heroBaseData = heroByEntity[heroKey] || {
    img: "/assets/cars.jpg",
    caption: "Luxury",
    text: ""
  };
  const heroImageKey = heroKey ? `category_hero_image_${heroKey}` : "";
  const heroData = {
    ...heroBaseData,
    img: (heroImageKey && typeof t === 'function')
      ? t(heroImageKey, heroBaseData.img)
      : heroBaseData.img
  };
%>
<link rel="preload" as="image" href="<%= heroData.img %>">

<section class="boxed-hero-shell">
  <div id="heroSection" class="hero-section boxed-hero-stage">
    <img id="heroImage" src="<%= heroData.img %>" alt="<%= heroData.caption %>" class="hero-image" width="1920" height="640" fetchpriority="high" loading="eager">
  </div>
</section>

 

<%- include('../../components/product-slider') %>

<%- include('../../components/category-search') %>


<%- include('../../components/entity-search', { currency }) %>
 
<%- include('../../components/product-list', { items, currentEntity }) %>


  <% let baseQS='' ; if (selectedFilters.brand) baseQS +=`&brand=${encodeURIComponent(selectedFilters.brand)}`; if
    (selectedFilters.model) baseQS +=`&model=${encodeURIComponent(selectedFilters.model)}`; if (selectedFilters.yearMin)
    baseQS +=`&yearMin=${encodeURIComponent(selectedFilters.yearMin)}`; if (selectedFilters.mileageMax)baseQS
    +=`&mileageMax=${encodeURIComponent(selectedFilters.mileageMax)}`; if (selectedFilters.paymentType) baseQS
    +=`&paymentType=${encodeURIComponent(selectedFilters.paymentType)}`; if (selectedFilters.priceMax) baseQS
    +=`&priceMax=${encodeURIComponent(selectedFilters.priceMax)}`; if (selectedFilters.location) baseQS
    +=`&location=${encodeURIComponent(selectedFilters.location)}`; %>
<section class="hernando-pagination">
  <div class="hernando-pagination-container">

    <div class="hernando-perpage-title">Inserate pro Seite</div>

    <div class="hernando-pagination-row">

      <!-- LINKS -->
      <div class="hernando-perpage">
        <select id="itemsPerPage"
                class="form-select hernando-perpage-select"
                onchange="updateLimit(this.value)">
          <option value="32" <%=limit===32?'selected':''%>>32</option>
          <option value="60" <%=limit===60?'selected':''%>>60</option>
          <option value="120" <%=limit===120?'selected':''%>>120</option>
        </select>
      </div>

      <!-- RECHTS -->
      <% if (totalPages > 1) { %>
        <%
          const maxPages = 5;
          let start = Math.max(1, currentPage - Math.floor(maxPages / 2));
          let end   = start + maxPages - 1;
          if (end > totalPages) {
            end = totalPages;
            start = Math.max(1, end - maxPages + 1);
          }
        %>

        <nav class="hernando-pagination-nav">
          <ul class="pagination">

            <% if (currentPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="?<%= new URLSearchParams({ ...query, hp: 1 }).toString() %>">«</a>
              </li>
              <li class="page-item">
                <a class="page-link" href="?<%= new URLSearchParams({ ...query, hp: currentPage - 1 }).toString() %>">‹</a>
              </li>
            <% } %>

            <% for (let p = start; p <= end; p++) { %>
              <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?<%= new URLSearchParams({ ...query, hp: p }).toString() %>"><%= p %></a>
              </li>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <li class="page-item">
                <a class="page-link" href="?<%= new URLSearchParams({ ...query, hp: currentPage + 1 }).toString() %>">›</a>
              </li>
              <li class="page-item">
                <a class="page-link" href="?<%= new URLSearchParams({ ...query, hp: totalPages }).toString() %>">»</a>
              </li>
            <% } %>

          </ul>
        </nav>
      <% } %>

    </div>
  </div>
</section>




    
<%
  const route = (currentEntity && currentEntity.route ? String(currentEntity.route).toLowerCase() : '');
  const keys  = [
    `entity.${route}.description_html`,
    `entity.${route}.description`
  ];

  const dbFallback = (currentEntity && typeof currentEntity.description === 'string')
    ? currentEntity.description
    : '';

  function fromT(k){
    try {
      if (typeof t === 'function') {
        const v = t(k, { fallback: '' });
        return (typeof v === 'string') ? v : '';
      }
    } catch(e) {}
    return '';
  }

  let descHtml = '';
  const brandSeoHtml = (typeof selectedBrandSeoText === 'string')
    ? selectedBrandSeoText.trim()
    : '';

  if (brandSeoHtml) {
    descHtml = brandSeoHtml;
  }

  for (const k of keys) {
    if (descHtml) break;
    const v = fromT(k);
    if (v && v.trim()) { descHtml = v; break; }
  }
  if (!descHtml) descHtml = dbFallback;
%>

<% if (descHtml && descHtml.trim()) { %>
<section class="container mb-5" style="max-width: 1800px !important;">
  <div>
    <div class="entity-description"><%- descHtml %></div>
  </div>
</section>
<% } %>

<style>
.entity-description .brand-taxonomy-flex {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 12px;
}
.entity-description .brand-taxonomy-section {
  flex: 1 1 320px;
  min-width: 280px;
}

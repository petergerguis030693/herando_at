<script>
document.addEventListener("DOMContentLoaded", async () => {
  const brandSelect = document.getElementById('brand_id');
  const modelSelect = document.getElementById('model_id');
  const currentModelId = "<%= item.model_id || '' %>";

  async function loadModels(brandId) {
    if (!brandId) {
      modelSelect.disabled = true;
      modelSelect.innerHTML = `<option value="">${<%- JSON.stringify(t('edit_listing.watches.model.choose_brand_first','Bitte zuerst Marke wählen …')) %>}</option>`;
      return;
    }

    modelSelect.disabled = true;
    modelSelect.innerHTML = `<option>${<%- JSON.stringify(t('edit_listing.watches.model.loading','Lade Modelle...')) %>}</option>`;

    try {
      const res = await fetch(`/buyer/api/models/${brandId}`);
      const payload = await res.json();
      const models = Array.isArray(payload)
        ? payload
        : (Array.isArray(payload?.models) ? payload.models : []);

      console.log("📦 Modelle geladen (Frontend):", models);

      if (!res.ok || models.length === 0) {
        modelSelect.innerHTML = `<option>${<%- JSON.stringify(t('edit_listing.watches.model.none','Keine Modelle gefunden')) %>}</option>`;
        modelSelect.disabled = true;
        return;
      }

      modelSelect.disabled = false;
      modelSelect.innerHTML = `<option value="">${<%- JSON.stringify(t('edit_listing.select.choose','Bitte wählen …')) %>}</option>`;

      models.forEach(m => {
        const selected = String(m.id) === String(currentModelId) ? 'selected' : '';
        modelSelect.innerHTML += `<option value="${m.id}" ${selected}>${m.name}</option>`;
      });

    } catch (err) {
      console.error("❌ Fehler beim Laden der Modelle:", err);
      modelSelect.innerHTML = `<option>${<%- JSON.stringify(t('edit_listing.watches.model.error','Fehler beim Laden')) %>}</option>`;
      modelSelect.disabled = false;
    }
  }

  // Nur nachladen, wenn serverseitig noch keine Model-Optionen vorhanden sind
  const hasInitialModels = modelSelect.options.length > 0 && Array.from(modelSelect.options).some(o => o.value);
  if (brandSelect.value && !hasInitialModels) {
    await loadModels(brandSelect.value);
  }

  // Beim Wechsel der Marke Modelle neu laden
  brandSelect.addEventListener("change", () => loadModels(brandSelect.value));
});
</script>






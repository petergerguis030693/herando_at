<script>
/* ---------------------------------------------------
   📌 FORM REFERENZ – SEHR WICHTIG
--------------------------------------------------- */
const form = document.querySelector('form[action^="/buyer/edit-listing"]');
console.log("📌 Erkanntes FORM:", form);


/* ---------------------------------------------------
   🔥 ALTE BILDER ENTFERNEN
--------------------------------------------------- */
function removeImage(btn, filename) {
  console.log("🗑️ [OLD] Entferne altes Bild:", filename);

  const wrapper = btn.closest('.image-box');
  if (wrapper) {
    wrapper.remove();
    console.log("🧱 [OLD] DOM entfernt.");
  } else {
    console.warn("⚠️ [OLD] Wrapper nicht gefunden!");
  }

  // Hidden Input für Backend (+ Debug)
  const removed = document.createElement('input');
  removed.type = 'hidden';
  removed.name = 'removedImages[]';
  removed.value = filename;

  form.appendChild(removed);

  console.log("📩 [OLD] Hidden Input hinzugefügt:", removed);
  console.log("📦 [OLD] Form Inputs total:", form.elements.length);
}


/* ---------------------------------------------------
   🔥 NEUE BILDER HANDLING (DataTransfer)
--------------------------------------------------- */
const dt = new DataTransfer();
console.log("📌 DataTransfer initialisiert:", dt);

function handleFiles(event) {
  const input = event.target;
  console.log("📥 Neue Dateien erkannt:", input.files.length);

  for (const file of input.files) {
    dt.items.add(file);
    console.log("➕ [NEW] Datei hinzugefügt:", file.name);
  }

  input.files = dt.files;
  console.log("🧾 [NEW] Gesamte Dateien im dt:", dt.files.length);

  renderNewPreviews();
}


/* ---------------------------------------------------
   🔥 Neue Bilder rendern
--------------------------------------------------- */
function renderNewPreviews() {
  const preview = document.getElementById('picture-preview');

  // nur NEUE Bilder entfernen
  const newImages = preview.querySelectorAll('.new-image');
  newImages.forEach(e => e.remove());
  console.log(`🧹 [NEW] Alte Previews entfernt (${newImages.length})`);

  Array.from(dt.files).forEach((file, index) => {
    if (!file.type.startsWith('image/')) return;

    const reader = new FileReader();

    reader.onload = e => {
      const wrap = document.createElement('div');
      wrap.className = 'new-image position-relative border rounded overflow-hidden bg-light';
      wrap.style.width = '220px';
      wrap.style.height = '160px';

      wrap.innerHTML = `
        <img src="${e.target.result}" class="img-fluid w-100 h-100 object-fit-cover">
        <button 
          type="button"
          class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 px-2 py-0 fw-bold"
          onclick="removeNewFile(${index})">×</button>
      `;

      preview.appendChild(wrap);
      console.log("🖼️ [NEW] Preview gerendert:", file.name);
    };

    reader.readAsDataURL(file);
  });

  console.log("🎨 [NEW] Render abgeschlossen.");
}


/* ---------------------------------------------------
   🔥 Neues Bild löschen
--------------------------------------------------- */
function removeNewFile(index) {
  console.log("🧹 [NEW] Entferne neues Bild index:", index);

  const nextDT = new DataTransfer();

  Array.from(dt.files).forEach((file, i) => {
    if (i !== index) {
      nextDT.items.add(file);
      console.log("➡️ [NEW] Datei bleibt:", file.name);
    } else {
      console.log("❌ [NEW] Datei gelöscht:", file.name);
    }
  });

  // dt aktualisieren
  dt.items.clear();
  for (const file of nextDT.files) dt.items.add(file);

  // Input aktualisieren
  document.getElementById('pictures').files = dt.files;

  console.log("📦 [NEW] Dateien nach Löschen:", dt.files.length);

  renderNewPreviews();
}


/* ---------------------------------------------------
   🔥 CKEditor
--------------------------------------------------- */
document.addEventListener('DOMContentLoaded', () => {
  const el = document.querySelector('#description');
  if (el && window.ClassicEditor) {
    ClassicEditor.create(el, {
      toolbar: ['heading','|','bold','italic','bulletedList','numberedList']
    })
      .then(editor => {
        console.log("✏️ CKEditor geladen");
      })
      .catch(err => console.error(err));
  }
});
</script>






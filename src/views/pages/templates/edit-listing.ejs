<label for="mainpicture-upload" class="form-label"><%= t('edit_listing.media.mainpicture','Titelbild ändern') %></label>

<div id="picture-preview" class="d-flex flex-wrap gap-3 mb-2">
  <%
    const extractImageFilename = (input) => {
      const fromString = (raw) => {
        let s = String(raw || '').trim();
        if (!s) return '';

        const imageMatch = s.match(/s:\d+:"image";s:\d+:"([^"]+)"/);
        if (imageMatch && imageMatch[1]) {
          return fromString(imageMatch[1]);
        }

        const serializedStringMatch = s.match(/^s:\d+:"([^"]+)";$/);
        if (serializedStringMatch && serializedStringMatch[1]) {
          return fromString(serializedStringMatch[1]);
        }

        if (s.startsWith('{') || s.startsWith('[')) {
          try {
            const parsed = JSON.parse(s);
            return extractImageFilename(parsed);
          } catch {}
        }

        if (s.includes(',')) {
          const first = s.split(',').map(v => v.trim()).find(Boolean);
          if (first) s = first;
        }

        s = s.split('?')[0].split('#')[0];
        return s.split('/').pop().trim();
      };

      if (!input) return '';
      if (Array.isArray(input)) return extractImageFilename(input[0]);
      if (typeof input === 'object') {
        return extractImageFilename(input.image || input.path || input.url || '');
      }
      return fromString(input);
    };

    const fileName = extractImageFilename(item.mainpicture);

    const imgPath = fileName
      ? `/images/${ent.route}/${item.id}/${encodeURIComponent(fileName)}`
      : null;
  %>

  <div class="image-box position-relative border rounded overflow-hidden shadow-sm bg-light"
       style="width:220px; height:160px;">

    <img 
      id="mainPreview"
      src="<%= imgPath || '/assets/herando-weblogo.png' %>" 
      class="img-fluid w-100 h-100 object-fit-cover">

  </div>
</div>

<input type="file" id="mainpicture-upload" class="form-control" accept="image/*"><br>

<span><%= t('edit_listing.media.mainpicture.note','* Bitte laden Sie hier ausschließlich ein neues Titelbild hoch, falls nötig') %></span>


<script>
const input  = document.getElementById('mainpicture-upload');
const preview = document.getElementById('mainPreview');

input?.addEventListener('change', async function () {
  const file = this.files[0];
  if (!file) return;

  // ✅ Vorschau sofort anzeigen
  const reader = new FileReader();
  reader.onload = e => preview.src = e.target.result;
  reader.readAsDataURL(file);

  // ✅ Upload
  const formData = new FormData();
  formData.append('mainpicture', file);

  const res = await fetch('/buyer/api/listing/<%= item.id %>/mainpicture/update', {
    method: 'POST',
    body: formData
  });

  const data = await res.json();

  if (!data.success) {
    alert(<%- JSON.stringify(t('edit_listing.media.upload_failed','Upload fehlgeschlagen')) %>);
  }
});
</script>




        <option value="" disabled <%= !item.country_id ? 'selected' : '' %>><%= t('edit_listing.select.choose','Bitte wählen …') %></option>
        <% filters.countries.forEach(c => { %>
          <option 
            value="<%= c.id %>" 
            <%= (item.country_id == c.id) ? 'selected' : '' %>>
            <%= t('country.' + c.id, c.name) %>
          </option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- Stadt -->
  <div class="row mb-3 align-items-center">
    <label for="city" class="col-sm-3 col-form-label text-end fw-semibold"><%= t('edit_listing.location.city','Stadt') %></label>
    <div class="col-sm-4">
      <input 
        id="city" 
        name="city" 
        type="text" 
        class="form-control" 
        value="<%= item.city || '' %>" 
        required>
    </div>
  </div>
</fieldset>


<!-- ⭐ BEARBEITEN BUTTON – RICHTIGER PLATZ -->
<div class="text-center mb-5">
  <button type="submit" class="btn btn-light px-5">
    <i class="bi bi-save me-2"></i><%= t('edit_listing.save','Speichern') %>
  </button>
</div>

</form>
</main>
</div>


<!-- SCRIPTS -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script>
const formattedInput = document.getElementById('priceFormatted');
const hiddenInput    = document.getElementById('price');

function formatNumberDE(value) {
  const num = value.replace(/\D/g, '');
  return num.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

formattedInput.addEventListener('input', function () {
  const cursorPos = this.selectionStart;

  // reine Zahl holen
  const raw = this.value.replace(/\D/g, '');

  // sichtbar formatieren
  this.value = formatNumberDE(raw);

  // echten Wert setzen
  hiddenInput.value = raw;

  // Cursor korrigieren
  this.setSelectionRange(cursorPos, cursorPos);
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const formattedInput = document.getElementById('priceFormatted');
  const hiddenInput    = document.getElementById('price');

  if (hiddenInput.value) {
    formattedInput.value = new Intl.NumberFormat(<%- JSON.stringify(_locale) %>)
      .format(hiddenInput.value);
  }
});
</script>

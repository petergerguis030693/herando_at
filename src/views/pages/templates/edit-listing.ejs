        <label for="quality" class="form-label"><%= t('edit_listing.properties.quality','Objektzustand') %></label>
        <select id="quality" name="quality" class="form-select">
          <option value=""><%= t('edit_listing.select.choose','Bitte wählen …') %></option>
          <% extras.quality.forEach(o => { %>
            <option value="<%= o.value %>" <%= item.quality == o.value ? 'selected' : '' %>><%= t('attribute.properties.quality.' + o.value, o.label) %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
  </div>

  <!-- Immobilienart, Rendite-Immobilien, Denkmalschutz -->
  <div class="row g-3 mb-3 align-items-end">
<% if (extras.propertytype) { %>
  <div class="col-md-4" id="wrapPropertyType">
    <label for="propertytype" class="form-label"><%= t('edit_listing.properties.type','Immobilienart') %></label>
    <select id="propertytype" name="propertytype" class="form-select">
      <option value="">---</option>
      <% extras.propertytype.forEach(o => { %>
        <option value="<%= o.value %>" <%= item.propertytype == o.value ? 'selected' : '' %>>
          <%= t('attribute.properties.propertytype.' + o.value, o.label) %>
        </option>
      <% }) %>
    </select>
  </div>
<% } %>

<% if (extras.investmenttype) { %>
  <div class="col-md-4" id="wrapInvestmentType">
    <label for="investmenttype" class="form-label"><%= t('edit_listing.properties.investment','Rendite-Immobilien') %></label>
    <select id="investmenttype" name="investmenttype" class="form-select">
      <option value="">---</option>
      <% extras.investmenttype.forEach(o => { %>
        <option value="<%= o.value %>" <%= item.investmenttype == o.value ? 'selected' : '' %>>
          <%= t('attribute.properties.investmenttype.' + o.value, o.label) %>
        </option>
      <% }) %>
    </select>
  </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const propertySelect   = document.getElementById('propertytype');
  const investmentSelect = document.getElementById('investmenttype');

  function updateState() {

    if (propertySelect.value) {
      // Rendite deaktivieren + NULL setzen
      investmentSelect.value = '';
      investmentSelect.disabled = true;
      investmentSelect.classList.add('opacity-50');
    } else {
      investmentSelect.disabled = false;
      investmentSelect.classList.remove('opacity-50');
    }

    if (investmentSelect.value) {
      // Immobilienart deaktivieren + NULL setzen
      propertySelect.value = '';
      propertySelect.disabled = true;
      propertySelect.classList.add('opacity-50');
    } else {
      propertySelect.disabled = false;
      propertySelect.classList.remove('opacity-50');
    }
  }

  propertySelect.addEventListener('change', updateState);
  investmentSelect.addEventListener('change', updateState);

  updateState(); // Edit-Fall
});
</script>





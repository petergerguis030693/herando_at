  <!-- PS <-> kW Umrechnung -->
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const kwInput = document.getElementById('power_kw');
    const psInput = document.getElementById('power_ps');
    if (!kwInput || !psInput) return;

    const KW_TO_PS = 1.36;
    let lock = false;

    const toNum = (v) => {
      if (v === '' || v === null || v === undefined) return NaN;
      const n = parseFloat(String(v).replace(',', '.'));
      return Number.isFinite(n) ? n : NaN;
    };

    kwInput.addEventListener('input', () => {
      if (lock) return;
      lock = true;
      const kw = toNum(kwInput.value);
      psInput.value = isNaN(kw) ? '' : Math.round(kw * KW_TO_PS);
      lock = false;
    });

    psInput.addEventListener('input', () => {
      if (lock) return;
      lock = true;
      const ps = toNum(psInput.value);
      kwInput.value = isNaN(ps) ? '' : Math.round(ps / KW_TO_PS);
      lock = false;
    });
  });
  </script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const cat = document.getElementById("brand_id");
  const subRow = document.getElementById("subcategory-row");
  const sub = document.getElementById("model_id");

  function filterSubs(pid) {
    Array.from(sub.options).forEach(o => {
      if (!o.dataset.parent) return;
      o.hidden = o.dataset.parent !== pid;
    });
  }

  // 🔥 Beim Laden (EDIT!)
  if (cat.value) {
    sub.disabled = false;
    subRow.classList.remove("d-none");
    filterSubs(cat.value);
  } else {
    subRow.classList.add("d-none");
    sub.disabled = true;
  }

  // 🔁 Bei Änderung
  cat.addEventListener("change", () => {
    const pid = cat.value;

    if (!pid) {
      subRow.classList.add("d-none");
      sub.disabled = true;
      sub.value = "";
      return;
    }

    sub.disabled = false;
    subRow.classList.remove("d-none");
    filterSubs(pid);
    sub.value = "";
  });
});
</script>



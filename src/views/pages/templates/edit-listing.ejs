<form action="/buyer/edit-listing/<%= item.id %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="ent_id" value="<%= ent.id %>">

<fieldset class="mb-4 p-4 border bg-white rounded shadow-sm listing-box">
  <legend class="fw-semibold px-2 listing-legend"><%= t('edit_listing.section.base','Basisdaten') %></legend>

  <!-- Titel -->
<div class="row mb-4">
  <div class="col-md-7">

    <label for="name" class="form-label fw-semibold">
      <%= t('edit_listing.label.title','Überschrift Ihrer Anzeige') %> *
    </label>

    <input 
      id="name" 
      name="name" 
      type="text" 
      class="form-control" 
      required 
      value="<%= item.name || '' %>">

  </div>
</div>


  <!-- Kaufpreis -->
  <div class="row mb-4 align-items-center">

    <label for="priceFormatted" class="col-md-3 col-form-label fw-semibold listing-label">
      * <%= t('edit_listing.label.price','Kaufpreis') %>
    </label>

    <div class="col-md-7 d-flex align-items-center gap-3">

      <!-- Preisfeld -->
      <div style="width: 220px;">
        <input 
          id="priceFormatted"
          type="text"
          class="form-control"
          inputmode="numeric"
          placeholder=""
          value="<%= item.price && item.price > 0 
            ? new Intl.NumberFormat(_locale).format(item.price) 
            : '' %>">

        <input 
          type="hidden"
          id="price"
          name="price"
          value="<%= item.price || '' %>">
      </div>

      <!-- Toggle -->
      <div class="form-check form-switch m-0 d-flex align-items-center">
        <input 
          class="form-check-input" 
          type="checkbox" 
          id="priceOnRequest" 
          onchange="togglePriceState()"
          <%= item.price === 0 ? 'checked' : '' %>>
        <label class="form-check-label fw-semibold ms-2" for="priceOnRequest">
          <%= t('edit_listing.price.on_request','auf Anfrage') %>
        </label>
      </div>

      <!-- Währung -->
      <div style="width: 120px;">
        <select id="currency" name="currency" class="form-select">
          <% [
            'EUR','USD','CHF','GBP','AED','AUD','CAD','CZK','DKK','HKD','HUF',
            'JPY','PLN','SEK'
          ].forEach(curr => { %>
            <option value="<%= curr %>" <%= item.currency === curr ? 'selected' : '' %>>
              <%= curr %>
            </option>
          <% }) %>
        </select>
      </div>

      <% if (user && user.registration_type === 'commercial') { %>
        <!-- MwSt -->
        <div class="form-check d-flex align-items-center gap-2 m-0">
          <input type="hidden" name="vat" value="0">
          <input 
            id="vat" 
            name="vat" 
            type="checkbox" 
            class="form-check-input" 
            value="1" 
            <%= item.vat == 1 ? 'checked' : '' %>>
          <label for="vat" class="form-check-label fw-semibold mb-0">
            <%= t('edit_listing.vat.deductible','MwSt. ausweisbar') %>
          </label>
        </div>
      <% } %>

    </div>
  </div>

  <div class="row">
    <div class="col-md-7">
      <p class="form-text">
        <%= t('edit_listing.price.hint','Wenn kein Preis angegeben wird, erscheint „Preis auf Anfrage“.') %>
      </p>
    </div>
  </div>
</fieldset>


<script>
let lastPriceValue = '';
const LOCALE = <%- JSON.stringify(_locale) %>;

function togglePriceState() {
  const checkbox   = document.getElementById('priceOnRequest');
  const priceInput = document.getElementById('priceFormatted');
  const hidden     = document.getElementById('price');

  if (checkbox.checked) {
    // 🔥 alten Wert merken
    lastPriceValue = hidden.value;

    priceInput.value = '';
    priceInput.disabled = true;
    hidden.value = 0;

  } else {
    priceInput.disabled = false;

    // 🔥 alten Wert zurücksetzen
    if (lastPriceValue) {
      hidden.value = lastPriceValue;
      priceInput.value = new Intl.NumberFormat(LOCALE)
        .format(lastPriceValue);
    }
  }
}
</script>






        <% }) %>
      </select>
    </div>
  </div>
</fieldset>

<script>
document.addEventListener("DOMContentLoaded", () => {
  // Sortiere Umweltplakette numerisch
  const select = document.getElementById("environmental_badge");
  if (!select) return;

  const firstOption = select.querySelector('option[value=""]');
  const options = Array.from(select.options).filter(o => o.value !== "");

  options.sort((a, b) => a.text.localeCompare(b.text, 'de', { numeric: true }));
  select.innerHTML = "";
  select.appendChild(firstOption);
  options.forEach(o => select.appendChild(o));

  // Falls im Datensatz bereits ein Wert gespeichert ist, diesen wieder aktivieren
  select.value = "<%= item.environmental_badge || '' %>";
});
</script>




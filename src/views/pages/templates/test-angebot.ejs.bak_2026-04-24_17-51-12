<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog auth-modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title"><%= t('offers.auth.modal.title', { fallback: 'Registrierung / Login' }) %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Tabs (intern, ausgeblendet) -->
        <ul class="nav nav-tabs mb-3 d-none" id="authTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button">
              <%= t('offers.auth.tab.login', { fallback: 'Login' }) %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button">
              <%= t('offers.auth.tab.register', { fallback: 'Registrieren' }) %>
            </button>
          </li>
        </ul>

        <div id="authEntryStep">
          <div class="registration-step-card mb-3">
            <span class="registration-step-badge">Start</span>
            <h6 class="mb-2"><%= t('offers.auth.start.title', 'Wie möchten Sie fortfahren?') %></h6>
            <p class="mb-0 text-muted"><%= t('offers.auth.start.subtitle', 'Wählen Sie Login oder neue Registrierung.') %></p>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <button type="button" class="auth-choice-card w-100" id="chooseAuthLogin">
                <h6 class="mb-1"><%= t('offers.auth.tab.login', { fallback: 'Login' }) %></h6>
                <span class="text-muted"><%= t('offers.auth.start.loginHelp', 'Ich habe bereits ein Konto.') %></span>
              </button>
            </div>
            <div class="col-md-6">
              <button type="button" class="auth-choice-card w-100" id="chooseAuthRegister">
                <h6 class="mb-1"><%= t('offers.auth.start.register', 'Neu registrieren') %></h6>
                <span class="text-muted"><%= t('offers.auth.start.registerHelp', 'Ich möchte ein neues Konto erstellen.') %></span>
              </button>
            </div>
          </div>
        </div>

        <div class="tab-content mt-3">
          <!-- 🟩 LOGIN -->
          <div class="tab-pane fade d-none" id="login">
            <button type="button" class="btn btn-sm btn-outline-secondary mb-3" id="backToAuthChoiceFromLogin">
              <%= t('common.back', 'Zurück') %>
            </button>
            <form id="loginForm" method="post" action="/auth/login" autocomplete="on">
              <div class="mb-3">
                <label class="form-label"><%= t('offers.auth.email', { fallback: 'E-Mail-Adresse' }) %></label>
                <input type="email" class="form-control" name="email" required>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('offers.auth.password', { fallback: 'Passwort' }) %></label>
                <input type="password" class="form-control" name="password" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">
                <%= t('offers.auth.login.button', { fallback: 'Einloggen' }) %>
              </button>
            </form>
          </div>

          <!-- 🟦 REGISTER -->
          <div class="tab-pane fade d-none" id="register">
            <!-- GEWERBLICH -->
            <div id="commercialForm" class="d-none">
              <form id="formCommercial" method="post" action="/auth/register" autocomplete="on" enctype="multipart/form-data">
                <h5 class="mb-3"><%= t('offers.auth.register.commercial.title', { fallback: 'Als gewerblicher Anbieter registrieren' }) %></h5>
                <input type="hidden" name="type" value="commercial">
                <input type="hidden" name="packageId" class="selected-package-id" value="">

                <div class="registration-step1">
                  <div class="registration-step-card">
                    <span class="registration-step-badge">Schritt 1 von 3</span>
                    <h6 class="mb-2"><%= t('offers.modal.package.selection.title', 'Paket und Kategorie auswählen') %></h6>
                    <div class="package-options-row mt-1">
                      <% (commercialPackages || []).forEach(function(pkg) { %>
                        <div class="package-option-col">
                          <div class="card shadow-sm h-100 border-0 package-option-card"
                               data-package-card-type="commercial"
                               data-package-card-id="<%= pkg.id %>"
                               data-category-select-id="commercialCategory_<%= pkg.id %>">
                            <div class="card-body d-flex flex-column justify-content-between">
                              <div>
                                <h5 class="fw-bold package-option-title"><%= pkg.translated_name || pkg.name %></h5>
                                <div class="package-option-divider"></div>
                                <div class="package-description mb-3"><%- pkg.translated_description || pkg.description || '' %></div>
                                <p class="text-center fw-bold" style="font-size: 14pt;">
                                  <%= t('buyer.packages.runtime.commercial', { fallback: 'Laufzeit 30 Tage' }) %>
                                </p>
                                <p class="fw-semibold fs-5 package-option-price">
                                  <%= Number(pkg.price).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) %>
                                </p>
                                <div class="mb-3">
                                  <label for="commercialCategory_<%= pkg.id %>" class="form-label fw-semibold">
                                    <%= t('buyer.packages.chooseCategory', { fallback: 'Kategorie wählen' }) %>
                                  </label>
                                  <select id="commercialCategory_<%= pkg.id %>" class="form-select package-category-select">
                                    <option value="" selected>
                                      <%= t('buyer.packages.chooseCategory.placeholder', { fallback: '– bitte wählen –' }) %>
                                    </option>
                                    <% categories.forEach(function(cat) { %>
                                      <option value="<%= cat.id %>"><%= cat.name %></option>
                                    <% }) %>
                                  </select>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                  <button type="button" class="btn btn-primary w-100 next-to-form" data-type="commercial">
                    <%= t('common.next', { fallback: 'Weiter' }) %>
                  </button>
                </div>

                <div class="registration-step2 d-none">
                  <div class="mb-3">
                    <span class="registration-step-badge mb-0">Schritt 2 von 3</span>
                  </div>

                <!-- 👤 Anrede -->
                <!-- 👤 Anrede -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.gender', { fallback: 'Anrede *' }) %></label>
                    <select name="gender" class="form-select" required>
                      <option value=""><%= t('offers.auth.gender.choose', { fallback: 'Bitte wählen...' }) %></option>
                      <option value="2"><%= t('offers.auth.gender.mr', { fallback: 'Herr' }) %></option>
                      <option value="3"><%= t('offers.auth.gender.mrs', { fallback: 'Frau' }) %></option>
                    </select>
                  </div>
                </div>

                <!-- 👥 Name -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.firstname', { fallback: 'Vorname *' }) %></label>
                    <input type="text" name="firstname" class="form-control" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.lastname', { fallback: 'Nachname *' }) %></label>
                    <input type="text" name="lastname" class="form-control" required>
                  </div>
                </div>

                <!-- 🏢 Firma -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.company', { fallback: 'Firma *' }) %></label>

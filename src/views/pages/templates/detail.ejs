<div id="lightboxOverlay" aria-hidden="true">
  <div id="lightboxContainer" role="dialog" aria-modal="true" aria-label="Bildansicht">
    <button id="lightboxClose" type="button" aria-label="Schließen">×</button>
    <button id="lightboxPrev" type="button" aria-label="Vorheriges Bild">
      <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <img id="lightboxImage" src="" alt="" />
    <button id="lightboxNext" type="button" aria-label="Nächstes Bild">
      <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </button>
  </div>
</div>
<script>
(function(){
  function initLightbox() {
  // 1) Bild-URLs sammeln
  const pics = Array.from(
    document.querySelectorAll('.product-single-thumbnails img')
  ).map(img => img.dataset.full || img.src);

  // Fallback: Hauptbild, falls keine Thumbnails
  const mainImg = document.getElementById('mainImage');
  if (!pics.length && mainImg) {
    pics.push(mainImg.src);
  }

  let currentIndex = 0;
  const overlay  = document.getElementById('lightboxOverlay');
  const container = document.getElementById('lightboxContainer');
  const imgEl    = document.getElementById('lightboxImage');
  const btnPrev  = document.getElementById('lightboxPrev');
  const btnNext  = document.getElementById('lightboxNext');
  const btnClose = document.getElementById('lightboxClose');
  if (!overlay || !container || !imgEl || !btnPrev || !btnNext || !btnClose || !pics.length) return;
  if (overlay.parentElement !== document.body) {
    document.body.appendChild(overlay);
  }
  imgEl.setAttribute('draggable', 'false');

  let prevBodyOverflow = '';
  let prevBodyOverscroll = '';
  let prevHtmlOverflow = '';
  let prevHtmlOverscroll = '';

  function lockPageScroll() {
    prevBodyOverflow = document.body.style.overflow;
    prevBodyOverscroll = document.body.style.overscrollBehavior;
    prevHtmlOverflow = document.documentElement.style.overflow;
    prevHtmlOverscroll = document.documentElement.style.overscrollBehavior;

    document.body.style.overflow = 'hidden';
    document.body.style.overscrollBehavior = 'none';
    document.documentElement.style.overflow = 'hidden';
    document.documentElement.style.overscrollBehavior = 'none';
  }

  function unlockPageScroll() {
    document.body.style.overflow = prevBodyOverflow;
    document.body.style.overscrollBehavior = prevBodyOverscroll;
    document.documentElement.style.overflow = prevHtmlOverflow;
    document.documentElement.style.overscrollBehavior = prevHtmlOverscroll;
  }

  function showLightbox(idx) {
    const wasOpen = overlay.style.display === 'flex';
    currentIndex = idx;
    const requestedUrl = pics[currentIndex];
    imgEl.src = requestedUrl;
    overlay.setAttribute('aria-hidden', 'false');
    overlay.style.display = 'flex';
    if (!wasOpen) lockPageScroll();
    resolveBestLightboxUrl(requestedUrl).then(bestUrl => {
      if (currentIndex !== idx) return;
      if (bestUrl && imgEl.src !== bestUrl) imgEl.src = bestUrl;
    });
  }
  function hideLightbox()    {
    overlay.style.display = 'none';
    overlay.setAttribute('aria-hidden', 'true');
    unlockPageScroll();
  }
  function showPrev()        { showLightbox((currentIndex - 1 + pics.length) % pics.length); }
  function showNext()        { showLightbox((currentIndex + 1) % pics.length); }

  function toAbsoluteUrl(url) {
    if (!url) return '';
    try {
      return new URL(url, window.location.origin).href;
    } catch (_) {
      return '';
    }
  }

  function addLargeX2Suffix(url) {
    if (!url) return '';
    const match = String(url).match(/^([^?#]+)(\?[^#]*)?(#.*)?$/);
    if (!match) return url;

    const basePath = match[1] || '';
    const query = match[2] || '';
    const hash = match[3] || '';
    if (/_largex2$/i.test(basePath) || /_largex2\.[^.\/]+$/i.test(basePath)) return url;

    const lastDot = basePath.lastIndexOf('.');
    const lastSlash = basePath.lastIndexOf('/');
    const hasExt = lastDot > lastSlash;
    const withSuffix = hasExt
      ? `${basePath.slice(0, lastDot)}_largex2${basePath.slice(lastDot)}`
      : `${basePath}_largex2`;
    return `${withSuffix}${query}${hash}`;
  }

  function normalizeLightboxUrl(url) {
    return toAbsoluteUrl(url).replace(/_largex2(?=(\.[^.\/?#]+)?([?#]|$))/i, '');
  }

  function imageExists(url) {
    return new Promise(resolve => {
      if (!url) return resolve(false);
      const testImg = new Image();
      testImg.onload = () => resolve(true);
      testImg.onerror = () => resolve(false);
      testImg.src = url;
    });
  }

  const bestLightboxUrlCache = new Map();
  async function resolveBestLightboxUrl(url) {
    if (!url) return url;
    if (bestLightboxUrlCache.has(url)) return bestLightboxUrlCache.get(url);

    const candidate = addLargeX2Suffix(url);
    if (!candidate || candidate === url) {
      bestLightboxUrlCache.set(url, url);
      return url;
    }

    const exists = await imageExists(candidate);
    const best = exists ? candidate : url;
    bestLightboxUrlCache.set(url, best);
    return best;
  }

  // 2) Klick auf Hauptbild: öffne an der aktuell angezeigten Stelle
  if (mainImg) {
    mainImg.style.cursor = 'zoom-in';
    mainImg.addEventListener('click', () => {
      const currentMain = normalizeLightboxUrl(mainImg.dataset.full || mainImg.dataset.zoom || mainImg.src);
      const idx = pics.findIndex(src => normalizeLightboxUrl(src) === currentMain);
      showLightbox(idx >= 0 ? idx : 0);
    });
  }

  // 3) Overlay-Klick schließt, Pfeile und X wie gehabt
  overlay.addEventListener('click', e => e.target === overlay && hideLightbox());
  container.addEventListener('click', e => e.target === container && hideLightbox());
  btnPrev.addEventListener('click', e => { e.stopPropagation(); showPrev(); });
  btnNext.addEventListener('click', e => { e.stopPropagation(); showNext(); });
  btnClose.addEventListener('click', hideLightbox);

  // 4) Swipe-Navigation in der Lightbox (Mobile/Tablet)
  let touchStartX = 0;
  let touchStartY = 0;
  let touchActive = false;

  container.addEventListener('touchstart', e => {
    if (overlay.style.display !== 'flex') return;
    if (!e.touches || e.touches.length !== 1) {
      touchActive = false;
      return;
    }
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchActive = true;
  }, { passive: true });

  container.addEventListener('touchend', e => {
    if (!touchActive || overlay.style.display !== 'flex') return;
    const t = e.changedTouches && e.changedTouches[0];
    touchActive = false;
    if (!t) return;

    const dx = t.clientX - touchStartX;
    const dy = t.clientY - touchStartY;

    if (Math.abs(dx) < 40) return;
    if (Math.abs(dy) > 80) return;

    if (dx < 0) showNext();
    else showPrev();
  }, { passive: true });

  container.addEventListener('touchcancel', () => {
    touchActive = false;
  }, { passive: true });

  container.addEventListener('touchmove', e => {
    if (overlay.style.display === 'flex') e.preventDefault();
  }, { passive: false });

  // 5) Tastatur-Navigation
  document.addEventListener('keydown', e => {
    if (overlay.style.display === 'flex') {
      if (e.key === 'Escape') hideLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    }
  });
  }

  const run = () => {
    try { initLightbox(); } catch (_) {}
  };

  const isMobileViewport = window.matchMedia('(max-width: 767.98px)').matches;
  if (isMobileViewport) {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(run, { timeout: 1200 });
    } else {
      setTimeout(run, 300);
    }
  } else {
    run();
  }
})();
</script>

<script>
// Sonstiges zeigt Textbox
document.getElementById("reportReason").addEventListener("change", function() {
  document.getElementById("otherReasonBox").style.display =
    this.value === "OTHER" ? "block" : "none";
});

// Senden
document.getElementById("reportForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const payload = {
    firstName: document.getElementById("reportFirstName").value,
    lastName: document.getElementById("reportLastName").value,
    email: document.getElementById("reportEmail").value,
    reason: document.getElementById("reportReason").value,
    message: document.getElementById("reportMessage").value,
    hp_report: document.getElementById("hp_report").value,

    itemTitle: `<%= item.title %>`,
    itemId: `<%= item.id %>`,
    itemUrl: `<%= seoCanonicalUrl || ((siteBaseUrl || '') + detailPath) %>`
  };

  const res = await fetch("/report-listing", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  const out = await res.json();

  if (out.success) {
    bootstrap.Modal.getInstance(document.getElementById("reportModal")).hide();
    alert("<%= t('common.report_success','Danke! Ihre Meldung wurde gesendet.') %>");
    e.target.reset();
  } else {
    alert(out.error || "<%= t('common.report_error','Fehler beim Senden.') %>");
  }
});
</script>


</body>

</html>

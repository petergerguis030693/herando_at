<%
  // ===== FEATURE/FUNCTION-BADGES =====
  const watchLabelOverrides = {
    function_4year: t('watches.feature.4year', 'Schaltjahresanzeige'),
    feature_screwedcrone: t('watches.feature.screwedcrone', 'Verschraubte Krone'),
    feature_display_back: t('watches.feature.display_back', 'Sichtboden')
  };

  const watchFlagKeys = Object.keys(item || {}).filter((key) => /^(feature_|function_)/.test(key));
  const isEnabledWatchFlag = (value) => value === 1 || value === '1' || value === true;

  const watchFeaturesMap = watchFlagKeys.reduce((acc, field) => {
    const cleanKey = field.replace(/^(feature_|function_)/, '');
    const humanLabel = cleanKey
      .split('_')
      .map((part) => {
        const upperPart = part.toUpperCase();
        if (upperPart === 'GMT' || upperPart === 'PVD') return upperPart;
        if (part === '4year') return '4-Year';
        return part.charAt(0).toUpperCase() + part.slice(1);
      })
      .join(' ');

    acc[field] = watchLabelOverrides[field] || t(`watches.feature.${cleanKey}`, humanLabel);
    return acc;
  }, {});

  const selectedWatchFeatures = watchFlagKeys.filter((field) => isEnabledWatchFlag(item[field]));
%>

<% if (selectedWatchFeatures.length) { %>

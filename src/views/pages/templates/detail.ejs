<% if (moreItems.length > 0) { %>
  <% moreItems.forEach(group => { %>
    <% if (group.route === 'properties') { %>
      <div class="p-3 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="fw-bold"><%= t('properties.more_from_seller', 'Weitere Immobilien dieses Händlers') %></h4>
          <a href="/seller/<%= seller.slug %>" class="small-coo fw-bold text-decoration-none">
            <%= t('cars.more_items.show_all', 'Alle anzeigen') %>
          </a>
        </div>

        <div id="carousel-<%= group.route %>" class="carousel slide custom-carousel">
          <div class="carousel-inner">
            <% for (let i = 0; i < group.items.length; i += 4) { %>
              <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                <div class="row g-3">
                  <% group.items.slice(i, i + 4).forEach(prod => { %>
                    <div class="col-md-3">
                      <div class="card h-100 shadow-sm border-0">
                        <div class="position-relative">
                          <a href="/<%= group.route %>/<%= prod.id %>/<%= prod.name %>">
                            <img src="<%= prod.mainpicture %>" class="card-img-top rounded-top fixed-img heIght" alt="<%= prod.name %>">
                          </a>
                          <% if (prod.created && new Date(prod.created) > new Date(Date.now() - 14*24*60*60*1000)) { %>
                            <span class="position-absolute top-0 start-0 m-2 badge bg-danger">
                              <%= t('common.new', 'Neu') %>
                            </span>
                          <% } %>
                        </div>

                        <div class="card-body">
                          <h6 class="fw-bold text-truncate mb-1"><%= prod.name %></h6>
                          <p class="fs-6 fw-bold text-success mb-2">
                            <%= (prod.price && prod.price > 0)
                                  ? new Intl.NumberFormat('de-DE').format(prod.price) + ' €'
                                  : t('common.price_on_request','Preis auf Anfrage') %>
                          </p>

                          <div class="d-flex flex-wrap gap-3 small text-dark mt-2">
                            <% if (prod.livingarea && prod.livingarea > 0) { %>
                              <span>
                                <i class="bi bi-aspect-ratio me-1 text-muted"></i>
                                <%= new Intl.NumberFormat('de-DE').format(prod.livingarea) %> m²
                              </span>
                            <% } %>

                            <% if (prod.bedrooms && prod.bedrooms > 0) { %>
                              <span>
                                <i class="bi bi-door-closed me-1 text-muted"></i>
                                <%= parseInt(prod.bedrooms) %> <%= t('properties.bedrooms_short', 'SZ') %>
                              </span>
                            <% } %>

                            <% if (prod.year && prod.year > 0) { %>
                              <span>
                                <i class="bi bi-calendar me-1 text-muted"></i>
                                <%= prod.year %>
                              </span>
                            <% } %>
                          </div>
                        </div>

                        <div class="card-footer bg-white small text-muted d-flex align-items-center">
                          <i class="bi bi-geo-alt me-1"></i>
                          <%= prod.city || t('common.location_on_request', 'Standort auf Anfrage') %>
                        </div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <% if (group.items.length > 1) { %>
            <button class="my-carousel-prev"
                    type="button"
                    data-bs-target="#carousel-<%= group.route %>"
                    data-bs-slide="prev">
              ‹
              <span class="visually-hidden">Vorherige</span>
            </button>

            <button class="my-carousel-next"
                    type="button"
                    data-bs-target="#carousel-<%= group.route %>"
                    data-bs-slide="next">
              ›
              <span class="visually-hidden">Nächste</span>
            </button>

            <div class="carousel-indicators mt-3 d-none d-md-flex">
              <% for (let i = 0; i < Math.ceil(group.items.length / 4); i++) { %>
                <button type="button"
                        data-bs-target="#carousel-<%= group.route %>"
                        data-bs-slide-to="<%= i %>"
                        class="line-indicator <%= i === 0 ? 'active' : '' %>">
                </button>
              <% } %>
            </div>

          <% } %>

        </div>
      </div>
    <% } %>
  <% }) %>
<% } %>


<% } else if (currentEntity.route === 'yachts') { %>

<div class="p-3 mb-4">
  <h4 class="mb-3 fw-bold"><%= t('yachts.tech_data', 'Technische Daten') %></h4>
  <table class="table table-borderless align-middle table-striped custom-striped">
      <tr>
        <td class="fw-semibold text-muted"><%= t('yachts.brand', 'Marke') %></td>
        <td><%= item.brandName || '-' %></td>
      </tr>

      <tr>
        <td class="fw-semibold text-muted"><%= t('yachts.model', 'Modell') %></td>
        <td><%= item.model || '-' %></td>
      </tr>
      <% if (item.yachttype) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.type', 'Yachttyp') %></td><td><%= yachtTypeMap[item.yachttype] || item.yachttype %></td></tr>
      <% } %>
      <% if (item.category) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.category', 'Kategorie') %></td><td><%= categoryMap[item.category] || item.category %></td></tr>
      <% } %>
      <% if (item.length) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.length', 'Länge') %></td><td><%= item.length %> m</td></tr>
      <% } %>
      <% if (item.beam) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.beam', 'Breite') %></td><td><%= item.beam %> m</td></tr>
      <% } %>
      <% if (item.draft) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.draft', 'Tiefgang') %></td><td><%= item.draft %> m</td></tr>
      <% } %>
      <% if (item.displacement) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.displacement', 'Verdrängung') %></td><td><%= item.displacement %> t</td></tr>
      <% } %>
      <% if (item.berths) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.berths', 'Kabinen') %></td><td><%= item.berths %></td></tr>
      <% } %>
      <% if (item.engines) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.engines', 'Motoren') %></td><td><%= item.engines %></td></tr>
      <% } %>
      <% if (item.horsepower) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.power', 'Leistung') %></td><td><%= item.horsepower %> PS</td></tr>
      <% } %>
      <% if (item.fuel) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.fuel', 'Treibstoff') %></td><td><%= fuelMap[item.fuel] || item.fuel %></td></tr>
      <% } %>
      <% if (item.fuel_tankage) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.fuel_tank', 'Treibstofftank') %></td><td><%= item.fuel_tankage %> L</td></tr>
      <% } %>
      <% if (item.water_tankage) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.water_tank', 'Wassertank') %></td><td><%= item.water_tankage %> L</td></tr>
      <% } %>
      <% if (item.hull) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.hull', 'Rumpf') %></td><td><%= hullMap[item.hull] || item.hull %></td></tr>
      <% } %>
      <% if (item.shape) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.condition', 'Zustand') %></td><td><%= shapeMap[item.shape] || item.shape %></td></tr>
      <% } %>
      <% if (item.max_speed) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.max_speed', 'Max. Geschwindigkeit') %></td>
          <td><%= item.max_speed %> km/h (<%= item.max_speed_kn %> kn)</td>
        </tr>
      <% } %>
      <% if (item.cruising_speed) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.cruising_speed', 'Reisegeschwindigkeit') %></td>
          <td><%= item.cruising_speed %> km/h (<%= item.cruising_speed_kn %> kn)</td>
        </tr>
      <% } %>
      <% if (item.year) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.year', 'Baujahr') %></td><td><%= item.year %></td></tr>
      <% } %>
      <% if (item.splashdown) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.splashdown', 'Stapellauf') %></td><td><%= item.splashdown %></td></tr>
      <% } %>
      <% if (item.naval_architect) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.architect', 'Architekt') %></td><td><%= item.naval_architect %></td></tr>
      <% } %>
      <% if (item.interior_designer) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.interior_designer', 'Innendesign') %></td><td><%= item.interior_designer %></td></tr>
      <% } %>
      <% if (item.price !== null) { %>
        <tr><td class="fw-semibold text-muted"><%= t('yachts.price', 'Preis') %></td>
          <td>
            <% if (item.price > 0) { %>
              <%= new Intl.NumberFormat('de-DE').format(item.price) %> <%= item.currency %>
            <% } else { %>
              <%= t('yachts.price_on_request', 'Preis auf Anfrage') %>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (item.description) { %>
  <div class="p-3 mb-4">
    <h4 class="mb-3 fw-bold border-bottom pb-2"><%= t('properties.description', 'Beschreibung laut Anbieter') %></h4>
    <div class="description-container position-relative">
      <div id="descriptionShort" class="description-text collapsed-text">
        <%- item.description %>
      </div>
      <div id="fadeOverlay" class="fade-overlay border-bottom"></div>
      <div class="text-center mt-3">
        <a href="javascript:void(0)" id="toggleDescription" class="btn btn-link fw-semibold text-decoration-none">
            <%= t('common.show_more', 'Mehr anzeigen') %>
        </a>
      </div>
    </div>
  </div>
<% } %>

<% if (similarItems && similarItems.length > 0) { %>
  <div class="p-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">

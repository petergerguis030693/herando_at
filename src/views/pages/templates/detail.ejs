              <%= String(item.maininspection_month).padStart(2,"0") %>/<%= item.maininspection %>
            <% } else { %>
              <%= item.maininspection %>
            <% } %>
          </td>
        </tr>
      <% } %>

    </tbody>
  </table>
</div>





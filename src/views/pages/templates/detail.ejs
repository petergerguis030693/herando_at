<% } %>


<% } else { %>

    <!-- 🔹 Standard-Layout für alle anderen Kategorien -->
    <ul class="nav nav-tabs" id="infoTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <a
          class="nav-link active"
          id="details-tab"
          data-bs-toggle="tab"
          href="#details"
          role="tab"
          aria-controls="details"
          aria-selected="true"
        >
          <%= T('product.tabs.details','Details') %>
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a
          class="nav-link"
          id="sicherheit-tab"
          data-bs-toggle="tab"
          href="#sicherheit"
          role="tab"
          aria-controls="sicherheit"
          aria-selected="false"
        >
        <%= T('product.tabs.security','Sicherheit') %>
        </a>
      </li>
    </ul>

    <div class="tab-content mt-3" id="infoTabsContent">
      <div
        id="details"
        class="tab-pane fade show active"
        role="tabpanel"
        aria-labelledby="details-tab"
      >
        <div class="row">
          <div class="col-md-6">
            <h4><%= T('product.tabs.description','Beschreibung') %></h4>
            <p><%- item.description %></p>
          </div>
          <div class="col-md-6">
            <h4><%= T('product.tabs.base','Basisdaten') %></h4>

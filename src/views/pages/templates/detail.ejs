<script>
(function () {
  const img   = document.getElementById('mainImage');
  const glass = document.getElementById('magnifier');
  const ZOOM  = 2;
  const canUseHoverZoom = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
  }

  function getObjectFitMetrics() {
    const rect = img.getBoundingClientRect();
    const iw = img.naturalWidth || 1;
    const ih = img.naturalHeight || 1;
    const cw = rect.width || 1;
    const ch = rect.height || 1;

    const objectFit = (window.getComputedStyle(img).objectFit || 'fill').trim();
    const useContain = objectFit === 'contain';
    const useCover = objectFit === 'cover';

    const scale = useCover
      ? Math.max(cw / iw, ch / ih)
      : useContain
        ? Math.min(cw / iw, ch / ih)
        : Math.min(cw / iw, ch / ih);

    const w = iw * scale;
    const h = ih * scale;

    const x = (cw - w) * 0.5;
    const y = (ch - h) * 0.5;

    return { rect, iw, ih, scale, w, h, x, y };
  }

  if (canUseHoverZoom) {
    img.addEventListener('mousemove', e => {
      const zoomSrc = img.dataset.zoom || img.src;
      const { rect, iw, ih, scale, w, h, x, y } = getObjectFitMetrics();

      // Maus relativ zum gerenderten Bild-Container
      const lx = e.clientX - rect.left;
      const ly = e.clientY - rect.top;

      if (lx < 0 || ly < 0 || lx > rect.width || ly > rect.height) {
        glass.style.display = 'none';
        return;
      }

      // Bei object-fit: contain gibt es ggf. "leere" Balken.
      // Dort die Lupe ausblenden, damit das Mapping nicht versetzt wirkt.
      const px = lx - x;
      const py = ly - y;
      if (px < 0 || py < 0 || px > w || py > h) {
        glass.style.display = 'none';
        return;
      }

      glass.style.display = 'block';

      const gw = glass.clientWidth;
      const gh = glass.clientHeight;

      /* =========================
         LUPENPOSITION
         Maus = Startpunkt
         ========================= */
      glass.style.left = lx + 'px';
      glass.style.top  = ly + 'px';

      /* =========================
         ZOOM – PIXELGENAU + CLAMP
         ========================= */
      const rx = clamp(px / scale, 0, iw);
      const ry = clamp(py / scale, 0, ih);

      const maxBgX = iw * ZOOM - gw;
      const maxBgY = ih * ZOOM - gh;

      const bgX = -clamp(rx * ZOOM, 0, maxBgX);
      const bgY = -clamp(ry * ZOOM, 0, maxBgY);

      glass.style.backgroundImage = `url(${zoomSrc})`;
      glass.style.backgroundRepeat = 'no-repeat';
      glass.style.backgroundSize =
        (iw * ZOOM) + 'px ' +
        (ih * ZOOM) + 'px';

      glass.style.backgroundPosition = `${bgX}px ${bgY}px`;
    });
  } else {
    glass.style.display = 'none';
  }

  img.addEventListener('mouseleave', () => {
    glass.style.display = 'none';
  });

window.changeImage = function (el) {
  const newSrc  = el.dataset.full || el.dataset.large || el.src;
  const zoomSrc = el.dataset.full || el.dataset.zoom || el.dataset.large || el.src;
  const mobileSrc = (() => {
    const sourceEl = el && el.parentElement ? el.parentElement.querySelector('source') : null;
    return (sourceEl && sourceEl.srcset) ? sourceEl.srcset : newSrc;
  })();
  const mainMobileSource = document.getElementById('mainImageSourceMobile');

  imageReady = false;
  glass.style.display = 'none';

  const requestId = ++window.__mainImageRequestId;

  resolveBestMainImageUrl(newSrc).then(bestSrc => {
    if (requestId !== window.__mainImageRequestId) return;

    const temp = new Image();
    temp.src = bestSrc;

    temp.onload = () => {
      if (requestId !== window.__mainImageRequestId) return;
      if (mainMobileSource) {
        mainMobileSource.srcset = mobileSrc;
      }
      img.src = bestSrc;
      img.dataset.full = bestSrc;
      img.dataset.zoom = bestSrc || zoomSrc;
      imageReady = true;
    };

    temp.onerror = () => {
      if (requestId !== window.__mainImageRequestId) return;
      if (mainMobileSource) {
        mainMobileSource.srcset = mobileSrc;
      }
      img.src = newSrc;
      img.dataset.full = newSrc;
      img.dataset.zoom = zoomSrc;
      imageReady = true;
    };
  });
};

function addLargeX2Suffix(url) {
  if (!url) return '';
  const match = String(url).match(/^([^?#]+)(\?[^#]*)?(#.*)?$/);
  if (!match) return url;

  const basePath = match[1] || '';
  const query = match[2] || '';
  const hash = match[3] || '';
  if (/_largex2$/i.test(basePath) || /_largex2\.[^.\/]+$/i.test(basePath)) return url;

  const lastDot = basePath.lastIndexOf('.');
  const lastSlash = basePath.lastIndexOf('/');
  const hasExt = lastDot > lastSlash;
  const withSuffix = hasExt
    ? `${basePath.slice(0, lastDot)}_largex2${basePath.slice(lastDot)}`
    : `${basePath}_largex2`;
  return `${withSuffix}${query}${hash}`;
}

function imageExists(url) {
  return new Promise(resolve => {
    if (!url) return resolve(false);
    const testImg = new Image();
    testImg.onload = () => resolve(true);
    testImg.onerror = () => resolve(false);
    testImg.src = url;
  });
}

const bestMainImageUrlCache = new Map();
async function resolveBestMainImageUrl(url) {
  if (!url) return url;
  if (bestMainImageUrlCache.has(url)) return bestMainImageUrlCache.get(url);

  const candidate = addLargeX2Suffix(url);
  if (!candidate || candidate === url) {
    bestMainImageUrlCache.set(url, url);
    return url;
  }

  const exists = await imageExists(candidate);
  const best = exists ? candidate : url;
  bestMainImageUrlCache.set(url, best);
  return best;
}

window.__mainImageRequestId = 0;
resolveBestMainImageUrl(img.dataset.full || img.src).then(bestSrc => {
  if (!bestSrc || bestSrc === img.src) return;
  img.src = bestSrc;
  img.dataset.full = bestSrc;
  img.dataset.zoom = bestSrc;
});

})();

window.thumbClick = function (el) {
  window.changeImage(el);
  const thumbs = Array.from(document.querySelectorAll('.product-single-thumbnails img'));
  thumbs.forEach(t => t.classList.remove('is-active'));
  if (el) el.classList.add('is-active');
};
</script>

<script>
(function () {
  const img = document.getElementById('mainImage');
  const thumbs = Array.from(document.querySelectorAll('.product-single-thumbnails img'));
  const thumbWrap = document.querySelector('.product-single-thumbnails');
  const prevBtn = document.getElementById('prevThumb');
  const nextBtn = document.getElementById('nextThumb');

  if (!img || thumbs.length === 0) return;

  function toAbsoluteUrl(url) {
    if (!url) return '';
    try {
      return new URL(url, window.location.origin).href;
    } catch (_) {
      return '';
    }
  }

  function normalizeThumbCompareUrl(url) {
    const absolute = toAbsoluteUrl(url);
    if (!absolute) return '';
    // Compare original/full URLs regardless of optional size suffixes.
    return absolute
      .replace(/_largex2(?=(\.[^.\/?#]+)?([?#]|$))/i, '')
      .replace(/_small(?=(\.[^.\/?#]+)?([?#]|$))/i, '');
  }

  function currentIndex() {
    const mainSrc = normalizeThumbCompareUrl(img.src);
    const i = thumbs.findIndex(t => {
      const candidate = normalizeThumbCompareUrl(t.dataset.full || t.src);
      return candidate === mainSrc;
    });
    return i >= 0 ? i : 0;
  }

  function markActive(i) {
    thumbs.forEach((t, idx) => {
      t.classList.toggle('is-active', idx === i);
    });
  }

  function updateThumbNavState(activeIdx = currentIndex()) {
    if (!prevBtn || !nextBtn) return;
    prevBtn.disabled = activeIdx <= 0;
    nextBtn.disabled = activeIdx >= (thumbs.length - 1);
  }

function show(i) {
  if (i < 0) i = 0;
  if (i >= thumbs.length) i = thumbs.length - 1;

  const el = thumbs[i];
  window.changeImage(el);
  markActive(i);

  // 👉 Thumbnail automatisch mitscrollen
  el.scrollIntoView({
    behavior: 'smooth',
    inline: 'center',
    block: 'nearest'
  });
}


  let startX = 0;
  let startY = 0;

  img.addEventListener('touchstart', e => {
    const t = e.touches[0];
    startX = t.clientX;
    startY = t.clientY;
  }, { passive: true });

  img.addEventListener('touchend', e => {
    const t = e.changedTouches[0];
    const dx = t.clientX - startX;
    const dy = t.clientY - startY;

    if (Math.abs(dx) < 50) return;
    if (Math.abs(dy) > 70) return;

    const i = currentIndex();

    if (dx < 0) show(i + 1); // swipe left
    else show(i - 1);        // swipe right
  }, { passive: true });

  // Initial den aktuell sichtbaren Thumb markieren
  markActive(currentIndex());

  if (thumbWrap && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      const i = currentIndex();
      show(i - 1);
      updateThumbNavState(Math.max(0, i - 1));
    });
    nextBtn.addEventListener('click', () => {
      const i = currentIndex();
      show(i + 1);
      updateThumbNavState(Math.min(thumbs.length - 1, i + 1));
    });
    window.addEventListener('resize', () => updateThumbNavState(currentIndex()));
    setTimeout(() => updateThumbNavState(currentIndex()), 0);
  }
})();
</script>









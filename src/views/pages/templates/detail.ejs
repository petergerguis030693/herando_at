  // ===== HELFER =====
  function mapValue(value, map) {
    if (value === null || value === undefined || value === '') return '';
    const keyNum = Number(value);
    return map[value] ?? map[keyNum] ?? String(value);
  }

  function mapList(values, map) {
    if (values === null || values === undefined || values === '') return '';
    const s = values.toString();
    if (!s.includes(',')) return mapValue(s.trim(), map);
    return s.split(',').map(v => mapValue(v.trim(), map)).join(', ');
  }

  // Einheitliche Ja/Nein-Ausgabe (akzeptiert 1/0, '1'/'0', true/false, 'Yes'/'No')
  function yesNo(v) {
    if (v === 1 || v === '1' || v === true)  return t('common.present','Vorhanden');
    if (v === 0 || v === '0' || v === false)  return t('common.not_present','Nicht vorhanden');
    if (typeof v === 'string') {
      const s = v.toLowerCase();
      if (s === 'yes')  return t('common.present','Vorhanden');
      if (s === 'no')   return t('common.not_present','Nicht vorhanden');
    }
    return 'Keine Angabe';
  }

  // Fallbacks für Box/Papiere aus deiner DB-Feldern (authenticity_*)
  const boxVal    = (item.box    !== undefined && item.box    !== null) ? item.box    : item.authenticity_box;
  const papersVal = (item.papers !== undefined && item.papers !== null) ? item.papers : item.authenticity_papers;

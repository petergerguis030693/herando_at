<script>
function fillTemplate(str, vars) {
  return str.replace(/\{(\w+)\}/g, (_, k) => (vars[k] ?? `{${k}}`));
}

document.addEventListener('DOMContentLoaded', () => {
  const raw = `<%- t('contact.modal.message') %>`;

  const msg = fillTemplate(raw, {
    NAME: "<%- cleanName %>",
    ROUTE: "<%- currentEntity.route %>",
    ID: "<%- item.id %>",
    SLUG: "<%- cleanSlug %>"
  });

  document.getElementById('modalMessage').value = msg;

  const form = document.getElementById('sellerContactForm');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const code = document.getElementById('modalPhoneCode')?.value || '';
      const num  = document.getElementById('modalPhone')?.value || '';
      const full = (code + ' ' + num).trim();
      const phoneHidden = document.getElementById('modalPhoneFull');
      if (phoneHidden) phoneHidden.value = full;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)).toString()
        });

        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          alert('Danke! Ihre Anfrage wurde gesendet.');
          form.reset();
          const modalEl = document.getElementById('contactModal');
          if (modalEl && window.bootstrap) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.hide();
          }
        } else {
          alert(data.error || 'Fehler beim Senden. Bitte später erneut versuchen.');
        }
      } catch (err) {
        alert('Fehler beim Senden. Bitte später erneut versuchen.');
      }
    });
  }
});
</script>


              <% item.specs.forEach(spec => { %>
                <tr>
                  <td><%= spec.label %></td>
                  <td><%= spec.value %></td>
                </tr>
              <% }); %>
            </table>
          </div>
        </div>
      </div>

      <div
        id="sicherheit"
        class="tab-pane fade"
        role="tabpanel"
        aria-labelledby="sicherheit-tab"
      >
        <h4><%= T('product.tabs.sec_coming','Sicherheitsdetails folgen hier...') %></h4>
      </div>
    </div>
  <% } %>
</div>


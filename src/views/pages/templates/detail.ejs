<script>
(function () {
  const img   = document.getElementById('mainImage');
  const glass = document.getElementById('magnifier');
  const ZOOM  = 2;

  function clamp(v, min, max) {
    return Math.max(min, Math.min(max, v));
  }

  function getContainMetrics() {
    const rect = img.getBoundingClientRect();

    const iw = img.naturalWidth;
    const ih = img.naturalHeight;

    const cw = rect.width;
    const ch = rect.height;

    const scale = Math.min(cw / iw, ch / ih);

    const w = iw * scale;
    const h = ih * scale;

    const x = (cw - w) * 0.5;
    const y = (ch - h) * 0.5;

    return { rect, w, h, x, y };
  }

  img.addEventListener('mousemove', e => {
    const zoomSrc = img.dataset.zoom || img.src;
    const { rect, w, h, x, y } = getContainMetrics();

    // Maus relativ zum echten Bild (contain!)
    const mx = e.clientX - rect.left - x;
    const my = e.clientY - rect.top  - y;

    // Maus darf bis zum Rand
    if (mx < 0 || my < 0 || mx > w || my > h) {
      glass.style.display = 'none';
      return;
    }

    glass.style.display = 'block';

    const gw = glass.clientWidth;
    const gh = glass.clientHeight;

    /* =========================
       LUPENPOSITION
       Maus = Startpunkt
       ========================= */
    glass.style.left = (x + mx) + 'px';
    glass.style.top  = (y + my) + 'px';

    /* =========================
       ZOOM – PIXELGENAU + CLAMP
       ========================= */
    const rx = mx / w * img.naturalWidth;
    const ry = my / h * img.naturalHeight;

    const maxBgX = img.naturalWidth  * ZOOM - gw;
    const maxBgY = img.naturalHeight * ZOOM - gh;

    const bgX = -clamp(rx * ZOOM, 0, maxBgX);
    const bgY = -clamp(ry * ZOOM, 0, maxBgY);

    glass.style.backgroundImage = `url(${zoomSrc})`;
    glass.style.backgroundRepeat = 'no-repeat';
    glass.style.backgroundSize =
      (img.naturalWidth * ZOOM) + 'px ' +
      (img.naturalHeight * ZOOM) + 'px';

    glass.style.backgroundPosition = `${bgX}px ${bgY}px`;
  });

  img.addEventListener('mouseleave', () => {
    glass.style.display = 'none';
  });

window.changeImage = function (el) {
  const newSrc  = el.dataset.large || el.src;
  const zoomSrc = el.dataset.full  || el.dataset.large || el.src;

  imageReady = false;
  glass.style.display = 'none';

  const temp = new Image();
  temp.src = newSrc;

  temp.onload = () => {
    img.src = newSrc;
    img.dataset.zoom = zoomSrc;
    imageReady = true;
  };
};

})();
</script>

<script>
(function () {
  const img = document.getElementById('mainImage');
  const thumbs = Array.from(document.querySelectorAll('.product-single-thumbnails img'));
  const thumbWrap = document.querySelector('.product-single-thumbnails');

  if (!img || thumbs.length === 0) return;

  function currentIndex() {
    const file = img.src.split('/').pop();
    const i = thumbs.findIndex(t => t.src.split('/').pop() === file);
    return i >= 0 ? i : 0;
  }

function show(i) {
  if (i < 0) i = 0;
  if (i >= thumbs.length) i = thumbs.length - 1;

  const el = thumbs[i];
  window.changeImage(el);

  // 👉 Thumbnail automatisch mitscrollen
  el.scrollIntoView({
    behavior: 'smooth',
    inline: 'center',
    block: 'nearest'
  });
}


  let startX = 0;
  let startY = 0;

  img.addEventListener('touchstart', e => {
    const t = e.touches[0];
    startX = t.clientX;
    startY = t.clientY;
  }, { passive: true });

  img.addEventListener('touchend', e => {
    const t = e.changedTouches[0];
    const dx = t.clientX - startX;
    const dy = t.clientY - startY;

    if (Math.abs(dx) < 50) return;
    if (Math.abs(dy) > 70) return;

    const i = currentIndex();

    if (dx < 0) show(i + 1); // swipe left
    else show(i - 1);        // swipe right
  }, { passive: true });
})();
</script>









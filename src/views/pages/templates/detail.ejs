<% if (item.firstregistration || item.year) { %>
  <tr>
    <td class="fw-semibold text-muted">
      <i class="bi bi-calendar-date custom-icon"></i>
      <%= t('cars.first_registration', 'Erstzulassung') %>
    </td>
    <td>
      <% if (item.firstregistration && item.firstregistration_month) { %>
        <%= String(item.firstregistration_month).padStart(2, "0") %>/<%= item.firstregistration %>
      <% } else if (item.firstregistration) { %>
        <%= item.firstregistration %>
      <% } else { %>
        <%= item.year %>
      <% } %>
    </td>
  </tr>
<% } %>


      <% if (item.maininspection || item.maininspection_month) { %>
        <tr>
          <td class="fw-semibold text-muted"><i class="bi bi-wrench custom-icon"></i> <%= t('cars.inspection', 'HU / TÜV') %></td>

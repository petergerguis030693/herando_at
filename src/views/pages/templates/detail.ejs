              <%
                const specs = Array.isArray(item.specs) ? item.specs : [];
                const usedSpecIndexes = new Set();

                const pickSpec = (labels = []) => {
                  const wanted = labels.map(v => String(v).trim().toLowerCase());
                  for (let i = 0; i < specs.length; i++) {
                    const s = specs[i];
                    const label = String(s?.label || '').trim().toLowerCase();
                    const value = s?.value;
                    if (!label || value === null || value === undefined || String(value).trim() === '') continue;
                    if (wanted.includes(label)) {
                      usedSpecIndexes.add(i);
                      return String(value);
                    }
                  }
                  return '';
                };

                const firstNonEmpty = (...values) => {
                  for (const value of values) {
                    if (value === null || value === undefined) continue;
                    const text = String(value).trim();
                    if (!text || text === '–') continue;
                    return text;
                  }
                  return '';
                };

                const nonNumeric = (value) => {
                  const text = String(value || '').trim();
                  return /^\d+$/.test(text) ? '' : text;
                };


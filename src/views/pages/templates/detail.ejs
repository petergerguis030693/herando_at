                const countryValue = firstNonEmpty(
                  pickSpec(['Land', 'Country']),
                  item.countryName,
                  item.country
                );
                const stateValue = firstNonEmpty(
                  pickSpec(['Bundesland', 'Region', 'State', 'State/Province']),

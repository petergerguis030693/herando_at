<%- include('../../partials/footer', { footerColumns }) %>



<div id="lightboxOverlay" style="
     display:none;
     position:fixed;
     top:0; left:0;
     width:100%; height:100%;
     background:rgba(0,0,0,0.8);
     align-items:center;
     justify-content:center;
     z-index:10000;">
  <div id="lightboxContainer" style="
       position:relative;
       width:100%; height:100%;
       background:#000;
       display:flex;
       align-items:center;
       justify-content:center;">
    <span id="lightboxClose" style="
          position:absolute;
          top:10px; right:10px;
          font-size:2rem;
          color:#fff;
          cursor:pointer;
          user-select:none;">×</span>
    <span id="lightboxPrev" style="
          position:absolute;
          top:50%;
          left:10px;
          transform:translateY(-50%);
          font-size:2rem;
          color:#fff;
          cursor:pointer;
          user-select:none;">❮</span>
    <img id="lightboxImage" src="" style="
         max-width:100%;
         max-height:100%;
         object-fit:contain;" />
    <span id="lightboxNext" style="
          position:absolute;
          top:50%;
          right:10px;
          transform:translateY(-50%);
          font-size:2rem;
          color:#fff;
          cursor:pointer;
          user-select:none;">❯</span>
  </div>
</div>
<script>
(function(){
  // 1) Bild-URLs sammeln
  const pics = Array.from(
    document.querySelectorAll('.product-single-thumbnails img')
  ).map(img => img.src);

  // Fallback: Hauptbild, falls keine Thumbnails
  const mainImg = document.getElementById('mainImage');
  if (!pics.length && mainImg) {
    pics.push(mainImg.src);
  }

  let currentIndex = 0;
  const overlay  = document.getElementById('lightboxOverlay');
  const imgEl    = document.getElementById('lightboxImage');
  const btnPrev  = document.getElementById('lightboxPrev');
  const btnNext  = document.getElementById('lightboxNext');
  const btnClose = document.getElementById('lightboxClose');

  function showLightbox(idx) {
    currentIndex = idx;
    imgEl.src = pics[currentIndex];
    overlay.style.display = 'flex';
  }
  function hideLightbox()    { overlay.style.display = 'none'; }
  function showPrev()        { showLightbox((currentIndex - 1 + pics.length) % pics.length); }
  function showNext()        { showLightbox((currentIndex + 1) % pics.length); }

  // 2) Klick auf Hauptbild: öffne an der aktuell angezeigten Stelle
  if (mainImg) {
    mainImg.style.cursor = 'zoom-in';
    mainImg.addEventListener('click', () => {
      const idx = pics.findIndex(src => src === mainImg.src);
      showLightbox(idx >= 0 ? idx : 0);
    });
  }

  // 3) Overlay-Klick schließt, Pfeile und X wie gehabt
  overlay.addEventListener('click', e => e.target === overlay && hideLightbox());
  btnPrev.addEventListener('click', e => { e.stopPropagation(); showPrev(); });
  btnNext.addEventListener('click', e => { e.stopPropagation(); showNext(); });
  btnClose.addEventListener('click', hideLightbox);

  // 4) Tastatur-Navigation
  document.addEventListener('keydown', e => {
    if (overlay.style.display === 'flex') {
      if (e.key === 'Escape') hideLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    }
  });
})();
</script>

<script>
// Sonstiges zeigt Textbox
document.getElementById("reportReason").addEventListener("change", function() {
  document.getElementById("otherReasonBox").style.display =
    this.value === "OTHER" ? "block" : "none";
});

// Senden
document.getElementById("reportForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const payload = {
    firstName: document.getElementById("reportFirstName").value,
    lastName: document.getElementById("reportLastName").value,
    email: document.getElementById("reportEmail").value,
    reason: document.getElementById("reportReason").value,
    message: document.getElementById("reportMessage").value,
    hp_report: document.getElementById("hp_report").value,

    itemTitle: `<%= item.title %>`,
    itemId: `<%= item.id %>`,
    itemUrl: `https://herando.at/<%= currentEntity.route %>/<%= item.id %>/<%= item.slug %>`
  };

  const res = await fetch("/report-listing", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  const out = await res.json();

  if (out.success) {
    bootstrap.Modal.getInstance(document.getElementById("reportModal")).hide();
    alert("<%= t('common.report_success','Danke! Ihre Meldung wurde gesendet.') %>");
    e.target.reset();
  } else {
    alert(out.error || "<%= t('common.report_error','Fehler beim Senden.') %>");
  }
});
</script>


</body>

</html>

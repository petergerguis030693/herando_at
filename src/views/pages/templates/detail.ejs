%>

<div class="p-3 mb-4">
  <h4 class="mb-3 fw-bold"><%= t('cars.equipment.title', 'Ausstattung') %></h4>

  <% 
    const selectedEquipment = Object.keys(equipmentMap).filter(key => item[key] == 1);
  %>

  <div class="equipment-grid">
    <% selectedEquipment.forEach(field => { %>
      <div class="equipment-item d-flex align-items-center mb-2">
        <i class="bi bi-<%= equipmentIcons[field] || 'check-circle' %> custom-icon"></i>
        <span class="custom-text"><%= t(`cars.equipment.${field}`, equipmentMap[field]) %></span>
      </div>
    <% }) %>
  </div>
</div>

<% if (item.description) { %>
  <div class="p-3 mb-4 ">
    <h4 class="mb-3 fw-bold border-bottom pb-2"><%= t('cars.description.title', 'Fahrzeugbeschreibung laut Anbieter') %></h4>

    <div class="description-container position-relative">
      <div id="descriptionShort" class="description-text collapsed-text">
        <%- item.description
            .replace(/(?:^|\n)[\-\•]\s*(.+)/g, '<li>$1</li>')
            .replace(/(<li>.*<\/li>)/gs, '<ul class="mb-2 ps-3">$1</ul>')
        %>
      </div>

      <div id="fadeOverlay" class="fade-overlay border-bottom"></div>

      <div class="text-center mt-3">
        <a href="javascript:void(0)" id="toggleDescription" class="btn btn-link fw-semibold text-decoration-none">
          <%= t('cars.description.more', 'Mehr anzeigen') %>
        </a>
      </div>
    </div>
  </div>
<% } %>

<% if (similarItems && similarItems.length > 0) { %>
  <div class="p-3 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold">
        <%= t('listing.similar.vehicles','Diese Fahrzeuge könnten Sie auch interessieren') %>
      </h4>
    </div>

    <div id="carousel-similar" class="carousel slide custom-carousel">
      <div class="carousel-inner">
        <% for (let i = 0; i < similarItems.length; i += 4) { %>
          <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <div class="row g-3" style="justify-content: left;">
              <% similarItems.slice(i, i + 4).forEach(item => { %>
                <div class="col-md-3">
                  <div class="card h-100 shadow-sm border-0">
                    <div class="position-relative">
                      <a href="/<%= currentEntity.route %>/<%= item.id %>/<%= item.slug %>">
                        <img src="<%= item.imageUrl %>" class="card-img-top rounded-top fixed-img heIght" alt="<%= item.title %>">
                      </a>
                    </div>

                    <div class="card-body">
                      <h6 class="fw-bold text-truncate mb-1"><%= item.title %></h6>

                        <p class="fs-6 fw-bold text-success mb-2">
                          <%= (!item.price || item.price <= 0)
                                ? t('common.price_on_request','Preis auf Anfrage')
                                : item.priceFormatted %>
                        </p>
                    </div>

                    <div class="card-footer bg-white small text-muted d-flex align-items-center">
                      <i class="bi bi-star me-1"></i> <%= t('common.recommendation','Empfehlung für Sie') %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <% if (similarItems.length > 4) { %>
        <!-- Custom Pfeile im gleichen Design wie meine my-carousel-Buttons -->
        <button class="my-carousel-prev"
                type="button"
                data-bs-target="#carousel-similar"
                data-bs-slide="prev">
          ‹
          <span class="visually-hidden">Vorherige</span>
        </button>

        <button class="my-carousel-next"
                type="button"
                data-bs-target="#carousel-similar"
                data-bs-slide="next">
          ›
          <span class="visually-hidden">Nächste</span>
        </button>

        <div class="carousel-indicators mt-3 d-none d-md-flex">
          <% for (let i = 0; i < Math.ceil(similarItems.length / 4); i++) { %>
            <button type="button"
                    data-bs-target="#carousel-similar"
                    data-bs-slide-to="<%= i %>"
                    class="line-indicator <%= i === 0 ? 'active' : '' %>">
            </button>
          <% } %>
        </div>
      <% } %>


    </div>
  </div>
<% } %>


<% if (moreItems.length > 0) { %>
  <% moreItems.forEach(group => { %>
    <div class="p-3 mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold"><%= t('cars.more_items.title', 'Weitere') %></h4>
        <% if (seller && seller.slug) { %>
          <a href="/seller/<%= seller.slug %>" class="small-coo fw-bold text-decoration-none">
            <%= t('cars.more_items.show_all', 'Alle anzeigen') %>
          </a>
        <% } %>
      </div>

      <div id="carousel-<%= group.route %>" class="carousel slide custom-carousel">
        <div class="carousel-inner">
          <% for (let i = 0; i < group.items.length; i += 4) { %>
            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
              <div class="row g-3" style="justify-content: left;">
                <% group.items.slice(i, i + 4).forEach(prod => { %>
                  <div class="col-md-3">
                    <div class="card h-100 shadow-sm border-0">
                      <div class="position-relative">
                        <a href="/<%= group.route %>/<%= prod.id %>/<%= prod.name %>">
                          <img src="<%= prod.mainpicture %>" class="card-img-top rounded-top fixed-img heIght" alt="<%= prod.name %>">
                        </a>
                        <% if (prod.created && new Date(prod.created) > new Date(Date.now() - 14*24*60*60*1000)) { %>
                          <span class="position-absolute top-0 start-0 m-2 badge bg-danger"><%= t('cars.more_items.new', 'Neu') %></span>
                        <% } %>
                      </div>

                      <div class="card-body">
                        <h6 class="fw-bold text-truncate mb-1"><%= prod.name %></h6>
                        <% if (prod.model) { %>
                          <p class="small text-muted text-truncate"><%= prod.model %></p>
                        <% } %>
                        <p class="fs-6 fw-bold text-success mb-2">
                          <%= (prod.price != null && Number(prod.price) > 0)
                                ? (prod.priceFormatted || convertPrice(prod.price, null, prod.currency || 'EUR'))
                                : t('common.price_on_request','Preis auf Anfrage') %>
                        </p>
                        <div class="d-flex flex-wrap small text-dark">
                          <% if (prod.transmission) { %>
                            <span class="me-3"><i class="bi bi-gear me-1"></i> <%= prod.transmission %></span>
                          <% } %>
                          <% if (prod.mileage) { %>
                            <span class="me-3"><i class="bi bi-speedometer2 me-1"></i> 
                              <%= new Intl.NumberFormat('de-DE').format(prod.mileage) %> km
                            </span>
                          <% } %>
                          <% if (prod.fuel) { %>
                            <span class="me-3"><i class="bi bi-fuel-pump me-1"></i> <%= fuelMap[prod.fuel] || prod.fuel %></span>
                          <% } %>
                          <% if (prod.firstregistration && prod.firstregistration_month) { %>
                            <span><i class="bi bi-calendar-event me-1"></i> 
                              EZ <%= String(prod.firstregistration_month).padStart(2,"0") %>/<%= prod.firstregistration %>
                            </span>
                          <% } %>
                        </div>
                      </div>

                      <div class="card-footer bg-white small text-muted d-flex align-items-center">
                        <i class="bi bi-geo-alt me-1"></i> 
                        <%= prod.city || t('cars.location.unknown', 'Standort auf Anfrage') %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>

        <% if (group.items.length > 1) { %>

          <button class="my-carousel-prev"
                  type="button"
                  data-bs-target="#carousel-<%= group.route %>"
                  data-bs-slide="prev">
            ‹
            <span class="visually-hidden">Vorherige</span>
          </button>

          <button class="my-carousel-next"
                  type="button"
                  data-bs-target="#carousel-<%= group.route %>"
                  data-bs-slide="next">
            ›
            <span class="visually-hidden">Nächste</span>
          </button>

          <div class="carousel-indicators mt-3 d-none d-md-flex">
            <% for (let i = 0; i < Math.ceil(group.items.length / 4); i++) { %>
              <button type="button"
                      data-bs-target="#carousel-<%= group.route %>"
                      data-bs-slide-to="<%= i %>"
                      class="line-indicator <%= i === 0 ? 'active' : '' %>">
              </button>
            <% } %>
          </div>

        <% } %>

      </div>
    </div>
  <% }) %>
<% } %>






<% } else if (currentEntity.route === 'watches') { %>
<%
  // ===== MAPPINGS =====
  const waterproofMap = {
    1: 'nicht wasserdicht',  2: '1 ATM',   3: '2 ATM',   4: '2.5 ATM', 5: '3 ATM',

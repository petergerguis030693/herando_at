<%
function slugifyLocal(str) {
  return str
    .toString()
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '') // Umlaute entfernen
    .replace(/[^a-z0-9]+/g, '-')   // alles außer Buchstaben/Zahlen → -
    .replace(/^-+|-+$/g, '')       // Trim
    .replace(/--+/g, '-');         // Doppelte -
}
const detailSlug = slugifyLocal(item.name);
%>

                            <% 
  const cleanName = (item.name || '')
    .replace(/<\/?h1>/gi, '')  // Falls echte HTML-Tags noch drin wären
    .replace(/\bh1\b/gi, '')   // entfernt das Wort "h1" alleine
    .replace(/-h1$/i, '')      // entfernt "-h1" am Ende
    .replace(/h1$/i, '')       // entfernt "h1" am Ende ohne Bindestrich
    .replace(/\s{2,}/g, ' ')   // doppelte Spaces
    .trim();
%>
<%
  const cleanSlug = (detailSlug || '')
    // Falls doch noch HTML drin wäre
    .replace(/<\/?h1>/gi, '')
    // Am Ende ein "-h1" entfernen
    .replace(/-h1$/i, '')
    // Am Ende nur "h1" ohne Bindestrich entfernen (zur Sicherheit)
    .replace(/h1$/i, '')
    // Doppelte Bindestriche aufräumen
    .replace(/--+/g, '-')
    // Bindestriche am Anfang/Ende weg
    .replace(/^-|-$/g, '');

  const detailPath = (() => {
    const slugPart = cleanSlug || item.slug || '';
    const suffix = slugPart ? `${slugPart}-${item.id}` : String(item.id);
    if (typeof entityPath === 'function') return entityPath(currentEntity.route, suffix);
    return `/${currentEntity.route}/${suffix}`;
  })();
%>




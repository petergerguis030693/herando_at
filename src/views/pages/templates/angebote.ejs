                      <% countries.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>


                <!-- ☎️ Kontakt -->
                <fieldset class="border p-3 mb-3 rounded">

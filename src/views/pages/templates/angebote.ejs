                      <input type="email" name="email" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                      <label class="form-label"><%= t('offers.auth.website', { fallback: 'Webseite' }) %></label>
                      <input type="text" name="website" class="form-control">
                    </div>
                  </div>
                </fieldset>

                <!-- 🔐 Passwort -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.password', { fallback: 'Passwort *' }) %>*</label>
                    <input type="password" name="password" class="form-control" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.password.repeat', { fallback: 'Passwort wiederholen *' }) %></label>
                    <input type="password" name="password_repeat" class="form-control" required>
                  </div>
                </div>

                <!-- ✅ Datenschutz -->
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" name="privacy_accepted" required>
                  <label class="form-check-label">
                    <%= t('offers.auth.privacy.prefix', { fallback: 'Ich habe die' }) %>

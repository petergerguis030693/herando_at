<%- include('../../partials/header') %>

<link rel="stylesheet" href="/css/angebote.css">
<style>

.modal-backdrop {
  display: none !important;
}

.custom-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 1050;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  backdrop-filter: blur(2px);
}

body.modal-open .custom-backdrop {
  opacity: 1;
  pointer-events: all;
}

.modal.show {
  z-index: 1060 !important;
}

span{
 font-size: 18px;
}
</style>


<section class="intro">
  <div class="angebot-container">
    <div class="content">
      <img src="/assets/villa.png" alt="<%= t('offers.intro.image_alt', 'Visual') %>" class="intro-image">
      <div class="text">
        <h2 style="text-align: left;"><%= t('offers.intro.title', 'Erfolgreich verkaufen mit Herando') %></h2>
        <ul>
          <li><%= t('offers.intro.list1', 'Verkaufen Sie auf dem führenden Marktplatz für Premiumgüter') %></li>
          <li><%= t('offers.intro.list2', 'Erreichen Sie zahlungskräftige Kaufkunden aus über 50 Ländern') %></li>
          <li><%= t('offers.intro.list3', 'Profitieren Sie von innovativen und exklusiven Marketingsmaßnahmen') %></li>
          <li><%= t('offers.intro.list4', 'Nutzen Sie unsere sichere, diskrete und transparente Zahlungsabwicklung - weltweit') %></li>
          <li><%= t('offers.intro.list5', 'Vertrauen Sie auf unser erfahrenes Team, dass Sie bei jedem Schritt unterstützt') %></li>
          <li style="text-align: left;"><%= t('offers.intro.list6', 'Inserieren Sie JETZT als Händler oder Privatperson für maximalen Verkaufserfolg!') %></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<div class="abtrennung"></div>


<section class="pricingContainer">
  <div class="container" style="margin-top: 40px; margin-bottom: 120px;">
<h1 class="text-center" style="font-size: 24pt;"><%= t('offers.pricing.title', { fallback: 'Marketing-Pakete bei Herando' }) %></h1>
<div class="text-center">
  <span><%= t('offers.pricing.subtitle', { fallback: 'Mit Herando erfolgreich inserieren - privat und gewerblich' }) %></span>
</div>

    <div class="row justify-content-center text-center" style="gap: 60px; margin-top: 100px;">

      <div class="col-md-4 col-lg-3">
        <div style="
          background: #ffffff;
          padding: 80px;
          width: 400px; 
          height: 400px;
          border-radius: 14px;
          border: 1px solid #c39052;
        ">
          <h2 class="pricingTitle"><%= t('offers.package.private', { fallback: 'Privat' }) %></h2>

          <img src="/assets/private.png"
               style="width: 190px; height: auto; display: block; margin: 20px auto;">

          <button class="buyButton btn btn-primary" 
                  onclick="handleBuy('<%= privateDefaultId %>', 'private')">
            <%= t('offers.pricing.button.buy', { fallback: 'Jetzt verkaufen' }) %>
          </button>

        </div>
      </div>

      <div class="col-md-4 col-lg-3">
        <div style="
          background: #ffffff;
          padding: 80px;
          width: 400px; 
          height: 400px;
          border-radius: 14px;
          border: 1px solid #c39052;
        ">
          <h2 class="pricingTitle"><%= t('offers.package.commercial', { fallback: 'Gewerblich' }) %></h2>

          <img src="/assets/commercial.png"
               style="width: 190px; height: auto; display: block; margin: 20px auto;">

          <button class="buyButton btn btn-primary"
                  onclick="handleBuy('<%= commercialDefaultId %>', 'commercial')">
            <%= t('offers.pricing.button.buy', { fallback: 'Jetzt verkaufen' }) %>
          </button>

        </div>
      </div>

    </div>

  </div>
</section>

<div class="abtrennung"></div>

<section class="optimal">
  <h2><%= t('offers.optimal.title', 'Die optimale Lösung für Ihre Premiumprodukte') %></h2><br>
  <span>
    <%= t('offers.optimal.text', 'Sie haben Interesse Ihre Premiumprodukte bei Herando erfolgsorientiert zu inserieren? Oder Sie begeistern sich als Kaufinteressent für unser exklusives Sortiment? Dann sind Sie bei Herando goldrichtig! Wir bieten Händlern, Maklern und Privatpersonen weltweit die optimale Lösung! Registrieren Sie sich und beginnen Sie Ihre persönliche Erfolgsgeschichte mit Herando.') %>
  </span>
</section>


<div class="abtrennung"></div>

<div class="carouselStepsContainer">
<h2><%= t('offers.carousel.steps.title') %></h2>

  <div id="carouselSteps" class="carousel slide" data-bs-ride="carousel">
<div class="carousel-inner">
  <!-- Schritt 1 -->
  <div class="carousel-item active carouselStepsItem">
    <span class="stepNumber">1.</span>
    <div>
      <h3><%= t('offers.carousel.steps.s1.title',{fallback:'Erstellen Sie Ihr Händlerkonto'}) %></h3>
      <p><%= t('offers.carousel.steps.s1.text',{fallback:'Starten Sie noch heute erfolgreich auf Herando, indem Sie Ihr Händlerkonto anlegen. Nach sorgfältiger Prüfung Ihrer Angaben und Unterlagen aktivieren wir Ihr Konto – und Sie beginnen Ihre persönliche Erfolgsgeschichte!'}) %></p>
    </div>
  </div>

  <!-- Schritt 2 -->
  <div class="carousel-item carouselStepsItem">
    <span class="stepNumber">2.</span>
    <div>
      <h3><%= t('offers.carousel.steps.s2.title',{fallback:'Inserieren Sie Ihre Produkte'}) %></h3>
      <p><%= t('offers.carousel.steps.s2.text',{fallback:'Präsentieren Sie unkompliziert Ihre exklusiven Premiumprodukte bei Herando und profitieren Sie von Millionen potenzieller Kaufkunden – selbstverständlich auf Wunsch auch mit höchster Diskretion!'}) %></p>
    </div>
  </div>

  <!-- Schritt 3 -->
  <div class="carousel-item carouselStepsItem">
    <span class="stepNumber">3.</span>
    <div>
      <h3><%= t('offers.carousel.steps.s3.title',{fallback:'Erfolgreich verkaufen'}) %></h3>
      <p><%= t('offers.carousel.steps.s3.text',{fallback:'Verkaufen Sie weltweit – mit maximaler Sicherheit und einer transparenten Abwicklung. Unsere Plattform bietet Ihnen einen zuverlässigen Verkaufsprozess und Zugang zu einem internationalen Kundenklientel.'}) %></p>
    </div>
  </div>

  <!-- Schritt 4 -->
  <div class="carousel-item carouselStepsItem">
    <span class="stepNumber">4.</span>
    <div>
      <h3><%= t('offers.carousel.steps.s4.title',{fallback:'Premium-Partner bei Herando werden!'}) %></h3>
      <p><%= t('offers.carousel.steps.s4.text',{fallback:'Erweitern Sie Ihre Reichweite und gewinnen Sie neue Kunden durch unser leistungsstarkes Netzwerk. Nutzen Sie die Vorteile einer benutzerfreundlichen Plattform, die Ihnen effiziente Verkaufsprozesse und individuellen Support bietet – diskret und zuverlässig.'}) %></p>
    </div>
  </div>
</div>


    <button class="carousel-control-prev" type="button" data-bs-target="#carouselSteps" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
      <span class="visually-hidden"><%= t('common.prev',{fallback:'Zurück'}) %></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselSteps" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
      <span class="visually-hidden"><%= t('common.next',{fallback:'Weiter'}) %></span>
    </button>
  </div>

  <div class="progressIndicator">
    <div class="progressStep activeStep"></div>
    <div class="progressStep"></div>
    <div class="progressStep"></div>    
    <div class="progressStep"></div>
  </div>
</div>

<script>
  // Fortschrittsanzeige aktualisieren
  document.getElementById('carouselSteps')?.addEventListener('slid.bs.carousel', function (event) {
    let index = event.to;
    let progressSteps = document.querySelectorAll(".progressStep");
    progressSteps.forEach((step, i) => step.classList.toggle("activeStep", i === index));
  });
</script>


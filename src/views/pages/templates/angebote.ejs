                <button type="submit" class="btn btn-primary w-100">
                  <%= t('offers.auth.register.button', { fallback: 'Registrieren und fortfahren' }) %>
                </button>
              </form>
            </div>

          </div> <!-- /tab-content pane -->
        </div> <!-- /tab-content -->
      </div> <!-- /modal-body -->
    </div>
  </div>
</div>


<% 
  const isLoggedIn = !!user && !!user.id;
  const safeUserType = userType || (user && user.type) || '';
  const hasPackage = !!userHasPackage;
%>

<script>
  // Globale Statusvariablen
  window.isLoggedIn = <%= isLoggedIn %>;
  window.userType = "<%= safeUserType %>";
  window.userHasPackage = <%= hasPackage %>;
</script>

<script>
  let selectedPackage = null;
  let selectedType = null;

  // ─── Kaufen-Button ────────────────────────────────────────────
  function handleBuy(packageId, type) {
    selectedPackage = packageId;
    selectedType = type;
    console.log('🟢 Paket gewählt:', packageId, 'Typ:', type);
    console.log('👤 Loginstatus:', window.isLoggedIn, '| Typ:', window.userType, '| Paketstatus:', window.userHasPackage);

    if (window.isLoggedIn) {
      // ✅ Richtiger Typ + Paket aktiv → direkt weiter
      if (window.userType === type && window.userHasPackage) {
        console.log('✅ Richtiger Typ + aktives Paket → Weiterleitung');
        window.location.href = `/buyer/sold?packageId=${packageId}&type=${type}`;
        return;
      }

      // ⚠️ Eingeloggt, aber anderer Typ → Logout und Modal öffnen
      if (window.userType !== type) {
        console.log('⚠️ Anderer Pakettyp → automatischer Logout + Registrierung neu starten');
        fetch('/auth/logout', { method: 'GET' })
          .then(() => openRegistrationModal(type))
          .catch(() => openRegistrationModal(type));
        return;
      }

      // 💡 Eingeloggt, aber kein aktives Paket → darf kaufen
      if (!window.userHasPackage) {
        console.log('💡 Kein aktives Paket → Weiterleitung erlaubt');
        window.location.href = `/buyer/sold?packageId=${packageId}&type=${type}`;
        return;
      }
    }

    // ❌ Nicht eingeloggt → Registrierung öffnen
    console.log('🔒 Nicht eingeloggt → Registrierung öffnen');
    openRegistrationModal(type);
  }

  // ─── Modal öffnen ─────────────────────────────────────────────
  function openRegistrationModal(type) {
    console.log('📦 Öffne Modal für Typ:', type);
    const modalEl = document.getElementById('authModal');
    if (!modalEl) return console.error('❌ authModal nicht gefunden!');

    // Formularumschaltung
    document.getElementById('commercialForm').classList.toggle('d-none', type !== 'commercial');
    document.getElementById('privateForm').classList.toggle('d-none', type !== 'private');

    // Modal anzeigen
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
  }

  // ─── Login-Handler ───────────────────────────────────────────
  document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target).entries());

    const res = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      console.log('✅ Login erfolgreich');
      window.location.href = `/buyer/sold?packageId=${selectedPackage}&type=${selectedType}`;
    } else {
      alert('<%= t("offers.auth.login.failed", { fallback: "❌ Login fehlgeschlagen." }) %>');
    }
  });

  // ─── Registrierung (beide Typen) ──────────────────────────────
  async function handleRegister(formEl, type) {
    const data = Object.fromEntries(new FormData(formEl).entries());
    data.type = type;
    data.packageId = selectedPackage;

    try {
      const res = await fetch('/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json().catch(() => ({}));

      if (res.ok && result.success) {
        alert('<%= t("offers.auth.register.success", { fallback: "Registrierung erfolgreich. Bitte E-Mail bestätigen." }) %>');
        window.location.href = '/auth/login';
        return;
      }
      else {
              alert('<%= t("offers.auth.register.failed", { fallback: "❌ Registrierung fehlgeschlagen: " }) %>' + (result.error || '<%= t("offers.auth.unknown_error", { fallback: "Unbekannter Fehler." }) %>'));
            }
          } catch (err) {
            alert('<%= t("offers.auth.server_error", { fallback: "❌ Serverfehler bei Registrierung: " }) %>' + err.message);
          }
        }

  document.getElementById('formCommercial')?.addEventListener('submit', e => {
    e.preventDefault();
    handleRegister(e.target, 'commercial');
  });

  document.getElementById('formPrivate')?.addEventListener('submit', e => {
    e.preventDefault();
    handleRegister(e.target, 'private');
  });
</script>








<div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title"><%= t('offers.auth.modal.title', { fallback: 'Registrierung / Login' }) %></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="authTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button">
              <%= t('offers.auth.tab.login', { fallback: 'Login' }) %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button">
              <%= t('offers.auth.tab.register', { fallback: 'Registrieren' }) %>
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <!-- 🟩 LOGIN -->
          <div class="tab-pane fade show active" id="login">
            <form id="loginForm">
              <div class="mb-3">
                <label class="form-label"><%= t('offers.auth.email', { fallback: 'E-Mail-Adresse' }) %></label>
                <input type="email" class="form-control" name="email" required>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('offers.auth.password', { fallback: 'Passwort' }) %></label>
                <input type="password" class="form-control" name="password" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">
                <%= t('offers.auth.login.button', { fallback: 'Einloggen' }) %>
              </button>
            </form>
          </div>

          <!-- 🟦 REGISTER -->
          <div class="tab-pane fade" id="register">
            <!-- GEWERBLICH -->
            <div id="commercialForm" class="d-none">
              <form id="formCommercial">
                <h5 class="mb-3"><%= t('offers.auth.register.commercial.title', { fallback: 'Als gewerblicher Anbieter registrieren' }) %></h5>

                <!-- 👤 Anrede -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.gender', { fallback: 'Anrede *' }) %></label>
                    <select name="gender" class="form-select" required>
                      <option value=""><%= t('offers.auth.gender.choose', { fallback: 'Bitte wählen...' }) %></option>
                      <option value="2"><%= t('offers.auth.gender.mr', { fallback: 'Herr' }) %></option>
                      <option value="3"><%= t('offers.auth.gender.mrs', { fallback: 'Frau' }) %></option>
                    </select>
                  </div>
                </div>

                <!-- 👥 Name -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.firstname', { fallback: 'Vorname *' }) %></label>
                    <input type="text" name="firstname" class="form-control" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.lastname', { fallback: 'Nachname *' }) %></label>
                    <input type="text" name="lastname" class="form-control" required>
                  </div>
                </div>

                <!-- 🏢 Firma -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.company', { fallback: 'Firma *' }) %></label>
                    <input type="text" name="company" class="form-control" required>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.vatid', { fallback: 'USt-ID' }) %></label>
                    <input type="text" name="vatid" class="form-control">
                  </div>
                </div>

                <!-- 🏠 Adresse -->
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label class="form-label"><%= t('offers.auth.street', { fallback: 'Straße *' }) %> *</label>
                    <input type="text" name="street" class="form-control" required>
                  </div>
                  <div class="col-md-2 mb-3">
                    <label class="form-label"><%= t('offers.auth.housenumber', { fallback: 'Nr. *' }) %> *</label>
                    <input type="text" name="housenumber" class="form-control" required>
                  </div>
                  <div class="col-md-4 mb-3">
                    <label class="form-label"><%= t('offers.auth.postcode', { fallback: 'PLZ' }) %> *</label>
                    <input type="text" name="postcode" class="form-control" required>
                  </div>

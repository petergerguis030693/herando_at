                <div class="registration-step3 d-none">
                  <h4 class="checkout-step-title"><%= t('buyer.sold.modal.title', 'Bestellübersicht') %></h4>

                  <div class="checkout-step-panel checkout-step-panel-review" data-type="private">
                    <div class="checkout-summary-box">
                      <div><%= t('buyer.sold.summary.marketing', 'Marketingpaket') %>: <strong class="checkout-package-name" data-type="private">-</strong></div>
                      <div><%= t('buyer.sold.summary.category', 'Kategorie') %>: <strong class="checkout-category-name" data-type="private">-</strong></div>
                    </div>

                    <div class="d-flex gap-2 mt-3 checkout-coupon-row">
                      <input type="text" class="form-control checkout-coupon-input flex-grow-1" data-type="private" placeholder="<%= t('buyer.sold.coupon.placeholder', 'Rabattcode') %>">
                      <button type="button" class="btn btn-outline-primary checkout-coupon-apply" data-type="private"><%= t('buyer.sold.coupon.apply', 'Rabattcode einlösen') %></button>
                      <button type="button" class="btn btn-outline-secondary checkout-coupon-cancel d-none" data-type="private"><%= t('buyer.sold.coupon.cancel', 'Rabattcode stornieren') %></button>

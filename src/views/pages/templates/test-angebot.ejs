                    <div class="checkout-price-box mt-3 checkout-price-box-target" data-type="private"></div>
                    <button type="button" class="btn btn-dark w-100 mt-4 checkout-to-confirm" data-type="private"><%= t('buyer.sold.checkout', 'Zur Kasse gehen') %></button>
                  </div>

                  <div class="checkout-step-panel checkout-step-panel-confirm d-none" data-type="private">
                    <div class="checkout-price-box checkout-final-summary" data-type="private"></div>

                    <div class="agb-box mt-4">
                      <span class="checkout-agb-badge">Sicherer Checkout</span>
                      <label class="agb-label">
                        <input class="checkout-paid-check" type="checkbox" id="privatePaidCheck">
                        <span>
                          <%= t('buyer.sold.agb.text1', 'Ich habe die') %>
                          <a href="/agb" target="_blank"><%= t('buyer.sold.agb.terms', 'Allgemeine Geschäftsbedingungen') %></a>
                          <%= t('buyer.sold.agb.text2', 'und die') %>
                          <a href="/datenschutz" target="_blank"><%= t('buyer.sold.agb.privacy', 'Datenschutzerklärung') %></a>
                          <%= t('buyer.sold.agb.text3', 'gelesen und akzeptiere die hiermit.') %>
                        </span>
                      </label>
                    </div>

                    <button type="button" class="btn btn-light w-100 mt-3 checkout-back-to-review" data-type="private">← <%= t('common.prev', 'Zurück') %></button>
                    <button type="button" class="btn btn-primary w-100 mt-3 proceed-to-payment" data-type="private"><%= t('buyer.sold.buy_now', 'Jetzt kaufen') %></button>
                  </div>
                </div>
              </form>
            </div>

          </div> <!-- /tab-content pane -->
        </div> <!-- /tab-content -->
      </div> <!-- /modal-body -->
    </div>
  </div>
</div>


<% 
  const isLoggedIn = !!user && !!user.id;
  const safeUserType = userType || (user && user.type) || '';
  const hasPackage = !!userHasPackage;
  const packageCatalogServer = {};
  (packages || []).forEach(function(pkg) {
    packageCatalogServer[String(pkg.id)] = {
      name: (pkg.translated_name || pkg.name || ''),
      price: Number(pkg.price || 0)
    };
  });
  const packageCatalogJson = JSON.stringify(packageCatalogServer);
%>

<script id="testAngebotBootstrapData" type="application/json"><%- JSON.stringify({
  isLoggedIn: isLoggedIn,
  userType: safeUserType,
  userHasPackage: hasPackage,
  packageCatalog: JSON.parse(packageCatalogJson || '{}'),
  requestedOfferType: requestedOfferType || ''
}) %></script>

<script>
  const bootstrapDataEl = document.getElementById('testAngebotBootstrapData');
  const bootstrapData = bootstrapDataEl ? JSON.parse(bootstrapDataEl.textContent || '{}') : {};
  window.isLoggedIn = !!bootstrapData.isLoggedIn;
  window.userType = bootstrapData.userType || '';
  window.userHasPackage = !!bootstrapData.userHasPackage;
  const requestedOfferType = bootstrapData.requestedOfferType || '';
  const isPrivateTypeRoute = requestedOfferType === 'private';
  const isTypeRoute = requestedOfferType === 'private' || requestedOfferType === 'commercial';
  const offerRouteByType = {
    private: '/angebot-private',
    commercial: '/angebot-commercial'
  };
  const authModalEl = document.getElementById('authModal');
  const authModalDialog = authModalEl ? authModalEl.querySelector('.modal-dialog') : null;
  const authModalHeader = authModalEl ? authModalEl.querySelector('.modal-header') : null;
  const authEntryStepEl = document.getElementById('authEntryStep');

  let selectedPackage = null;
  let selectedType = null;
  let authChoiceContextType = null;
  const selectedCategoryByType = { commercial: '', private: '' };
  const selectedPackageByType = { commercial: '', private: '' };
  const registrationCompletedByType = { commercial: false, private: false };
  // Zahlungsflow aktiv: Stripe wird normal verwendet
  const TEST_ANGEBOT_DISABLE_STRIPE = false;
  const checkoutStateByType = {
    commercial: { originalNet: 0, currentNet: 0, discountPercent: 0, discountAmount: 0, vatValidation: 'none', vatReason: 'none' },
    private: { originalNet: 0, currentNet: 0, discountPercent: 0, discountAmount: 0, vatValidation: 'none', vatReason: 'none' }
  };
  const vatCheckStateByType = {
    commercial: { checked: false, normalizedVatId: '', countryId: '', companyName: '', vatValidation: 'none', vatReason: 'none' },
    private: { checked: false, normalizedVatId: '', countryId: '', vatValidation: 'none' }
  };
  const packageCatalog = bootstrapData.packageCatalog || {};

  function normalizePackageNoteLineBreaks() {
    const paragraphs = document.querySelectorAll('#commercialForm .package-description p, #privateForm .package-description p');
    paragraphs.forEach((paragraph) => {
      const html = String(paragraph.innerHTML || '');
      if (!html || html.includes('<br') || !html.includes('(')) return;
      paragraph.innerHTML = html.replace(/\s+\(/, '<br>(');
    });
  }

  normalizePackageNoteLineBreaks();

  function formatPriceEUR(value) {
    return Number(value || 0).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
  }

  function getRegisterForm(type) {
    return type === 'commercial'
      ? document.getElementById('formCommercial')
      : document.getElementById('formPrivate');
  }

  function normalizeVatIdClient(vatid) {
    return String(vatid || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  }

  function getCommercialVatElements() {
    const form = document.getElementById('formCommercial');
    return {
      form,
      vatInput: form ? form.querySelector('input[name="vatid"]') : null,
      companyInput: form ? form.querySelector('input[name="company"]') : null,
      countrySelect: form ? form.querySelector('select[name="country_id"]') : null,
      checkBtn: form ? form.querySelector('.uid-check-trigger') : null,
      infoEl: form ? form.querySelector('.uid-check-feedback[data-type="commercial"]') : null
    };
  }

  function renderCommercialVatInfo(message, tone) {
    const { infoEl } = getCommercialVatElements();
    if (!infoEl) return;
    const toneClass = tone === 'success'
      ? 'text-success'
      : tone === 'danger'
        ? 'text-danger'
        : tone === 'warning'
          ? 'text-warning'
          : 'text-muted';
    infoEl.innerHTML = message ? `<span class="${toneClass}">${message}</span>` : '';
  }

  async function performCommercialVatCheck(options = {}) {
    const { silent = false, force = false } = options;
    const { vatInput, companyInput, countrySelect, checkBtn } = getCommercialVatElements();
    if (!vatInput || !countrySelect) return { success: false, skipped: true };

    const vatid = String(vatInput.value || '').trim();
    const countryId = String(countrySelect.value || '').trim();
    const companyName = String(companyInput?.value || '').trim();
    const normalizedVatId = normalizeVatIdClient(vatid);
    const state = vatCheckStateByType.commercial;

    if (!force && state.checked && state.normalizedVatId === normalizedVatId && state.countryId === countryId && state.companyName === companyName) {
      return { success: true, cached: true, vatValidation: state.vatValidation };
    }

    if (!vatid) {
      state.checked = true;
      state.normalizedVatId = '';
      state.countryId = countryId;
      state.companyName = companyName;
      state.vatValidation = 'none';
      if (!silent) renderCommercialVatInfo('<%= t("offers.uid.empty_vatid", { fallback: "Keine USt-ID angegeben. MwSt wird berechnet." }) %>', 'muted');
      console.log('[UID] Kein Wert für USt-ID eingegeben, setze vatValidation=none');
      return { success: true, vatValidation: 'none', reason: 'empty' };
    }

    if (!countryId) {
      state.checked = false;
      if (!silent) renderCommercialVatInfo('<%= t("offers.uid.country_required", { fallback: "Bitte zuerst ein Land auswählen." }) %>', 'warning');
      console.log('[UID] Land fehlt für UID-Prüfung');
      return { success: false, vatValidation: 'invalid', reason: 'country-missing' };
    }

    if (checkBtn) checkBtn.disabled = true;
    if (!silent) renderCommercialVatInfo('<%= t("offers.uid.checking", { fallback: "UID wird geprüft..." }) %>', 'muted');

    try {
      const res = await fetch('/auth/offers/check-vatid', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vatid, country_id: countryId, company: companyName })
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.success) {
        throw new Error(result.error || 'UID-Prüfung fehlgeschlagen');
      }
      console.log('[UID] CHECK UID API Ergebnis:', result);

      state.checked = true;
      state.normalizedVatId = String(result.normalizedVatId || normalizedVatId);
      state.countryId = countryId;
      state.companyName = companyName;
      state.vatValidation = result.vatValidation || 'none';
      state.vatReason = result.reason || 'none';
      checkoutStateByType.commercial.vatValidation = state.vatValidation;
      checkoutStateByType.commercial.vatReason = state.vatReason;

      if (state.vatValidation === 'valid') {
        renderCommercialVatInfo(
          result.reason === 'local-fallback'
            ? '<%= t("offers.uid.valid_local_fallback", { fallback: "UID-Prüfung erfolgreich (lokale Prüfung, VIES nicht erreichbar)." }) %>'
            : '<%= t("offers.uid.valid", { fallback: "UID-Prüfung erfolgreich." }) %>',
          'success'
        );
      } else if (state.vatValidation === 'none') {
        renderCommercialVatInfo('<%= t("offers.uid.empty_vatid", { fallback: "Keine USt-ID angegeben. MwSt wird berechnet." }) %>', 'muted');
      } else if (result.reason === 'vies-error') {
        renderCommercialVatInfo('<%= t("offers.uid.vies_unavailable", { fallback: "UID-Prüfung über VIES aktuell gestört." }) %>', 'warning');
      } else if (result.reason === 'format') {
        renderCommercialVatInfo('<%= t("offers.uid.invalid_format", { fallback: "UID-Prüfung nicht erfolgreich: Ungültiges USt-ID-Format." }) %>', 'danger');
      } else if (result.reason === 'tax-applies' && result.viesValid === false) {
        renderCommercialVatInfo('<%= t("offers.uid.invalid_vies", { fallback: "UID-Prüfung nicht erfolgreich: VIES meldet die USt-ID als ungültig." }) %>', 'danger');
      } else {
        renderCommercialVatInfo('<%= t("offers.uid.invalid_vat_applies", { fallback: "UID-Prüfung nicht erfolgreich: MwSt wird berechnet." }) %>', 'danger');
      }

      return result;
    } catch (err) {
      state.checked = false;
      renderCommercialVatInfo('<%= t("offers.uid.check_unavailable_retry", { fallback: "UID-Prüfung aktuell nicht verfügbar. Beim Fortfahren wird erneut geprüft." }) %>', 'warning');
      console.error('[UID] CHECK UID Fehler:', err);
      return { success: false, error: err.message || 'UID-Prüfung fehlgeschlagen' };
    } finally {
      if (checkBtn) checkBtn.disabled = false;
    }
  }

  function getDocumentY(el) {
    const rect = el.getBoundingClientRect();
    const vv = window.visualViewport;
    const vvOffsetY = vv ? vv.offsetTop : 0;
    return window.scrollY + rect.top - vvOffsetY;
  }

  function keepFlowAnchored() {
    if (!isTypeRoute) return;
    const anchor = authModalHeader || authModalEl;
    if (!anchor) return;
    const scrollToAnchorTop = function(options) {
      const behavior = options && options.behavior ? options.behavior : 'auto';
      const y = getDocumentY(anchor);
      const targetTop = Math.max(0, y - 4);
      const currentTop = window.scrollY;
      const delta = targetTop - currentTop;
      const smoothUpThreshold = 12;
      const chosenBehavior =
        behavior === 'smooth' && delta < -smoothUpThreshold
          ? 'smooth'
          : 'auto';
      window.scrollTo({ top: targetTop, behavior: chosenBehavior });
    };
    requestAnimationFrame(function() { scrollToAnchorTop({ behavior: 'smooth' }); });
    window.setTimeout(function() { scrollToAnchorTop({ behavior: 'smooth' }); }, 0);
    window.setTimeout(scrollToAnchorTop, 80);
    window.setTimeout(scrollToAnchorTop, 220);
    window.setTimeout(scrollToAnchorTop, 420);
  }

  function setAuthModalWide(isWide) {
    if (!authModalDialog) return;
    authModalDialog.classList.toggle('auth-modal-wide', !!isWide);
  }

  function setAuthModalForm(isForm) {
    if (!authModalDialog) return;
    authModalDialog.classList.toggle('auth-modal-form', !!isForm);
  }


  function activateAuthPane(paneId) {
    ['login', 'register'].forEach(function(id) {
      const pane = document.getElementById(id);
      if (!pane) return;
      const isActive = paneId === id;
      pane.classList.toggle('d-none', !isActive);
      pane.classList.toggle('show', isActive);
      pane.classList.toggle('active', isActive);
    });
  }

  function showAuthChoice() {
    if (authEntryStepEl) authEntryStepEl.classList.remove('d-none');
    activateAuthPane(null);
    setAuthModalWide(false);
    setAuthModalForm(false);
    keepFlowAnchored();
  }

  function showLoginPane() {
    if (authEntryStepEl) authEntryStepEl.classList.add('d-none');
    activateAuthPane('login');
    setAuthModalWide(false);
    setAuthModalForm(false);
    keepFlowAnchored();
  }

  function showRegisterPane(type, targetStep, resetFlow) {
    const desiredStep = Number(targetStep || 1);
    const shouldReset = resetFlow !== false;
    if (authEntryStepEl) authEntryStepEl.classList.add('d-none');
    activateAuthPane('register');
    setAuthModalWide(type === 'commercial');
    setAuthModalForm(false);
    document.getElementById('commercialForm').classList.toggle('d-none', type !== 'commercial');
    document.getElementById('privateForm').classList.toggle('d-none', type !== 'private');
    if (shouldReset) {
      resetRegisterFlow(type);
    } else {
      updatePackagePreview(type);
      markSelectedPackageCard(type, selectedPackageByType[type] || null);
      setRegisterStep(type, desiredStep);
    }
    keepFlowAnchored();
  }

  function setRegisterStep(type, step) {
    const form = getRegisterForm(type);
    if (!form) return;

    const step1 = form.querySelector('.registration-step1');
    const step2 = form.querySelector('.registration-step2');
    const step3 = form.querySelector('.registration-step3');
    const panels = [step1, step2, step3].filter(Boolean);
    const nextPanel = panels[step - 1];
    if (!nextPanel) return;
    const currentPanel = panels.find(function(panel) { return !panel.classList.contains('d-none'); });

    if (step === 1) {
      setAuthModalWide(type === 'commercial');
      setAuthModalForm(false);
    } else {
      setAuthModalWide(false);
      setAuthModalForm(true);
    }

    const headingEl = form.querySelector('.register-form-heading');
    if (headingEl) {
      headingEl.classList.toggle('d-none', step === 3);
    }

    if (step === 3) {
      setCheckoutPanel(type, 'review');
      const paidCheck = form.querySelector('.checkout-paid-check');
      if (paidCheck) paidCheck.checked = false;
    }

    const commercialStep1TitleAddon = document.getElementById('commercialStep1TitleAddon');
    if (commercialStep1TitleAddon) {
      commercialStep1TitleAddon.classList.toggle('d-none', !(type === 'commercial' && step === 1));
    }

    panels.forEach(function(panel, idx) {
      const active = idx === (step - 1);
      panel.querySelectorAll('select, input, button, textarea').forEach(function(el) {
        el.disabled = !active;
      });
    });

    if (!currentPanel || currentPanel === nextPanel || currentPanel.classList.contains('d-none')) {
      nextPanel.classList.remove('d-none');
      keepFlowAnchored();
      return;
    }

    currentPanel.classList.add('registration-step-leave');

    window.setTimeout(function() {
      currentPanel.classList.add('d-none');
      currentPanel.classList.remove('registration-step-leave');

      nextPanel.classList.remove('d-none');
      nextPanel.classList.add('registration-step-enter');

      requestAnimationFrame(function() {
        nextPanel.classList.add('registration-step-enter-active');
      });

      window.setTimeout(function() {
        nextPanel.classList.remove('registration-step-enter');
        nextPanel.classList.remove('registration-step-enter-active');
        keepFlowAnchored();
      }, 240);
    }, 180);
  }

  function updatePackagePreview(type) {
    const form = getRegisterForm(type);
    const pkgId = selectedPackageByType[type] || '';
    form?.querySelectorAll('.selected-package-id').forEach(input => { input.value = pkgId; });
  }

  function markSelectedPackageCard(type, packageId) {
    document.querySelectorAll('.package-option-card[data-package-card-type="' + type + '"]').forEach(function(card) {
      const isSelected = String(card.dataset.packageCardId) === String(packageId || '');
      card.classList.toggle('is-selected', isSelected);
    });
  }

  function getSelectedCategoryLabel(type) {
    const pkgId = selectedPackageByType[type];
    const select = document.getElementById(type + 'Category_' + pkgId);
    if (!select) return '-';
    const idx = select.selectedIndex;
    return idx >= 0 ? String(select.options[idx].textContent || '-').trim() : '-';
  }

  function setCheckoutPanel(type, panel) {
    const review = document.querySelector('.checkout-step-panel-review[data-type="' + type + '"]');
    const confirm = document.querySelector('.checkout-step-panel-confirm[data-type="' + type + '"]');
    if (!review || !confirm) return;
    const showConfirm = panel === 'confirm';
    review.classList.toggle('d-none', showConfirm);
    confirm.classList.toggle('d-none', !showConfirm);
  }

  function renderCheckoutStep(type) {
    const pkgId = selectedPackageByType[type];
    const pkg = packageCatalog[String(pkgId)] || {};
    const state = checkoutStateByType[type];
    if (!state.originalNet) {
      state.originalNet = Number(pkg.price || 0);
      state.currentNet = Number(pkg.price || 0);
      state.discountPercent = 0;
      state.discountAmount = 0;
    }

    const reverseCharge =
      type === 'commercial' && state.vatValidation === 'valid';
    const taxRate = reverseCharge ? 0 : 0.21;
    const tax = state.currentNet * taxRate;
    const gross = state.currentNet + tax;

    const packageNameEl = document.querySelector('.checkout-package-name[data-type="' + type + '"]');
    const categoryNameEl = document.querySelector('.checkout-category-name[data-type="' + type + '"]');
    const priceBox = document.querySelector('.checkout-price-box-target[data-type="' + type + '"]');
    const finalSummaryBox = document.querySelector('.checkout-final-summary[data-type="' + type + '"]');
    const couponInfo = document.querySelector('.checkout-coupon-info[data-type="' + type + '"]');
    const cancelBtn = document.querySelector('.checkout-coupon-cancel[data-type="' + type + '"]');
    const vatCheckInfo = document.querySelector('.checkout-vat-check-info[data-type="' + type + '"]');
    const categoryName = getSelectedCategoryLabel(type);

    if (packageNameEl) packageNameEl.textContent = pkg.name || '-';
    if (categoryNameEl) categoryNameEl.textContent = categoryName;

    let priceHtml = '';
    if (priceBox) {
      let discountHtml = '';
      if (state.discountPercent > 0) {
        discountHtml = `
          <div class="d-flex justify-content-between text-danger">
            <span>${'<%= t("offers.checkout.discount_percent", { fallback: "Rabatt ({percent}%)" }) %>'.replace('{percent}', state.discountPercent)}</span>
            <strong>- ${formatPriceEUR(state.discountAmount)}</strong>
          </div>
          <div class="d-flex justify-content-between">
            <span><%= t("offers.checkout.subtotal_new", { fallback: "Neue Zwischensumme" }) %></span>
            <strong>${formatPriceEUR(state.currentNet)}</strong>
          </div>
        `;
      }

      priceHtml = `
        <div class="d-flex justify-content-between">
          <span><%= t("offers.checkout.subtotal", { fallback: "Zwischensumme" }) %></span>
          <strong>${formatPriceEUR(state.originalNet)}</strong>
        </div>
        ${discountHtml}
        <div class="d-flex justify-content-between">
          <span>${reverseCharge ? '<%= t("offers.checkout.tax.reverse_charge", { fallback: "MwSt (Reverse Charge, 0%)" }) %>' : '<%= t("offers.checkout.tax.digital_21", { fallback: "Digitale USt (21%)" }) %>'}</span>
          <strong>${formatPriceEUR(tax)}</strong>
        </div>
        <hr>
        <div class="d-flex justify-content-between fs-5">
          <strong>${reverseCharge ? '<%= t("offers.checkout.total.reverse_charge", { fallback: "Gesamt (netto, Reverse Charge)" }) %>' : '<%= t("offers.checkout.total.including_tax", { fallback: "Gesamt inkl. Steuer" }) %>'}</strong>
          <strong>${formatPriceEUR(gross)}</strong>
        </div>
      `;
      priceBox.innerHTML = priceHtml;
    }

    if (finalSummaryBox) {
      finalSummaryBox.innerHTML = `
        <div class="fw-semibold mb-1"><%= t("buyer.sold.summary.marketing", "Marketingpaket") %></div>
        <div><strong>${pkg.name || '-'}</strong></div>
        <div class="text-muted"><%= t("buyer.sold.summary.category", "Kategorie") %>: <strong>${categoryName}</strong></div>
        <hr>
        ${priceHtml}
      `;
    }

    if (couponInfo && !couponInfo.textContent.trim()) couponInfo.innerHTML = '';
    if (cancelBtn) cancelBtn.classList.toggle('d-none', !(state.discountPercent > 0));
    if (vatCheckInfo) {
      if (type !== 'commercial' || state.vatValidation === 'none') {
        vatCheckInfo.innerHTML = '';
      } else if (state.vatValidation === 'valid') {
        if (state.vatReason === 'local-fallback') {
          vatCheckInfo.innerHTML = '<span class="text-success"><%= t("offers.checkout.vat_info_valid_local_reverse_charge", { fallback: "UID lokal bestätigt (VIES war nicht erreichbar). Reverse Charge (0% MwSt) möglich." }) %></span>';
        } else {
          vatCheckInfo.innerHTML = '<span class="text-success"><%= t("offers.checkout.vat_info_valid_reverse_charge", { fallback: "UID-Prüfung erfolgreich: Reverse Charge (0% MwSt) möglich." }) %></span>';
        }
      } else if (state.vatReason === 'vies-error') {
        vatCheckInfo.innerHTML = '<span class="text-warning"><%= t("offers.checkout.vat_info_vies_temporarily_unavailable", { fallback: "VIES ist aktuell vorübergehend nicht erreichbar. Bitte später erneut CHECK UID ausführen." }) %></span>';
      } else {
        vatCheckInfo.innerHTML = '<span class="text-danger"><%= t("offers.uid.invalid_vat_applies", { fallback: "UID-Prüfung nicht erfolgreich: MwSt wird berechnet." }) %></span>';
      }
    }
  }

  function resetRegisterFlow(type) {
    const form = getRegisterForm(type);
    if (!form) return;
    setRegisterStep(type, 1);
    updatePackagePreview(type);
    registrationCompletedByType[type] = false;
    selectedPackageByType[type] = '';
    selectedCategoryByType[type] = '';
    checkoutStateByType[type] = { originalNet: 0, currentNet: 0, discountPercent: 0, discountAmount: 0, vatValidation: 'none', vatReason: 'none' };
    const paidCheck = form.querySelector('.checkout-paid-check');
    if (paidCheck) paidCheck.checked = false;
    const couponInput = form.querySelector('.checkout-coupon-input');
    if (couponInput) couponInput.value = '';
    const couponInfo = form.querySelector('.checkout-coupon-info');
    if (couponInfo) couponInfo.innerHTML = '';
    setCheckoutPanel(type, 'review');
    selectedPackage = null;
    markSelectedPackageCard(type, null);
  }

  // ─── Kaufen-Button ────────────────────────────────────────────
  function handleBuy(packageId, type) {
    const targetRoute = offerRouteByType[type] || '/angebote';
    if (!requestedOfferType || requestedOfferType !== type) {
      window.location.href = targetRoute;
      return;
    }

    selectedPackage = packageId;
    selectedType = type;
    console.log('🟢 Paket gewählt:', packageId, 'Typ:', type);
    console.log('👤 Loginstatus:', window.isLoggedIn, '| Typ:', window.userType, '| Paketstatus:', window.userHasPackage);

    if (window.isLoggedIn) {
      // ✅ Richtiger Typ + Paket aktiv → direkt weiter
      if (window.userType === type && window.userHasPackage) {
        console.log('✅ Richtiger Typ + aktives Paket → Weiterleitung');
        window.location.href = `/buyer/sold?packageId=${packageId}&type=${type}`;
        return;
      }

      // ⚠️ Eingeloggt, aber anderer Typ → Logout und Modal öffnen
      if (window.userType !== type) {
        console.log('⚠️ Anderer Pakettyp → automatischer Logout + Registrierung neu starten');
        fetch('/auth/logout', { method: 'GET' })
          .then(() => openRegistrationModal(type))
          .catch(() => openRegistrationModal(type));
        return;
      }

      // 💡 Eingeloggt, aber kein aktives Paket → darf kaufen
      if (!window.userHasPackage) {
        console.log('💡 Kein aktives Paket → Weiterleitung erlaubt');
        window.location.href = `/buyer/sold?packageId=${packageId}&type=${type}`;
        return;
      }
    }

    // ❌ Nicht eingeloggt → Registrierung öffnen
    console.log('🔒 Nicht eingeloggt → Registrierung öffnen');
    openRegistrationModal(type);
  }

  // ─── Modal öffnen ─────────────────────────────────────────────
  function openRegistrationModal(type) {
    console.log('📦 Öffne Modal für Typ:', type);
    if (!authModalEl) return console.error('❌ authModal nicht gefunden!');
    selectedType = type;
    authChoiceContextType = null;
    showRegisterPane(type, 1, true);

    if (isTypeRoute) return;
    // Modal anzeigen
    const modal = bootstrap.Modal.getOrCreateInstance(authModalEl);
    modal.show();
  }

  // ─── Login-Handler ───────────────────────────────────────────
  document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(e.target).entries());

    const res = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      console.log('✅ Login erfolgreich');
      const category = encodeURIComponent(selectedCategoryByType[selectedType] || '');
      window.location.href = `/buyer/sold?packageId=${selectedPackage}&type=${selectedType}&category_id=${category}`;
    } else {
      alert('<%= t("offers.auth.login.failed", "Login fehlgeschlagen.") %>');
    }
  });

  // ─── Registrierung (beide Typen) ──────────────────────────────
  async function handleRegister(formEl, type) {
    if (registrationCompletedByType[type]) {
      renderCheckoutStep(type);
      setRegisterStep(type, 3);
      return;
    }

    const formData = new FormData(formEl);
    const packageId = selectedPackageByType[type] || '';
    const categoryId = selectedCategoryByType[type] || '';
    const phonePrefix = String(formData.get('phone_country_code') || '').trim();
    const phoneValue = String(formData.get('phone') || '').trim();
    formData.set('type', type);
    formData.set('packageId', packageId);
    formData.set('category_id', categoryId);

    if (!packageId) {
      alert('<%= t("offers.modal.package.required", "Bitte wählen Sie zuerst ein Paket aus.") %>');
      setRegisterStep(type, 1);
      return;
    }

    if (!categoryId) {
      alert('<%= t("offers.modal.category.required", "Bitte wählen Sie zuerst eine Kategorie aus.") %>');
      setRegisterStep(type, 1);
      return;
    }

    if (type === 'commercial' || type === 'private') {
      if (!phonePrefix) {
        alert('<%= t("offers.auth.phone.prefix.required", "Bitte wählen Sie eine Landvorwahl aus.") %>');
        return;
      }
      if (phoneValue) {
        formData.set('phone', `${phonePrefix} ${phoneValue}`.trim());
      }
    }
    formData.delete('phone_country_code');

    selectedCategoryByType[type] = categoryId;

    if (type === 'commercial') {
      const vatState = vatCheckStateByType.commercial;
      const normalizedCurrentVat = normalizeVatIdClient(formData.get('vatid'));
      const countryIdCurrent = String(formData.get('country_id') || '').trim();
      const companyCurrent = String(formData.get('company') || '').trim();
      const needsAutoCheck = !vatState.checked
        || vatState.normalizedVatId !== normalizedCurrentVat
        || vatState.countryId !== countryIdCurrent
        || vatState.companyName !== companyCurrent;
      if (needsAutoCheck) {
        await performCommercialVatCheck({ silent: false, force: true });
      }
    }

    try {
      const res = await fetch('/auth/oofers/regsiter-and-pay', {
        method: 'POST',
        body: formData
      });
      const result = await res.json().catch(() => ({}));

      if (res.ok && result.success) {
        registrationCompletedByType[type] = true;
        checkoutStateByType[type] = {
          originalNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
          currentNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
          discountPercent: 0,
          discountAmount: 0,
          vatValidation: type === 'commercial' ? (result.vatValidation || 'none') : 'none',
          vatReason: type === 'commercial' ? (result.reason || 'none') : 'none'
        };
        renderCheckoutStep(type);
        setRegisterStep(type, 3);
        return;
      }
      else {
              alert('<%= t("offers.auth.register.failed", "Registrierung fehlgeschlagen: ") %>' + (result.error || '<%= t("offers.auth.unknown_error", "Unbekannter Fehler.") %>'));
            }
          } catch (err) {
            alert('<%= t("offers.auth.server_error", "Serverfehler bei Registrierung: ") %>' + err.message);
          }
        }

  document.getElementById('formCommercial')?.addEventListener('submit', e => {
    e.preventDefault();
    handleRegister(e.target, 'commercial');
  });

  document.getElementById('formPrivate')?.addEventListener('submit', e => {
    e.preventDefault();
    handleRegister(e.target, 'private');
  });

  (() => {
    const { form, vatInput, companyInput, countrySelect, checkBtn } = getCommercialVatElements();
    if (!form || !vatInput || !countrySelect || !checkBtn) return;

    checkBtn.addEventListener('click', () => {
      performCommercialVatCheck({ silent: false, force: true });
    });

    const markVatCheckDirty = () => {
      vatCheckStateByType.commercial.checked = false;
      vatCheckStateByType.commercial.companyName = String(companyInput?.value || '').trim();
      checkoutStateByType.commercial.vatValidation = 'none';
      checkoutStateByType.commercial.vatReason = 'none';
      if (String(vatInput.value || '').trim()) {
        renderCommercialVatInfo('<%= t("offers.uid.prompt_check_or_continue", { fallback: "Bitte CHECK UID ausführen oder einfach fortfahren (Auto-Check)." }) %>', 'muted');
      } else {
        renderCommercialVatInfo('', 'muted');
      }
    };

    vatInput.addEventListener('input', markVatCheckDirty);
    companyInput?.addEventListener('input', markVatCheckDirty);
    countrySelect.addEventListener('change', markVatCheckDirty);
  })();

  document.querySelectorAll('.next-to-form').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      if (!selectedPackageByType[type]) {
        alert('<%= t("offers.modal.package.required", "Bitte wählen Sie zuerst ein Paket aus.") %>');
        return;
      }
      if (!selectedCategoryByType[type]) {
        alert('<%= t("offers.modal.category.required", "Bitte wählen Sie zuerst eine Kategorie aus.") %>');
        return;
      }
      authChoiceContextType = type;
      showAuthChoice();
    });
  });

  document.querySelectorAll('.back-to-package').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      setRegisterStep(type, 1);
    });
  });

  document.querySelectorAll('.back-to-form').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      setRegisterStep(type, 2);
    });
  });

  document.querySelectorAll('.checkout-to-confirm').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      setCheckoutPanel(type, 'confirm');
      keepFlowAnchored();
    });
  });

  document.querySelectorAll('.checkout-back-to-review').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      setCheckoutPanel(type, 'review');
      keepFlowAnchored();
    });
  });

  document.querySelectorAll('.package-option-card').forEach(function(card) {
    card.addEventListener('click', function(event) {
      if (event.target.closest('select')) return;

      const type = card.dataset.packageCardType;
      const packageId = card.dataset.packageCardId;
      const categorySelect = document.getElementById(card.dataset.categorySelectId || '');
      const categoryValue = categorySelect ? categorySelect.value : '';

      selectedPackage = packageId;
      selectedType = type;
      selectedPackageByType[type] = packageId;
      selectedCategoryByType[type] = categoryValue || '';
      checkoutStateByType[type] = {
        originalNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
        currentNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
        discountPercent: 0,
        discountAmount: 0,
        vatValidation: 'none',
        vatReason: 'none'
      };

      const form = getRegisterForm(type);
      form?.querySelectorAll('.selected-package-id').forEach(function(input) {
        input.value = packageId;
      });

      markSelectedPackageCard(type, packageId);
      keepFlowAnchored();
    });
  });

  document.querySelectorAll('.package-category-select').forEach(function(selectEl) {
    selectEl.addEventListener('change', function() {
      const card = selectEl.closest('.package-option-card');
      if (!card) return;
      const type = card.dataset.packageCardType;
      const packageId = card.dataset.packageCardId;
      selectedPackageByType[type] = packageId;
      selectedCategoryByType[type] = selectEl.value || '';
      checkoutStateByType[type] = {
        originalNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
        currentNet: Number((packageCatalog[String(packageId)] || {}).price || 0),
        discountPercent: 0,
        discountAmount: 0,
        vatValidation: 'none',
        vatReason: 'none'
      };
      selectedPackage = packageId;
      selectedType = type;
      markSelectedPackageCard(type, packageId);
      keepFlowAnchored();
    });
  });

  document.querySelectorAll('.checkout-coupon-apply').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const type = btn.dataset.type;
      const state = checkoutStateByType[type];
      const input = document.querySelector('.checkout-coupon-input[data-type="' + type + '"]');
      const info = document.querySelector('.checkout-coupon-info[data-type="' + type + '"]');
      const code = String(input?.value || '').trim().toUpperCase();
      const packageId = selectedPackageByType[type];
      if (!code || !packageId) return;

      try {
        const res = await fetch('/buyer/apply-coupon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ code, packageId })
        });
        const data = await res.json().catch(() => ({}));
        if (!data.ok) {
          if (info) info.innerHTML = '<span class="text-danger">Ungültiger Rabattcode</span>';
          return;
        }
        state.discountPercent = Number(data.percent || 0);
        state.currentNet = Number(data.newNet || state.originalNet);
        state.discountAmount = Math.max(0, state.originalNet - state.currentNet);
        if (info) info.innerHTML = '<span class="text-success">Rabattcode erfolgreich angewendet</span>';
        renderCheckoutStep(type);
      } catch (err) {
        if (info) info.innerHTML = '<span class="text-danger">Rabattcode konnte nicht geprüft werden</span>';
      }
    });
  });

  document.querySelectorAll('.checkout-coupon-cancel').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const type = btn.dataset.type;
      const state = checkoutStateByType[type];
      state.currentNet = state.originalNet;
      state.discountPercent = 0;
      state.discountAmount = 0;
      const input = document.querySelector('.checkout-coupon-input[data-type="' + type + '"]');
      const info = document.querySelector('.checkout-coupon-info[data-type="' + type + '"]');
      if (input) input.value = '';
      if (info) info.innerHTML = '';
      renderCheckoutStep(type);
    });
  });

  document.querySelectorAll('.proceed-to-payment').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const type = btn.dataset.type;
      const paidCheck = document.getElementById(type + 'PaidCheck');
      if (!paidCheck || !paidCheck.checked) {
        alert('<%= t("buyer.sold.agb.required", "Bitte bestätigen Sie die AGB und Datenschutzerklärung.") %>');
        return;
      }

      const packageId = selectedPackageByType[type];
      const categoryId = selectedCategoryByType[type];
      if (!packageId || !categoryId) {
        alert('Bitte wählen Sie Paket und Kategorie erneut aus.');
        setRegisterStep(type, 1);
        return;
      }

      const state = checkoutStateByType[type];
      const submitForm = document.createElement('form');
      submitForm.method = 'POST';
      submitForm.action = '/buyer/checkout';

      const fields = {
        packageId,
        type,
        category_id: categoryId,
        checkout_source: 'angebote',
        test_angebot_disable_stripe: TEST_ANGEBOT_DISABLE_STRIPE ? '1' : '0',
        netPriceOverride: String(Number(state.currentNet || state.originalNet || 0).toFixed(2)),
        discountPercent: String(state.discountPercent || 0),
        discountAmount: String(Number(state.discountAmount || 0).toFixed(2))
      };

      Object.entries(fields).forEach(function(entry) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = entry[0];
        input.value = entry[1];
        submitForm.appendChild(input);
      });

      document.body.appendChild(submitForm);
      submitForm.submit();
    });
  });

  document.getElementById('chooseAuthLogin')?.addEventListener('click', function() {
    showLoginPane();
  });

  document.getElementById('chooseAuthRegister')?.addEventListener('click', function() {
    const targetType = authChoiceContextType || selectedType || 'commercial';
    showRegisterPane(targetType, 2, false);
  });

  document.getElementById('backToAuthChoiceFromLogin')?.addEventListener('click', function() {
    showAuthChoice();
  });

  document.getElementById('backToAuthChoiceFromRegister')?.addEventListener('click', function() {
    showAuthChoice();
  });

  authModalEl?.addEventListener('hidden.bs.modal', function() {
    authChoiceContextType = null;
    showAuthChoice();
  });

  if (isTypeRoute) {
    const firstMainSection = document.querySelector('.intro, .optimal, .carouselStepsContainer, .pricingContainer');
    if (authModalEl && firstMainSection && firstMainSection.parentNode) {
      firstMainSection.parentNode.insertBefore(authModalEl, firstMainSection);
    }
    openRegistrationModal(requestedOfferType);
    window.scrollTo({ top: 0, behavior: 'auto' });
    keepFlowAnchored();
  }

  const commercialLogoInput = document.getElementById('commercialLogoInput');
  const commercialLogoPreviewWrap = document.getElementById('commercialLogoPreviewWrap');
  const commercialLogoPreview = document.getElementById('commercialLogoPreview');
  const commercialLogoPreviewRemove = document.getElementById('commercialLogoPreviewRemove');
  let currentCommercialLogoObjectUrl = '';

  commercialLogoInput?.addEventListener('change', function() {
    const file = commercialLogoInput.files && commercialLogoInput.files[0];
    if (!file) {
      if (commercialLogoPreview) commercialLogoPreview.src = '';
      commercialLogoPreviewWrap?.classList.add('d-none');
      return;
    }

    if (currentCommercialLogoObjectUrl) {
      URL.revokeObjectURL(currentCommercialLogoObjectUrl);
      currentCommercialLogoObjectUrl = '';
    }
    if (commercialLogoPreview) {
      currentCommercialLogoObjectUrl = URL.createObjectURL(file);
      commercialLogoPreview.src = currentCommercialLogoObjectUrl;
    }
    commercialLogoPreviewWrap?.classList.remove('d-none');
  });

  commercialLogoPreviewRemove?.addEventListener('click', function() {
    if (currentCommercialLogoObjectUrl) {
      URL.revokeObjectURL(currentCommercialLogoObjectUrl);
      currentCommercialLogoObjectUrl = '';
    }
    if (commercialLogoInput) commercialLogoInput.value = '';
    if (commercialLogoPreview) commercialLogoPreview.src = '';
    commercialLogoPreviewWrap?.classList.add('d-none');
  });
</script>







<div class="modal fade" id="buyModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('offers.modal.title',{fallback:'Paket buchen'}) %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common.close',{fallback:'Schließen'}) %>"></button>
      </div>
      <form id="buyForm" action="/angebote/buchen" method="post">
        <div class="modal-body">
          <div class="container-fluid">
            <div class="row">
              <!-- linke Spalte -->
              <div class="col-md-6">
                <input type="hidden" name="package_id" id="modalPackageId">
                <div class="mb-3">
                  <label class="form-label"><%= t('offers.modal.pkg',{fallback:'Paket'}) %></label>
                  <input type="text" class="form-control" id="modalPackageName" readonly>
                </div>
                <div class="mb-3">
                  <label for="category" class="form-label"><%= t('offers.modal.category',{fallback:'Kategorie'}) %></label>
                  <select id="category" name="category_id" class="form-select" required>
                    <option value=""><%= t('offers.modal.category.placeholder',{fallback:'– bitte wählen –'}) %></option>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.id %>"><%= cat.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="buyModalCountry" class="form-label"><%= t('offers.modal.country',{fallback:'Land'}) %></label>
                  <select id="buyModalCountry" name="country_id" class="form-select" required>
                    <option value=""><%= t('offers.modal.country.placeholder',{fallback:'– bitte wählen –'}) %></option>
                    <% countries.forEach(c => { %>
                      <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                  </select>
                </div>
              
                <div class="mb-3">
                  <label for="firstname" class="form-label"><%= t('offers.modal.firstname',{fallback:'Vorname'}) %></label>
                  <input type="text" id="firstname" name="firstname" class="form-control" required>
                </div>
                <div class="mb-3">
                  <label for="lastname" class="form-label"><%= t('offers.modal.lastname',{fallback:'Nachname'}) %></label>
                  <input type="text" id="lastname" name="lastname" class="form-control" required>
                </div>
              </div>
              <!-- rechte Spalte -->
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="company" class="form-label"><%= t('offers.modal.company',{fallback:'Firma'}) %></label>
                  <input type="text" id="company" name="company" class="form-control">
                </div>
                <div class="mb-3">
                  <label for="vatid" class="form-label"><%= t('offers.modal.vatid',{fallback:'USt-ID'}) %></label>
                  <input type="text" id="vatid" name="vatid" class="form-control">
                </div>
                <div class="mb-3">
                  <label for="street" class="form-label"><%= t('offers.modal.street',{fallback:'Straße'}) %> *</label>
                  <input type="text" id="street" name="street" class="form-control" required>
                </div>
                <div class="mb-3">
                  <label for="housenumber" class="form-label"><%= t('offers.modal.housenumber',{fallback:'Hausnummer'}) %> *</label>
                  <input type="text" id="housenumber" name="housenumber" class="form-control" required>
                </div>
                <div class="row">
                  <div class="col-6 mb-3">
                    <label for="postcode" class="form-label"><%= t('offers.modal.postcode',{fallback:'PLZ'}) %> *</label>
                    <input type="text" id="postcode" name="postcode" class="form-control" required>
                  </div>
                  <div class="col-6 mb-3">
                    <label for="buyModalCity" class="form-label"><%= t('offers.modal.city',{fallback:'Stadt'}) %> *</label>
                    <input type="text" id="buyModalCity" name="city" class="form-control" required>
                  </div>
                </div>
                <div class="mb-3">
                  <label for="phone" class="form-label"><%= t('offers.modal.phone',{fallback:'Telefon'}) %></label>
                  <input type="tel" id="phone" name="phone" class="form-control">
                </div>
                <div class="mb-3">
                  <label for="email" class="form-label"><%= t('offers.modal.email',{fallback:'E-Mail'}) %> *</label>
                  <input type="email" id="email" name="email" class="form-control" required>
                </div>
              </div>
            </div> 
          </div> 
        </div> 
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel',{fallback:'Abbrechen'}) %></button>
          <button type="submit" class="btn btn-primary"><%= t('common.book',{fallback:'Buchen'}) %></button>
        </div>
      </form>
    </div>
  </div>
</div>


<%- include('../../partials/footer') %>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('buyModal');
  modal.addEventListener('show.bs.modal', event => {
    const button = event.relatedTarget;
    document.getElementById('modalPackageId').value = button.getAttribute('data-pkg-id');
    document.getElementById('modalPackageName').value = button.getAttribute('data-pkg-name');
  });
});
</script>


<script>
  const wrapperMenu = document.querySelector('.wrapper-menu');
  const navbarCollapse = document.querySelector('#navbarNav');
  wrapperMenu?.addEventListener('click', function () {
    wrapperMenu.classList.toggle('open');
    navbarCollapse?.classList.toggle('show');
  });

  // Modal füllen
  document.getElementById('buyModal')?.addEventListener('show.bs.modal', event => {
    const btn = event.relatedTarget;
    document.getElementById('modalPackageId').value   = btn.dataset.pkgId;
    document.getElementById('modalPackageName').value = btn.dataset.pkgName;
  });
</script>



</body>
</html>

<div class="<%= isTypeRoute ? 'container my-4' : 'modal fade' %>" id="authModal" tabindex="-1" aria-hidden="<%= isTypeRoute ? 'false' : 'true' %>">
  <div class="modal-dialog auth-modal-dialog <%= isTypeRoute ? '' : 'modal-dialog-centered' %>">
    <div class="modal-content shadow">
      <!--<div class="modal-header bg-dark text-white">
        <h5 class="modal-title"><%= t('offers.auth.modal.title', { fallback: 'Registrierung / Login' }) %></h5>
        <% if (!isTypeRoute) { %>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        <% } %>
      </div>-->

      <div class="modal-body p-4">
        <!-- Tabs (intern, ausgeblendet) -->
        <ul class="nav nav-tabs mb-3 d-none" id="authTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button">
              <%= t('offers.auth.tab.login', { fallback: 'Login' }) %>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="register-tab" data-bs-toggle="tab" data-bs-target="#register" type="button">
              <%= t('offers.auth.tab.register', { fallback: 'Registrieren' }) %>
            </button>
          </li>
        </ul>

        <div id="authEntryStep">
          <div class="registration-step-card mb-3">
            <span class="registration-step-badge">Start</span>
            <h6 class="mb-2"><%= t('offers.auth.start.title', 'Wie möchten Sie fortfahren?') %></h6>
            <p class="mb-0 text-muted"><%= t('offers.auth.start.subtitle', 'Wählen Sie Login oder neue Registrierung.') %></p>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <button type="button" class="auth-choice-card w-100" id="chooseAuthLogin">

<% const renderCards = (list) => { %>

  <% if (!list.length) { %>
      <%= t('buyer.history.noresults', 'Keine Inserate gefunden') %>
    <% return; %>
  <% } %>

  <div class="listing-cards">
    <div class="row g-4">

    <% list.forEach(item => { %>

      <div class="col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm border-0 position-relative">

          <% if (item.hasPlacement) { %>
            <div style="
              position:absolute;top:10px;left:10px;
              background:#1A253C;color:#fff;
              padding:6px 12px;border-radius:12px;
              font-weight:600;font-size:0.9rem;">
              ⭐ <%= t('buyer.history.card.featured','Anzeige aktiv') %>
            </div>
          <% } %>

          <img src="<%= item.imageUrl %>" class="card-img-top rounded-top img" alt="">

          <div class="card-body">

            <h6 class="card-title fw-semibold text-truncate">
              <%= item.translatedTitle || item.name || item.title || t('buyer.history.card.unnamed', 'Unbenanntes Inserat') %>
            </h6>

            <p class="small mb-1 text-muted">
              <%= entityLabel(item.entityRoute) %> • <%= t('buyer.history.card.id', 'ID') %>: <%= item.id %>
            </p>

            <% if (item.placementEndDate) { %>
              <p class="small text-success"> <%= t('buyer.history.card.until', 'Bis') %> <%= new Date(item.placementEndDate).toLocaleDateString(_locale) %></p>
            <% } %>

            <span><b><%= new Intl.NumberFormat(_locale, { 
              minimumFractionDigits: 2, 
              maximumFractionDigits: 2 
            }).format(item.price) %> <%- item.currency %></b></span>

            <div class="listing-action-buttons d-flex gap-2 mt-2">

              <% if (activeTab !== 'review') { %>
                <a href="/buyer/edit-listing/<%= item.id %>"
                  class="btn btn-primary"
                  title="<%= t('buyer.history.edit', 'Bearbeiten') %>"
                  aria-label="<%= t('buyer.history.edit', 'Bearbeiten') %>"
                  style="background:#1A253C;">
                  <i class="bi bi-pencil text-white"></i>
                  <span class="listing-action-text text-white"><%= t('buyer.history.edit', 'Bearbeiten') %></span>
                </a>

                <form method="POST" action="/buyer/delete-listing/<%= item.id %>"
                      onsubmit="return confirm('<%= t('buyer.history.confirm.delete','Möchtest du dieses Inserat wirklich löschen?').replace(/'/g, '\\\'') %>')">
                  <button type="submit"
                      class="btn btn-primary"
                      title="<%= t('buyer.history.btn.delete', 'Löschen') %>"
                      aria-label="<%= t('buyer.history.btn.delete', 'Löschen') %>"
                          style="background:#1A253C;">
                    <i class="bi bi-trash text-white"></i>
                    <span class="listing-action-text text-white"><%= t('buyer.history.btn.delete', 'Löschen') %></span>
                  </button>
                </form>

                <% if (activeTab === 'drafts') { %>
                  <%
                    const submitCatId = Number(
                      (submitOnlineCategoryIdByRoute && submitOnlineCategoryIdByRoute[String(item.entityRoute || '').toLowerCase()]) || 0
                    );
                    const submitSlotsLeft = Number(
                      (submitOnlineRemainingByCategory && submitOnlineRemainingByCategory[submitCatId]) || 0
                    );
                  %>
                  <% if (submitCatId && submitSlotsLeft > 0) { %>
                    <form method="POST" action="/buyer/submit-online"
                          onsubmit="return confirm('<%= t('buyer.history.confirm.submit_review_now','Möchtest du dieses Inserat jetzt zur Prüfung einreichen?').replace(/'/g, '\\\'') %>')">
                      <input type="hidden" name="items" value="<%= item.entityRoute %>:<%= item.id %>:<%= submitCatId %>">
                      <button type="submit"
                          class="btn btn-primary"
                          title="<%= t('buyer.history.btn.publish_now', 'Jetzt veröffentlichen') %>"
                          aria-label="<%= t('buyer.history.btn.publish_now', 'Jetzt veröffentlichen') %>"
                          style="background:#1A253C;">
                        <i class="bi bi-send-check text-white"></i>
                        <span class="listing-action-text text-white"><%= t('buyer.history.btn.publish_now', 'Jetzt veröffentlichen') %></span>
                      </button>
                    </form>
                  <% } %>
                <% } %>
              <% } %>


              <% if (item.status == 3 && item.visible == 1) { %>

                <a href="/buyer/upgrade/<%= item.id %>"
                  class="btn btn-primary"
                  title="<%= t('buyer.history.btn.upgrade', 'Upgrade') %>"
                  aria-label="<%= t('buyer.history.btn.upgrade', 'Upgrade') %>"
                  style="background:#1A253C;">
                  <i class="bi bi-bar-chart-line text-white"></i>
                  <span class="listing-action-text text-white"><%= t('buyer.history.btn.upgrade', 'Upgrade') %></span>
                </a>

                <form method="POST" action="/buyer/toggle-listing/<%= item.id %>"
                      onsubmit="return confirm('<%= t('buyer.history.confirm.deactivate','Möchtest du dieses Inserat wirklich deaktivieren?').replace(/'/g, '\\\'') %>')">
                  <input type="hidden" name="target" value="deactivate">
                  <input type="hidden" name="return_tab" value="deactivate">
                  <button type="submit"
                      class="btn btn-primary"
                      title="<%= t('buyer.history.btn.deactivate', 'Deaktivieren') %>"
                      aria-label="<%= t('buyer.history.btn.deactivate', 'Deaktivieren') %>"
                      style="background:#1A253C;">
                    <i class="bi bi-stop-circle text-white"></i>
                    <span class="listing-action-text text-white"><%= t('buyer.history.btn.deactivate', 'Deaktivieren') %></span>
                  </button>
                </form>

              <% } %>

              <% if (item.status == 3 && item.visible == 0) { %>
                <form method="POST" action="/buyer/toggle-listing/<%= item.id %>"
                      onsubmit="return confirm('<%= t('buyer.history.confirm.resume','Möchtest du dieses Inserat wieder online stellen?').replace(/'/g, '\\\'') %>')">
                  <input type="hidden" name="target" value="online">
                  <input type="hidden" name="return_tab" value="online">
                  <button type="submit"
                      class="btn btn-primary"
                      title="<%= t('buyer.history.btn.resume', 'Online stellen') %>"
                      aria-label="<%= t('buyer.history.btn.resume', 'Online stellen') %>"
                      style="background:#1A253C;">
                    <i class="bi bi-play-circle text-white"></i>
                    <span class="listing-action-text text-white"><%= t('buyer.history.btn.resume', 'Online stellen') %></span>
                  </button>
                </form>

                <form method="POST" action="/buyer/toggle-listing/<%= item.id %>"
                      onsubmit="return confirm('<%= t('buyer.history.confirm.deactivate','Möchtest du dieses Inserat wirklich deaktivieren?').replace(/'/g, '\\\'') %>')">
                  <input type="hidden" name="target" value="deactivate">
                  <input type="hidden" name="return_tab" value="deactivate">
                  <button type="submit"
                      class="btn btn-primary"
                      title="<%= t('buyer.history.btn.deactivate', 'Deaktivieren') %>"
                      aria-label="<%= t('buyer.history.btn.deactivate', 'Deaktivieren') %>"
                      style="background:#1A253C;">
                    <i class="bi bi-stop-circle text-white"></i>
                    <span class="listing-action-text text-white"><%= t('buyer.history.btn.deactivate', 'Deaktivieren') %></span>
                  </button>
                </form>
              <% } %>

              <% if (item.status == 4 && (item.visible == 0 || item.visible == 2)) { %>
                <form method="POST" action="/buyer/toggle-listing/<%= item.id %>"
                      onsubmit="return confirm('<%= (item.visible == 2 ? t('buyer.history.confirm.to_paused','Möchtest du dieses Inserat zurück zu Angehalten verschieben?') : t('buyer.history.confirm.resume','Möchtest du dieses Inserat wieder online stellen?')).replace(/'/g, '\\\'') %>')">
                  <input type="hidden" name="target" value="<%= item.visible == 2 ? 'paused' : 'online' %>">
                  <input type="hidden" name="return_tab" value="<%= item.visible == 2 ? 'paused' : 'online' %>">
                  <button type="submit"
                      class="btn btn-primary"
                      title="<%= item.visible == 2 ? t('buyer.history.btn.to_paused', 'Zu Angehalten') : t('buyer.history.btn.resume', 'Online stellen') %>"
                      aria-label="<%= item.visible == 2 ? t('buyer.history.btn.to_paused', 'Zu Angehalten') : t('buyer.history.btn.resume', 'Online stellen') %>"
                      style="background:#1A253C;">
                    <i class="bi <%= item.visible == 2 ? 'bi-arrow-counterclockwise' : 'bi-play-circle' %> text-white"></i>
                    <span class="listing-action-text text-white"><%= item.visible == 2 ? t('buyer.history.btn.to_paused', 'Zu Angehalten') : t('buyer.history.btn.resume', 'Online stellen') %></span>
                  </button>
                </form>
              <% } %>

            </div>

          </div>
        </div>
      </div>

    <% }) %>

    </div>
  </div>

<% } %>


<div class="tab-content">

  <div class="tab-pane fade show active">
    <% if (activeTab === "online") renderCards(onlineListings) %>
    <% if (activeTab === "drafts") { %>
      <% renderCards(offlineListings) %>
      <%
        const draftsNoSlotRoutes = Array.from(new Set(
          (offlineListings || [])
            .map(item => String(item.entityRoute || '').toLowerCase())
            .filter(route => {
              const catId = Number((submitOnlineCategoryIdByRoute && submitOnlineCategoryIdByRoute[route]) || 0);
              if (!catId) return false;
              const slots = Number((submitOnlineRemainingByCategory && submitOnlineRemainingByCategory[catId]) || 0);
              return slots <= 0;
            })
        ));
      %>
      <% if (draftsNoSlotRoutes.length > 0) { %>
        <div class="alert alert-warning mt-3">
          <div class="fw-semibold mb-1">
            <%= t('buyer.history.no_slots_notice_title', 'Für folgende Kategorien sind aktuell keine freien Slots mehr verfügbar:') %>
          </div>
          <div class="mb-2">
            <span style="font-size: 24px;"><b><%= draftsNoSlotRoutes.map(r => entityLabel(r)).join(', ') %></b></span>
          </div>
          <div>
            <a href="/buyer/sold" class="tiny-link"><%= t('buyer.history.buy_more_slots', 'Weitere Slots kaufen') %></a>
            <span> <%= t('buyer.history.or', 'oder') %> </span>
            <a href="/contact" class="tiny-link"><%= t('buyer.history.contact_support', 'Support kontaktieren') %></a>
          </div>
        </div>
      <% } %>
    <% } %>
    <% if (activeTab === "review") renderCards(reviewListings) %>
    <% if (activeTab === "paused") renderCards(pausedListings) %>
    <% if (activeTab === "deactivate") renderCards(deactivateListings) %>
    <% if (activeTab === "deleted") renderCards(deletedListings) %>
    <% if (activeTab === "expired") renderCards(expiredListings) %>
  </div>

</div>
    </div>
  </div>

<%- include('../../partials/footer') %>

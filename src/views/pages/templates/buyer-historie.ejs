<%- include('../../partials/header') %>
<%
  const _langRaw = (typeof lang !== 'undefined' && lang) ? String(lang) : 'de';
  const _lang = _langRaw.includes('-') ? _langRaw.split('-')[0] : _langRaw;
  const _localeMap = {
    de:'de-DE', en:'en-US', fr:'fr-FR', it:'it-IT', tr:'tr-TR', ja:'ja-JP',
    cs:'cs-CZ', ru:'ru-RU', es:'es-ES', nl:'nl-NL', pl:'pl-PL'
  };
  const _locale = _localeMap[_lang] || 'de-DE';
  const _entityLabelFallbacks = {
    properties: 'Immobilien',
    cars: 'Autos',
    watches: 'Uhren',
    yachts: 'Yachten',
    lifestyles: 'Lifestyle'
  };
  const entityLabel = (route) => {
    const key = String(route || '').toLowerCase();
    if (!key) return t('buyer.history.card.category_unknown', 'Kategorie');
    return t(`global.category.${key}`, _entityLabelFallbacks[key] || key);
  };
%>
<link rel="stylesheet" href="/css/buyer.css">
</head>
<style>
  .navi-links{
    color: #1A253C !important; 
  }

  .btn-danger{
  --bs-btn-border-color: transparent !important;
  --bs-btn-border-color: transparent !important;
  --bs-btn-hover-border-color: transparent !important;
  --bs-btn-active-border-color: transparent !important;
  --bs-btn-disabled-border-color: transparent !important;
  }

  .btn-primary:hover{
    border-color: transparent !important;
  }

  .btn-outline-dark:hover{
    border-color: transparent !important;
  }

  .listing-action-buttons .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .listing-action-text {
    display: none;
  }

  @media (max-width: 767.98px) {
    .listing-action-buttons {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px !important;
    }

    .listing-action-buttons > a,
    .listing-action-buttons > form {
      width: 100%;
      margin: 0;
    }

    .listing-action-buttons .btn {
      width: 100%;
    }

    .listing-action-text {
      display: inline;
    }
  }

</style>
<body>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div class="alert alert-danger alert-dismissible fade show position-fixed top-50 start-50 translate-middle" role="alert" style="z-index:1050;min-width:300px;">
    <%= errorMessage %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('global.close', 'Schließen') %>"></button>
  </div>
<% } %>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="alert alert-success alert-dismissible fade show position-fixed top-50 start-50 translate-middle" role="alert" style="z-index:1050;min-width:300px;">
    <%= successMessage %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('global.close', 'Schließen') %>"></button>
  </div>
<% } %>


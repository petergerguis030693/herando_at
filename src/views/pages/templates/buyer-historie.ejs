	        <button class="btn btn-dark px-4" aria-label="<%= t('buyer.history.filter.apply') %>"><%= t('buyer.history.filter.apply') %></button>

        <a href="/buyer/historie?tab=<%= activeTab %>" class="btn btn-outline-secondary">
          <%= t('buyer.history.filter.reset') %>
        </a>
      </div>

    </div>

</form>

<script>

          data-bs-toggle="list"
          data-bs-target="#pane-price"
          type="button"
          role="tab"
          aria-controls="pane-price"
        >
          Preis
        </button>
        <button
          class="list-group-item list-group-item-action"
          id="tab-year"
          data-bs-toggle="list"
          data-bs-target="#pane-year"
          type="button"
          role="tab"
          aria-controls="pane-year"
        >
          Jahr
        </button>
        <% if (currentEntity.route === 'properties') { %>
          <button
            class="list-group-item list-group-item-action"
            id="tab-propertytype"
            data-bs-toggle="list"
            data-bs-target="#pane-propertytype"
            type="button"
            role="tab"
            aria-controls="pane-propertytype"
          >
            Immobilientyp
          </button>
        <% } %>
        <button
          class="list-group-item list-group-item-action"
          id="tab-location"
          data-bs-toggle="list"
          data-bs-target="#pane-location"
          type="button"
          role="tab"
          aria-controls="pane-location"
        >
          Standort
        </button>
      </nav>
    </div>

    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Rechte Spalte: Tab-Panes -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <div class="col-md-9">
      <div class="tab-content">

        <% if (currentEntity.route !== 'properties') { %>
          <!-- ========================== -->
          <!-- 1) MARKEN-PANE -->
          <!-- ========================== -->
          <div

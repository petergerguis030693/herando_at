            </div>
            <div
              class="row row-cols-2 row-cols-md-3 g-2"
              style="max-height: 400px; overflow-y: auto;"
            >
              <% filters.brands.forEach(brand => { %>
                <div class="col">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="filter[brand]"
                      id="brand-<%= brand.id %>"
                      value="<%= brand.id %>"
                      <%= selectedFilters.brandIds.includes(brand.id.toString()) ? 'checked' : '' %>
                    />
                    <label
                      class="form-check-label"
                      for="brand-<%= brand.id %>"
                    >
                      <%= brand.name %>
                    </label>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- ========================== -->
          <!-- 2) MODELL-PANE -->
          <!-- ========================== -->
          <div
            class="tab-pane fade"
            id="pane-model"
            role="tabpanel"
            aria-labelledby="tab-model"
          >
            <div class="mb-3">
              <input
                type="text"
                class="form-control"
                id="searchModel"
                placeholder="Suche nach Modell"
              />
            </div>
            <div
              class="row row-cols-2 row-cols-md-3 g-2"
              style="max-height: 400px; overflow-y: auto;"
            >
              <% filters.models.forEach(model => { %>
                <div class="col">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      name="filter[model]"
                      id="model-<%= model.id %>"
                      value="<%= model.id %>"
                      <%= selectedFilters.modelIds.includes(model.id.toString()) ? 'checked' : '' %>
                    />
                    <label
                      class="form-check-label"
                      for="model-<%= model.id %>"
                    >
                      <%= model.name %>
                    </label>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- ========================== -->
        <!-- 3) PREIS-PANE -->
        <!-- ========================== -->
        <div
          class="tab-pane fade <%= currentEntity.route === 'properties' ? 'show active' : '' %>"
          id="pane-price"
          role="tabpanel"
          aria-labelledby="tab-price"
        >
          <div class="row g-2">
            <div class="col-6">
              <label for="priceMin" class="form-label">Min €</label>
              <input
                type="number"
                class="form-control"
                id="priceMin"
                name="filter[priceMin]"
                placeholder="0"
                value="<%= selectedFilters.priceMin !== null ? selectedFilters.priceMin : '' %>"
              />
            </div>
            <div class="col-6">
              <label for="priceMax" class="form-label">Max €</label>
              <input
                type="number"
                class="form-control"
                id="priceMax"
                name="filter[priceMax]"
                placeholder="10.000+"
                value="<%= selectedFilters.priceMax !== null ? selectedFilters.priceMax : '' %>"
              />
            </div>
          </div>
        </div>

        <!-- ========================== -->
        <!-- 4) JAHR-PANE -->
        <!-- ========================== -->
        <div
          class="tab-pane fade"
          id="pane-year"
          role="tabpanel"
          aria-labelledby="tab-year"
        >
          <div class="row g-2">
            <div class="col-6">
              <label for="yearMin" class="form-label">Min Jahr</label>
              <select
                class="form-select"
                id="yearMin"
                name="filter[yearMin]"
              >
                <option value="">Alle Jahre</option>
                <% if (filters.years && Array.isArray(filters.years)) { %>
                  <% filters.years.forEach(y => { %>
                    <option
                      value="<%= y.year %>"
                      <%= String(y.year) === String(selectedFilters.yearMin) ? 'selected' : '' %>
                    >
                      <%= y.year %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>
            <div class="col-6">
              <label for="yearMax" class="form-label">Max Jahr</label>
              <select
                class="form-select"
                id="yearMax"
                name="filter[yearMax]"
              >
                <option value="">Alle Jahre</option>
                <% if (filters.years && Array.isArray(filters.years)) { %>
                  <% filters.years.forEach(y => { %>
                    <option
                      value="<%= y.year %>"
                      <%= String(y.year) === String(selectedFilters.yearMax) ? 'selected' : '' %>
                    >
                      <%= y.year %>
                    </option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>
        </div>

        <!-- ========================== -->
        <!-- 5) IMMOBILIENTYP-PANE (nur wenn properties) -->
        <!-- ========================== -->
        <% if (currentEntity.route === 'properties') { %>
          <div
            class="tab-pane fade"
            id="pane-propertytype"
            role="tabpanel"
            aria-labelledby="tab-propertytype"
          >
            <div class="mb-3">
              <input
                type="text"
                class="form-control"
                id="searchPropertytype"
                placeholder="Suche nach Immobilientyp"
              />
            </div>
            <div
              class="row row-cols-2 row-cols-md-3 g-2"
              style="max-height: 400px; overflow-y: auto;"
            >
              <% if (filters.propertytypes && Array.isArray(filters.propertytypes)) { %>
                <% filters.propertytypes.forEach(pt => { %>
                  <div class="col">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        name="filter[propertytype]"
                        id="propType-<%= pt.id %>"
                        value="<%= pt.id %>"
                        <%= Array.isArray(selectedFilters.propertytypes) && selectedFilters.propertytypes.includes(pt.id.toString()) ? 'checked' : '' %>
                      />
                      <label class="form-check-label" for="propType-<%= pt.id %>">
                        <%= pt.name %>
                      </label>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        <% } %>


        <!-- ========================== -->
        <!-- 6) STANDORT-PANE -->
        <!-- ========================== -->
        <div
          class="tab-pane fade"
          id="pane-location"
          role="tabpanel"
          aria-labelledby="tab-location"
        >
          <div class="mb-3">
            <label for="searchLocation" class="form-label">Stadt oder Land</label>
            <input
              type="text"
              class="form-control"
              id="searchLocation"
              name="filter[location]"
              placeholder="z. B. Berlin"
              value="<%= selectedFilters.location || '' %>"
            />
          </div>

          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="filter[inEurope]"
              id="inEurope"
              value="true"
              <%= selectedFilters.inEurope ? 'checked' : '' %>
            />
            <label class="form-check-label" for="inEurope">
              Europa
            </label>
          </div>

          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="filter[inEU]"
              id="inEU"
              value="true"
              <%= selectedFilters.inEU ? 'checked' : '' %>
            />
            <label class="form-check-label" for="inEU">
              Europäische Union
            </label>
          </div>

          <div class="form-check">
            <input
              class="form-check-input"
              type="checkbox"
              name="filter[inGermany]"
              id="inGermany"
              value="true"
              <%= selectedFilters.inGermany ? 'checked' : '' %>
            />
            <label class="form-check-label" for="inGermany">
              Deutschland
            </label>
          </div>

          <hr />

          <div class="mb-3">
            <label for="countrySelect" class="form-label">Land (präzise)</label>
            <select
              class="form-select"
              id="countrySelect"
              name="filter[countryId]"
            >
              <option value="">Alle Länder</option>
              <% filters.countries.forEach(c => { %>
                <option
                  value="<%= c.id %>"
                  <%= String(c.id) === String(selectedFilters.countryId) ? 'selected' : '' %>
                >
                  <%= c.name %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>

      </div> <!-- /.tab-content -->
    </div> <!-- /.col-md-9 -->
  </div> <!-- /.row -->
</div>
<!-- /.modal-body -->

<!-- FOOTER -->
<div class="modal-footer">
  <button
    type="button"
    class="btn btn-secondary"
    data-bs-dismiss="modal"
  >
    Abbrechen
  </button>
  <button type="button" class="btn btn-primary" id="applyFilters">
    Filter anwenden
  </button>
</div>


      </div> <!-- /.modal-content -->
    </div> <!-- /.modal-dialog -->
  </div>
  <!-- ===================== -->
  <!-- ENDE FILTER-MODAL -->
  <!-- ===================== -->

<%
  // ─── Funktion: req.query → URL‐Query‐String ───────────────────────
  function buildQS(queryObj) {
    const parts = [];
    for (const key in queryObj) {
      const val = queryObj[key];
      if (Array.isArray(val)) {
        val.forEach(v => {
          parts.push(`${encodeURIComponent(key)}=${encodeURIComponent(v)}`);
        });
      } else if (val !== undefined && val !== null && val !== '') {
        parts.push(`${encodeURIComponent(key)}=${encodeURIComponent(val)}`);
      }
    }
    return parts.join('&');
  }

  // Basis‐Query, z. B. "filter[brand]=3&filter[yearMin]=2018&limit=60&hp=2"
  const baseQS = buildQS(query);
%>

<section class="productWrapper container mb-5">
  <div class="productContainer">
    <div id="<%= currentEntity.route %>Grid" class="productGrid d-flex flex-wrap">
      <% items.forEach(item => {
           const pic = (item.pictures && item.pictures[0])
             ? item.pictures[0].image
             : 'placeholder.jpg';
      %>
      <div class="cardPeter mb-4 me-4">
        <div class="imageBild">
          <div class="bild">
            <img
              src="/images/<%= currentEntity.route %>/<%= item.id %>/<%= pic %>"
              alt="<%= item.title %>"
              loading="lazy"
            />
          </div>
        </div>
        <div class="informationSection pt-2">
          <div class="productInfo">
            <a href="/<%= currentEntity.route %>/<%= item.id %>/<%= encodeURIComponent(item.title) %>">
              <h5 class="mb-1"><%= item.title %></h5>
            </a>
            <p class="productPrice mb-2"><%= item.priceFormatted %></p>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Pagination mit Erhalt der Filter‐Parameter -->
<section class="paginationWrapper container d-flex justify-content-between align-items-center mb-5">
  <div class="paginationControls">
    <label for="itemsPerPage" class="me-2">Produkte pro Seite:</label>
    <select
      id="itemsPerPage"
      class="form-select w-auto"
      style="width: 100px !important;"
      onchange="
        {
          const newLimit = this.value;
          const params = new URLSearchParams('<%= baseQS %>');
          params.set('limit', newLimit);
          params.set('hp', 1);
          window.location.search = params.toString();
        }
      "
    >
      <option value="30" <%= limit === 30 ? 'selected' : '' %>>30</option>
      <option value="60" <%= limit === 60 ? 'selected' : '' %>>60</option>
      <option value="120" <%= limit === 120 ? 'selected' : '' %>>120</option>
    </select>
  </div>

  <div class="pageNavigation">
    <% if (currentPage > 1) { %>
      <a
        href="?<%= baseQS %>&hp=<%= currentPage - 1 %>&limit=<%= limit %>"
        class="paginationButton btn btn-outline-primary me-2"
      >❮</a>
    <% } else { %>
      <span class="paginationButton btn btn-outline-secondary disabled me-2">❮</span>
    <% } %>

    <span><%= currentPage %> / <%= totalPages %></span>

    <% if (currentPage < totalPages) { %>
      <a
        href="?<%= baseQS %>&hp=<%= currentPage + 1 %>&limit=<%= limit %>"
        class="paginationButton btn btn-outline-primary ms-2"
      >❯</a>
    <% } else { %>
      <span class="paginationButton btn btn-outline-secondary disabled ms-2">❯</span>
    <% } %>
  </div>
</section>



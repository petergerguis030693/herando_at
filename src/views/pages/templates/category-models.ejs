<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/product.css">

  <!-- Kategorie-Titel -->

<style>
  /* Wrapper um Section für absolute Pfeil-Positionierung */
  .product-scroller {
    position: relative;
    margin: 2rem 0; /* optional: Abstand oben/unten */
  }

  /* Der Scroll-Container selbst */
  .product-container {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    /* kein Padding hier, damit Items wirklich am Rand starten */
    -webkit-overflow-scrolling: touch;
  }
  .product-container::-webkit-scrollbar { display: none; }
  .product-container { -ms-overflow-style: none; scrollbar-width: none; }

  .product-item {
    flex: 0 0 auto;
    width: 200px;
    height: 200px;
    margin-right: 1rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .product-item img {
    width: 100%;
    height: 100px;
    object-fit: cover;
  }
  .product-item p,
  .product-item h3 {
    margin: 0;
    padding: 2px;
    font-size: 0.85rem;
    text-align: left;
    line-height: 1.2;
  }
  .product-item .price {
    margin-top: auto;
    font-weight: bold;
  }

  /* Pfeile außerhalb der Section */
  .scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    border: none;
    background: rgb(1, 6, 29);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
  }
  .scroll-btn.left  { top: 260px; right: 130px; }   /* Pfeil 20px links außerhalb */
  .scroll-btn.right { top: 260px; right: 90px; }  /* Pfeil 20px rechts außerhalb */

  .modal-content{
    width: 1200px; 
    height: 700px; 
  }

  .btn-primary {
    --bs-btn-bg: #1A253C !important;
        border:none;

  }

  .list-group-item.active {
    background-color: #1A253C !important;
        border:none;

  }

  .form-check-input:checked {
      background-color: #1A253C;
      border:none;
  }


  
</style>

<div class="product-scroller">
  <!-- Linker Pfeil, außerhalb -->
<button class="scroll-btn left d-none d-md-flex" aria-label="Scroll nach links">
  <i class="bi bi-chevron-left"></i>
</button>
<button class="scroll-btn right d-none d-md-flex" aria-label="Scroll nach rechts">
  <i class="bi bi-chevron-right"></i>
</button>

  <section class="product-container container-fluid py-4 mb-5">
    <% const randomItems = items.slice().sort(() => Math.random() - 0.5).slice(0,12);
       randomItems.forEach(item => {
         const pic = item.pictures?.[0]?.image || 'placeholder.jpg';
    %>
      <div class="product-item">
        <img src="/images/<%= currentEntity.route %>/<%= item.id %>/<%= pic %>"
             alt="<%= item.title %>">
        <p><%= item.makeName || '' %></p>
        <a href="<%= currentEntity.route %>/<%= item.id %>/<%= item.title %>"><h3><%= item.title %></h3></a>
        <p class="price"><%= item.priceFormatted %> €</p>
      </div>
    <% }) %>
  </section>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.product-container');
    const leftBtn  = document.querySelector('.scroll-btn.left');
    const rightBtn = document.querySelector('.scroll-btn.right');
    const scrollStep = 220; // etwas mehr als eine Item-Breite

    leftBtn.addEventListener('click', () => {
      container.scrollBy({ left: -scrollStep, behavior: 'smooth' });
    });
    rightBtn.addEventListener('click', () => {
      container.scrollBy({ left:  scrollStep, behavior: 'smooth' });
    });
  });
</script>






 <!-- Filter-Leiste -->
<section class="filters container mb-5">
  <button
    type="button"
    class="filter-btn btn btn-outline-secondary me-2"
    data-bs-toggle="modal"
    data-bs-target="#filterModal"
  >
    Filter (<%= totalCount %>)
  </button>

  <%
    // ─── 1) Erstelle je nach Kategorie eine kombinierte Liste ────────────
    const combined = [];
    if (currentEntity.route === 'properties') {
      // Für Immobilien: nur Immobilientypen und Länder
      if (filters.propertytypes && Array.isArray(filters.propertytypes)) {
        filters.propertytypes.forEach(pt => {
          combined.push({ type: 'propertytype', id: pt.id, name: pt.name });
        });
      }
      if (filters.countries && Array.isArray(filters.countries)) {
        filters.countries.forEach(c => {
          combined.push({ type: 'countryId', id: c.id, name: c.name });
        });
      }
    } else {
      // Für alle anderen: Marken, Modelle und Länder
      if (filters.brands && Array.isArray(filters.brands)) {
        filters.brands.forEach(b => {
          combined.push({ type: 'brand', id: b.id, name: b.name });
        });
      }
      if (filters.models && Array.isArray(filters.models)) {
        filters.models.forEach(m => {
          combined.push({ type: 'model', id: m.id, name: m.name });
        });
      }
      if (filters.countries && Array.isArray(filters.countries)) {
        filters.countries.forEach(c => {
          combined.push({ type: 'countryId', id: c.id, name: c.name });
        });
      }
    }

    // ─── 2) Mische die kombinierte Liste und wähle die ersten 8 Elemente ─
    const randomBtns = combined.sort(() => Math.random() - 0.5).slice(0, 8);

    // ─── 3) QS ohne alle "filter[...]"-Parameter für RESET ───────────────
    const resetQS = new URLSearchParams(query);
    for (const key of Object.keys(query)) {
      if (key.startsWith('filter[')) {
        resetQS.delete(key);
      }
    }
    resetQS.set('hp', 1);
  %>


  <!-- RESET-Button -->
  <button
    type="button"
    class="btn btn-outline-secondary me-1"
    onclick="window.location.search = '<%= resetQS.toString() %>'"
  >
    RESET
  </button>

  <!-- Acht zufällige Filter-Buttons -->
  <% randomBtns.forEach(btn => {
       const qs = new URLSearchParams(query);
       qs.set(`filter[${btn.type}]`, btn.id);
       qs.set('hp', 1);
  %>
    <button
      type="button"
      class="btn btn-light me-1"
      onclick="window.location.search = '<%= qs.toString() %>'"
    >
      <%= btn.name %>
    </button>
  <% }) %>
</section>



  <div
    class="modal fade"
    id="filterModal"
    tabindex="-1"
    aria-labelledby="filterModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <!-- HEADER -->
        <div class="modal-header bg-dark-blue text-white">
          <h5 class="modal-title" id="filterModalLabel">Filter</h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Schließen"
          ></button>
        </div>

<!-- BODY -->
<div class="modal-body">
  <div class="row">
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <!-- Linke Spalte: Kategorien -->
    <!-- ──────────────────────────────────────────────────────────────────── -->
    <div class="col-md-3 pe-0">
      <nav class="list-group list-group-flush">
        <% if (currentEntity.route !== 'properties') { %>
          <button
            class="list-group-item list-group-item-action active"
            id="tab-brand"

   <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-…"
    crossorigin="anonymous"
  ></script>

  <!-- ===================== -->
  <!-- SCRIPT: Live-Suche + Filter anwenden -->
  <!-- ===================== -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
  // 1) Live-Suche Marke
  const inputBrand = document.getElementById("searchBrand");
  const brandRows = document.querySelectorAll("#pane-brand .form-check");
  if (inputBrand) {
    inputBrand.addEventListener("input", () => {
      const filterText = inputBrand.value.trim().toLowerCase();
      brandRows.forEach(row => {
        const lbl = row.querySelector("label").textContent.toLowerCase();
        row.style.display = lbl.includes(filterText) ? "block" : "none";
      });
    });
  }

  // 2) Live-Suche Modell
  const inputModel = document.getElementById("searchModel");
  const modelRows = document.querySelectorAll("#pane-model .form-check");
  if (inputModel) {
    inputModel.addEventListener("input", () => {
      const filterText = inputModel.value.trim().toLowerCase();
      modelRows.forEach(row => {
        const lbl = row.querySelector("label").textContent.toLowerCase();
        row.style.display = lbl.includes(filterText) ? "block" : "none";
      });
    });
  }

  // 3) „Filter anwenden“
  document.getElementById("applyFilters").addEventListener("click", () => {
    const params = new URLSearchParams(window.location.search);

    // ► Marken (Checkboxen)
    const checkedBrands = Array.from(
      document.querySelectorAll("#pane-brand .form-check-input:checked")
    ).map(inp => inp.value);
    params.delete("filter[brand]");
    if (checkedBrands.length) {
      checkedBrands.forEach(b => params.append("filter[brand]", b));
    }

    // ► Modelle (Checkboxen)
    const checkedModels = Array.from(
      document.querySelectorAll("#pane-model .form-check-input:checked")
    ).map(inp => inp.value);
    params.delete("filter[model]");
    if (checkedModels.length) {
      checkedModels.forEach(m => params.append("filter[model]", m));
    }

    // ► Preis
    const priceMin = document.getElementById("priceMin").value;
    const priceMax = document.getElementById("priceMax").value;
    if (priceMin !== "") {
      params.set("filter[priceMin]", priceMin);
    } else {
      params.delete("filter[priceMin]");
    }
    if (priceMax !== "") {
      params.set("filter[priceMax]", priceMax);
    } else {
      params.delete("filter[priceMax]");
    }

    // ► Jahr
    const yearMin = document.getElementById("yearMin").value;
    const yearMax = document.getElementById("yearMax").value;
    if (yearMin !== "") {
      params.set("filter[yearMin]", yearMin);
    } else {
      params.delete("filter[yearMin]");
    }
    if (yearMax !== "") {
      params.set("filter[yearMax]", yearMax);
    } else {
      params.delete("filter[yearMax]");
    }

    // ► Standort (Freitext)
    const locationText = document.getElementById("searchLocation").value.trim();
    if (locationText !== "") {
      params.set("filter[location]", locationText);
    } else {
      params.delete("filter[location]");
    }

    // ► Europa/EU/Deutschland
    ["inEurope", "inEU", "inGermany"].forEach(id => {
      const chk = document.getElementById(id);
      if (chk && chk.checked) {
        params.set(`filter[${id}]`, "true");
      } else {
        params.delete(`filter[${id}]`);
      }
    });

    // ► Exaktes Land (Dropdown)
    const countrySelect = document.getElementById("countrySelect");
    if (countrySelect) {
      const val = countrySelect.value;
      if (val) {
        params.set("filter[countryId]", val);
      } else {
        params.delete("filter[countryId]");
      }
    }

  const checkedPropTypes = Array.from(
    document.querySelectorAll("#pane-propertytype .form-check-input:checked")
  ).map(inp => inp.value);
  params.delete("filter[propertytype]");
  if (checkedPropTypes.length) {
    checkedPropTypes.forEach(pt => params.append("filter[propertytype]", pt));
  }

    // ► Seite zurücksetzen
    params.set("hp", 1);

    window.location.search = params.toString();
  });
});

  </script>
</body>
</html>

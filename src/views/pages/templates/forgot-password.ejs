<!DOCTYPE html>
<html lang="de">

<head>
  <!-- Grundlegende Meta-Tags -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- SEO: Titel & Beschreibung -->
  <title>Herando – Luxus-Autos, Yachten, Immobilien & Uhren | Kaufen & Verkaufen</title>
  <meta
    name="description"
    content="Entdecken Sie über 100.000 Premium-Angebote: Luxus-Autos, exklusive Yachten, Traum-Immobilien & Uhren bei Herando. Jetzt finden & verkaufen!"
  />
  <meta name="robots" content="index, follow" />

  <!-- Canonical -->
  <link rel="canonical" href="https://www.herando.com/" />

  <!-- hreflang für Mehrsprachigkeit -->
  <link rel="alternate" href="https://www.herando.com/" hreflang="de" />
  <link rel="alternate" href="https://www.herando.com/en/" hreflang="en" />
  <link rel="alternate" href="https://www.herando.com/es/" hreflang="es" />
  <link rel="alternate" href="https://www.herando.com/fr/" hreflang="fr" />
  <!-- x-default für alle anderen Sprachen -->
  <link rel="alternate" href="https://www.herando.com/" hreflang="x-default" />

  <!-- Open Graph & Twitter Cards -->
  <meta property="og:title" content="Herando – Luxus-Autos, Yachten, Immobilien & Uhren" />
  <meta
    property="og:description"
    content="Entdecken Sie über 100.000 Premium-Angebote: Luxus-Autos, Yachten, Immobilien & Uhren."
  />
  <meta property="og:image" content="https://www.herando.com/assets/og-image.jpg" />
  <meta property="og:url" content="https://www.herando.com/" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Herando – Luxus-Autos, Yachten, Immobilien & Uhren" />
  <meta
    name="twitter:description"
    content="Über 100.000 Premium-Angebote entdecken: Autos, Yachten, Immobilien & Uhren bei Herando."
  />
  <meta name="twitter:image" content="https://www.herando.com/assets/og-image.jpg" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Herando",
      "url": "https://www.herando.com/",
      "logo": "https://www.herando.com/assets/herando-weblogo.svg",
      "sameAs": [
        "https://www.facebook.com/Herando",
        "https://twitter.com/Herando",
        "https://www.instagram.com/Herando"
      ]
    }
  </script>

  <link rel="shortcut icon" href="/assets/herando-weblogo.svg" type="image/x-icon" />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
  />

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/magazin.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/products.css">
<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/product-single.css">
<link rel="stylesheet" href="/css/search.css">
<link rel="stylesheet" href="/css/language-modal.css">
<link rel="stylesheet" href="/css/navbar-clean.css">
<link rel="stylesheet" href="/css/ui-components.css">
<link rel="stylesheet" href="/css/mobile.css">

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

  <style>
    .input-group-text{
      background-color: transparent;
    }

    .form-check-input:checked {
    background-color: rgb(195, 144, 82);
    border-color: rgb(195, 144, 82);
    }

    a:hover {
    text-decoration: underline;
    color: rgb(195, 144, 82);
    }
  </style>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <!-- Logo -->
          <div class="text-center mb-4">
            <img 
              src="/assets/herando-weblogo.png" 
              alt="Herando Logo" 
              style="max-width:200px;width:100%;height:auto;">
          </div>

          <!-- Titel -->
          <h4 class="text-center mb-3"><%= t('forgot.heading','Passwort zurücksetzen') %></h4>
          <p class="text-center text-muted small mb-4">
            <%= t('forgot.body_line1','Geben Sie Ihre E-Mail-Adresse ein.') %><br>
            <%= t('forgot.body_line2','Sie erhalten einen Link zum Zurücksetzen Ihres Passworts.') %>
          </p>

          <!-- Meldung -->
          <div id="msg"></div>

          <!-- Formular -->
          <form id="forgotForm" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label"><%= t('forgot.email_label','E-Mail-Adresse') %></label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
                placeholder="<%= t('forgot.email_placeholder','name@beispiel.de') %>"
              />
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary">
                <%= t('forgot.submit','Reset-Link senden') %>
              </button>
            </div>

            <p class="text-center small mb-0">
              <a href="/auth/login"><%= t('forgot.back_to_login','Zurück zum Login') %></a>
            </p>
          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const email = document.getElementById('email').value.trim();
  const msg = document.getElementById('msg');

  const MSG_EMAIL_REQUIRED = <%- JSON.stringify(t('forgot.msg.email_required','Bitte E-Mail eingeben.')) %>;
  const MSG_SUCCESS = <%- JSON.stringify(t('forgot.msg.success','Falls die E-Mail existiert, wurde ein Reset-Link gesendet.')) %>;
  const MSG_SERVER_ERROR = <%- JSON.stringify(t('forgot.msg.server_error','Serverfehler.')) %>;

  msg.innerHTML = '';
  if (!email) {
    msg.innerHTML = `<div class="alert alert-danger">${MSG_EMAIL_REQUIRED}</div>`;
    return;
  }

  try {
    const res = await fetch('/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });

    const data = await res.json();

    msg.innerHTML = `<div class="alert alert-success">${MSG_SUCCESS}</div>`;

  } catch (err) {
    msg.innerHTML = `<div class="alert alert-danger">${MSG_SERVER_ERROR}</div>`;
  }
});
</script>

</body>
</html>

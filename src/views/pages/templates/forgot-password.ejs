<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title><%= t('forgot.title','Passwort vergessen – Herando') %></title>
  <meta name="robots" content="noindex, nofollow" />

  <link rel="shortcut icon" href="/assets/herando-weblogo.svg" type="image/x-icon" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/magazin.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/products.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/product-single.css">
  <link rel="stylesheet" href="/css/search.css">
  <link rel="stylesheet" href="/css/language-modal.css">
  <link rel="stylesheet" href="/css/navbar-clean.css">
  <link rel="stylesheet" href="/css/ui-components.css">
  <link rel="stylesheet" href="/css/mobile.css">
</head>

<body>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <!-- Logo -->
          <div class="text-center mb-4">
            <img 
              src="/assets/herando-weblogo.png" 
              alt="Herando Logo" 
              style="max-width:200px;width:100%;height:auto;">
          </div>

          <!-- Titel -->
          <h4 class="text-center mb-3"><%= t('forgot.heading','Passwort zurücksetzen') %></h4>
          <p class="text-center text-muted small mb-4">
            <%= t('forgot.body_line1','Geben Sie Ihre E-Mail-Adresse ein.') %><br>
            <%= t('forgot.body_line2','Sie erhalten einen Link zum Zurücksetzen Ihres Passworts.') %>
          </p>

          <!-- Meldung -->
          <div id="msg"></div>

          <!-- Formular -->
          <form id="forgotForm" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label"><%= t('forgot.email_label','E-Mail-Adresse') %></label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                required
                placeholder="<%= t('forgot.email_placeholder','name@beispiel.de') %>"
              />
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary">
                <%= t('forgot.submit','Reset-Link senden') %>
              </button>
            </div>

            <p class="text-center small mb-0">
              <a href="/auth/login"><%= t('forgot.back_to_login','Zurück zum Login') %></a>
            </p>
          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('forgotForm').addEventListener('submit', async (e) => {
  e.preventDefault();

  const email = document.getElementById('email').value.trim();
  const msg = document.getElementById('msg');

  const MSG_EMAIL_REQUIRED = <%- JSON.stringify(t('forgot.msg.email_required','Bitte E-Mail eingeben.')) %>;
  const MSG_SUCCESS = <%- JSON.stringify(t('forgot.msg.success','Falls die E-Mail existiert, wurde ein Reset-Link gesendet.')) %>;
  const MSG_SERVER_ERROR = <%- JSON.stringify(t('forgot.msg.server_error','Serverfehler.')) %>;

  msg.innerHTML = '';
  if (!email) {
    msg.innerHTML = `<div class="alert alert-danger">${MSG_EMAIL_REQUIRED}</div>`;
    return;
  }

  try {
    const res = await fetch('/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });

    const data = await res.json();

    msg.innerHTML = `<div class="alert alert-success">${MSG_SUCCESS}</div>`;

  } catch (err) {
    msg.innerHTML = `<div class="alert alert-danger">${MSG_SERVER_ERROR}</div>`;
  }
});
</script>

</body>
</html>

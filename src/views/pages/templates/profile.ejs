<div class="profile-box">
  <div class="box-header">
    <h3><%= t('buyer.profile.privacy.title') %></h3>
  </div>

  <div class="box-content">

    <p class="privacy-info">
      <%= t('buyer.profile.privacy.info') %>
    </p>

    <div class="privacy-grid" id="privacyGrid">

      <!-- Name -->
      <div class="privacy-left">
        <input type="checkbox"
              class="privacy-toggle"
              data-field="details_name_hidden"
              <%= user.details_name_hidden == 1 ? "checked" : "" %>>
        <p class="privacy-desc"><%= t('buyer.profile.privacy.name.desc') %></p>
      </div>
      <div class="privacy-right">
        <strong><%= t('buyer.profile.privacy.name.label') %></strong>
      </div>

      <!-- Telefon -->
      <div class="privacy-left">
        <input type="checkbox"
              class="privacy-toggle"
              data-field="details_phone_hidden"
              <%= user.details_phone_hidden == 1 ? "checked" : "" %>>
        <p class="privacy-desc"><%= t('buyer.profile.privacy.phone.desc') %></p>
      </div>
      <div class="privacy-right">
        <strong><%= t('buyer.profile.privacy.phone.label') %></strong>
      </div>

      <!-- E-Mail -->
      <div class="privacy-left">
        <input type="checkbox"
              class="privacy-toggle"
              data-field="details_email_hidden"
              <%= user.details_email_hidden == 1 ? "checked" : "" %>>
        <p class="privacy-desc"><%= t('buyer.profile.privacy.email.desc') %></p>
      </div>
      <div class="privacy-right">
        <strong><%= t('buyer.profile.privacy.email.label') %></strong>
      </div>

    </div>
    <script>
      document.querySelectorAll('.privacy-toggle').forEach(cb => {
        cb.addEventListener('change', async () => {
          const field = cb.dataset.field;
          const value = cb.checked ? 1 : 0;

          try {
            const res = await fetch('/api/user/privacy', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ field, value })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.message);

          } catch (err) {
            alert("<%= t('global.error.save_failed') %>");
            cb.checked = !cb.checked; // rollback
          }
        });
      });
      </script>



  </div>
</div>


  <% if (billingMissing) { %>
<%
  const _missingList = String(billingMissing || '').split(',').map(k => k.trim()).filter(Boolean);
  const _missingSet = new Set(_missingList);
  const isMissing = (key) => _missingSet.has(key);
%>
<div class="modal fade show" id="billingMissingModal" style="display:block;" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">
          <%= t('buyer.profile.billing_missing_title') %>
        </h5>
      </div>

      <div class="modal-body">
        <p><%= t('buyer.profile.billing_missing_desc') %></p>

        <% if (_missingList.length) { %>
          <ul class="small text-muted">
            <% _missingList.forEach(k => { %>
              <li><strong><%= t(k.trim()) %></strong></li>
            <% }) %>
          </ul>
        <% } %>

        <form id="billingMissingForm" method="POST" action="/buyer/profile/update">
          <input type="hidden" name="type" value="person_billing">
          <% if (pendingCheckout) { %>
            <input type="hidden" name="resumeCheckout" value="1">
          <% } %>

          <input type="hidden" name="gender" value="<%= user.gender || '' %>">
          <input type="hidden" name="phone" value="<%= user.phone || '' %>">
          <input type="hidden" name="mobile" value="<%= user.mobile || '' %>">
          <input type="hidden" name="fax" value="<%= user.fax || '' %>">
          <input type="hidden" name="website" value="<%= user.website || '' %>">
          <input type="hidden" name="imprint" value="<%= user.imprint || '' %>">

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">
                <%= t('buyer.profile.firstname') %>
                <% if (isMissing('buyer.profile.firstname')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="firstname" class="form-control" value="<%= user.firstname || '' %>" <%= isMissing('buyer.profile.firstname') ? 'required' : '' %>>
            </div>
            <div class="col-md-6">
              <label class="form-label">
                <%= t('buyer.profile.lastname') %>
                <% if (isMissing('buyer.profile.lastname')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="lastname" class="form-control" value="<%= user.lastname || '' %>" <%= isMissing('buyer.profile.lastname') ? 'required' : '' %>>
            </div>

            <div class="col-md-6">
              <label class="form-label">
                <%= t('buyer.profile.company') %>
                <% if (isMissing('buyer.profile.company')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="company" class="form-control" value="<%= user.company || '' %>" <%= isMissing('buyer.profile.company') ? 'required' : '' %>>
            </div>
            <div class="col-md-6">
              <label class="form-label">
                <%= t('buyer.profile.vat_id') %>
                <% if (isMissing('buyer.profile.vatid')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="vatid" class="form-control" value="<%= user.vatid || '' %>" <%= isMissing('buyer.profile.vatid') ? 'required' : '' %>>
            </div>

            <div class="col-md-8">
              <label class="form-label">
                <%= t('buyer.profile.street') %>
                <% if (isMissing('buyer.profile.street')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="street" class="form-control" value="<%= user.street || '' %>" <%= isMissing('buyer.profile.street') ? 'required' : '' %>>
            </div>
            <div class="col-md-4">
              <label class="form-label">
                <%= t('buyer.profile.house_number') %>
                <% if (isMissing('buyer.profile.housenumber')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="housenumber" class="form-control" value="<%= user.housenumber || '' %>" <%= isMissing('buyer.profile.housenumber') ? 'required' : '' %>>
            </div>

            <div class="col-md-4">
              <label class="form-label">
                <%= t('buyer.profile.postcode') %>
                <% if (isMissing('buyer.profile.postcode')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="postcode" class="form-control" value="<%= user.postcode || '' %>" <%= isMissing('buyer.profile.postcode') ? 'required' : '' %>>
            </div>
            <div class="col-md-4">
              <label class="form-label">
                <%= t('buyer.profile.city') %>
                <% if (isMissing('buyer.profile.city')) { %><span class="text-danger">*</span><% } %>
              </label>
              <input name="city" class="form-control" value="<%= user.city || '' %>" <%= isMissing('buyer.profile.city') ? 'required' : '' %>>
            </div>
            <div class="col-md-4">
              <label class="form-label">
                <%= t('buyer.profile.country') %>
                <% if (isMissing('buyer.profile.country')) { %><span class="text-danger">*</span><% } %>
              </label>
              <select name="country_id" class="form-select" <%= isMissing('buyer.profile.country') ? 'required' : '' %>>
                <option value="" disabled <%= !user.country_id ? 'selected' : '' %>><%= t('global.select_placeholder') %></option>
                <% countries.forEach(c => { %>
                  <option value="<%= c.id %>" <%= String(user.country_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </form>
      </div> 

      <div class="modal-footer">
        <button class="btn btn-outline-secondary" type="button" onclick="closeBillingModal()">
          <%= t('global.cancel') %>
        </button>
        <% if (pendingCheckout) { %>
          <button class="btn btn-primary" type="submit" form="billingMissingForm">
            <%= t('buyer.sold.checkout', 'Zur Kasse gehen') %>
          </button>
        <% } else { %>
          <button class="btn btn-primary" type="submit" form="billingMissingForm">
            <%= t('global.save', 'Speichern') %>
          </button>
        <% } %>
      </div>

    </div>
  </div>
</div>

<script>
function closeBillingModal(){
  document.getElementById('billingMissingModal').style.display='none';
  history.replaceState({}, '', '/buyer/profil');
}
</script>
<% } %>



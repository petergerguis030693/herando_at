<div class="profile-box">
  <div class="box-header">
    <h3><%= t('buyer.profile.packages.title') %></h3>
  </div>

  <div class="box-content">

    <% if (!activePackages || activePackages.length === 0) { %>

      <p class="text-muted"><%- t('buyer.profile.packages.none') %></p>

    <% } else { %>

      <table style="width:100%; border-collapse: collapse; margin-top:10px;">
        <thead>
          <tr style="background:#f7f7f7; text-align:left;">
            <th style="padding:8px;"><%= t('buyer.profile.packages.col_package') %></th>
            <th style="padding:8px;"><%= t('buyer.profile.packages.col_category') %></th>
            <th style="padding:8px;"><%= t('buyer.profile.packages.col_end_date') %></th>
            <th style="padding:8px;"><%= t('buyer.profile.packages.col_remaining') %></th>
            <th style="padding:8px;"><%= t('buyer.profile.packages.col_listings') %></th>
          </tr>
        </thead>

        <%
          function pkgName(pkg) {
            const key = 'buyer.package.' + pkg.package_name.toLowerCase().replace(/\s+/g, '_');
            return t(key, pkg.package_name);
          }
        %>

        <tbody>
          <% activePackages.forEach(pkg => { %>
            <tr style="border-bottom:1px solid #eee;">
              <td style="padding:8px;">
                <%= pkgName(pkg) %>
                (<%= pkg.registration_type === 'commercial' ? t('buyer.profile.packages.type_commercial') : t('buyer.profile.packages.type_private') %>)
              </td>

                <%
                  const CATEGORY_ROUTE_MAP = {
                    'autos': 'cars',
                    'immobilien': 'properties',
                    'yachten': 'yachts',
                    'lifestyle': 'lifestyles',
                    'lifestyles': 'lifestyles',
                    'uhren': 'watches'
                  };

                  function catName(pkg) {
                    const raw = (pkg.categoryName || '').toString().trim().toLowerCase();
                    const route = CATEGORY_ROUTE_MAP[raw] || raw; // Fallback: raw selbst
                    return t('global.category.' + route);
                  }
                %>

              <td style="padding:8px;">
                <%= catName(pkg) %>
              </td>


              <td style="padding:8px;">
                <%= new Date(pkg.end_date).toLocaleDateString(user.language || 'de-DE') %>
              </td>

              <td style="padding:8px;">
                <%= pkg.restDays %> <%= t('global.days') %>
              </td>

              <td style="padding:8px;">
                <%= pkg.used_listings %> / <%= pkg.max_listings %>
              </td>
            </tr>
          <% }) %>
        </tbody>

      </table>

    <% } %>

  </div>

  
</div>



<script>
document.addEventListener('DOMContentLoaded', () => {
  const faqItems = document.querySelectorAll('.faq-item');

  const packageDescriptionNodes = document.querySelectorAll('.package-description p, .package-description li, .package-description div, .package-description span');
  packageDescriptionNodes.forEach((node) => {
    const html = String(node.innerHTML || '');
    if (!html || html.includes('<br') || !html.includes('Optionale Zubuchung möglich (')) return;
    node.innerHTML = html.replace('Optionale Zubuchung möglich (', 'Optionale Zubuchung möglich <br>(');
  });

  faqItems.forEach(item => {
    const button = item.querySelector('.faq-question');
    button.addEventListener('click', () => {
      // Wenn offen → schließen
      if (item.classList.contains('active')) {
        item.classList.remove('active');
        return;
      }
      // Alle anderen schließen
      faqItems.forEach(i => i.classList.remove('active'));
      // Diesen öffnen
      item.classList.add('active');
    });
  });
});
</script>



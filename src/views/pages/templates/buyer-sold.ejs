     <%- include('../../partials/header') %>
          <link rel="stylesheet" href="/css/buyer.css">
          <style>
  .custom-faq {
    border-top: 1px solid #ddd;
  }

  .faq-item {
    border-bottom: 1px solid #ddd;
  }

  .faq-question {
    width: 100%;
    background: none;
    border: none;
    padding: 18px 0;
    font-size: 16pt;
    font-weight: 500;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    color: #111;
    transition: color 0.25s ease;
  }

  .faq-question:hover {
    color: #000;
  }

  .faq-chevron {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-right: 2px solid #000;
    border-bottom: 2px solid #000;
    transform: rotate(45deg);
    transition: transform 0.25s ease;
    margin-left: 10px;
  }

  .faq-item.active .faq-chevron {
    transform: rotate(-135deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    color: #555;
    line-height: 1.6;
    text-align: left;
    transition: all 0.35s ease;
    font-size: 16pt;
  }

  .faq-item.active .faq-answer {
    max-height: 500px;
    opacity: 1;
    margin-bottom: 15px;
  }

  .MWST-class{
    text-align: left;
    font-size: 14px;
  }

  .sechszehnpx{
    font-size: 16px;
  }

  /* Goldener Herando-Rahmen fuer Paketkarten */
  .buyer-package-card {
    border: 3px solid #c8a24e !important;
    border-radius: 12px;
  }

  .buyer-gold-divider {
    width: 100px;
    height: 1px;
    background: #c8a24e;
    margin: 10px auto;
  }

  .buyer-package-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .buyer-package-meta {
    margin-top: auto;
    border-top: 1px solid #d8d8d8;
    padding-top: 14px;
  }

  /* ===== Checkout Modal ===== */

.checkout-modal {
  max-width: 820px;
}

.checkout-modal .modal-content {
  border-radius: 18px;
  padding: 30px 35px;
  box-shadow: 0 25px 60px rgba(0,0,0,0.15);
  border: none;
}

/* Titel */
.checkout-modal h4 {
  font-size: 26px;
  font-weight: 600;
  margin-bottom: 25px;
}

/* Paketübersicht */
#packageSummary {
  background: #f8f9fb;
  padding: 18px 22px;
  border-radius: 12px;
  margin-bottom: 20px;
  border: 1px solid #e6e6e6;
}

/* Preisbox */
#priceBox, #finalSummary {
  background: #ffffff;
  border: 1px solid #eaeaea;
  border-radius: 12px;
  padding: 20px 25px;
  font-size: 17px;
}

/* Rabattbereich */
#couponInput {
  height: 46px;
  border-radius: 10px;
  font-size: 15px;
}

#applyCouponBtn,
#cancelCouponBtn {
  height: 46px;
  border-radius: 10px;
  font-weight: 600;
  min-width: 200px;
}

/* Buttons unten */
#toStep2,
#buyNowBtn {
  height: 52px;
  border-radius: 12px;
  font-size: 17px;
  font-weight: 600;
}

/* AGB Bereich */
.form-check {
  background: #f8f9fb;
  padding: 15px 18px;
  border-radius: 10px;
  border: 1px solid #e6e6e6;
}

/* Trennlinie schöner */
#priceBox hr {
  margin: 18px 0;
  border-top: 1px solid #ddd;
}

/* Scroll falls Inhalt höher */
.checkout-modal .modal-content {
  max-height: 90vh;
  overflow-y: auto;
}

/* Mobile Optimierung */
@media (max-width: 768px) {
  .checkout-modal {
    max-width: 96%;
  }

  .checkout-modal .modal-content {
    padding: 20px;
  }

  #applyCouponBtn,
  #cancelCouponBtn {
    min-width: 100px;
    font-size: 14px;
  }
}

/* ===== AGB Box ===== */

.agb-box {
  background: #f8f9fb;
  border: 1px solid #e4e6ea;
  border-radius: 12px;
  padding: 18px 20px;
}

.agb-label {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 16px;
  cursor: pointer;
  margin: 0;
}

.agb-label input[type="checkbox"] {
  width: 22px;
  height: 22px;
  accent-color: #c89b5b; /* Herando Gold */
  cursor: pointer;
}

.agb-label a {
  color: #c89b5b;
  font-weight: 600;
  text-decoration: none;
}

.agb-label a:hover {
  text-decoration: underline;
}

/* Herando Feedback Box (statt grün) */
.herando-info {
  background: #fff8ef;
  border: 1px solid #e6c9a2;
  color: #7a5a2b;
  border-radius: 10px;
  padding: 12px 16px;
  margin-top: 12px;
  font-size: 15px;
  font-weight: 500;
}

/* Step Animation */
#step1, #step2 {
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.step-hide {
  opacity: 0;
  transform: translateX(10px);
}

.step-show {
  opacity: 1;
  transform: translateX(0);
}

</style>



<%
  // Arrays absichern + Duplikate entfernen
  const _private = Array.isArray(privatePackages) ? [...new Set(privatePackages)] : [];
  const _light   = Array.isArray(commercialPackages?.LIGHT)   ? [...new Set(commercialPackages.LIGHT)]   : [];
  const _medium  = Array.isArray(commercialPackages?.MEDIUM)  ? [...new Set(commercialPackages.MEDIUM)]  : [];
  const _pro     = Array.isArray(commercialPackages?.PRO)     ? [...new Set(commercialPackages.PRO)]     : [];
  const _prem    = Array.isArray(commercialPackages?.PREMIUM) ? [...new Set(commercialPackages.PREMIUM)] : [];
  const _tEntity = (routeOrName) => {
    const value = String(routeOrName || '').trim();
    if (!value) return '';
    return t('global.category.' + value, t('category.' + value, value));
  };
  const _fmtEntities = (list) => list.map(_tEntity).filter(Boolean).join(', ');
%>


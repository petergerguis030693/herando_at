<script>
let selectedForm = null;
let selectedBtn  = null;

let originalNet = 0;
let currentNet  = 0;
let discountPercent = 0;
let discountAmount  = 0;

function money(v){ return (Math.round(v*100)/100).toFixed(2).replace('.', ',') + ' €'; }

function resetSteps() {
  step1.style.display = 'block';
  step2.style.display = 'none';
  couponInput.value = '';
  agbCheck.checked = false;
}

function renderSummary() {
  const pkgName = selectedBtn.dataset.packageName;
  const select = selectedForm.querySelector('select[name="category_id"]');
  const entityText = select.options[select.selectedIndex].text;

  const html = `
    <div style="font-size:20px;font-weight:600;margin-bottom:10px;">${TXT_MARKETING_PAKET}</div>
    <div style="font-size:18px;"><strong>${pkgName}</strong></div>
    <div style="color:#666;">${TXT_CATEGORY}: <strong>${entityText}</strong></div>
  `;

  packageSummary.innerHTML = html;
  finalSummary.innerHTML = html + '<hr>' + priceBox.innerHTML;
}

function renderPrices() {
  const tax = currentNet * 0.21;
  const gross = currentNet + tax;

  let discountRow = '';
  if (discountPercent > 0) {
    discountRow = `
      <div class="d-flex justify-content-between text-danger">
        <div>${TXT_DISCOUNT} (${discountPercent}%)</div>
        <div>- ${money(discountAmount)}</div>
      </div>
      <div class="d-flex justify-content-between">
        <div>${TXT_NEW_SUBTOTAL}</div>
        <div><strong>${money(currentNet)}</strong></div>
      </div>
    `;
  }

  priceBox.innerHTML = `
    <div class="d-flex justify-content-between">
      <div>${TXT_SUBTOTAL}</div>
      <div><strong>${money(originalNet)}</strong></div>
    </div>
    ${discountRow}
    <div class="d-flex justify-content-between">
      <div>${TXT_TAX_LABEL}</div>
      <div><strong>${money(tax)}</strong></div>
    </div>
    <hr>
    <div class="d-flex justify-content-between fs-5">
      <div><strong>${TXT_TOTAL}</strong></div>
      <div><strong>${money(gross)}</strong></div>
    </div>
  `;

  renderSummary();
}

// Öffnen
document.querySelectorAll('.openConfirmModal').forEach(btn => {
  btn.onclick = () => {
    selectedBtn = btn;
    selectedForm = document.getElementById(btn.dataset.form);

    const select = selectedForm.querySelector('select[name="category_id"]');
    if (!select.value) { select.focus(); return; }

    originalNet = parseFloat(btn.dataset.netPrice);
    currentNet = originalNet;

    discountPercent = 0;
    discountAmount = 0;
    cancelCouponBtn.style.display = 'none';
    couponInfoBox.innerHTML = '';

    resetSteps();
    renderPrices();

    bootstrap.Modal.getOrCreateInstance(confirmBuyModal).show();
  };
});

// Coupon
applyCouponBtn.onclick = async () => {
  const code = couponInput.value.trim().toUpperCase();
  if (!code) return;

  const res = await fetch('/buyer/apply-coupon', {
    method: 'POST',
    headers: {'Content-Type':'application/x-www-form-urlencoded'},
    body: new URLSearchParams({ code, packageId: selectedBtn.dataset.packageId })
  });

  const data = await res.json();
  if (!data.ok) return alert(TXT_INVALID_COUPON);

  discountPercent = data.percent;
  discountAmount = originalNet - parseFloat(data.newNet);
  currentNet = parseFloat(data.newNet);

  cancelCouponBtn.style.display = 'inline-block';

  couponInfoBox.innerHTML =
    `<div class="herando-info">${TXT_COUPON_APPLIED} (${discountPercent}%)</div>`;

  renderPrices();
};

// Coupon löschen
cancelCouponBtn.onclick = () => {
  discountPercent = 0;
  discountAmount = 0;
  currentNet = originalNet;

  couponInput.value = '';
  cancelCouponBtn.style.display = 'none';
  couponInfoBox.innerHTML = '';

  renderPrices();
};

// Step weiter
toStep2.onclick = () => {
  step1.style.display = 'none';
  step2.style.display = 'block';
};

// Zurück
backToStep1.onclick = () => {
  step2.style.display = 'none';
  step1.style.display = 'block';
};

// Kaufen
buyNowBtn.onclick = () => {
  if (!agbCheck.checked) return;
  selectedForm.querySelector('[name="netPriceOverride"]').value = currentNet;
  selectedForm.querySelector('[name="discountPercent"]').value = discountPercent;
  selectedForm.querySelector('[name="discountAmount"]').value = discountAmount;

  selectedForm.submit();
};

// Modal Reset + Overlay Fix
confirmBuyModal.addEventListener('hidden.bs.modal', () => {
  document.querySelectorAll('.modal-backdrop').forEach(e => e.remove());
  document.body.classList.remove('modal-open');
  resetSteps();
});
</script>





<%- include('../../partials/footer', { footerColumns }) %>

</body>
</html>

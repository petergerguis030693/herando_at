  <% if (_private.length === 0 && _light.length === 0 && _medium.length === 0 && _pro.length === 0 && _prem.length === 0) { %>

    <p class="text-muted"><%- t('buyer.marketing.none') %></p>

  <% } else { %>

    <% if (_private.length > 0) { %>
      <p class="text-muted">
        <%- t('buyer.marketing.private') %>
        <strong><%= _fmtEntities(_private) %></strong>
      </p>
    <% } %>

    <% if (_light.length > 0) { %>
      <p class="text-muted">
        <%- t('buyer.marketing.light') %>
        <strong><%= _fmtEntities(_light) %></strong>
      </p>
    <% } %>

    <% if (_medium.length > 0) { %>
      <p class="text-muted">
        <%- t('buyer.marketing.medium', 'Aktives Marketing-Paket Medium in:') %>
        <strong><%= _fmtEntities(_medium) %></strong>
      </p>
    <% } %>

    <% if (_pro.length > 0) { %>
      <p class="text-muted">
        <%- t('buyer.marketing.pro') %>
        <strong><%= _fmtEntities(_pro) %></strong>
      </p>
    <% } %>

    <% if (_prem.length > 0) { %>
      <p class="text-muted">
        <%- t('buyer.marketing.premium') %>
        <strong><%= _fmtEntities(_prem) %></strong>
      </p>
    <% } %>

  <% } %>

</section>





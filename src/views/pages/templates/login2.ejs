<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login – Herando</title>
  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    /* Zusätzliche minimalistische Anpassungen */
    body {
      background-color: #f8f9fa;
    }
    .login-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      border-radius: 0.75rem;
      box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    .toggle-password {
      cursor: pointer;
    }
  </style>
</head>
<body>

  <div class="container login-container">
    <div class="row w-100 justify-content-center">
      <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card">
          <div class="card-body p-4">
            <h1 class="h4 mb-4 text-center">Einloggen</h1>

            <!-- Fehlermeldung (sichtbar, wenn serverseitig eine Variable "error" gesetzt ist) -->
            <% if (error) { %>
              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>
            <% } %>

            <form action="/auth/login" method="post">
              <!-- E-Mail-Feld -->
              <div class="mb-3">
                <label for="email" class="form-label">E-Mail-Adresse</label>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  required
                  placeholder="name@beispiel.de"
                />
              </div>

              <!-- Passwort-Feld mit Eye-Icon zum Umschalten -->
              <div class="mb-3 position-relative">
                <label for="password" class="form-label">Passwort</label>
                <input
                  type="password"
                  class="form-control pe-5"
                  id="password"
                  name="password"
                  required
                  placeholder="••••••••"
                />
                <span
                  class="position-absolute top-50 end-0 translate-middle-y me-3 toggle-password"
                  onclick="togglePassword()"
                  style="user-select: none;"
                >
                  <i class="bi bi-eye-slash" id="eyeIcon"></i>
                </span>
              </div>

              <!-- Eingeloggt bleiben und "Passwort vergessen?" -->
              <div class="d-flex justify-content-between align-items-center mb-4 small">
                <div class="form-check">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="remember"
                    name="remember"
                  />
                  <label class="form-check-label" for="remember">
                    Eingeloggt bleiben
                  </label>
                </div>
              </div>

              <!-- Login-Button -->
              <div class="d-grid mb-3">
                <button type="submit" class="btn btn-primary">Einloggen</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS + Icons -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.min.js"></script>

  <script>
    function togglePassword() {
      const pwdInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        eyeIcon.classList.remove('bi-eye-slash');
        eyeIcon.classList.add('bi-eye');
      } else {
        pwdInput.type = 'password';
        eyeIcon.classList.remove('bi-eye');
        eyeIcon.classList.add('bi-eye-slash');
      }
    }
  </script>
</body>
</html>

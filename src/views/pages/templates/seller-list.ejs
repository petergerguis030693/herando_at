<section class="seller-page">
  <!-- Verkäuferprofil -->
<div class="seller-header">
  <div class="avatar">
    <% if (sellerProfile.hasLogo && sellerProfile.logo) { %>
      <img
        src="<%= sellerProfile.logo %>"
        alt="<%= sellerProfile.company || 'Händler' %>"
        class="seller-logo"
        loading="lazy">
    <% } else { %>
      <span class="seller-initials">
        <%= sellerProfile.company
          ? sellerProfile.company.split(' ').map(n => n[0]).join('').substring(0,2)
          : 'H' %>
      </span>
    <% } %>
  </div>

  <div class="info">
    <h2><%= sellerProfile.company %></h2>

    <% if (sellerProfile.company) { %>
      <p>
        <strong><%= t('seller.company', 'Firma:') %></strong>
        <%= sellerProfile.company %>
      </p>
    <% } %>

    <% if (sellerProfile.address) { %>
      <p>
        <strong><%= t('seller.address', 'Adresse:') %></strong>
        <%= sellerProfile.address %>
      </p>
    <% } %>
  </div>
</div>



  <!-- Inserate -->
<% if (allItems.length > 0) { %>
  <div class="productGrid d-flex flex-wrap" style="margin-top: 30px;">
    <% allItems.forEach(item => { %>
      <a href="/<%= item.route %>/<%= item.id %>/<%= item.slug %>">
        <div class="cardPeter mb-4 me-4">
          <div class="imageBild">
            <div class="bild">
              <img 
                src="<%= item.image %>" 
                alt="<%= item.title %>" 
                loading="lazy" 
                style="width:400px;height:280px;object-fit:cover;object-position:center top;display:block;margin:0 auto;cursor:pointer;">
            </div>
          </div>

          <div class="informationSection pt-2">
            <div class="productInfo">
              <h3 class="lux-card-title" style="margin-bottom:10px;font-size:14pt;">
                <b><%= item.title.length > 30 ? item.title.substring(0,30) + '...' : item.title %></b>
              </h3>

              <% if (item.route === 'cars') { %>
                <div class="cartype-box">
                  <p class="cartype-box" style="font-size:12pt;margin-top:12px;">

                    <% if (item.gearbox) { %>
                      <span class="info-item">
                        <i class="bi bi-gear-fill"></i>
                        <%= gearboxMap[item.gearbox] || '' %>
                      </span>
                    <% } %>

                    <% if (item.mileage) { %>
                      <span class="info-item">
                        <i class="bi bi-speedometer2"></i>
                        <%= new Intl.NumberFormat('de-DE').format(item.mileage) %> km
                      </span>
                    <% } %>

                    <% if (item.fuel) { %>
                      <span class="info-item">
                        <i class="bi bi-fuel-pump"></i>
                        <%= fuelMap[item.fuel] || '' %>
                      </span>
                    <% } %>

                    <% if (item.firstregistration) { %>
                      <span class="info-item">
                        <i class="bi bi-calendar-event"></i>
                        <%= t('cars.first_registration', 'Erstzulassung') %> <%= item.firstregistration %>
                      </span>
                    <% } %>

                  </p>
                </div>
              <% } %>

<% if (item.route === 'properties') { %>
  <div class="cartype-box">
    <p class="cartype-box" style="font-size:12pt;margin-top:12px;">

      <% if (item.propertytype) { %>
        <span class="info-item">
          <i class="bi bi-building"></i>
          <%= propertyTypeMap[item.propertytype] || '' %>
        </span>
      <% } %>

      <% if (item.livingarea) { %>
        <span class="info-item">
          <i class="bi bi-aspect-ratio"></i>
          <%= new Intl.NumberFormat('de-DE').format(item.livingarea) %> m²
        </span>
      <% } %>

      <% if (item.rooms) { %>
        <span class="info-item">
          <i class="bi bi-door-closed"></i>
          <%= item.rooms %> <%= t('properties.rooms', 'Zimmer') %>
        </span>
      <% } %>

      <% if (item.propertyshape) { %>
        <span class="info-item">
          <i class="bi bi-bricks"></i>
          <%= propertyShapeMap[item.propertyshape] || '' %>
        </span>
      <% } %>

    </p>
  </div>
<% } %>


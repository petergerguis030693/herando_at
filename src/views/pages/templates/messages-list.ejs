<%- include('../../partials/header') %>
          <link rel="stylesheet" href="/css/buyer.css">


  <style>
    body{ background:var(--hr-bg); }
    .account-shell{ max-width:1500px; margin:24px auto; }
    .main{ flex:1; padding:24px; }
    .card-clean{ border:1px solid var(--hr-border); border-radius:12px; overflow:hidden; background:#fff; }
    .card-clean .card-header{ background:#fff; font-weight:700; padding:12px 16px; border-bottom:1px solid var(--hr-border); }
    .card-clean .card-body{ padding:16px; }
    @media (max-width:992px){ .left-nav{ display:none; } .account-shell{ padding:0 12px; } }
    .badge-unread{ background:#e7f1ff; color:#0b5ed7; text-transform:uppercase; font-size:.7rem; }
  </style>
<body>
  <% const _cp = (typeof currentPage !== 'undefined' ? currentPage : null); %>

  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-50 start-50 translate-middle" role="alert" style="z-index:1050;min-width:300px;">
      <%= errorMessage %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show position-fixed top-50 start-50 translate-middle" role="alert" style="z-index:1050;min-width:300px;">
      <%= successMessage %><button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>


  <div class="account-shell d-flex gap-3">
     <%- include('../../partials/asside') %>

    <!-- MAIN -->
    <main class="main"> 
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="m-0" style="font-weight: 700;"><i class="bi bi-chat-square-text me-2"></i><%= t('buyer.messages.title','Meine Nachrichten') %></h4>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-secondary btn-sm" href="/buyer/messages/sent"><%= t('buyer.messages.sent','Gesendet') %></a>
          <a class="btn btn-primary btn-sm" href="/buyer/messages/compose"><i class="bi bi-pencil-square me-1"></i>  <%= t('buyer.messages.compose','Neue Nachricht') %></a>
        </div>
      </div>

      <div class="card-clean" style="margin-top: 24pt; font-weight: bolder;">
        <div class="card-header d-flex align-items-center justify-content-between">
          <span>  <%= t('buyer.messages.inbox','Posteingang') %></span>
          <div class="d-flex align-items-center gap-2">
            <input id="msgSearch" type="search" class="form-control form-control-sm" placeholder="Suchen …">
            <div class="form-check form-switch m-0">
              <input class="form-check-input" type="checkbox" id="onlyUnread">
              <label class="form-check-label small" for="onlyUnread"><%= t('buyer.messages.only_unread','nur ungelesen') %></label>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if (!items || !items.length) { %>
            <div class="text-muted">  <%= t('buyer.messages.no_items','Noch keine Nachrichten.') %></div>
          <% } else { %>
            <div class="list-group" id="msgList">
              <% items.forEach(m => { %>
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start msg-item"
                   data-search="<%- ((m.subject||'') + ' ' + (m.sender_firstname||'') + ' ' + (m.sender_lastname||'') + ' ' + (m.sender_email||'')).toLowerCase() %>"
                   data-unread="<%= m.read_at ? '0' : '1' %>"
                   href="/buyer/messages/<%= m.id %>">
                  <div class="me-auto">
                    <div class="fw-semibold">
                      <%= m.subject ? m.subject : t('buyer.messages.subject_empty','(ohne Betreff)') %>
                      <% if (!m.read_at) { %><span class="badge badge-unread ms-2"><%= t('buyer.messages.badge_new','neu') %></span><% } %>
                    </div>
                    <div class="text-muted small">
                      <i class="bi bi-person me-1"></i>
                      <%= m.sender_firstname || '' %> <%= m.sender_lastname || '' %>
                      <%= m.sender_email ? '(' + m.sender_email + ')' : '' %>
                    </div>
                  </div>
                  <small class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i>
                    <%= m.sent_at ? new Date(m.sent_at).toLocaleString('de-DE') : '' %>
                  </small>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    const msgSearch = document.getElementById('msgSearch');
    const onlyUnread = document.getElementById('onlyUnread');
    const list = document.getElementById('msgList');

    function applyFilters(){
      if(!list) return;
      const q = (msgSearch?.value || '').trim().toLowerCase();
      const unreadOnly = !!(onlyUnread && onlyUnread.checked);
      list.querySelectorAll('.msg-item').forEach(el => {
        const txt = el.getAttribute('data-search') || '';
        const isUnread = el.getAttribute('data-unread') === '1';
        const matchText = !q || txt.includes(q);
        const matchUnread = !unreadOnly || isUnread;
        el.style.display = (matchText && matchUnread) ? '' : 'none';
      });
    }

    if (msgSearch) msgSearch.addEventListener('input', applyFilters);
    if (onlyUnread) onlyUnread.addEventListener('change', applyFilters);
  </script>
<%- include('../../partials/footer', { footerColumns }) %>

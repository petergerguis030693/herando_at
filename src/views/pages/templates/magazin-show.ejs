<%- include('../../partials/header') %>

<div class="container my-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-transparent p-0 mb-0">
      <li class="breadcrumb-item">
        <a href="/" class="text-decoration-none">
          <i class="bi bi-house-door-fill"></i>
        </a>
      </li>
      <li class="breadcrumb-item">
        <a href="/magazin" class="text-decoration-none">
          <i class="bi bi-journal-text"></i> <%= t('magazin.breadcrumb', 'Magazin') %>
        </a>
      </li>
      <li class="breadcrumb-item active" aria-current="page"><%= page.title %></li>
    </ol>
  </nav>

  <% if (page.published_at && new Date(page.published_at) > new Date()) { %>
    <div class="alert alert-info mb-3" role="status">
      <%= t('magazin.upcoming_banner', 'Geplanter Veröffentlichungsbeginn (bis dahin noindex für Suchmaschinen):') %>
      <strong><%= new Date(page.published_at).toLocaleString('de-DE', { dateStyle: 'full', timeStyle: 'short' }) %></strong>
    </div>
  <% } %>

  <!-- Titel & Meta -->
  <h1 class="fw-bold mb-2">
    <%= page.title %>
  </h1>
  <div class="text-muted mb-4" style="font-size:0.9rem;">
    <%= t('magazin.by', 'Von') %> <strong><%= page.author %></strong> &bull;
    <%= new Date(page.published_at || page.created).toLocaleDateString('de-DE', {
          day:'2-digit', month:'long', year:'numeric'
       }) %>
  </div>

  <!-- Cover Image -->
  <% if (page.cover_image) { %>
    <img
      src="/uploads/postings/<%= page.slug %>/<%= page.cover_image %>"
      alt="<%= page.title %>"
      width="1200"
      height="675"
      class="img-fluid rounded mb-4 shadow-sm"
      decoding="async">
  <% } %>

  <!-- Content -->
  <div style="line-height:1.7; font-size:1rem;">
    <%- page.content %>
  </div>

  <!-- Zurück-Button -->
  <div class="mt-4">
    <a href="/magazin" class="btn btn-primary">
      <i class="bi bi-arrow-left-circle"></i> <%= t('magazin.back', 'Zurück') %>
    </a>
  </div>
</div>

<%- include('../../partials/footer', { footerColumns }) %>

</body>
</html>

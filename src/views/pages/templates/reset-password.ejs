<!DOCTYPE html>
<%
  const SUPPORTED_LANGS = ['de', 'en', 'fr', 'it', 'tr', 'ja', 'cs', 'ru', 'es', 'nl', 'pl'];
  const rawLang = String(
    (typeof lang !== 'undefined' && lang) ||
    (typeof locale !== 'undefined' && locale) ||
    (typeof currentLang !== 'undefined' && currentLang) ||
    'de'
  ).toLowerCase();
  const shortLang = rawLang.split(/[-_]/)[0];
  const activeLang = SUPPORTED_LANGS.includes(shortLang) ? shortLang : 'de';
  const BASE_URL = (typeof siteBaseUrl !== 'undefined' && siteBaseUrl) ? siteBaseUrl : 'https://www.herando.com';
  const xDefaultLang = (typeof domainDefaultLang !== 'undefined' && domainDefaultLang) ? domainDefaultLang : 'de';
  const PAGE_PATH = '/auth/reset-password';
  const canonicalUrl = `${BASE_URL}${activeLang === 'de' ? '' : `/${activeLang}`}${PAGE_PATH}`;
  const hrefFor = (code) => `${BASE_URL}${code === 'de' ? '' : `/${code}`}${PAGE_PATH}`;
%>
<html lang="<%= activeLang %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Herando – Luxus-Autos, Yachten, Immobilien & Uhren | Kaufen & Verkaufen</title>
  <meta
    name="description"
    content="Entdecken Sie über 100.000 Premium-Angebote: Luxus-Autos, exklusive Yachten, Traum-Immobilien & Uhren bei Herando. Jetzt finden & verkaufen!"
  />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href="<%= canonicalUrl %>" />
  <% SUPPORTED_LANGS.forEach((code) => { %>
    <link rel="alternate" href="<%= hrefFor(code) %>" hreflang="<%= code %>" />
  <% }) %>
  <link rel="alternate" href="<%= hrefFor(xDefaultLang) %>" hreflang="x-default" />

  <meta property="og:title" content="Herando – Luxus-Autos, Yachten, Immobilien & Uhren" />
  <meta
    property="og:description"
    content="Entdecken Sie über 100.000 Premium-Angebote: Luxus-Autos, Yachten, Immobilien & Uhren."
  />
  <meta property="og:image" content="<%= BASE_URL %>/assets/og-image.jpg" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Herando – Luxus-Autos, Yachten, Immobilien & Uhren" />
  <meta
    name="twitter:description"
    content="Über 100.000 Premium-Angebote entdecken: Autos, Yachten, Immobilien & Uhren bei Herando."
  />
  <meta name="twitter:image" content="<%= BASE_URL %>/assets/og-image.jpg" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Herando",
      "url": "<%= BASE_URL %>/",
      "logo": "<%= BASE_URL %>/assets/herando-weblogo.svg",
      "sameAs": [
        "https://www.facebook.com/Herando",
        "https://twitter.com/Herando",
        "https://www.instagram.com/Herando"
      ]
    }
  </script>

  <link rel="shortcut icon" href="/assets/herando-weblogo.svg" type="image/x-icon" />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
  />

<link rel="stylesheet" href="/css/style.min.css">
<link rel="stylesheet" href="/css/magazin.min.css">
<link rel="stylesheet" href="/css/footer.min.css">
<link rel="stylesheet" href="/css/products.min.css">
<link rel="stylesheet" href="/css/header.css">
<link rel="stylesheet" href="/css/product-single.min.css">
<link rel="stylesheet" href="/css/search.min.css">
<link rel="stylesheet" href="/css/language-modal.min.css">
<link rel="stylesheet" href="/css/navbar-clean.min.css">
<link rel="stylesheet" href="/css/ui-components.min.css">
<link rel="stylesheet" href="/css/mobile.min.css">

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

  <style>
    .input-group-text{
      background-color: transparent;
    }

    .form-check-input:checked {
    background-color: rgb(195, 144, 82);
    border-color: rgb(195, 144, 82);
    }

    a:hover {
    text-decoration: underline;
    color: rgb(195, 144, 82);
    }
  </style>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <!-- Logo -->
          <div class="text-center mb-4">
            <img 
              src="/assets/herando-weblogo.png" 
              alt="Herando Logo" 
              style="max-width:200px;width:100%;height:auto;">
          </div>

          <!-- Titel -->
          <h4 class="text-center mb-3"><%= t('reset.heading','Neues Passwort setzen') %></h4>
          <p class="text-center text-muted small mb-4">
            <%= t('reset.body','Bitte vergeben Sie ein neues Passwort für Ihr Konto.') %>
          </p>

          <!-- Meldung -->
          <div id="msg"></div>

          <!-- Formular -->
          <form id="resetForm" novalidate>

            <input type="hidden" name="token" id="token" value="<%= token %>">

            <div class="mb-3">
              <label for="password" class="form-label"><%= t('reset.password_label','Neues Passwort') %></label>
              <div class="position-relative">
                <input
                  type="password"
                  class="form-control pe-5"
                  id="password"
                  required
                  placeholder="••••••••"
                />
                <span
                  class="position-absolute top-50 end-0 translate-middle-y pe-3"
                  style="cursor:pointer;"
                  id="togglePassword"
                >
                  <i class="bi bi-eye-slash"></i>
                </span>
              </div>
            </div>

            <div class="mb-3 position-relative">
              <label for="passwordRepeat" class="form-label"><%= t('reset.password_repeat_label','Passwort wiederholen') %></label>
              <input
                type="password"
                class="form-control pe-5"
                id="passwordRepeat"
                required
                placeholder="••••••••"
              />
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary">
                <%= t('reset.submit','Passwort speichern') %>
              </button>
            </div>

            <p class="text-center small mb-0">
              <a href="/auth/login"><%= t('reset.back_to_login','Zurück zum Login') %></a>
            </p>

          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('resetForm');
  const msg = document.getElementById('msg');
  const pw = document.getElementById('password');
  const pw2 = document.getElementById('passwordRepeat');
  const toggle = document.getElementById('togglePassword');
  const MSG_PASSWORD_MIN = <%- JSON.stringify(t('reset.msg.password_min','Passwort muss mindestens 8 Zeichen haben.')) %>;
  const MSG_PASSWORD_MISMATCH = <%- JSON.stringify(t('reset.msg.password_mismatch','Passwörter stimmen nicht überein.')) %>;
  const MSG_ERROR = <%- JSON.stringify(t('reset.msg.error','Fehler')) %>;
  const MSG_SUCCESS = <%- JSON.stringify(t('reset.msg.success','Passwort erfolgreich geändert. Sie werden weitergeleitet ...')) %>;
  const MSG_SERVER_ERROR = <%- JSON.stringify(t('reset.msg.server_error','Serverfehler.')) %>;

  toggle.addEventListener('click', () => {
    const type = pw.type === 'password' ? 'text' : 'password';
    pw.type = type;
    pw2.type = type;
    toggle.querySelector('i').classList.toggle('bi-eye');
    toggle.querySelector('i').classList.toggle('bi-eye-slash');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.innerHTML = '';

    if (pw.value.length < 8) {
      msg.innerHTML = `<div class="alert alert-danger">${MSG_PASSWORD_MIN}</div>`;
      return;
    }

    if (pw.value !== pw2.value) {
      msg.innerHTML = `<div class="alert alert-danger">${MSG_PASSWORD_MISMATCH}</div>`;
      return;
    }

    try {
      const res = await fetch('/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: document.getElementById('token').value,
          password: pw.value
        })
      });

      const data = await res.json();

      if (!res.ok) {
        msg.innerHTML = `<div class="alert alert-danger">${data.message || MSG_ERROR}</div>`;
        return;
      }

      msg.innerHTML = `
        <div class="alert alert-success">
          ${MSG_SUCCESS}
        </div>
      `;

      setTimeout(() => {
        window.location.href = '/auth/login';
      }, 1500);

    } catch (err) {
      msg.innerHTML = `<div class="alert alert-danger">${MSG_SERVER_ERROR}</div>`;
    }
  });
});
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Neues Passwort setzen – Herando</title>
  <meta name="robots" content="noindex, nofollow" />

  <link rel="shortcut icon" href="/assets/herando-weblogo.svg" type="image/x-icon" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <!-- Logo -->
          <div class="text-center mb-4">
            <img 
              src="/assets/herando-weblogo.png" 
              alt="Herando Logo" 
              style="max-width:200px;width:100%;height:auto;">
          </div>

          <!-- Titel -->
          <h4 class="text-center mb-3">Neues Passwort setzen</h4>
          <p class="text-center text-muted small mb-4">
            Bitte vergeben Sie ein neues Passwort für Ihr Konto.
          </p>

          <!-- Meldung -->
          <div id="msg"></div>

          <!-- Formular -->
          <form id="resetForm" novalidate>

            <input type="hidden" name="token" id="token" value="<%= token %>">

            <div class="mb-3 position-relative">
              <label for="password" class="form-label">Neues Passwort</label>
              <input
                type="password"
                class="form-control pe-5"
                id="password"
                required
                placeholder="••••••••"
              />
              <span
                class="position-absolute top-50 end-0 translate-middle-y pe-3"
                style="cursor:pointer;"
                id="togglePassword"
              >
                <i class="bi bi-eye-slash"></i>
              </span>
            </div>

            <div class="mb-3 position-relative">
              <label for="passwordRepeat" class="form-label">Passwort wiederholen</label>
              <input
                type="password"
                class="form-control pe-5"
                id="passwordRepeat"
                required
                placeholder="••••••••"
              />
            </div>

            <div class="d-grid mb-3">
              <button type="submit" class="btn btn-primary">
                Passwort speichern
              </button>
            </div>

            <p class="text-center small mb-0">
              <a href="/auth/login">Zurück zum Login</a>
            </p>

          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('resetForm');
  const msg = document.getElementById('msg');
  const pw = document.getElementById('password');
  const pw2 = document.getElementById('passwordRepeat');
  const toggle = document.getElementById('togglePassword');

  toggle.addEventListener('click', () => {
    const type = pw.type === 'password' ? 'text' : 'password';
    pw.type = type;
    pw2.type = type;
    toggle.querySelector('i').classList.toggle('bi-eye');
    toggle.querySelector('i').classList.toggle('bi-eye-slash');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.innerHTML = '';

    if (pw.value.length < 8) {
      msg.innerHTML = '<div class="alert alert-danger">Passwort muss mindestens 8 Zeichen haben.</div>';
      return;
    }

    if (pw.value !== pw2.value) {
      msg.innerHTML = '<div class="alert alert-danger">Passwörter stimmen nicht überein.</div>';
      return;
    }

    try {
      const res = await fetch('/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: document.getElementById('token').value,
          password: pw.value
        })
      });

      const data = await res.json();

      if (!res.ok) {
        msg.innerHTML = `<div class="alert alert-danger">${data.message || 'Fehler'}</div>`;
        return;
      }

      msg.innerHTML = `
        <div class="alert alert-success">
          Passwort erfolgreich geändert. Sie werden weitergeleitet …
        </div>
      `;

      setTimeout(() => {
        window.location.href = '/auth/login';
      }, 1500);

    } catch (err) {
      msg.innerHTML = '<div class="alert alert-danger">Serverfehler.</div>';
    }
  });
});
</script>

</body>
</html>

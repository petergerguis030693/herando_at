<footer class="herando-footer">
  <div class="container">

    <div class="hf-row top">

      <div>
        <h6 class="gold"><%= t('footer.newsletter.title') %></h6>
        <button class="btn btn-border" id="openNewsletterModal"><%= t('footer.newsletter.cta') %></button>
      </div>

      <div id="newsletterModal" class="hf-modal" aria-hidden="true" role="dialog" aria-labelledby="nl_title">
        <div class="hf-modal-backdrop"></div>
        <div class="hf-modal-dialog" role="document">
          <button class="hf-modal-close" id="closeNewsletterModal" aria-label="Close">×</button>

          <h3 id="nl_title"><%= t('footer.newsletter.modal.title') %></h3>

          <form id="newsletterForm">

            <!-- 👤 NAME (OPTIONAL) -->
            <label for="nl_name">
              <%= t('footer.newsletter.name.label', { fallback: 'Name (optional)' }) %>
            </label>
            <input
              type="text"
              class="w-100"
              id="nl_name"
              name="name"
              placeholder="<%= t('footer.newsletter.name.placeholder', { fallback: 'Ihr Name' }) %>"
            />

            <!-- 📧 EMAIL -->
            <label for="nl_email">
              <%= t('footer.newsletter.email.label') %>
            </label>
            <input
              type="email"
              class="w-100"
              id="nl_email"
              name="email"
              required
              placeholder="<%= t('footer.newsletter.email.placeholder') %>"
            />

            <!-- 🗂️ KATEGORIEN -->
            <label>
              <%= t('footer.newsletter.category.label') %>
            </label>
            <div id="nl_ententies" class="nl-checkbox-list">
              <p class="loading">
                <%= t('footer.newsletter.category.loading') %>
              </p>
            </div>

            <!-- ✅ CONSENT -->
            <label class="consent">
              <input type="checkbox" id="nl_accepted" name="accepted" value="1" required />
              <%= t('footer.newsletter.consent') %>
            </label>

            <div class="hf-modal-actions">
              <button type="submit" class="btn hf-btn primary">
                <%= t('footer.newsletter.submit') %>
              </button>
              <p id="nl_feedback" class="nl-feedback" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </div>

      <script>
      (function(){
        const modal    = document.getElementById('newsletterModal');
        const openBtn  = document.getElementById('openNewsletterModal');
        const closeBtn = document.getElementById('closeNewsletterModal');
        const form     = document.getElementById('newsletterForm');
        const select   = document.getElementById('nl_ententies');
        const email    = document.getElementById('nl_email');
        const feedback = document.getElementById('nl_feedback');

        function open(){
          modal.classList.add('open');
          document.body.classList.add('modal-open');
          modal.setAttribute('aria-hidden','false');
          setTimeout(() => email?.focus(), 50);
        }

        function close(){
          modal.classList.remove('open');
          document.body.classList.remove('modal-open');
          modal.setAttribute('aria-hidden','true');
          feedback.textContent = '';
          form.reset();

          if (select) {
            select.innerHTML = '<p class="loading"><%= t('footer.newsletter.category.loading') %></p>';
          }
        }

        openBtn?.addEventListener('click', open);
        closeBtn?.addEventListener('click', close);

        modal?.addEventListener('click', e => {
          if (e.target.classList.contains('hf-modal-backdrop')) close();
        });

        window.addEventListener('keydown', e => {
          if (e.key === 'Escape' && modal.classList.contains('open')) close();
        });

        // ─────────────────────────────
        // Kategorien laden
        // ─────────────────────────────
        async function loadEntenties(){
          try {
            const res = await fetch('/newsletter/entities');
            const data = await res.json();

            select.innerHTML = '';

            data.entities.forEach(e => {
              select.insertAdjacentHTML('beforeend', `
                <label class="nl-checkbox">
                  <input type="checkbox" name="ententies_ids[]" value="${e.id}">
                  <span>${e.name}</span>
                </label>
              `);
            });
          } catch {
            select.innerHTML = '<p class="error"><%= t('footer.newsletter.error') %></p>';
          }
        }

        openBtn?.addEventListener('click', loadEntenties);

        // ─────────────────────────────
        // Submit
        // ─────────────────────────────
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();

          feedback.textContent = '<%= t('footer.newsletter.sending') %>';

          const ententies_ids = Array.from(
            document.querySelectorAll('input[name="ententies_ids[]"]:checked')
          ).map(cb => cb.value);

          const payload = {
            name: form.name?.value?.trim() || null,
            email: form.email.value.trim(),
            ententies_ids,
            accepted: form.accepted.checked ? 1 : 0
          };

          try {
            const res = await fetch('/newsletter/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data?.message || '<%= t('footer.newsletter.error') %>');

            feedback.textContent = '<%= t('footer.newsletter.success') %>';
            setTimeout(close, 1200);

          } catch (err) {
            feedback.textContent = err.message || '<%= t('footer.newsletter.error') %>';
          }
        });
      })();
      </script>

    </div>


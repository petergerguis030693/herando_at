<script> 
document.addEventListener('DOMContentLoaded', () => {
  const ccToEmoji = cc => String.fromCodePoint(...cc.toUpperCase().split('').map(c => 127397 + c.charCodeAt()));

  document.querySelectorAll('#flags .flag-icon').forEach(el => {
    const fromClass = (el.className.match(/flag-icon-([a-z]{2})/i) || [,''])[1];
    const fromAlt   = (el.getAttribute('alt') || '').trim();
    const cc = (fromAlt || fromClass || '').toLowerCase();
    if (!cc) return;

    const img = new Image();
    img.className = 'flag';
    img.alt = cc.toUpperCase();
    img.src    = `https://flagcdn.com/24x18/${cc}.png`;
    img.srcset = `https://flagcdn.com/24x18/${cc}.png 1x, https://flagcdn.com/48x36/${cc}.png 2x`;

    img.onerror = () => {
      const span = document.createElement('span');
      span.textContent = ccToEmoji(cc);
      span.style.marginRight = '6px';
      span.style.fontSize = '1rem';
      el.replaceWith(span);
    };

    el.replaceWith(img);
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const overlay = document.getElementById('cookie-overlay');
  const modal   = overlay.querySelector('.cookie-modal');
  const body    = document.body;

  function openModalInstant() {
    overlay.classList.add('open');
    body.classList.add('cookie-open');
  }

  function openModalAnimated() {
    // sichtbar machen
    overlay.classList.add('open');
    body.classList.add('cookie-open');

    // Startzustand (JS!)
    overlay.style.opacity = '0';
    modal.style.opacity = '0';
    modal.style.transform = 'translateY(30px) scale(0.96)';

    // Overlay fade
    overlay.animate(
      [{ opacity: 0 }, { opacity: 1 }],
      { duration: 200, easing: 'ease-out', fill: 'forwards' }
    );

    // Modal move + scale
    modal.animate(
      [
        { opacity: 0, transform: 'translateY(30px) scale(0.96)' },
        { opacity: 1, transform: 'translateY(0) scale(1)' }
      ],
      { duration: 320, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' }
    );
  }

  function closeModal() {
    overlay.classList.remove('open');
    body.classList.remove('cookie-open');

    // cleanup inline styles
    overlay.style.opacity = '';
    modal.style.opacity = '';
    modal.style.transform = '';
  }

  /* =============================
     AUTO OPEN (OHNE ANIMATION)
  ============================= */
  try {
    const consent = JSON.parse(localStorage.getItem('cookie.consent'));
    if (!consent || !consent.expiresAt || Date.now() > consent.expiresAt) {
      openModalInstant();
    }
  } catch {
    openModalInstant();
  }

  /* =============================
     LINK OPEN (MIT ANIMATION)
  ============================= */
  document.querySelectorAll('.open-cookie-settings, #open-cookie-settings')
    .forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        openModalAnimated();
      });
    });

  /* =============================
     CLOSE BUTTON (X)
  ============================= */
  const closeBtn = document.getElementById('cookie-close');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      // 2h Wiederöffnung
      localStorage.setItem('cookie.consent', JSON.stringify({
        required: true,
        stats: false,
        expiresAt: Date.now() + 2 * 60 * 60 * 1000
      }));
      closeModal();
    });
  }

  /* =============================
     ACTION BUTTONS
  ============================= */
  document.getElementById('cookie-required')?.addEventListener('click', () => {
    localStorage.setItem('cookie.consent', JSON.stringify({
      required: true,
      stats: false,
      expiresAt: Date.now() + 6 * 30 * 24 * 60 * 60 * 1000
    }));
    closeModal();
  });

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem('cookie.consent', JSON.stringify({
      required: true,
      stats: true,
      expiresAt: Date.now() + 6 * 30 * 24 * 60 * 60 * 1000
    }));
    closeModal();
  });

});
</script>

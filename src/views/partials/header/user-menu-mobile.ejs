<div class="dropdown position-relative user-switcher">
  <div class="user-icon" id="userDropdownMobile" data-bs-toggle="dropdown" aria-expanded="false">
    <% if (user && (user.firstname || user.name)) { %>
      <span><%= (user.firstname ? user.firstname[0] : user.name[0]).toUpperCase() %></span>
    <% } else { %>
      <i class="bi bi-person fs-5 text-dark"></i>
    <% } %>
  </div>

  <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 rounded-3"
      aria-labelledby="userDropdownMobile"
      style="min-width:200px;">

    <% if (user) { %>

      <li><a class="dropdown-item" href="/buyer"><i class="bi bi-grid me-2"></i> <%= t('user.menu.dashboard','Übersicht') %></a></li>
      <li><a class="dropdown-item" href="/buyer/messages"><i class="bi bi-chat-square-text me-2"></i> <%= t('user.menu.messages','Nachrichten') %></a></li>
      <li><a class="dropdown-item" href="/buyer/sold"><i class="bi bi-cash-stack me-2"></i> <%= t('user.menu.sell','Verkaufen') %></a></li>
      <li><a class="dropdown-item" href="/buyer/historie"><i class="bi bi-clock-history me-2"></i> <%= t('user.menu.history','Inserat - Historie') %></a></li>
      <li><a class="dropdown-item" href="/buyer/statistiken"><i class="bi bi-graph-up-arrow me-2"></i> <%= t('buyer.statistics.title', 'Statistiken') %></a></li>
      <li><a class="dropdown-item" href="/buyer/wishlist"><i class="bi bi-heart me-2"></i> <%= t('user.menu.wishlist','Merkliste') %></a></li>

      <li><hr class="dropdown-divider"></li>

      <li><a class="dropdown-item" href="/buyer/profil"><i class="bi bi-person-gear me-2"></i> <%= t('user.menu.profile_settings','Profil-Einstellungen') %></a></li>
      <li><a class="dropdown-item" href="/buyer/newsletters"><i class="bi bi-envelope-paper-heart me-2"></i> <%= t('user.menu.newsletter','Newsletter') %></a></li>

      <li><hr class="dropdown-divider"></li>

      <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> <%= t('user.menu.logout','Logout') %></a></li>

    <% } else { %>

      <li><a class="dropdown-item" href="/auth/login"><i class="bi bi-box-arrow-in-right me-2"></i> <%= t('user.menu.login','Login') %></a></li>
      <li><a class="dropdown-item" href="/auth/register"><i class="bi bi-person-plus me-2"></i> <%= t('user.menu.register','Registrieren') %></a></li>

    <% } %>

  </ul>
</div>

<%
  const siteBase = siteBaseUrl || 'https://www.herando.com';
  const toAbsUrl = (url, fallback = '') => {
    const val = String(url || fallback || '');
    if (!val) return siteBase + '/';
    if (/^https?:\/\//i.test(val)) return val;
    return `${siteBase}${val.startsWith('/') ? val : `/${val}`}`;
  };

  const canonicalUrl = toAbsUrl(seo?.canonical_url, seoCanonicalUrl || '/');
  const ogImage = toAbsUrl(seo?.og_image, ogDefaultImage || '/assets/og-image.jpg');
  const hreflangMap = (seoHreflangUrls && Object.keys(seoHreflangUrls).length)
    ? seoHreflangUrls
    : { de: `${siteBase}/` };
  const xDefaultUrl = toAbsUrl(seoXDefaultUrl || canonicalUrl);
%>

<title><%= seo?.title || "Herando – Luxus-Autos, Yachten, Immobilien & Uhren" %></title>

<meta name="description" content="<%= seo?.meta_description || 'Entdecken Sie über 100.000 Premium-Angebote: Luxus-Autos, exklusive Yachten, Immobilien & Uhren bei Herando.' %>">
<meta name="robots" content="<%= seo?.robots || 'index, follow' %>">

<link rel="canonical" href="<%= canonicalUrl %>" />

<% Object.entries(hreflangMap).forEach(([code, url]) => { %>
<link rel="alternate" hreflang="<%= code %>" href="<%= toAbsUrl(url) %>" />
<% }) %>

<link rel="alternate" hreflang="x-default" href="<%= xDefaultUrl %>" />
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta property="og:title" content="<%= seo?.og_title || seo?.title || 'Herando – Luxus-Autos, Yachten, Immobilien & Uhren' %>">
<meta property="og:description" content="<%= seo?.og_description || seo?.meta_description || 'Entdecken Sie über 100.000 Premium-Angebote weltweit.' %>">
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:type" content="website">

<meta name="twitter:card" content="<%= seo?.twitter_card || 'summary_large_image' %>">
<meta name="twitter:title" content="<%= seo?.og_title || seo?.title || 'Herando – Luxus-Autos, Yachten, Immobilien & Uhren' %>">
<meta name="twitter:description" content="<%= seo?.og_description || seo?.meta_description || 'Entdecken Sie über 100.000 Premium-Angebote weltweit.' %>">
<meta name="twitter:image" content="<%= ogImage %>">

<% if (seo?.structured_data_json) { %>
<script type="application/ld+json">
<%- typeof seo.structured_data_json === "string" ? seo.structured_data_json : JSON.stringify(seo.structured_data_json) %>
</script>
<% } else { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Herando",
  "url": "<%= siteBase %>/",
  "logo": "<%= toAbsUrl(siteLogoUrl || '/assets/herando-weblogo.svg') %>"
}
</script>
<% } %>

<%
const normalize = (r) => {
  const x = String(r || "").trim().toLowerCase();
  if (["auto","autos","car","cars","fahrzeug","fahrzeuge"].includes(x)) return "autos";
  if (["watch","watches","uhr","uhren"].includes(x)) return "watches";
  if (["property","properties","immobilie","immobilien","realestate","real-estate"].includes(x)) return "properties";
  if (["yacht","yachts","boot","boote","boats"].includes(x)) return "yachts";
  if (["lifestyle","lifestyles"].includes(x)) return "lifestyles";
  return x;
};

const route = normalize(cat.route);
const canonicalRoute = route === 'autos' ? 'cars' : route;
const entityHref = (routeName, suffix = "") => {
  const canonical = routeName === 'autos' ? 'cars' : routeName;
  const base = typeof entityPath === "function" ? entityPath(canonical) : `/${canonical}`;
  const s = String(suffix || "");
  if (!s) return base;
  if (s.startsWith("?")) return `${base}${s}`;
  return `${base}/${s.replace(/^\/+/, "")}`;
};

<style>
  html {
    overflow-y: auto !important;
  }

  body {
    overflow-y: auto !important;
  }

  /* When overlays/modals are open: lock page scroll completely */
  body.cookie-open,
  body.modal-open {
    overflow-y: hidden !important;
  }

  /* Cookie modal: single scroll container inside modal */
  #cookie-overlay.open {
    overflow: hidden !important;
  }

  #cookie-overlay .cookie-modal {
    max-height: calc(100vh - 40px) !important;
    display: flex !important;
    flex-direction: column !important;
  }

  #cookie-overlay #cookie-settings-body {
    min-height: 0 !important;
  }

  #cookie-overlay .cookie-content {
    overflow-y: auto !important;
    min-height: 0 !important;
  }

  @media (max-width: 768px) {
    body.cookie-open,
    body.modal-open {
      overflow-y: hidden !important;
    }
  }
</style>


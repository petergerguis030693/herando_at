<div class="position-relative w-100">
  <div class="input-group" style="height:50px;">
    <span class="input-group-text bg-white border-end-0">
      <i class="bi bi-search text-secondary"></i>
    </span>
    <input
      id="mobileSearchInput"
      type="text"
      class="form-control border-start-0"
      placeholder="<%= t('header.search.placeholder') %>"
      aria-label="<%= t('header.search.aria_label') %>"
      autocomplete="off"
      style="border-top-left-radius:0;border-bottom-left-radius:0;"
    >
    <button class="btn btn-primary" type="button" id="mobileSearchSubmit">
      <i class="bi bi-arrow-right-circle"></i>
    </button>
  </div>

  <div
    id="mobileSearchDropdown"
    class="search-dropdown-box"
    style="display:none; position:absolute; top:100%; left:0; right:0; width:100%; max-height:55vh; overflow-y:auto; z-index:3000; background:#fff; border:1px solid #e5e5e5; border-radius:12px; box-shadow:0 6px 20px rgba(0,0,0,.08);"
  ></div>
</div>

<script>
(() => {
  const searchInput = document.getElementById('mobileSearchInput');
  const searchDropdown = document.getElementById('mobileSearchDropdown');
  const searchSubmit = document.getElementById('mobileSearchSubmit');
  if (!searchInput || !searchDropdown || !searchSubmit) return;

  let searchDebounce;

  function renderSearchDropdown(data) {
    const {
      propertySuggestions = [],
      brandModels = [],
      models = [],
      sellers = [],
      listings = []
    } = data || {};

    let html = '';

    if (propertySuggestions.length > 0) {
      html += '<div class="search-section-title">Immobilien</div>';
      html += propertySuggestions.map((p) => `
        <a href="${p.url}" class="search-result-item">
          <i class="bi bi-house-door"></i>
          <div>
            <div class="search-result-title">${p.title}</div>
            <div class="search-result-sub">${p.subtitle}</div>
          </div>
        </a>
      `).join('');
    }

    if (brandModels.length > 0 || models.length > 0) {
      html += '<div class="search-section-title">Marken & Modelle</div>';
      const combined = [...brandModels, ...models];
      html += combined.map((m) => `
        <a href="${m.url}" class="search-result-item">
          <i class="bi bi-grid"></i>
          <div>
            <div class="search-result-title">${m.title}</div>
            <div class="search-result-sub">${m.subtitle}</div>
          </div>
        </a>
      `).join('');
    }

    if (sellers.length > 0) {
      html += '<div class="search-section-title">Händler</div>';
      html += sellers.map((s) => `
        <a href="${s.url}" class="search-result-item">
          <i class="bi bi-person-badge"></i>
          <div>
            <div class="search-result-title">${s.title}</div>
            <div class="search-result-sub">${s.subtitle}</div>
          </div>
        </a>
      `).join('');
    }

    if (listings.length > 0) {
      html += '<div class="search-section-title">Inserate</div>';
      html += listings.map((i) => `
        <a href="${i.url}" class="search-result-item">
          <i class="bi bi-search"></i>
          <div>
            <div class="search-result-title">${i.title}</div>
            <div class="search-result-sub">${i.subtitle}</div>
          </div>
        </a>
      `).join('');
    }

    if (!propertySuggestions.length && !brandModels.length && !models.length && !sellers.length && !listings.length) {
      html = '<div class="px-3 py-3 text-muted small">Keine Ergebnisse gefunden.</div>';
    }

    searchDropdown.innerHTML = html;
    searchDropdown.style.display = 'block';
  }

  async function fetchSuggestions(q) {
    const res = await fetch(`/api/search/suggestions?q=${encodeURIComponent(q)}`);
    return res.json();
  }

  async function navigateByPriority(q) {
    if (q.length < 2) return;

    try {
      const data = await fetchSuggestions(q);
      if (data.propertySuggestions?.length > 0) return (location.href = data.propertySuggestions[0].url);
      if (data.brandModels?.length > 0) {
        const brand = data.brandModels.find((x) => x.subtitle === 'Marke');
        if (brand) return (location.href = brand.url);
      }
      if (data.models?.length > 0) return (location.href = data.models[0].url);
      if (data.sellers?.length > 0) return (location.href = data.sellers[0].url);
      if (data.listings?.length > 0) return (location.href = data.listings[0].url);
      return (location.href = `/search?q=${encodeURIComponent(q)}`);
    } catch (_) {
      return (location.href = `/search?q=${encodeURIComponent(q)}`);
    }
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(async () => {
      const q = searchInput.value.trim();
      if (q.length < 2) {
        searchDropdown.style.display = 'none';
        searchDropdown.innerHTML = '';
        return;
      }

      try {
        const data = await fetchSuggestions(q);
        renderSearchDropdown(data);
      } catch (_) {}
    }, 300);
  });

  searchInput.addEventListener('keydown', async (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    await navigateByPriority(searchInput.value.trim());
  });

  searchSubmit.addEventListener('click', async () => {
    await navigateByPriority(searchInput.value.trim());
  });

  document.addEventListener('click', (e) => {
    if (!searchDropdown.contains(e.target) && e.target !== searchInput && e.target !== searchSubmit) {
      searchDropdown.style.display = 'none';
    }
  });
})();
</script>

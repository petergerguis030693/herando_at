<%
  const _user        = typeof user !== 'undefined' ? user : null;
  const _unread      = typeof unreadMessages !== 'undefined' ? unreadMessages : 0;
  const _entities    = typeof ententies !== 'undefined' ? ententies : [];
  const _catLabel    = typeof catLabel !== 'undefined' ? catLabel : (()=>{});
  const _getMegaMenu = typeof getMegaMenu !== 'undefined' ? getMegaMenu : (()=>{});

  const _lang        = typeof lang !== 'undefined' ? lang : 'de';
  const _currentLang = typeof currentLang !== 'undefined' ? currentLang : _lang;
  const _LANGS       = typeof LANGS !== 'undefined' ? LANGS : [];

  const _country     = typeof country !== 'undefined' ? country : 'DE';
  const _currency    = typeof currency !== 'undefined' ? currency : 'EUR';

  const ORDER = ["autos", "watches", "properties", "yachts", "lifestyles"];

  const normalize = (r) => {
    const x = String(r || "").trim().toLowerCase();
    if (["auto","car","cars","fahrzeug","fahrzeuge"].includes(x)) return "autos";
    if (["uhr","watch","watches"].includes(x)) return "watches";
    if (["immobilie","realestate","real-estate","property","properties"].includes(x)) return "properties";
    if (["yacht","yachts","boot","boote","boats"].includes(x)) return "yachts";
    if (["lifestyle","lifestyles"].includes(x)) return "lifestyles";
    return x;
  };

  const sortedEntities = [..._entities].sort((a,b) => {
    const A = normalize(a.route);
    const B = normalize(b.route);
    return ORDER.indexOf(A) - ORDER.indexOf(B);
  });
%>


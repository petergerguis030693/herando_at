                    Banner
                  </a>
                </li>
                <li>
                  <a href="/admin/ads/catalog" class="nav-link <%= active === 'ads-catalog' ? 'active' : '' %>">
                    <i class="bi bi-book me-1"></i>
                    Katalog
                  </a>
                </li>
                <li>
                  <a href="/admin/ads/advert_inserat"
                    class="nav-link <%= active === 'ads-advert_inserat' ? 'active' : '' %>">
                    <i class="bi bi-card-text me-1"></i>
                    Inserat
                  </a>
                </li>
                <li>
                  <a href="/admin/ads/examination"
                    class="nav-link <%= active === 'ads-advert_inserat' ? 'active' : '' %>">
                    <i class="bi bi-card-text me-1"></i>
                    Bezahlte Werbeanzeige Prüfen
                  </a>
                </li>
              </ul>
            </div>
          </li>

          <li class="nav-item">
            <a href="/admin/pages" class="nav-link <%= active === 'pages' ? 'active' : '' %>">
              <i class="bi bi-file-earmark-text me-1"></i>
              Seiten verwalten
            </a>
          </li>

          <!-- optional: direkt “Neue Seite” -->
          <li class="nav-item">
            <a href="/admin/pages/new" class="nav-link <%= active === 'pages-new' ? 'active' : '' %>">
              <i class="bi bi-plus-square me-1"></i>
              Neue Seite
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/landing" class="nav-link <%= active === 'pages' ? 'active' : '' %>">
              <i class="bi bi-file-earmark-text me-1"></i>
              Landingpages verwalten
            </a>
          </li>

          <!-- optional: direkt “Neue Seite” -->
          <li class="nav-item">
            <a href="/admin/landing/new" class="nav-link <%= active === 'pages-new' ? 'active' : '' %>">
              <i class="bi bi-plus-square me-1"></i>
              Neue Landingpage
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/footer" class="nav-link <%= active === 'footer' ? 'active' : '' %>">
              <i class="bi bi-columns-gap me-1"></i>
              Footer verwalten
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/contacts" class="nav-link <%= active === 'contacts' ? 'active' : '' %>">
              <i class="bi bi-envelope me-1"></i>
              Kontakt‑Anfragen
            </a>
          </li>


          <li class="nav-item">
            <a href="/admin/postings" class="nav-link <%= active === 'footer' ? 'active' : '' %>">
              <i class="bi bi-columns-gap me-1"></i>
              Posts verwalten
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/packages/userpackages" class="nav-link <%= active === 'userpackages' ? 'active' : '' %>">

              Markenverwaltung
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/newsletter" class="nav-link <%= active === 'pages' ? 'active' : '' %>">
              <i class="bi bi-envelope me-1"></i>
              Newsletter verschicken
            </a>
          </li>

          <li class="nav-item">
            <a href="/admin/analytics" class="nav-link <%= active === 'pages' ? 'active' : '' %>">

          </li>
          <li class="nav-item">
            <a class="nav-link <%= active==='ui-translations' ? 'active fw-bold' : '' %>" href="/admin/seo">
              SEO - Metadaten
            </a>
          </li>

            <% } %>




              <li class="nav-item">
                <a href="/" class="nav-link <%= active === 'userpackages' ? 'active' : '' %>">
                  <i class="bi bi-house-fill me-1"></i>
                  Zur Startseite
                </a>

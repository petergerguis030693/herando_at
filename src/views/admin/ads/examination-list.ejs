            </a>
          </li>
          <li class="nav-item mb-2">
            <a href="/admin/users" class="nav-link <%= active === 'users-new' ? 'active' : '' %>">
              <i class="bi bi-people me-1"></i> Alle Benutzer anzeigen
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/contacts" class="nav-link <%= active === 'contacts' ? 'active' : '' %>">
              <i class="bi bi-envelope me-1"></i>
              Kontakt‑Anfragen
            </a>
          </li>
          <li class="nav-item">
            <a href="/admin/analytics" class="nav-link <%= active === 'pages' ? 'active' : '' %>">
              <i class="bi bi-graph-up-arrow me-2"></i>
              Analytics
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= active==='ui-translations' ? 'active fw-bold' : '' %>" href="/admin/ui">
              UI-Texte

              <li class="nav-item mt-4">
                <a class="nav-link text-danger" href="/admin/logout">Logout</a>
              </li>
      </ul>
    </nav>

  <!-- Hauptinhalt der Prüfung -->
  <div class="main-content flex-grow-1 p-3">
    <h1 class="mb-4">Anzeigen zur Prüfung</h1>

    <% for (const ent of entieties) { %>
      <div class="card mb-4">
        <div class="card-header">
          <h2><%= ent.name %></h2>
        </div>
        <div class="card-body">
          <div class="row">
            <% if (reviewMap[ent.id] && reviewMap[ent.id].length > 0) { %>
              <% reviewMap[ent.id].forEach(ad => { %>
                <div class="col-md-4 mb-4" id="ad-<%= ad.id %>">
                  <div class="card h-100 shadow-sm rounded">
                    <% if (ad.image) { %>
                      <img
                        src="<%= ad.image %>"
                        class="card-img-top rounded-top"
                        alt="<%= ad.name %>"
                        style="height: 200px; object-fit: cover;"
                      />
                    <% } else { %>
                      <div
                        class="d-flex justify-content-center align-items-center bg-light text-muted rounded-top"
                        style="height: 200px;"
                      >
                        Kein Bild verfügbar
                      </div>
                    <% } %>

                    <div class="card-body d-flex flex-column">
                      <!-- Hier wird der Name korrekt angezeigt -->
                      <h5 class="card-title text-truncate mb-2"><%= ad.name %></h5>

                      <!-- Prüfstatus visuell -->
                      <p class="card-text mb-3">
                        <% if (ad.examination_status === 1) { %>
                          <span class="text-success me-2" title="Genehmigt">
                            <i class="fas fa-check-circle fa-lg"></i>
                          </span>
                          <small class="text-muted">Genehmigt</small>
                        <% } else if (ad.examination_status === 2) { %>
                          <span class="text-danger me-2" title="Abgelehnt">
                            <i class="fas fa-times-circle fa-lg"></i>
                          </span>
                          <small class="text-muted">Abgelehnt</small>
                        <% } else { %>
                          <span class="text-warning me-2" title="Ausstehend">
                            <i class="fas fa-hourglass-half fa-lg"></i>
                          </span>
                          <small class="text-muted">Ausstehend</small>
                        <% } %>
                      </p>

                      <!-- Buttons zum Genehmigen/Ablehnen -->
                      <div class="mt-auto d-flex justify-content-between">
                        <% if (ad.examination_status === 0) { %>
                          <button
                            class="btn btn-success btn-sm me-2 approve-btn"
                            data-id="<%= ad.id %>"
                            data-entity-id="<%= ent.id %>"
                            data-table-name="<%= ent.table_name %>"
                          >
                            <i class="fas fa-check"></i> Genehmigen
                          </button>
                          <button
                            class="btn btn-danger btn-sm reject-btn"
                            data-id="<%= ad.id %>"
                            data-entity-id="<%= ent.id %>"
                            data-table-name="<%= ent.table_name %>"
                          >
                            <i class="fas fa-times"></i> Ablehnen
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="col-12">
                <p class="text-muted">Keine offenen Inserate zur Prüfung für diese Kategorie.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Genehmigen
    document.querySelectorAll('.approve-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const adId = btn.dataset.id;
        const entityId = btn.dataset.entityId;
        const tableName = btn.dataset.tableName;
        if (!confirm('Möchten Sie dieses Inserat wirklich genehmigen?')) return;
        try {
          const res = await fetch('/admin/ads/approve', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({adId, entityId, tableName})
          });
          if (res.ok) {
            alert('Inserat erfolgreich genehmigt!');
            location.reload();
          } else {
            const err = await res.json();
            alert('Fehler: ' + err.message);
          }
        } catch (e) {
          console.error(e);
          alert('Ein unerwarteter Fehler ist aufgetreten.');
        }
      });
    });

    // Ablehnen (ohne Modal, per prompt)
    document.querySelectorAll('.reject-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const adId = btn.dataset.id;
        const entityId = btn.dataset.entityId;
        const tableName = btn.dataset.tableName;
        const message = prompt('Bitte Begründung für die Ablehnung eingeben:');
        if (message === null) return;  // abgebrochen
        if (!confirm('Möchten Sie dieses Inserat wirklich ablehnen?')) return;
        try {
          const res = await fetch('/admin/ads/reject', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({adId, entityId, tableName, message})
          });
          if (res.ok) {
            alert('Inserat erfolgreich abgelehnt!');
            location.reload();
          } else {
            const err = await res.json();
            alert('Fehler: ' + err.message);
          }
        } catch (e) {
          console.error(e);
          alert('Ein unerwarteter Fehler ist aufgetreten.');
        }
      });
    });
  });
</script>

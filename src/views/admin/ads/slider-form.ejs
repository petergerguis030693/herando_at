<!-- views/admin/ads/slider-list.ejs -->
<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
<%- include('../sidebar', { active: active, role: role }) %>
  </aside>

  <!-- Main Content -->
  <main class="flex-fill p-4">
    <h1 class="mb-4">Spezial-Werbeanzeigen</h1>

    <% entieties.forEach(ent => { 
         // Für diese Kategorie ggf. bestehende Anzeige aus adsMap holen
         const ad = adsMap[ent.id];
    %>
      <section class="mb-5">
        <h2 class="h5 mb-3"><%= ent.name %></h2>

        <div class="bg-white border rounded p-4 d-flex justify-content-between align-items-center">
          <% if (ad) { %>
            <!-- Bestehende Anzeige -->
            <div>
              <p class="mb-1"><strong>Inserat-ID:</strong> <%= ad.advert_id %></p>
              <p class="mb-0">
                <strong>Zeitraum:</strong>
                <%= ad.start_date.toISOString().slice(0,10) %>
                &nbsp;–&nbsp;
                <%= ad.end_date.toISOString().slice(0,10) %>
              </p>
            </div>
            <div>
              <a href="/admin/ads/slider/<%= ad.id %>/edit" class="btn btn-sm btn-primary me-2">
                Bearbeiten
              </a>
              <form action="/admin/ads/slider/<%= ad.id %>/delete" method="post" class="d-inline">
                <button
                  type="submit"
                  class="btn btn-sm btn-danger"
                  onclick="return confirm('Wirklich löschen?')"
                >
                  Löschen
                </button>
              </form>
            </div>
          <% } else { %>
            <!-- Neue Anzeige anlegen -->
            <a
              href="/admin/ads/slider/new?entitie_id=<%= ent.id %>"
              class="btn btn-outline-primary"
            >
              + Werbeanzeige hinzufügen
            </a>
          <% } %>
        </div>
      </section>
    <% }) %>
  </main>
</div>

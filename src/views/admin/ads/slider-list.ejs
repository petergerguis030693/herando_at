<!-- views/admin/ads/slider-list.ejs -->
<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
<%- include('../sidebar', { active: active, role: role }) %>
  </aside>
  <link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
  rel="stylesheet"
  integrity="..."
  crossorigin="anonymous"
>
<main class="flex-fill p-4">
  <h1 class="mb-4">Spezial-Werbeanzeigen</h1>

  <% entieties.forEach(ent => {
       const ad = adsMap[ent.id];
  %>
    <section class="mb-5">
      <h2 class="h5 mb-3"><%= ent.name %></h2>
      <div
        id="box-<%=ent.id%>"
        class="bg-light border rounded p-4 text-center"
        style="min-height:200px; position:relative;"
      >
        <% if (ad) { %>
          <img
            id="img-<%=ent.id%>"
            src="<%=ad.image%>"
            class="img-fluid"
            style="height:500px; width: 100%;"
          >
          <div class="mt-2">
            <button
              class="btn btn-sm btn-primary me-2"
              data-bs-toggle="modal"
              data-bs-target="#modal-edit-<%=ent.id%>"
            >✏️ Bearbeiten</button>
            <button
              class="btn btn-sm btn-danger"
              onclick="deleteEntry(<%=ad.id%>,<%=ent.id%>)"
            >🗑️ Löschen</button>
          </div>
        <% } else { %>
          <button
            class="btn btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#modal-new-<%=ent.id%>"
          >+ Werbeanzeige hinzufügen</button>
        <% } %>
      </div>
    </section>
  <% }) %>

  <!-- NEW-Modal -->
  <% entieties.forEach(ent => {
       if (!adsMap[ent.id]) {
  %>
    <div class="modal fade" id="modal-new-<%=ent.id%>" tabindex="-1">
      <div class="modal-dialog"><div class="modal-content">
        <form onsubmit="applyNew(<%=ent.id%>); return false;">
          <input type="hidden" name="entitie_id" value="<%=ent.id%>">
          <div class="modal-header">
            <h5 class="modal-title">Neue Anzeige für <%=ent.name%></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Inserat</label>
              <select
                id="new-select-<%=ent.id%>"
                name="advert_id"
                class="form-select"
                onchange="previewNew(<%=ent.id%>)"
                required
              >
                <option value="">– wählen –</option>
                <% advertsMap[ent.id].forEach(a => { %>
                  <option
                    value="<%=a.id%>"
                    data-image="<%=a.image%>"
                  ><%=a.name%></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Startdatum</label>
              <input type="date" name="start_date" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Enddatum</label>
              <input type="date" name="end_date" class="form-control" required>
            </div>
            <div class="text-center">
              <img
                id="new-preview-<%=ent.id%>"
                src=""
                class="img-fluid d-none"
                style="max-height:180px;"
              >
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary"
                    data-bs-dismiss="modal">Abbrechen</button>
            <button type="submit" class="btn btn-primary">Speichern</button>
          </div>
        </form>
      </div></div>
    </div>
  <% } }) %>

  <!-- EDIT-Modal -->
  <% entieties.forEach(ent => {
       const ad = adsMap[ent.id];
       if (ad) {
  %>
    <div class="modal fade" id="modal-edit-<%=ent.id%>" tabindex="-1">
      <div class="modal-dialog"><div class="modal-content">
        <form onsubmit="applyEdit(<%=ad.id%>,<%=ent.id%>); return false;">
          <div class="modal-header">
            <h5 class="modal-title">Anzeige bearbeiten für <%=ent.name%></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Inserat</label>
              <select
                id="edit-select-<%=ent.id%>"
                name="advert_id"
                class="form-select"
                onchange="previewEdit(<%=ent.id%>)"
                required
              >
                <% advertsMap[ent.id].forEach(a => { %>
                  <option
                    value="<%=a.id%>"
                    data-image="<%=a.image%>"
                    <%= a.id===ad.advert_id?'selected':'' %>
                  ><%=a.name%></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Startdatum</label>
              <input
                type="date"
                id="edit-start-<%=ent.id%>"
                name="start_date"
                class="form-control"
                value="<%=ad.start_date.toISOString().slice(0,10)%>"
                required
              >
            </div>
            <div class="mb-3">
              <label class="form-label">Enddatum</label>
              <input
                type="date"
                id="edit-end-<%=ent.id%>"
                name="end_date"
                class="form-control"
                value="<%=ad.end_date.toISOString().slice(0,10)%>"
                required
              >
            </div>
            <div class="text-center">
              <img
                id="edit-preview-<%=ent.id%>"
                src="<%=ad.image%>"
                class="img-fluid"
                style="max-height:180px;"
              >
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary"
                    data-bs-dismiss="modal">Abbrechen</button>
            <button type="submit" class="btn btn-primary">Aktualisieren</button>
          </div>
        </form>
      </div></div>
    </div>
  <% } }) %>

</main>

<script>
  function previewNew(entId) {
    const sel = document.getElementById('new-select-' + entId);
    const url = sel.selectedOptions[0]?.dataset.image;
    const img = document.getElementById('new-preview-' + entId);
    if (url) { img.src = url; img.classList.remove('d-none'); }
    else    { img.classList.add('d-none'); }
  }

  function applyNew(entId) {
    const modalEl = document.getElementById('modal-new-' + entId);
    const form    = modalEl.querySelector('form');
    const data    = new URLSearchParams(new FormData(form));
    fetch('/admin/ads/slider/new', {
      method: 'POST', body: data,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(json => {
      bootstrap.Modal.getInstance(modalEl).hide();
      location.reload(); // vereinfacht: Page neu laden, damit alle Modals da sind
    })
    .catch(console.error);
  }

  function previewEdit(entId) {
    const sel = document.getElementById('edit-select-' + entId);
    const url = sel.selectedOptions[0]?.dataset.image;
    const img = document.getElementById('edit-preview-' + entId);
    if (url) img.src = url;
  }

  function applyEdit(sliderId, entId) {
    const modalEl = document.getElementById('modal-edit-' + entId);
    const form    = modalEl.querySelector('form');
    const data    = new URLSearchParams(new FormData(form));
    fetch(`/admin/ads/slider/${sliderId}/edit`, {
      method: 'POST', body: data,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(() => location.reload())
    .catch(console.error);
  }

  function deleteEntry(sliderId, entId) {
    if (!confirm('Wirklich löschen?')) return;
    fetch(`/admin/ads/slider/${sliderId}/delete`, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(() => location.reload())
    .catch(console.error);
  }
</script>
<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
  integrity="..."
  crossorigin="anonymous"
></script>

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin – Aktive Inserate Übersicht</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Dein eigenes Admin‑CSS -->
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-light">
  <div class="d-flex">
    <!-- Sidebar -->
    <%- include('./sidebar', { active: active }) %>

    <!-- Main Content -->
    <main class="main-content flex-fill">
      <!-- Optional: Dein Header‑Partial -->
      <%- include('admin/_header', { role }) %>

      <div class="content">
        <h2>Aktive Inserate Übersicht</h2>
        <div class="row">
          <% Object.entries(counts).forEach(([cat, cnt]) => { %>
            <div class="col-md-3 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title text-capitalize"><%= cat %></h5>
                  <p class="display-4 mb-0"><%= cnt %></p>
                </div>
                <div class="card-footer">
                  <a href="/admin/listings?category=<%= cat %>" class="btn btn-sm btn-primary">&gt;</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </main>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

      tr.innerHTML = `
        <td>${r.created_at || '–'}</td>
        <td>${roleLabel}</td>
        <td>${userLabel}</td>
        <td>${r.path || '–'}</td>
        <td>${element || '–'}</td>
        <td>${r.element_text || '–'}</td>
        <td>${r.target_url || '–'}</td>
      `;
      tb.appendChild(tr);
    }
  }

  const donutCharts = Object.create(null);
  async function loadDonut(endpoint, canvasId) {
    const rows = await getJSON(`/admin/analytics/${endpoint}?${qs()}`);
    const labels = rows.map(r => Object.values(r)[0] || 'unknown');
    const values = rows.map(r => Number(Object.values(r)[1] || 0));
    const ctx = document.getElementById(canvasId).getContext('2d');
    if (donutCharts[canvasId]) donutCharts[canvasId].destroy();
    donutCharts[canvasId] = new Chart(ctx, {
      type: 'doughnut',
      data: { labels, datasets: [{ data: values }] },
      options: { plugins: { legend: { position: 'bottom' } } }
    });
    return donutCharts[canvasId];
  }

  async function loadCountriesChart() {
    const c = await getJSON(`/admin/analytics/countries.json?${qs()}&limit=20`);
    const ctx = document.getElementById('chartCountries').getContext('2d');
    if (chCountries) chCountries.destroy();
    chCountries = new Chart(ctx, {
      type: 'bar',
      data: { labels: c.map(r => r.country || '–'), datasets: [{ label: 'Sessions', data: c.map(r => Number(r.sessions || 0)) }] },
      options: {
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  }

  async function loadBarsEntryExit() {
    const data = await getJSON(`/admin/analytics/entry-exit.json?${qs()}`);
    const entries = (data.entries || []).slice(0, 15);
    const exits = (data.exits || []).slice(0, 15);

    const eCtx = document.getElementById('chartEntries').getContext('2d');
    if (chEntries) chEntries.destroy();
    chEntries = new Chart(eCtx, {
      type: 'bar',
      data: {
        labels: entries.map(r => r.path),
        datasets: [{ label: 'Entries', data: entries.map(r => Number(r.entries || 0)) }]
      },
      options: {
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });

    const xCtx = document.getElementById('chartExits').getContext('2d');
    if (chExits) chExits.destroy();
    chExits = new Chart(xCtx, {
      type: 'bar',
      data: {
        labels: exits.map(r => r.path),
        datasets: [{ label: 'Exits', data: exits.map(r => Number(r.exits || 0)) }]
      },
      options: {
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });
  }

  function wireExports() {
    const q = qs();
    document.getElementById('exportPv').href = `/admin/analytics/export/pageviews.csv?${q}`;
    document.getElementById('exportEv').href = `/admin/analytics/export/events.csv?${q}`;
  }

  async function loadAll() {
    try {
      validRangeOrFix();
      clearError();
      setBusy(true);
      highlightActivePreset();
      syncUrl();
      if (statusEl) statusEl.textContent = 'Lade Analytics-Daten…';
      wireExports();

      const jobs = await Promise.allSettled([
        loadSummary(),
        loadTable('top-pages.json', 'tblPages',
          [{ key: 'path', maxLen: 70 }, { key: 'views', align: 'end' }, { key: 'avg_time_s', align: 'end' }],
          'Keine Seitenaufrufe im Zeitraum.'
        ),
        loadTable('top-clicks.json', 'tblClicks',
          [{ key: 'path', maxLen: 55 }, { key: 'target', maxLen: 70 }, { key: 'clicks', align: 'end' }],
          'Keine Klicks im Zeitraum.'
        ),
        loadTable('searches.json', 'tblSearches',
          [{ key: 'query', maxLen: 70 }, { key: 'cnt', align: 'end' }],
          'Keine Suchen im Zeitraum.'
        ),
        loadTable('referrers.json', 'tblReferrers',
          [{ key: 'referer', maxLen: 70 }, { key: 'hits', align: 'end' }],
          'Keine Referrer im Zeitraum.'
        ),
        loadSessionsTable(),
        loadActivityTable(),
        loadClickEventsTable(),
        loadDonut('devices.json', 'chartDevices'),
        loadDonut('browsers.json', 'chartBrowsers'),
        loadDonut('os.json', 'chartOS'),
        loadCountriesChart(),
        loadBarsEntryExit(),
        loadInsights()
      ]);

      const failures = jobs.filter(j => j.status === 'rejected');
      if (failures.length) {
        showError(`${failures.length} Bereich(e) konnten nicht geladen werden. Details in der Browser-Konsole.`);
        failures.forEach(f => console.error(f.reason));
      } else {
        const now = new Date();
        if (statusEl) statusEl.textContent = `Zeitraum ${elFrom.value} – ${elTo.value} | Zuletzt aktualisiert: ${now.toLocaleTimeString('de-DE')}`;
      }
    } catch (err) {
      showError(err.message || 'Fehler beim Laden der Analytics-Daten.');
      console.error(err);
    } finally {
      setBusy(false);
    }
  }

  highlightActivePreset();
  const runActivityReload = () => {
    Promise.all([
      loadActivityTable(),
      loadClickEventsTable()
    ]).catch((err) => {
      showError(err.message || 'Fehler beim Laden der Aktivitaets-/Klickliste.');
      console.error(err);
    });
  };
  activityActorFilter?.addEventListener('change', runActivityReload);
  activityRoleFilter?.addEventListener('change', runActivityReload);
  activityMethodFilter?.addEventListener('change', runActivityReload);
  activityFilterApply?.addEventListener('click', runActivityReload);
  [activityUserFilter, activityPathFilter].forEach((el) => {
    el?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        ev.preventDefault();
        runActivityReload();
      }
    });
  });
  loadAll();
</script>

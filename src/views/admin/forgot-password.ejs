<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Admin Passwort zurücksetzen</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="d-flex align-items-center justify-content-center vh-100 bg-light">
  <div class="card p-4 shadow-sm" style="max-width: 420px; width:100%;">
    <div class="text-center mb-3">
      <img src="/assets/herando-weblogo.svg" alt="Herando" style="height: 120px;">
    </div>
    <h5 class="text-center mb-3">Admin-Passwort zurücksetzen</h5>
    <p class="text-muted small mb-3 text-center">
      Gib deine Admin-E-Mail ein. Wenn ein passendes Konto existiert, erhältst du einen Reset-Link.
    </p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <% if (!redirectHome) { %>
    <form action="/admin/forgot-password" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">E-Mail</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          placeholder="E-Mail eingeben"
          required
        >
      </div>
      <div class="d-grid mb-2">
        <button type="submit" class="btn btn-dark">Reset-Link senden</button>
      </div>
      <div class="text-center">
        <a href="/admin/login" class="small text-decoration-none">Zurück zum Login</a>
      </div>
    </form>
    <% } %>
  </div>
  <% if (redirectHome) { %>
    <script>
      setTimeout(() => { window.location.href = '/'; }, 1800);
    </script>
  <% } %>
</body>
</html>

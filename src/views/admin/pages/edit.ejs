<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active, role: role  }) %>
  </aside>

  <main class="main-content flex-fill">
    <header class="bg-herando text-white p-3 mb-4">
      <h1 class="h4 mb-0">
        <%= action === 'new'
            ? 'Neue Seite erstellen'
            : `Seite bearbeiten: ${page.slug}` %>
      </h1>
    </header>

    <div class="content container">
      <!-- Flash-Message -->
      <% if (flash.error) { %>
        <div class="alert alert-danger"><%= flash.error %></div>
      <% } %>
      <% const pageLangs = [
        { code: 'en', label: 'English' },
        { code: 'fr', label: 'Français' },
        { code: 'it', label: 'Italiano' },
        { code: 'tr', label: 'Türkçe' },
        { code: 'ja', label: '日本語' },
        { code: 'cs', label: 'Čeština' },
        { code: 'ru', label: 'Русский' },
        { code: 'es', label: 'Español' },
        { code: 'nl', label: 'Nederlands' },
        { code: 'pl', label: 'Polski' }
      ]; %>

      <form
        method="POST"
        action="<%= action === 'new'
                   ? '/admin/pages/new'
                   : `/admin/pages/${page.slug}/edit` %>"
      >
        <div class="mb-3">
          <label for="slug" class="form-label">Slug</label>
          <input
            type="text"
            id="slug"
            name="slug"
            class="form-control"
            required
            value="<%= page.slug || '' %>"
          />
          <small class="form-text text-muted">
            z. B. <code>agb</code>, <code>datenschutz</code> (wird Teil der URL)
          </small>
        </div>

        <div class="mb-3">
          <label for="title" class="form-label">Titel (Deutsch)</label>
          <input
            type="text"
            id="title"
            name="title"
            class="form-control"
            required
            value="<%= page.title || '' %>"
          />
        </div>

        <div class="mb-3">
        <label for="content" class="form-label">Inhalt (Deutsch, HTML)</label>
        <textarea
            id="content"
            name="content"
            rows="10"
            class="form-control js-ck-editor"
        ><%= page.content || '' %></textarea>
        </div>

        <hr class="my-4">
        <h5 class="mb-3">Übersetzungen</h5>
        <p class="text-muted">Diese Felder werden direkt in der Tabelle <code>pages</code> gespeichert.</p>

        <% pageLangs.forEach(l => { %>
          <div class="card mb-4">
            <div class="card-header">
              <strong><%= l.label %></strong> (<code><%= l.code %></code>)
            </div>
            <div class="card-body">
              <div class="mb-3">
                <label for="title_<%= l.code %>" class="form-label">Titel (<%= l.label %>)</label>
                <input
                  type="text"
                  id="title_<%= l.code %>"
                  name="title_<%= l.code %>"
                  class="form-control"
                  value="<%= page[`title_${l.code}`] || '' %>"
                />
              </div>

              <div class="mb-0">
                <label for="content_<%= l.code %>" class="form-label">Inhalt (<%= l.label %>, HTML)</label>
                <textarea
                  id="content_<%= l.code %>"
                  name="content_<%= l.code %>"
                  rows="8"
                  class="form-control js-ck-editor"
                ><%= page[`content_${l.code}`] || '' %></textarea>
              </div>
            </div>
          </div>
        <% }) %>

        <button type="submit" class="btn btn-primary">
          <%= action === 'new' ? 'Anlegen' : 'Speichern' %>
        </button>
        <a href="/admin/pages" class="btn btn-secondary ms-2">Abbrechen</a>
      </form>
    </div>
  </main>
</div>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ENjdO4Dr2bkBIFxQpeoYz1D3ZdZ7q2g9CFR+8a3vyzU6q4U+ht0GL0+c0pwzFvgP"
    crossorigin="anonymous"
  ></script>

<script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
<script>
  const editorConfig = {
    toolbar: [
      'heading', '|',
      'bold', 'italic', 'underline', '|',
      'link', 'bulletedList', 'numberedList', '|',
      'blockQuote', 'insertTable', 'undo', 'redo'
    ]
  };

  document.querySelectorAll('.js-ck-editor').forEach((el) => {
    ClassicEditor.create(el, editorConfig).catch((error) => console.error(error));
  });
</script>

<%- include('../sidebar', { active }) %>

<main class="flex-fill p-4">
  <h1 class="mb-4">
    <% if (news.id) { %>Artikel bearbeiten<% } else { %>Neuer Artikel<% } %>
  </h1>

  <!-- Haupt-Formular -->
  <form
    id="newsForm"
    action="<%= action %>"
    method="<%= method %>"
    enctype="multipart/form-data"
  >
    <div class="row g-3">
      <div class="col-md-2">
        <label for="language" class="form-label">Sprache</label>
        <select id="language" name="language" class="form-select" required>
          <option value="de" <%= news.language==='de'?'selected':'' %>>Deutsch</option>
          <option value="en" <%= news.language==='en'?'selected':'' %>>Englisch</option>
        </select>
      </div>

      <div class="col-md-10">
        <label for="title" class="form-label">Titel</label>
        <input
          type="text" id="title" name="title"
          class="form-control"
          value="<%= news.title||'' %>"
          required
        >
      </div>

      <div class="col-12">
        <label for="teaser" class="form-label">Teaser</label>
        <textarea
          id="teaser" name="teaser"
          class="form-control"
          rows="2" required
        ><%= news.teaser||'' %></textarea>
      </div>

      <div class="col-12">
        <label class="form-label">Inhalt</label>
        <!-- Quill-Editor Container -->
        <div id="editor" style="height: 300px; background: #fff; border: 1px solid #ccc;">
          <% if (news.description) { %>
            <%- news.description %>
          <% } %>
        </div>
        <!-- Verstecktes Feld für den HTML-Content -->
        <input type="hidden" name="description" id="hiddenDesc">
      </div>

      <div class="col-md-3">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select" required>
          <option value="1" <%= news.status===1?'selected':'' %>>Entwurf</option>
          <option value="2" <%= news.status===2?'selected':'' %>>Review</option>
          <option value="3" <%= news.status===3?'selected':'' %>>Veröffentlicht</option>
        </select>
      </div>

      <div class="col-md-3">
        <label for="published" class="form-label">Published</label>
        <input
          type="datetime-local" id="published" name="published"
          class="form-control"
          value="<%= news.published
            ? new Date(news.published).toISOString().slice(0,16)
            : '' %>"
        >
      </div>

      <div class="col-md-6">
        <label for="images" class="form-label">Bilder hochladen</label>
        <input
          type="file" id="images" name="images"
          class="form-control" multiple accept="image/*"
        >
      </div>
    </div>

    <hr class="my-4">

    <button type="submit" class="btn btn-success">
      <i class="bi bi-save me-1"></i>
      <% if (news.id) { %>Aktualisieren<% } else { %>Anlegen<% } %>
    </button>
    <a href="/admin/news" class="btn btn-secondary ms-2">Abbrechen</a>
  </form>

  <!-- Vorhandene Bilder (jetzt außerhalb des Haupt-Forms!) -->
  <% if (images && images.length) { %>
    <hr class="my-4">
    <h5>Vorhandene Bilder</h5>
    <div class="row g-3">
      <% images.forEach(fname => { %>
        <div class="col-3 text-center">
          <img
            src="/images/news/<%= news.id %>/<%= encodeURIComponent(fname) %>"
            class="img-fluid mb-2 border"
            style="max-height:120px; object-fit:cover;"
          >
          <button
            class="btn btn-sm btn-outline-danger"
            onclick="deleteImage('<%= news.id %>','<%= encodeURIComponent(fname) %>')"
          >
            🗑️
          </button>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<!-- Quill CSS & JS -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
  // 1. Quill initialisieren
  const quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ header: [1, 2, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block', 'link', 'image'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['clean']
      ]
    }
  });

  // 2. Beim Absenden die Beschreibung setzen
  document.getElementById('newsForm').addEventListener('submit', () => {
    document.getElementById('hiddenDesc').value = quill.root.innerHTML;
  });

  // 3. AJAX-Bildlöschung
  async function deleteImage(newsId, filename) {
    if (!confirm('Bild wirklich löschen?')) return;
    try {
      const res = await fetch(`/admin/news/${newsId}/delete-image`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ filename })
      });
      if (res.ok) location.reload();
      else alert('Fehler beim Löschen');
    } catch (err) {
      console.error(err);
      alert('Netzwerkfehler');
    }
  }
</script>

<!-- Bootstrap-Bundle (falls noch nicht global eingebunden) -->
<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
  integrity="..."
  crossorigin="anonymous"
></script>

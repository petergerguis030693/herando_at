<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active, role: role  }) %>
  </aside>
  <main class="flex-fill container py-4">
    <h1><%= action === 'new' ? 'Neues Posting' : 'Posting bearbeiten' %></h1>
    <% if (messages.error) { %>
      <div class="alert alert-danger"><%= messages.error %></div>
    <% } %>

    <form action="<%= action === 'new' ? '/admin/postings/new' : '/admin/postings/' + posting.slug + '/edit' %>" method="POST" enctype="multipart/form-data">

      <!-- Title & Slug -->
      <div class="mb-3">
        <label for="title" class="form-label">Titel</label>
        <input type="text" id="title" name="title" value="<%= posting.title || '' %>" class="form-control" required>
      </div>
      <div class="mb-3">
        <label for="slug" class="form-label">Slug (URL)</label>
        <input type="text" id="slug" name="slug" value="<%= posting.slug || '' %>" class="form-control" required>
      </div>

      <!-- Kategorie -->
      <div class="mb-3">
        <label for="category" class="form-label">Kategorie</label>
        <select id="category" name="category" class="form-select" required>
          <option value="magazin" <%= posting.category==='magazin'?'selected':'' %>>Magazin</option>
          <option value="news"    <%= posting.category==='news'   ?'selected':'' %>>News</option>
          <option value="presse"  <%= posting.category==='presse' ?'selected':'' %>>Presse</option>
        </select>
      </div>

      <!-- Autor & Ort -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="author" class="form-label">Autor</label>
          <input type="text" id="author" name="author" value="<%= posting.author || '' %>" class="form-control" required>
        </div>
        <div class="col-md-6 mb-3">
          <label for="location" class="form-label">Ort</label>
          <input type="text" id="location" name="location" value="<%= posting.location || '' %>" class="form-control">
        </div>
      </div>

      <div class="mb-3">
        <label for="published_at" class="form-label">Veröffentlichung</label>
        <input type="datetime-local" id="published_at" name="published_at" class="form-control" value="<%= typeof publishedAtInput !== 'undefined' ? publishedAtInput : '' %>">
        <div class="form-text">Datum und Uhrzeit, ab wann der Artikel öffentlich sichtbar ist. Feld leeren = Entwurf (nur im Admin, nicht auf der Website). Beim neuen Artikel ist standardmäßig „jetzt“ vorausgewählt.</div>
      </div>

      <!-- Cover Image -->
      <div class="mb-3">
        <label class="form-label">Cover-Bild</label>
        <% if (posting.cover_image) { %>
          <div class="mb-2">
            <img src="/uploads/postings/<%= posting.slug %>/<%= posting.cover_image %>" alt="Cover" class="img-thumbnail" style="max-width:200px;">
          </div>
        <% } %>
        <input type="file" name="cover_image" accept="image/*" class="form-control">
      </div>

      <!-- Additional Images -->
      <div class="mb-3">
        <label class="form-label">Weitere Bilder</label>
        <% if (posting.additional_images && posting.additional_images.length) { %>
          <div class="d-flex flex-wrap mb-2">
            <% posting.additional_images.forEach(img => { %>
              <div class="me-2 mb-2">
                <img src="/uploads/postings/<%= posting.slug %>/<%= img %>" alt="Extra" class="img-thumbnail" style="max-width:100px;">
              </div>
            <% }) %>
          </div>
        <% } %>
        <input type="file" name="additional_images" multiple accept="image/*" class="form-control">
        <input type="hidden" name="_old_additional" value='<%= JSON.stringify(posting.additional_images||[]) %>'>
      </div>

      <!-- Content (CKEditor) -->
      <div class="mb-3">
        <label for="content" class="form-label">Inhalt</label>
        <textarea id="content" name="content" class="form-control" style="height:400px;"><%= posting.content || '' %></textarea>
      </div>

      <button type="submit" class="btn btn-success">
        <%= action === 'new' ? 'Anlegen' : 'Speichern' %>
      </button>
    </form>
  </main>
</div>

<!-- CKEditor 5 Integration -->
<script src="https://cdn.ckeditor.com/ckeditor5/35.0.1/classic/ckeditor.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    ClassicEditor.create(document.querySelector('#content'))
      .catch(error => console.error(error));
  });
</script>
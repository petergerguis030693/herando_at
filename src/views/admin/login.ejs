<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Herando Admin-Panel Login</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="d-flex align-items-center justify-content-center vh-100 bg-light">

  <div class="card p-4 shadow-sm" style="max-width: 360px; width:100%;">
    <div class="text-center mb-4">
      <img src="/assets/herando-weblogo.svg" alt="Herando" style="height: 150px;">
    </div>
    <h5 class="text-center mb-4">Admin-Panel Login</h5>

    <% if (error) { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="mb-3">
        <label for="username" class="form-label">E-Mail</label>
        <input
          type="email"
          id="username"
          name="username"
          class="form-control"
          placeholder="E-Mail eingeben"
          required
        >
      </div>
      <div class="mb-3 position-relative">
        <label for="password" class="form-label">Passwort</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Passwort eingeben"
          required
        >
        <i
          class="bi bi-eye-slash position-absolute"
          id="togglePassword"
          style="top: 38px; right: 12px; cursor:pointer;"
        ></i>
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-dark">Anmelden</button>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
  <script>
    const pwd = document.getElementById('password');
    const toggle = document.getElementById('togglePassword');
    toggle.addEventListener('click', () => {
      const type = pwd.type === 'password' ? 'text' : 'password';
      pwd.type = type;
      toggle.className = type === 'password' ? 'bi bi-eye-slash' : 'bi bi-eye';
    });
  </script>
</body>
</html>

          <option value="4113" <%= data.brand_id==='4113'?'selected':'' %>>Feinkost / Weine / Spirituosen</option>
          <option value="4107" <%= data.brand_id==='4107'?'selected':'' %>>Gesundheit</option>
          <option value="4110" <%= data.brand_id==='4110'?'selected':'' %>>Hotels &amp; Resorts</option>
          <option value="4115" <%= data.brand_id==='4115'?'selected':'' %>>Inneneinrichtungen</option>
          <option value="4114" <%= data.brand_id==='4114'?'selected':'' %>>Wohnmobile und Freizeitfahrzeuge</option>
          <option value="4109" <%= data.brand_id==='4109'?'selected':'' %>>Vermietung</option>
          <option value="4106" <%= data.brand_id==='4106'?'selected':'' %>>Dienstleistungen</option>
          <option value="4112" <%= data.brand_id==='4112'?'selected':'' %>>Reisen</option>
          <option value="4108" <%= data.brand_id==='4108'?'selected':'' %>>Wellness &amp; Spa</option>
        </select>
      </div>

      <!-- Unterkategorie -->
      <div class="col-md-4">
        <label for="model_id" class="form-label">Unterkategorie</label>
        <select id="model_id" name="model_id" class="form-select">
          <option value="">– wählen –</option>
          <!-- wird per JS befüllt -->
        </select>
      </div>
    </div>

    <!-- Überschrift Ihrer Anzeige -->
    <div class="mb-4">
      <label for="name" class="form-label">* Überschrift Ihrer Anzeige</label>
      <input type="text" id="name" name="name" class="form-control" value="<%= data.name||'' %>">
    </div>

    <!-- Preis / Währung -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <label for="price" class="form-label">Preis</label>
        <input type="number" id="price" name="price" class="form-control" step="any" value="<%= data.price||'' %>">
      </div>
      <div class="col-md-3">
        <label for="currency" class="form-label">Währung</label>
        <select id="currency" name="currency" class="form-select form-select--brown">
          <option value="">– wählen –</option>
          <% ['EUR','USD','CHF'].forEach(c => { %>
            <option value="<%=c%>" <%= data.currency===c?'selected':'' %>><%=c%></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Beschreibung -->
    <div class="mb-4">
      <label for="description" class="form-label">* Beschreibung</label>
      <textarea id="description" name="description" class="form-control" rows="6"><%= data.description||'' %></textarea>
    </div>
    <div class="mb-3">
      <label for="video" class="form-label">Link zum Video</label>
      <input type="text" id="video" name="video" class="form-control" value="<%= data.video||'' %>">
    </div>

    <!-- Standort -->
    <fieldset class="border p-3 mb-4">
      <legend class="px-2">Standort</legend>
      <div class="row g-3">
        <div class="col-md-4">
          <label for="country_id" class="form-label">* Land</label>
          <select id="country_id" name="country_id" class="form-select" required>
            <option value="">– wählen –</option>
            <% countries.forEach(c => { %>
              <option value="<%=c.id%>" <%= data.country_id==c.id?'selected':'' %>><%=c.label%></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label for="state_id" class="form-label">Bundesland</label>
          <select id="state_id" name="state_id" class="form-select">
            <option value="">– wählen –</option>
          </select>
        </div>
        <div class="col-md-4">
          <label for="city" class="form-label">* Stadt</label>
          <input type="text" id="city" name="city" class="form-control" required value="<%= data.city||'' %>">
        </div>
      </div>
    </fieldset>
  </fieldset>

  <!-- JavaScript zum dynamischen Nachladen der Unterkategorien -->
  <script>
    const subcats = {
      '4105': [ // Accessoires
        { id: '6419', label: 'Bekleidung und Schuhe' },
        { id: '6420', label: 'Brillen' },
        { id: '6424', label: 'Dekoration' },
        { id: '6421', label: 'Elektronik - Elektro Geräte' },
        { id: '6422', label: 'Fun- und Sportgeräte' },
        { id: '6423', label: 'Handtaschen' },
        { id: '6425', label: 'Kosmetik und Parfüm' },
        { id: '6426', label: 'Kunst' },
        { id: '6427', label: 'Schmuck und Juwelen' },
        { id: '6428', label: 'Sonstige' }
      ],
      '4107': [ // Gesundheit
        { id: '6433', label: 'Detox Clinics' },
        { id: '6434', label: 'Gesundheitszentren' },
        { id: '6435', label: 'Health Tech' },
        { id: '6437', label: 'Hotels' },
        { id: '6436', label: 'Longevity Clinics' },
        { id: '6438', label: 'Zahnmedizin' }
      ],
      '4109': [ // Vermietung
        { id: '6431', label: 'Autos' },
        { id: '6429', label: 'Boote / Yachten' },
        { id: '6430', label: 'Flugzeuge' },
        { id: '6432', label: 'Wohnmobile und Freizeitfahrzeuge' }
      ],
      '4112': [ // Reisen
        { id: '6418', label: 'Aktivsport' }
      ]
      // … ggf. noch weitere …
    };

    document.getElementById('brand_id').addEventListener('change', function() {
      const sel = document.getElementById('model_id');
      sel.innerHTML = '<option value="">– wählen –</option>';
      (subcats[this.value]||[]).forEach(o => {
        const opt = document.createElement('option');
        opt.value = o.id;
        opt.textContent = o.label;
        sel.appendChild(opt);
      });
    });

    // Bei Reload vorhandene Werte wiederherstellen:
    window.addEventListener('DOMContentLoaded', () => {
      const b = '<%= data.brand_id||'' %>';
      const m = '<%= data.model_id||'' %>';
      if (b) {
        const br = document.getElementById('brand_id');
        br.value = b;
        br.dispatchEvent(new Event('change'));
        if (m) document.getElementById('model_id').value = m;
      }
    });
  </script>
<% } %>

        <!-- Bilder Upload & Submit -->
        <div class="mb-3">
          <label class="form-label">Hauptbild</label>
          <input type="file" name="mainpicture" class="form-control" accept="image/*">
        </div>
        <div class="mb-3">
          <label class="form-label">Galeriebilder</label>
          <input type="file" name="pictures" class="form-control" accept="image/*" multiple>
        </div>
        <div class="d-flex justify-content-between">
          <button type="submit" class="btn btn-primary">Weiter zur Vorschau &rarr;</button>
        </div>
      </form>

    <% } else if (step === 2) { %>
      <!-- STEP 2: Vorschau & Bestätigung -->
      <h3 class="mb-4">2. Vorschau & Bestätigung</h3>
      <dl class="row mb-4">
        <dt class="col-sm-3">Kategorie</dt>
        <dd class="col-sm-9"><%=entity.name%></dd>
        <% if (isCars) { %>
          <dt class="col-sm-3">Marke</dt>
          <dd class="col-sm-9"><%=brands.find(b=>b.id===data.brand_id)?.name%></dd>
          <dt class="col-sm-3">Modell</dt>
          <dd class="col-sm-9"><%=models.find(m=>m.id===data.model_id)?.name%></dd>
        <% } %>
      </dl>
      <form method="post" action="/admin/listings/new">
        <input type="hidden" name="step" value="2">
        <div class="d-flex justify-content-between">
          <a href="?step=1&entId=<%=data.entId%><% if(isCars){ %>&brand_id=<%=data.brand_id%>&model_id=<%=data.model_id%><% } %>"
             class="btn btn-outline-secondary">&larr; Bearbeiten</a>
          <button type="submit" class="btn btn-success">Inserat erstellen</button>
        </div>
      </form>
    <% } %>

  </main>
</div>

<script>
  // JS für MwSt‑Anzeige
  document.addEventListener('DOMContentLoaded', () => {
    const chk     = document.getElementById('vat');
    const wrapper = document.getElementById('vat_rate_container');
    function toggle() {
      wrapper.style.display = chk.checked ? 'block' : 'none';
    }
    chk.addEventListener('change', toggle);
    toggle();
  });
</script>

<%# views/admin/listings/new-wizard.ejs %>
<%
  // Aktuelle Entität ermitteln
  const entity       = entieties.find(e => e.id === data.entId);
  const isCars       = entity && entity.route === 'cars';
  const isWatches    = entity && entity.route === 'watches';
  const isYachts     = entity && entity.route === 'yachts';
  const isProperties = entity && entity.route === 'properties';
  const isLifestyles = entity && entity.route === 'lifestyles';
  const thisYear     = new Date().getFullYear();
%>
<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width:250px">
    <%- include('../sidebar', { active: active }) %>
  </aside>
  <main class="flex-fill p-4">

    <style>
      .form-select--brown {
        border: 1px solid #a67c52;
        color: #5c3a21;
      }
      .form-select--brown:focus {
        box-shadow: 0 0 0 .2rem rgba(140,90,50,.25);
      }
      .btn-langzeit {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
      }
    </style>

    <!-- Wizard Steps -->
    <ul class="wizard list-unstyled d-flex justify-content-between mb-4">
      <li class="text-center flex-fill">
        <div class="badge <%= step===1?'bg-primary':'bg-success' %> text-white rounded-circle mb-1"
             style="width:32px;height:32px;line-height:32px">1</div>
        <div>Eingaben</div>
      </li>
      <li class="text-center flex-fill">
        <div class="badge <%= step===2?'bg-primary':'bg-secondary' %> text-white rounded-circle mb-1"
             style="width:32px;height:32px;line-height:32px">2</div>
        <div>Vorschau</div>
      </li>
    </ul>

    <% if (step === 1) { %>
      <!-- STEP 1: GET‑Formular -->
      <form method="get" action="/admin/listings/new" class="mb-4">
        <input type="hidden" name="step" value="1">
        <div class="row g-3">
          <div class="col-md-4">
            <label for="entId" class="form-label">Kategorie</label>
<select id="entId" name="entId" class="form-select" required onchange="this.form.submit()">
  <% entieties.forEach(ent => { %>
    <option value="<%= ent.id %>" <%= Number(data.entId) === Number(ent.id) ? 'selected' : '' %>>
      <%= ent.name %>
    </option>
  <% }) %>
</select>



          </div>
          <% if (isCars) { %>
            <div class="col-md-4">
              <label for="brand_id" class="form-label">Marke</label>
              <select id="brand_id" name="brand_id" class="form-select" onchange="this.form.submit()">
                <option value="">– Marke wählen –</option>
                <% brands.forEach(b=>{ %>
                  <option value="<%=b.id%>" <%=data.brand_id===b.id?'selected':''%>><%=b.name%></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-4">
              <label for="model_id" class="form-label">Modell</label>
              <select id="model_id" name="model_id" class="form-select" onchange="this.form.submit()">
                <option value="">– Modell wählen –</option>
                <% models.forEach(m=>{ %>
                  <option value="<%=m.id%>" <%=data.model_id===m.id?'selected':''%>><%=m.name%></option>
                <% }) %>
              </select>
            </div>
          <% } %>
        </div>
      </form>

      <!-- STEP 1: POST‑Formular -->
      <form method="post" action="/admin/listings/new" enctype="multipart/form-data">
        <input type="hidden" name="step"     value="1">
        <input type="hidden" name="entId"    value="<%=data.entId||''%>">
        <input type="hidden" name="brand_id" value="<%=data.brand_id||''%>">
        <input type="hidden" name="model_id" value="<%=data.model_id||''%>">
        <input type="hidden" name="visible"  value="0">
        <input type="hidden" name="status"   value="1">

<% if (isCars) { %>
  <% 
    // Helfer und Konstante
    const findAttr = col => attrs.find(a => a.column_name === col);
    const thisYear = new Date().getFullYear();

    // Gruppen‑Definition für Cars (Allgemeine Angaben außen vor)
    const groups = [
      { legend: 'Technische Daten',   fields: ['engine','mileage','capacity','power'] },
      { legend: 'Verbrauch',           fields: ['fuel','emission_co2','consumption_city','consumption_country','consumption_combined','pollution_class','environmental_badge','emission_class'] },
      { legend: 'Sicherheit',          fields: ['airbags','isofix','abs','esp','asr','hill_climb','fatigue','dimming_mirror','nightvision','emergency_call','traffic_signs'] },
      { legend: 'Komfort',             fields: ['climatisation','aux_heating','electric_heated_seats','ventilated_seats','electric_windows','electric_adjusted_seats','electric_mirrors','electric_tailgate','central_locking','keyless_central_locking','assisted_steering','cruise_control','adaptive_cruise_control','collision_avoidance','blind_spot_monitor','lane_departure_warning','head_up_display','light_sensor','rain_sensor','startstop_system','heated_windshield','heated_steering_wheel','arm_rest','lumbar_support','massage_seats','fold_flat_passenger_seat','ambient_lighting','leather_steering_wheel'] },
      { legend: 'Infotainment',        fields: ['tuner_radio','radio_dab','cdplayer','mp3interface','navigation','tv','soundsystem','touchscreen','voice_control','usb','apple_car_play','android_auto','wifi_hotspot','music_streaming','inductive_charging','digital_cockpit','onboard_computer','multifunction_steeringwheel','bluetooth','handsfree_kit'] },
      { legend: 'Extras',              fields: ['alloy_wheels','sports_package','sports_suspension','sports_seats','trailer_coupling','roof_rack','skibag','sunroof','panoramic_roof','taxi','disabled_accessible','summer_tires','winter_tires','all_season_tires','tire_pressure_monitoring','winter_package','smokers_package','air_suspension'] },
      { legend: 'Beschreibung',        fields: ['description','video'] },
      { legend: 'Standort',            fields: ['country_id','state_id','city'] }
    ];
  %>

  <!-- ── Allgemeine Angaben ───────────────────────────────────────────────────── -->
  <fieldset class="border p-3 mb-4">
    <legend class="px-2">Allgemeine Angaben</legend>

    <!-- Marke & Modell -->
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <label for="brand_id" class="form-label">* Marke</label>
        <select id="brand_id" name="brand_id" class="form-select" required>
          <option value="">– wählen –</option>
          <% brands.forEach(b => { %>
            <option value="<%=b.id%>" <%=data.brand_id==b.id?'selected':''%>><%=b.name%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label for="model_id" class="form-label">* Modell</label>
        <select id="model_id" name="model_id" class="form-select" required>
          <option value="">– wählen –</option>
          <% models.forEach(m => { %>
            <option value="<%=m.id%>" <%=data.model_id==m.id?'selected':''%>><%=m.name%></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Titel -->
    <div class="mb-4">
      <label for="name" class="form-label">* Überschrift Ihrer Anzeige</label>
      <input type="text" id="name" name="name" class="form-control" required
             value="<%=data.name||''%>">
    </div>

    <!-- Preis / Währung / MwSt -->
    <div class="row g-3 mb-4 align-items-end">
      <div class="col-md-3">
        <label for="price" class="form-label">Preis</label>
        <input type="number" id="price" name="price" class="form-control" step="any"
               value="<%=data.price||''%>">
      </div>
      <div class="col-md-3">
        <label for="currency" class="form-label">Währung</label>
        <select id="currency" name="currency" class="form-select form-select--brown">
          <option value="">– wählen –</option>
          <% ['EUR','USD','CHF'].forEach(c => { %>
            <option value="<%=c%>" <%=data.currency===c?'selected':''%>><%=c%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="vat" name="vat" value="1"
                 <%=data.vat?'checked':''%>>
          <label class="form-check-label" for="vat">MwSt</label>
        </div>
      </div>
      <div class="col-md-2" id="vat_rate_container" style="display:none;">
        <label for="taxrate" class="form-label">Steuersatz (%)</label>
        <input type="number" id="taxrate" name="taxrate" class="form-control" step="any"
               value="<%=data.taxrate||''%>">
      </div>
    </div>

    <!-- Erstzulassung / Nächste HU / Baujahr -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <label class="form-label">Erstzulassung</label>
        <div class="d-flex">
          <select name="firstregistration_month" class="form-select me-1">
            <option value="">– Mon –</option>
            <% for(let m=1; m<=12; m++){ %>
              <option value="<%=m%>" <%=data.firstregistration_month==m?'selected':''%>>
                <%=m.toString().padStart(2,'0')%>
              </option>
            <% } %>
          </select>
          <select name="firstregistration" class="form-select">
            <option value="">– Jahr –</option>
            <% for(let y=thisYear; y>=1900; y--){ %>
              <option value="<%=y%>" <%=data.firstregistration==y?'selected':''%>><%=y%></option>
            <% } %>
          </select>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label">Nächste HU</label>
        <div class="d-flex">
          <select name="maininspection_month" class="form-select me-1">
            <option value="">– Mon –</option>
            <% for(let m=1; m<=12; m++){ %>
              <option value="<%=m%>" <%=data.maininspection_month==m?'selected':''%>>
                <%=m.toString().padStart(2,'0')%>
              </option>
            <% } %>
          </select>
          <select name="maininspection" class="form-select">
            <option value="">– Jahr –</option>
            <% for(let y=thisYear; y>=1900; y--){ %>
              <option value="<%=y%>" <%=data.maininspection==y?'selected':''%>><%=y%></option>
            <% } %>
          </select>
        </div>
      </div>
      <div class="col-md-2">
        <label for="year" class="form-label">Baujahr</label>
        <select id="year" name="year" class="form-select">
          <option value="">– Jahr –</option>
          <% for(let y=thisYear; y>=1900; y--){ %>
            <option value="<%=y%>" <%=data.year==y?'selected':''%>><%=y%></option>
          <% } %>
        </select>
      </div>
    </div>

    <!-- Shape / Farbe / Metallic -->
    <div class="row g-3 mb-4 align-items-center">
      <div class="col-md-4">
        <label for="shape" class="form-label"><%=findAttr('shape').label%></label>
        <select id="shape" name="shape" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('shape').options.forEach(o=>{ %>
            <option value="<%=o.id%>" <%=data.shape==o.id?'selected':''%>><%=o.label%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="color" class="form-label"><%=findAttr('color').label%></label>
        <select id="color" name="color" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('color').options.forEach(o=>{ %>
            <option value="<%=o.id%>" <%=data.color==o.id?'selected':''%>><%=o.label%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1">
        <div class="form-check mt-4">
          <input class="form-check-input" type="checkbox" id="metallic" name="metallic" value="1"
                 <%=data.metallic?'checked':''%>>
          <label class="form-check-label" for="metallic">Metallic</label>
        </div>
      </div>
    </div>

    <!-- Interior / Innenfarbe / Langzeitmiete -->
    <div class="row g-3 mb-4 align-items-center">
      <div class="col-md-4">
        <label for="interior" class="form-label"><%=findAttr('interior').label%></label>
        <select id="interior" name="interior" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('interior').options.forEach(o=>{ %>
            <option value="<%=o.id%>" <%=data.interior==o.id?'selected':''%>><%=o.label%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="interior_color" class="form-label"><%=findAttr('interior_color').label%></label>
        <select id="interior_color" name="interior_color" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('interior_color').options.forEach(o=>{ %>
            <option value="<%=o.id%>" <%=data.interior_color==o.id?'selected':''%>><%=o.label%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <button type="button" class="btn btn-langzeit mt-2">Langzeitmiete</button>
      </div>
    </div>

    <!-- Checkbook / Unfallfrei / Nichtraucher -->
    <div class="row g-3 mb-4">
      <% ['checkbook','accident_free','non_smoking'].forEach(fn => {
           const attr = findAttr(fn);
           if (!attr) return;
      %>
        <div class="col-auto">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="<%=fn%>" name="<%=fn%>" value="1"
                   <%=data[fn]?'checked':''%>>
            <label class="form-check-label" for="<%=fn%>"><%=attr.label%></label>
          </div>
        </div>
      <% }) %>
    </div>
  </fieldset>

  <!-- ── Restliche Car‑Gruppen über Loop ────────────────────────────────────── -->
  <% groups.forEach(group => { %>
    <fieldset class="border p-3 mb-4">
      <legend class="px-2"><%=group.legend%></legend>
      <% 
        // für die vier Grid‑Legenden nutze Grid‑Layout
        const isGrid = ['Sicherheit','Komfort','Infotainment','Extras'].includes(group.legend);
      %>
      <% if (isGrid) { %>
        <div class="row row-cols-2 row-cols-md-5 g-3 mb-3">
          <% group.fields.forEach(fn => {
               const attr = findAttr(fn);
               if (!attr) return;
          %>
            <div class="col">
              <div class="form-check">
                <input type="hidden" name="<%=fn%>" value="0">
                <input class="form-check-input" type="checkbox" id="<%=fn%>" name="<%=fn%>" value="1"
                       <%=data[fn]?'checked':''%>>
                <label class="form-check-label" for="<%=fn%>"><%=attr.label%></label>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <% group.fields.forEach(fn => {
             const attr = findAttr(fn);
             if (!attr) return;
        %>
          <div class="mb-3">
            <label for="<%=fn%>" class="form-label"><%=attr.label%></label>
            <% if (attr.field_type==='select') { %>
              <select id="<%=fn%>" name="<%=fn%>" class="form-select">
                <option value="">– wählen –</option>
                <% attr.options.forEach(o=>{ %>
                  <option value="<%=o.id%>" <%=data[fn]==o.id?'selected':''%>><%=o.label%></option>
                <% }) %>
              </select>
            <% } else if (attr.field_type==='number') { %>
              <input type="number" id="<%=fn%>" name="<%=fn%>" class="form-control" step="any"
                     value="<%=data[fn]||''%>">
            <% } else if (attr.field_type==='textarea') { %>
              <textarea id="<%=fn%>" name="<%=fn%>" class="form-control" rows="4"><%=data[fn]||''%></textarea>
            <% } else if (attr.field_type==='boolean') { %>
              <div class="form-check">
                <input type="hidden" name="<%=fn%>" value="0">
                <input class="form-check-input" type="checkbox" id="<%=fn%>" name="<%=fn%>" value="1"
                       <%=data[fn]?'checked':''%>>
                <label class="form-check-label" for="<%=fn%>"><%=attr.label%></label>
              </div>
            <% } else { %>
              <input type="text" id="<%=fn%>" name="<%=fn%>" class="form-control"
                     value="<%=data[fn]||''%>">
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </fieldset>
  <% }) %>


        <% } else if (isWatches) { %>
<% if (isWatches) { %>
  <% 
    const findAttr = col => attrs.find(a => a.column_name === col);
    const thisYear = new Date().getFullYear();
  %>

  <!-- Allgemeine Angaben -->
  <fieldset class="border p-3 mb-4">
    <legend class="px-2">Allgemeine Angaben</legend>
    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label for="brand_id" class="form-label"><%= findAttr('brand_id').label %></label>
        <select id="brand_id" name="brand_id" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('brand_id').options.forEach(o => { %>
            <option value="<%= o.id %>" <%= data.brand_id==o.id?'selected':'' %>><%= o.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="model_id" class="form-label"><%= findAttr('model_id').label %></label>
        <select id="model_id" name="model_id" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('model_id').options.forEach(o => { %>
            <option value="<%= o.id %>" <%= data.model_id==o.id?'selected':'' %>><%= o.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="reference" class="form-label"><%= findAttr('reference').label %></label>
        <input type="text" id="reference" name="reference" class="form-control" value="<%= data.reference||'' %>">
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label for="adnumber" class="form-label"><%= findAttr('adnumber').label %></label>
        <input type="text" id="adnumber" name="adnumber" class="form-control" value="<%= data.adnumber||'' %>">
      </div>
      <div class="col-md-4">
        <label for="name" class="form-label"><%= findAttr('name').label %></label>
        <input type="text" id="name" name="name" class="form-control" value="<%= data.name||'' %>">
      </div>
      <div class="col-md-4"></div>
    </div>

    <div class="row g-3 mb-3 align-items-end">
      <div class="col-md-3">
        <label for="price" class="form-label"><%= findAttr('price').label %></label>
        <input type="number" id="price" name="price" class="form-control" step="any" value="<%= data.price||'' %>">
      </div>
      <div class="col-md-3">
        <label for="currency" class="form-label"><%= findAttr('currency').label %></label>
        <select id="currency" name="currency" class="form-select form-select--brown">
          <option value="">– wählen –</option>
          <% ['EUR','USD','CHF'].forEach(c => { %>
            <option value="<%=c%>" <%= data.currency===c?'selected':'' %>><%=c%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="vat" name="vat" value="1" <%= data.vat?'checked':'' %>>
          <label class="form-check-label" for="vat"><%= findAttr('vat').label %></label>
        </div>
      </div>
      <div class="col-md-2" id="vat_rate_container" style="display:none;">
        <label for="taxrate" class="form-label"><%= findAttr('taxrate')?.label || 'Steuersatz (%)' %></label>
        <input type="number" id="taxrate" name="taxrate" class="form-control" step="any" value="<%= data.taxrate||'' %>">
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-3">
        <label for="year" class="form-label"><%= findAttr('year').label %></label>
        <select id="year" name="year" class="form-select">
          <option value="">– Jahr –</option>
          <% for(let y=thisYear; y>=1900; y--){ %>
            <option value="<%=y%>" <%= data.year==y?'selected':'' %>><%=y%></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="shape" class="form-label"><%= findAttr('shape').label %></label>
        <select id="shape" name="shape" class="form-select">
          <option value="">– wählen –</option>
          <% findAttr('shape').options.forEach(o=>{ %>
            <option value="<%=o.id%>" <%= data.shape==o.id?'selected':'' %>><%=o.label%></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <div class="form-check mt-4">
          <input class="form-check-input" type="checkbox" id="used" name="used" value="1" <%= data.used?'checked':'' %>>
          <label class="form-check-label" for="used"><%= findAttr('used').label %></label>
        </div>
      </div>
    </div>
  </fieldset>

  <!-- Technische Daten -->
  <fieldset class="border p-3 mb-4">
    <legend class="px-2">Technische Daten</legend>
    <div class="row g-3 mb-3">
      <% [
           'watchtype','gender','case_material','strap_material','strap_color',
           'dial_color','dial_shape','dial_numbers','movement','movement_caliber',
           'caliber','power_reserve','jewels_number','frequency','crystal',
           'diameter','height','clasp_type','clasp_material','bezel_material',
           'waterproof'
         ].forEach(fn => {
           const attr = findAttr(fn);
           if (!attr) return;
      %>
        <div class="col-md-3">
          <label for="<%=fn%>" class="form-label"><%=attr.label%></label>
          <% if (attr.field_type==='select') { %>
            <select id="<%=fn%>" name="<%=fn%>" class="form-select">
              <option value="">– wählen –</option>
              <% attr.options.forEach(o=>{ %>
                <option value="<%=o.id%>" <%= data[fn]==o.id?'selected':'' %>><%=o.label%></option>
              <% }) %>
            </select>
          <% } else if (attr.field_type==='number') { %>
            <input type="number" id="<%=fn%>" name="<%=fn%>" class="form-control" step="any" value="<%=data[fn]||''%>">
          <% } else { %>
            <input type="text" id="<%=fn%>" name="<%=fn%>" class="form-control" value="<%=data[fn]||''%>">
          <% } %>
        </div>
      <% }) %>
    </div>
  </fieldset>

  <!-- Echtheit -->
  <fieldset class="border p-3 mb-4">
    <legend class="px-2">Echtheit</legend>
    <div class="row row-cols-2 row-cols-md-3 g-3">
      <% ['authenticity_papers','authenticity_box','authenticity_warranty'].forEach(fn=>{
           const attr = findAttr(fn);
           if (!attr) return;
      %>
        <div class="col">
          <div class="form-check">
            <input type="hidden" name="<%=fn%>" value="0">
            <input class="form-check-input" type="checkbox" id="<%=fn%>" name="<%=fn%>" value="1" <%=data[fn]?'checked':''%>>
            <label class="form-check-label" for="<%=fn%>"><%=attr.label%></label>
          </div>
        </div>
      <% }) %>
    </div>
  </fieldset>

  <!-- Funktionen -->
  <fieldset class="border p-3 mb-4">
    <legend class="px-2">Funktionen</legend>
    <div class="row row-cols-2 row-cols-md-5 g-3">
      <% [
           'function_alarm','function_chronograph','function_date','function_day','function_month',
           'function_year','function_4year','function_perpetual_calendar','function_gmt','function_timeequation',
           'function_minuterepeater','function_repetition','function_jumping_hour','function_double_chronograph',

<link rel="stylesheet" href="/css/product-single.min.css">

<%
  // Hilfsfunktion zum Extrahieren des Dateinamens
  function getFilename(pic) {
    if (typeof pic === 'string') return pic;
    if (pic && typeof pic === 'object') {
      return pic.image || pic.filename || '';
    }
    return '';
  }
%>

<form method="POST" enctype="multipart/form-data">
  <section class="container product-single-container mb-5">
    <div class="row">
      <!-- Bilder-Spalte -->
      <div class="col-md-6">
        <div class="product-single-images mb-4">
          <div class="img-magnifier-container mb-3">
            <% 
              const mainPic = (Array.isArray(item.pictures) && item.pictures.length)
                ? getFilename(item.pictures[0])
                : '';
            %>
            <img
              id="mainImage"
              src="/images/<%= currentEntity.route %>/<%= item.id %>/<%= mainPic || 'placeholder.jpg' %>"
              class="img-fluid"
              alt="Hauptbild">
            <div class="img-magnifier-glass"></div>
          </div>
          <label class="form-label">Hauptbild ändern</label>
          <input type="file" name="mainpicture" class="form-control mb-4" accept="image/*">
        </div>

        <div class="thumbnail-slider mb-4">
          <button type="button" id="prevThumb" class="btn btn-light mb-2" disabled>&#10094;</button>
          <div class="product-single-thumbnails d-flex mb-2">
            <% if (Array.isArray(item.pictures)) { %>
              <% item.pictures.forEach(function(pic) { 
                   const fn = getFilename(pic);
                   if (!fn) return;
              %>
                <img
                  src="/images/<%= currentEntity.route %>/<%= item.id %>/<%= fn %>"
                  style="width:80px;height:80px;object-fit:cover"
                  class="me-2 rounded"
                  onclick="changeImage(this)">
              <% }); %>
            <% } %>
          </div>
          <button type="button" id="nextThumb" class="btn btn-light mb-3">&#10095;</button>
          <label class="form-label">Galeriebilder hinzufügen</label>
          <input type="file" name="pictures" class="form-control" multiple accept="image/*">
        </div>
      </div>

      <!-- Detail-Spalte -->
      <div class="col-md-6">
        <h2 class="mb-4">Inserat bearbeiten</h2>

        <div class="mb-3">
          <label for="name" class="form-label">Titel</label>
          <input id="name" name="name" class="form-control" value="<%= item.name %>" required>
        </div>

        <div class="row mb-3">
          <div class="col">
            <label for="price" class="form-label">Preis</label>
            <input id="price" name="price" type="number" step="any" class="form-control" value="<%= item.price %>">
          </div>
          <div class="col">
            <label for="currency" class="form-label">Währung</label>
            <select id="currency" name="currency" class="form-select">
              <% ['EUR','USD','CHF'].forEach(function(c) { %>
                <option value="<%= c %>" <%= item.currency === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Beschreibung</label>
          <textarea id="description" name="description" class="form-control" rows="5"><%= item.description %></textarea>
        </div>

        <% if (Array.isArray(attrs) && attrs.length) { %>
          <% attrs.forEach(function(attr) {
               var val = item[attr.column_name];
          %>
            <div class="mb-3">
              <label class="form-label" for="<%= attr.column_name %>"><%= attr.label %></label>

              <% if (attr.field_type === 'select') { %>
                <select id="<%= attr.column_name %>" name="<%= attr.column_name %>" class="form-select">
                  <option value="">– bitte wählen –</option>
                  <% attr.options.forEach(function(o) { %>
                    <option value="<%= o.id %>" <%= val == o.id ? 'selected' : '' %>><%= o.label %></option>
                  <% }); %>
                </select>

              <% } else if (attr.field_type === 'boolean') { %>
                <select id="<%= attr.column_name %>" name="<%= attr.column_name %>" class="form-select">
                  <option value="">– bitte wählen –</option>
                  <option value="1" <%= val === 1 ? 'selected' : '' %>>Ja</option>
                  <option value="0" <%= val === 0 ? 'selected' : '' %>>Nein</option>
                </select>

              <% } else if (attr.field_type === 'number') { %>
                <input
                  type="number"
                  id="<%= attr.column_name %>"
                  name="<%= attr.column_name %>"
                  class="form-control"
                  step="any"
                  value="<%= val %>">

              <% } else if (attr.field_type === 'textarea') { %>
                <textarea
                  id="<%= attr.column_name %>"
                  name="<%= attr.column_name %>"
                  class="form-control"
                  rows="3"><%= val %></textarea>

              <% } else { %>
                <input
                  type="text"
                  id="<%= attr.column_name %>"
                  name="<%= attr.column_name %>"
                  class="form-control"
                  value="<%= val %>">
              <% } %>

            </div>
          <% }); %>
        <% } %>

        <div class="text-end mt-4">
          <button type="submit" class="btn btn-success">Speichern</button>
        </div>
      </div>
    </div>
  </section>
</form>

<script>
  // Thumbnail-Scroll
  document.addEventListener("DOMContentLoaded", function () {
    var thumbs = document.querySelector(".product-single-thumbnails");
    var prev   = document.getElementById("prevThumb");
    var next   = document.getElementById("nextThumb");

    function update() {
      prev.disabled = thumbs.scrollLeft === 0;
      next.disabled = thumbs.scrollLeft + thumbs.clientWidth >= thumbs.scrollWidth - 1;
    }
    prev.addEventListener("click", function() {
      thumbs.scrollBy({ left: -thumbs.clientWidth, behavior: "smooth" });
    });
    next.addEventListener("click", function() {
      thumbs.scrollBy({ left: thumbs.clientWidth, behavior: "smooth" });
    });
    thumbs.addEventListener("scroll", update);
    update();
  });

  // Bild-Lupe
  function magnify(imgID, zoom) {
    var img   = document.getElementById(imgID);
    var glass = img.parentElement.querySelector('.img-magnifier-glass');

    function setGlassBG() {
      glass.style.backgroundImage = "url('" + img.src + "')";
      glass.style.backgroundSize  = (img.width * zoom) + "px " + (img.height * zoom) + "px";
    }

    function moveGlass(e) {
      var rect = img.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var w = glass.offsetWidth  / 2;
      var h = glass.offsetHeight / 2;
      x = Math.max(w, Math.min(x, img.width - w));
      y = Math.max(h, Math.min(y, img.height - h));
      glass.style.left = (x - w) + "px";
      glass.style.top  = (y - h) + "px";
      var bgX = -((x * zoom) - w);
      var bgY = -((y * zoom) - h);
      glass.style.backgroundPosition = bgX + "px " + bgY + "px";
    }

    img.addEventListener('mouseenter', function() {
      setGlassBG();
      glass.style.display = 'block';
    });
    img.addEventListener('mousemove', moveGlass);
    img.addEventListener('mouseleave', function() {
      glass.style.display = 'none';
    });
  }
  document.addEventListener('DOMContentLoaded', function() {
    magnify('mainImage', 2.5);
  });

  // Wechsel auf Thumbnail-Klick
  function changeImage(thumb) {
    var main = document.getElementById('mainImage');
    main.src = thumb.src;
    main.dispatchEvent(new Event('mouseenter'));
  }
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Alle .mb-3 Container, die als Boolean getaggt sind
  document.querySelectorAll('div.mb-3[data-field-type="boolean"]').forEach(wrapper => {
    // finde das existierende Feld (Select oder Input)
    const oldField = wrapper.querySelector('[name]');
    if (!oldField) return;
    
    const name     = oldField.name;
    const current  = oldField.value === '1';  // true wenn '1', sonst false
    const labelTxt = (wrapper.querySelector('label')||{}).textContent || name;
    
    // Baue das neue Markup
    wrapper.innerHTML = '';
    wrapper.classList.add('form-check');
    
    // Hidden für 0
    const hidden = document.createElement('input');
    hidden.type  = 'hidden';
    hidden.name  = name;
    hidden.value = '0';
    wrapper.appendChild(hidden);
    
    // Checkbox für 1
    const chk = document.createElement('input');
    chk.type    = 'checkbox';
    chk.className = 'form-check-input';
    chk.id      = name;
    chk.name    = name;
    chk.value   = '1';
    if (current) chk.checked = true;
    wrapper.appendChild(chk);
    
    // Label
    const lbl = document.createElement('label');
    lbl.className   = 'form-check-label';
    lbl.htmlFor     = name;
    lbl.textContent = labelTxt;
    wrapper.appendChild(lbl);
  });
});
</script>


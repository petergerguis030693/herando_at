<script>
// Hilfsfunktion: Form zu x-www-form-urlencoded serialisieren
function formToURLEncoded(form, extra = []) {
  const fd = new FormData(form);
  for (const [k,v] of extra) fd.set(k, v);
  const usp = new URLSearchParams();
  for (const [k,v] of fd.entries()) usp.append(k, v);
  return usp.toString();
}

// Einzel-Approve: sofort verschieben, dann Übersetzung im Hintergrund
document.addEventListener('submit', async function (ev) {
  const form = ev.target.closest('form[action*="/action"]');
  if (!form) return;

  const btn = ev.submitter || document.activeElement;
  if (!btn || btn.name !== 'action' || btn.value !== 'approve') return;

  ev.preventDefault();

  const actionUrl = form.getAttribute('action'); // WICHTIG: nicht form.action!
  const body = formToURLEncoded(form, [['action','approve']]);

  try {
    // 1) Sofort freigeben (urlencoded!)
    const res = await fetch(actionUrl + '?ajax=1', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body
    });
    if (!res.ok) throw new Error(await res.text());

    // 2) Karte direkt entfernen
    const col = form.closest('.col');
    if (col) col.remove();

    // 3) Übersetzung im Hintergrund
    const translateUrl = actionUrl.replace('/action', '/translate');
    fetch(translateUrl, { method: 'POST' }).catch(() => {});
  } catch (err) {
    alert('Fehler beim Approve: ' + (err?.message || err));
  }
});
</script>

<script>
// Bulk-Approve: sofort freigeben, dann je ID Background-Translate
document.addEventListener('submit', async function (ev) {
  const bulkForm = ev.target.closest('#bulkForm');
  if (!bulkForm) return;

  const btn = ev.submitter || document.activeElement;
  if (!btn || btn.name !== 'action' || btn.value !== 'approve') return;

  ev.preventDefault();

  // IDs einsammeln
  const checked = Array.from(document.querySelectorAll('.bulk-checkbox:checked'));
  const ids = checked.map(cb => cb.value).filter(Boolean);
  if (!ids.length) { alert('Bitte mindestens ein Inserat auswählen.'); return; }

  const actionUrl = bulkForm.getAttribute('action');

  // urlencoded Body bauen:
  const fd = new FormData(bulkForm);
  // Bereinige alte ids[] und setze neu
  Array.from(fd.keys()).filter(k => k === 'ids[]').forEach(k => fd.delete(k));
  ids.forEach(id => fd.append('ids[]', id));
  fd.set('action','approve');

  const usp = new URLSearchParams();
  for (const [k,v] of fd.entries()) usp.append(k, v);

  try {
    // 1) Sofort freigeben
    const res = await fetch(actionUrl + '?ajax=1', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: usp.toString()
    });
    if (!res.ok) throw new Error(await res.text());

    // 2) Aus UI entfernen
    checked.forEach(cb => { const col = cb.closest('.col'); if (col) col.remove(); });
  } catch (err) {
    alert('Fehler bei Bulk-Approve: ' + (err?.message || err));
  }
});

// Approve: serverseitig über alle Seiten laufen lassen
document.addEventListener('DOMContentLoaded', () => {
  const btn = document.getElementById('approveAllPagesBtn');
  if (!btn) return;

  const statusEl = document.getElementById('approveAllPagesStatus');
  const SOURCE = 'approve-all-pages';

  btn.addEventListener('click', async () => {
    if (!confirm('toapprove für diese Kategorie freigeben (über alle Seiten)?')) return;
    btn.disabled = true;

    try {
      const body = new URLSearchParams({
        state: 'toapprove',
        chunkSize: '300',
        translate: '1'
      }).toString();

      const res = await fetch(`/admin/listings/${encodeURIComponent('<%= category %>')}/approve-all-pages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body
      });

      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        alert(data?.message || 'Fehler beim Starten');
      } else {
        if (statusEl) {
          statusEl.style.display = '';
          statusEl.textContent = `Freigabe gestartet. Übersetzungen laufen (Queue zeigt Fortschritt an)…`;
        }

        // Polling ohne Reload: beobachten, bis keine Jobs mit source=approve-all-pages mehr aktiv/warten.
        const pollMs = 2000;
        const startedAt = Date.now();
        const maxMs = 60 * 60 * 1000; // 1h Sicherheitsgrenze

        const sp0 = new URLSearchParams(window.location.search);
        let uiPage = parseInt(String(sp0.get('page') || '1'), 10);
        if (!Number.isFinite(uiPage) || uiPage < 1) uiPage = 1;
        const fixedCategory = '<%= category %>';
        const fixedState = 'toapprove';

        let lastUiUpdateAt = 0;
        const refreshUI = async () => {
          // UI-Nachladen nur in moderaten Abständen (Sonst erzeugen wir unnötige Last).
          if (Date.now() - lastUiUpdateAt < 5000) return;
          lastUiUpdateAt = Date.now();

          const sp = new URLSearchParams(window.location.search);
          sp.set('category', fixedCategory);
          sp.set('state', fixedState);
          sp.set('page', String(uiPage));
          const url = window.location.pathname + '?' + sp.toString();

          const r = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
          if (!r.ok) return;
          const html = await r.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');

          const newGrid = doc.getElementById('listingsGrid');
          const newPagination = doc.querySelector('div.d-flex.justify-content-between.align-items-center.mt-4');

          const curGrid = document.getElementById('listingsGrid');
          const curPagination = document.querySelector('div.d-flex.justify-content-between.align-items-center.mt-4');

          if (newGrid && curGrid) curGrid.replaceWith(newGrid);
          if (newPagination && curPagination) curPagination.replaceWith(newPagination);

          // Wenn die aktuelle Seite gerade leer ist und es noch eine "Weiter"-Seite gibt:
          // dann automatisch uiPage erhöhen (page=2, page=3, ...) bis keine Seite mehr existiert.
          const gridHasCards = Boolean(newGrid && newGrid.querySelector('.card'));
          const hasNext = Boolean(newPagination && newPagination.textContent && newPagination.textContent.includes('Weiter'));
          // Springe zur nächsten Seite, sobald im Pagination-UI ein "Weiter" existiert.
          // Dadurch siehst du unmittelbar Seite 2, auch wenn Seite 1 noch nicht leer ist.
          if (hasNext) uiPage += 1;

          return { gridHasCards, hasNext, uiPage };
        };

        const timer = setInterval(async () => {
          try {
            // Immer UI refreshen und page-advance machen (nicht vom Queue-Status abhängig).
            const uiRes = await refreshUI();
            if (!uiRes) return;

            // Optional: Queue-Fortschritt anzeigen (aber nicht als Stop-Kriterium verwenden).
            let snap = null;
            try {
              const r = await fetch('/admin/listings/translate-queue/api');
              if (r.ok) snap = await r.json();
            } catch (_) {}

            const isActive =
              (snap?.current?.source === SOURCE) ||
              (Array.isArray(snap?.waiting) && snap.waiting.some(j => j?.source === SOURCE));

            if (statusEl && snap) {
              const running = snap?.current?.id
                ? `laufen: id=${snap.current.id} (${snap.current.source})`
                : 'laufen: —';
              statusEl.textContent =
                `Freigabe: ${data?.category || ''} | ${running} | backlog=${snap?.backlog ?? 0}.` +
                ` (nach ${Math.round((Date.now() - startedAt) / 1000)}s)`;
            }

            // Stop, wenn die Seite leer ist und es keine "Weiter"-Seite gibt.
            if ((!uiRes.gridHasCards && !uiRes.hasNext) || Date.now() - startedAt > maxMs) {
              clearInterval(timer);
              if (statusEl) {
                statusEl.textContent = (!uiRes.gridHasCards && !uiRes.hasNext)
                  ? 'Freigabe übersetzt/abgearbeitet.'
                  : 'Zeitlimit erreicht: bitte in der Queue nachsehen.';
              }
              setTimeout(() => {
                try { window.location.reload(); } catch (_) {}
              }, 1200);
            }
          } catch (_) {
            // ignore transient errors
          }
        }, pollMs);
      }
    } catch (err) {
      alert('Fehler: ' + (err?.message || err));
    } finally {
      btn.disabled = false;
    }
  });
});
</script>

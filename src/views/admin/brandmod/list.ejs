<!-- Quill CSS -->
 <%
  const ENTITY_MAP = {
    1: { name: 'Autos',      route: 'cars' },
    2: { name: 'Uhren',      route: 'watches' },
    3: { name: 'Autos',      route: 'cars' },
    4: { name: 'Yachts',     route: 'yachts' },
    5: { name: 'Lifestyle',  route: 'lifestyles' }
  };

  function resolveEntity(type) {
    return ENTITY_MAP[type] || { name: 'Unbekannt', route: '#' };
  }
%>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width:250px;">
    <%- include('../sidebar', { active: active, role: role }) %>
  </aside>

  <!-- Main -->
  <div class="flex-fill container mt-4">
    <h1>Marken, Modelle & SEO</h1>

    <!-- Tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'brands' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#brands">Marken</button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'models' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#models">Modelle</button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'brandSeo' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#brandSeo">Brand SEO</button>
      </li>
      <li class="nav-item">
        <button class="nav-link <%= activeTab === 'modelSeo' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#modelSeo">Model SEO</button>
      </li>
    </ul>

    <div class="tab-content mt-3">

      <!-- ===================== MARKEN ===================== -->
      <div class="tab-pane fade <%= activeTab === 'brands' ? 'show active' : '' %>" id="brands">
        <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalBrand">
          Neue Marke
        </button>

        <form method="GET" action="/admin/modbrand" class="row g-2 mb-3">
          <input type="hidden" name="tab" value="brands">
          <input type="hidden" name="modelSearch" value="<%= modelSearch || '' %>">
          <input type="hidden" name="modelPage" value="<%= currentModelPage || 1 %>">
          <div class="col-md-8">
            <input id="searchBrands" name="brandSearch" class="form-control" placeholder="Marken suchen..." value="<%= brandSearch || '' %>">
          </div>
          <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Suchen</button>
            <a class="btn btn-outline-secondary" href="/admin/modbrand?tab=brands&modelSearch=<%= encodeURIComponent(modelSearch || '') %>&modelPage=<%= currentModelPage || 1 %>">Reset</a>
          </div>
        </form>


        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Name</th>
              <th>Kategorie</th>
            </tr>
          </thead>
          <tbody>
          <% if (!brandRows || !brandRows.length) { %>
            <tr>
              <td colspan="2" class="text-muted">Keine Marken gefunden.</td>
            </tr>
          <% } %>
          <% (brandRows || []).forEach(b => { %>
            <tr data-id="<%= b.id %>" data-name="<%= b.name %>" data-entitieid="<%= b.type %>">
              <td><%= b.name %></td>
              <td>
                <span class="badge bg-primary">
                  <%= resolveEntity(b.type).name %>
                </span>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>

        <%
          const brandPagerBase = new URLSearchParams();
          brandPagerBase.set('tab', 'brands');
          if (brandSearch) brandPagerBase.set('brandSearch', brandSearch);
          if (modelSearch) brandPagerBase.set('modelSearch', modelSearch);
          if (currentModelPage) brandPagerBase.set('modelPage', String(currentModelPage));
          const buildBrandPageUrl = (p) => {
            const q = new URLSearchParams(brandPagerBase.toString());
            q.set('brandPage', String(p));
            return `/admin/modbrand?${q.toString()}`;
          };
          const brandPageStart = Math.max(1, (currentBrandPage || 1) - 2);
          const brandPageEnd = Math.min(brandTotalPages || 1, (currentBrandPage || 1) + 2);
        %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div class="text-muted">
            <strong><%= brandTotal || 0 %></strong> Marken
            (<%= perPage || 50 %> pro Seite)
            • Seite <strong><%= currentBrandPage || 1 %></strong> von <strong><%= brandTotalPages || 1 %></strong>
          </div>
          <div class="btn-group" role="group" aria-label="Marken Pagination">
            <a class="btn btn-outline-secondary <%= (currentBrandPage || 1) <= 1 ? 'disabled' : '' %>"
               href="<%= buildBrandPageUrl(Math.max(1, (currentBrandPage || 1) - 1)) %>">&laquo;</a>
            <% if (brandPageStart > 1) { %>
              <a class="btn btn-outline-secondary" href="<%= buildBrandPageUrl(1) %>">1</a>
              <% if (brandPageStart > 2) { %>
                <button type="button" class="btn btn-outline-secondary" disabled>…</button>
              <% } %>
            <% } %>
            <% for (let p = brandPageStart; p <= brandPageEnd; p++) { %>
              <% if (p === (currentBrandPage || 1)) { %>
                <button type="button" class="btn btn-primary" disabled><%= p %></button>
              <% } else { %>
                <a class="btn btn-outline-secondary" href="<%= buildBrandPageUrl(p) %>"><%= p %></a>
              <% } %>
            <% } %>
            <% if (brandPageEnd < (brandTotalPages || 1)) { %>
              <% if (brandPageEnd < (brandTotalPages || 1) - 1) { %>
                <button type="button" class="btn btn-outline-secondary" disabled>…</button>
              <% } %>
              <a class="btn btn-outline-secondary" href="<%= buildBrandPageUrl(brandTotalPages || 1) %>"><%= brandTotalPages || 1 %></a>
            <% } %>
            <a class="btn btn-outline-secondary <%= (currentBrandPage || 1) >= (brandTotalPages || 1) ? 'disabled' : '' %>"
               href="<%= buildBrandPageUrl(Math.min(brandTotalPages || 1, (currentBrandPage || 1) + 1)) %>">&raquo;</a>
          </div>
        </div>
      </div>

      <div class="modal fade" id="modalBrand" tabindex="-1">
  <div class="modal-dialog">
    <form id="brandCreateForm" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Neue Marke</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input name="name" class="form-control mb-2" placeholder="Markenname" required>

        <select name="entitieId" class="form-select" required>
          <% ententies.forEach(e => { %>
            <option value="<%= e.id %>"><%= e.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="modal-footer">
        <button class="btn btn-success">Speichern</button>
      </div>
    </form>
  </div>
</div>


      <!-- ===================== MODELLE ===================== -->
      <div class="tab-pane fade <%= activeTab === 'models' ? 'show active' : '' %>" id="models">
      <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#modalModel">
        Neues Modell
      </button>

      <form method="GET" action="/admin/modbrand" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="models">
        <input type="hidden" name="brandSearch" value="<%= brandSearch || '' %>">
        <input type="hidden" name="brandPage" value="<%= currentBrandPage || 1 %>">
        <div class="col-md-8">
          <input id="searchModels" name="modelSearch" class="form-control" placeholder="Modelle suchen..." value="<%= modelSearch || '' %>">
        </div>
        <div class="col-auto d-flex gap-2">
          <button type="submit" class="btn btn-outline-primary">Suchen</button>
          <a class="btn btn-outline-secondary" href="/admin/modbrand?tab=models&brandSearch=<%= encodeURIComponent(brandSearch || '') %>&brandPage=<%= currentBrandPage || 1 %>">Reset</a>
        </div>
      </form>


        <table class="table table-bordered">
          <thead>
            <tr>
              <th>Marke</th>
              <th>Modell</th>
              <th>Aktionen</th>
            </tr>
          </thead>
          <tbody>
          <% if (!modelRows || !modelRows.length) { %>
            <tr>
              <td colspan="3" class="text-muted">Keine Modelle gefunden.</td>
            </tr>
          <% } %>
          <% (modelRows || []).forEach(m => { %>
            <tr data-id="<%= m.id %>" data-brandid="<%= m.brand_id %>">
              <td><%= m.brand_name %></td>
              <td><%= m.name %></td>
              <td>
                <button class="btn btn-sm btn-secondary btnEditModel">Bearbeiten</button>
                <button class="btn btn-sm btn-danger btnDeleteModel">Löschen</button>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>

        <%
          const modelPagerBase = new URLSearchParams();
          modelPagerBase.set('tab', 'models');
          if (modelSearch) modelPagerBase.set('modelSearch', modelSearch);
          if (brandSearch) modelPagerBase.set('brandSearch', brandSearch);
          if (currentBrandPage) modelPagerBase.set('brandPage', String(currentBrandPage));
          const buildModelPageUrl = (p) => {
            const q = new URLSearchParams(modelPagerBase.toString());
            q.set('modelPage', String(p));
            return `/admin/modbrand?${q.toString()}`;
          };
          const modelPageStart = Math.max(1, (currentModelPage || 1) - 2);
          const modelPageEnd = Math.min(modelTotalPages || 1, (currentModelPage || 1) + 2);
        %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
          <div class="text-muted">
            <strong><%= modelTotal || 0 %></strong> Modelle
            (<%= perPage || 50 %> pro Seite)
            • Seite <strong><%= currentModelPage || 1 %></strong> von <strong><%= modelTotalPages || 1 %></strong>
          </div>
          <div class="btn-group" role="group" aria-label="Modelle Pagination">
            <a class="btn btn-outline-secondary <%= (currentModelPage || 1) <= 1 ? 'disabled' : '' %>"
               href="<%= buildModelPageUrl(Math.max(1, (currentModelPage || 1) - 1)) %>">&laquo;</a>
            <% if (modelPageStart > 1) { %>
              <a class="btn btn-outline-secondary" href="<%= buildModelPageUrl(1) %>">1</a>
              <% if (modelPageStart > 2) { %>
                <button type="button" class="btn btn-outline-secondary" disabled>…</button>
              <% } %>
            <% } %>
            <% for (let p = modelPageStart; p <= modelPageEnd; p++) { %>
              <% if (p === (currentModelPage || 1)) { %>
                <button type="button" class="btn btn-primary" disabled><%= p %></button>
              <% } else { %>
                <a class="btn btn-outline-secondary" href="<%= buildModelPageUrl(p) %>"><%= p %></a>
              <% } %>
            <% } %>
            <% if (modelPageEnd < (modelTotalPages || 1)) { %>
              <% if (modelPageEnd < (modelTotalPages || 1) - 1) { %>
                <button type="button" class="btn btn-outline-secondary" disabled>…</button>
              <% } %>
              <a class="btn btn-outline-secondary" href="<%= buildModelPageUrl(modelTotalPages || 1) %>"><%= modelTotalPages || 1 %></a>
            <% } %>
            <a class="btn btn-outline-secondary <%= (currentModelPage || 1) >= (modelTotalPages || 1) ? 'disabled' : '' %>"
               href="<%= buildModelPageUrl(Math.min(modelTotalPages || 1, (currentModelPage || 1) + 1)) %>">&raquo;</a>
          </div>
        </div>
      </div>

      <div class="modal fade" id="modalModel" tabindex="-1">
  <div class="modal-dialog">
    <form id="modelCreateForm" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Neues Modell</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <select name="brandId" class="form-select mb-2" required>
          <% brands.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.name %></option>
          <% }) %>
        </select>

        <input name="name" class="form-control" placeholder="Modellname" required>
      </div>

      <div class="modal-footer">
        <button class="btn btn-success">Speichern</button>
      </div>
    </form>
  </div>
</div>


      <!-- ===================== BRAND SEO ===================== -->
      <div class="tab-pane fade <%= activeTab === 'brandSeo' ? 'show active' : '' %>" id="brandSeo">
        <form id="brandSeoForm">
          <div class="row g-2 mb-2">
            <div class="col">
              <select id="seoBrand" class="form-select" required>
                <% brands.forEach(b => { %>
                  <option value="<%= b.id %>"><%= b.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col">
              <select id="seoBrandEntitie" class="form-select" required>
                <% ententies.forEach(e => { %>
                  <option value="<%= e.id %>"><%= e.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col">
              <select id="seoBrandLang" class="form-select">
                <option value="de">DE</option>
                <option value="en">EN</option>
              </select>
            </div>
          </div>

          <input id="seoBrandTitle" class="form-control mb-2" placeholder="SEO Title">
          <textarea id="seoBrandDesc" class="form-control mb-2" placeholder="SEO Description"></textarea>
          <div id="editorBrandSeo" style="height:200px;"></div>

          <button class="btn btn-success mt-2">Speichern</button>
        </form>
      </div>

      <!-- ===================== MODEL SEO ===================== -->
      <div class="tab-pane fade <%= activeTab === 'modelSeo' ? 'show active' : '' %>" id="modelSeo">
        <form id="modelSeoForm">
          <div class="row g-2 mb-2">
            <div class="col">
              <select id="seoModel" class="form-select">
                <% models.forEach(m => { %>
                  <option value="<%= m.id %>" data-brandid="<%= m.brand_id %>">
                    <%= m.brand_name %> – <%= m.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col">
              <select id="seoModelEntitie" class="form-select">
                <% ententies.forEach(e => { %>
                  <option value="<%= e.id %>"><%= e.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col">
              <select id="seoModelLang" class="form-select">
                <option value="de">DE</option>
                <option value="en">EN</option>
              </select>
            </div>
          </div>

          <input id="seoModelTitle" class="form-control mb-2" placeholder="SEO Title">
          <textarea id="seoModelDesc" class="form-control mb-2" placeholder="SEO Description"></textarea>
          <div id="editorModelSeo" style="height:200px;"></div>

          <button class="btn btn-success mt-2">Speichern</button>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- JS -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const ENTITY_MAP = {
    1: { name: 'Autos',       route: 'cars' },
    2: { name: 'Uhren',       route: 'watches' },
    3: { name: 'Autos',       route: 'cars' },
    4: { name: 'Immobilien',  route: 'properties' },
    5: { name: 'Lifestyle',   route: 'lifestyles' }
  };

  function resolveEntity(type) {
    return ENTITY_MAP[type] || { name: 'Unbekannt', route: '#' };
  }
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {

  const qBrandSeo = new Quill('#editorBrandSeo', { theme:'snow' });
  const qModelSeo = new Quill('#editorModelSeo', { theme:'snow' });

  document.getElementById('brandSeoForm').onsubmit = e => {
    e.preventDefault();
    fetch('/admin/modbrand/brands/seo/save', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({
        brand_id: document.getElementById('seoBrand').value,
        entitie_id: document.getElementById('seoBrandEntitie').value,
        language: document.getElementById('seoBrandLang').value,
        seo_title: document.getElementById('seoBrandTitle').value,
        seo_description: document.getElementById('seoBrandDesc').value,
        seo_text: qBrandSeo.root.innerHTML
      })
    }).then(() => alert('Brand SEO gespeichert'));
  };

  document.getElementById('modelSeoForm').onsubmit = e => {
    e.preventDefault();
    const model = document.getElementById('seoModel');
    fetch('/admin/modbrand/models/seo/save', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({
        model_id: model.value,
        brand_id: model.selectedOptions[0].dataset.brandid,
        entitie_id: document.getElementById('seoModelEntitie').value,
        language: document.getElementById('seoModelLang').value,
        seo_title: document.getElementById('seoModelTitle').value,
        seo_description: document.getElementById('seoModelDesc').value,
        seo_text: qModelSeo.root.innerHTML
      })
    }).then(() => alert('Model SEO gespeichert'));
  };

});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

  async function postForm(form, url) {
    const body = new URLSearchParams();
    for (const [key, value] of new FormData(form).entries()) {
      body.append(key, value);
    }

    const res = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
      },
      body
    });

    if (!res.ok) {
      alert('Fehler beim Speichern');
      return;
    }

    location.reload(); // später ersetzbar durch DOM-Update
  }

  document.getElementById('brandCreateForm')
    .addEventListener('submit', e => {
      e.preventDefault();
      postForm(e.target, '/admin/modbrand/brands/new');
    });

  document.getElementById('modelCreateForm')
    .addEventListener('submit', e => {
      e.preventDefault();
      postForm(e.target, '/admin/modbrand/models/new');
    });

  async function postUrl(url, data) {
    const body = new URLSearchParams();
    Object.entries(data || {}).forEach(([key, value]) => {
      body.append(key, value == null ? '' : String(value));
    });

    const res = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
      },
      body
    });

    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(text || 'Fehler beim Speichern');
    }
  }

  document.querySelectorAll('.btnEditModel').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const tr = btn.closest('tr');
      if (!tr) return;

      const id = tr.dataset.id;
      const brandId = tr.dataset.brandid;
      const currentName = (tr.children[1]?.innerText || '').trim();
      const nextName = prompt('Modellname bearbeiten', currentName);

      if (nextName === null) return;
      if (!nextName.trim()) {
        alert('Bitte einen Modellnamen eingeben.');
        return;
      }

      try {
        await postUrl(`/admin/modbrand/models/${id}/edit`, {
          brandId,
          name: nextName.trim()
        });
        location.reload();
      } catch (err) {
        alert(err.message || 'Fehler beim Bearbeiten');
      }
    });
  });

  document.querySelectorAll('.btnDeleteModel').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const tr = btn.closest('tr');
      if (!tr) return;

      const id = tr.dataset.id;
      const modelName = (tr.children[1]?.innerText || '').trim();
      const ok = confirm(`Modell wirklich löschen?\n${modelName || `ID ${id}`}`);
      if (!ok) return;

      try {
        await postUrl(`/admin/modbrand/models/${id}/delete`, {});
        location.reload();
      } catch (err) {
        alert(err.message || 'Fehler beim Löschen');
      }
    });
  });

});
</script>

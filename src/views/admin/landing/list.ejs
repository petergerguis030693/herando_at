<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

<main class="container py-4">
  <% if (messages.success) { %>
    <div class="alert alert-success"><%= messages.success %></div>
  <% } %>
  <% if (messages.error) { %>
    <div class="alert alert-danger"><%= messages.error %></div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Landing-Pages</h1>
    <a href="/admin/landing/new" class="btn btn-primary">Neue Landing-Page</a>
  </div>

  <% if (pages.length === 0) { %>
    <p class="text-muted">Keine Landing-Pages vorhanden.</p>
  <% } else { %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Slug</th>
          <th>Titel</th>
          <th>Erstellt</th>
          <th>Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% pages.forEach(page => { %>
          <tr>
            <td><%= page.slug %></td>
            <td><%= page.title %></td>
            <td><%= new Date(page.created).toLocaleDateString('de-DE') %></td>
            <td>
              <a href="/admin/landing/<%= page.slug %>/edit" class="btn btn-sm btn-outline-secondary">Bearbeiten</a>
              <form
                action="/admin/landing/<%= page.slug %>/delete"
                method="POST"
                class="d-inline"
                onsubmit="return confirm('Wirklich löschen?');"
              >
                <button class="btn btn-sm btn-danger">Löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Admin Neues Passwort</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="d-flex align-items-center justify-content-center vh-100 bg-light">
  <div class="card p-4 shadow-sm" style="max-width: 420px; width:100%;">
    <div class="text-center mb-3">
      <img src="/assets/herando-weblogo.svg" alt="Herando" style="height: 120px;">
    </div>
    <h5 class="text-center mb-3">Neues Admin-Passwort</h5>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/admin/reset-password" method="POST">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="mb-3">
        <label for="password" class="form-label">Neues Passwort</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Mindestens 8 Zeichen"
          minlength="8"
          required
        >
      </div>

      <div class="mb-3">
        <label for="passwordRepeat" class="form-label">Passwort wiederholen</label>
        <input
          type="password"
          id="passwordRepeat"
          name="passwordRepeat"
          class="form-control"
          placeholder="Passwort wiederholen"
          minlength="8"
          required
        >
      </div>

      <div class="d-grid mb-2">
        <button type="submit" class="btn btn-dark">Passwort speichern</button>
      </div>
      <div class="text-center">
        <a href="/admin/login" class="small text-decoration-none">Zurück zum Login</a>
      </div>
    </form>
  </div>
</body>
</html>

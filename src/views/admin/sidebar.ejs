<script>
  (() => {
    const body = document.body;
    const sidebar = document.querySelector('.admin-sidebar-nav');
    if (!body || !sidebar) return;

    body.classList.add('admin-page');

    const layout = sidebar.closest('.d-flex');
    if (layout) {
      layout.classList.add('admin-layout');
    }

    const desktopToggle = sidebar.querySelector('.admin-sidebar-toggle');
    const mobileToggle = document.querySelector('.admin-sidebar-mobile-toggle');
    const mobileClose = sidebar.querySelector('.admin-sidebar-close');
    const hostAside = sidebar.closest('aside.sidebar');
    const storageKey = 'admin_sidebar_collapsed';

    if (hostAside) {
      hostAside.classList.add('admin-sidebar-host');
    }

    if (window.innerWidth >= 992 && localStorage.getItem(storageKey) === '1') {
      body.classList.add('admin-sidebar-collapsed');
    }

    const closeMobileSidebar = () => {
      body.classList.remove('admin-sidebar-mobile-open');
    };

    desktopToggle?.addEventListener('click', () => {
      const collapsed = body.classList.toggle('admin-sidebar-collapsed');
      localStorage.setItem(storageKey, collapsed ? '1' : '0');
    });

    mobileToggle?.addEventListener('click', () => {
      body.classList.add('admin-sidebar-mobile-open');
    });

    mobileClose?.addEventListener('click', closeMobileSidebar);

    sidebar.querySelectorAll('a.nav-link').forEach((link) => {
      // Collapse-Trigger in der Sidebar sollen nur auf/zu toggeln und nicht die mobile Sidebar schließen.
      if (link.dataset.bsToggle === 'collapse') return;
      link.addEventListener('click', closeMobileSidebar);
    });

    document.addEventListener('click', (event) => {
      if (!body.classList.contains('admin-sidebar-mobile-open')) return;
      const target = event.target;
      if (sidebar.contains(target) || mobileToggle?.contains(target)) return;
      closeMobileSidebar();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 992) {
        closeMobileSidebar();
      }
    });
  })();
</script>

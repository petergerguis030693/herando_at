     <%- include('../../partials/header-admin') %>


<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .card-grid-item {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  body.modal-open {
  overflow: auto !important;
  padding-right: 0 !important;
}

.customer-id-link {
  font-weight: 700;
  text-decoration: none;
}

.customer-id-link:hover {
  text-decoration: underline;
}

</style>

<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <main class="flex-fill p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="mb-0">Benutzerverwaltung</h1>
      <a href="/admin/users/new" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i> Neuer Benutzer
      </a>
    </div>

    <!-- Ablaufende Verträge in diesem Monat -->
    <% if (renewals && renewals.length) { %>
      <div class="alert alert-warning mb-4">
        <strong><%= renewals.length %> Marketing-Paket<%= renewals.length > 1 ? 'e' : '' %> läuft/laufen diesen Monat ab:</strong>
        <% renewals.forEach(u => { %>
          <span class="badge bg-danger me-1"><%= u.firstname %> <%= u.lastname %></span>
        <% }) %>
      </div>
    <% } %>

    <%
      const buildQuery = (patch = {}) => {
        const merged = {
          search_name: searchName || '',
          search_company: searchCompany || '',
          search_email: searchEmail || '',
          search_id: searchId || '',
          search_address: searchAddress || '',
          status: status || 'all',
          package: packageFilter || '',
          entity: entityFilter || '',
          sort: (typeof sort !== 'undefined' && sort) ? sort : 'registered_desc',
          ...patch
        };
        const params = new URLSearchParams();
        Object.entries(merged).forEach(([key, value]) => {
          if (value === null || value === undefined || value === '') return;
          params.set(key, String(value));
        });
        const query = params.toString();
        return query ? `?${query}` : '?';
      };
      const currentSort = (typeof sort !== 'undefined' && sort) ? sort : 'registered_desc';
      const sortLabelMap = {
        registered_desc: 'Registrierdatum absteigend',
        registered_asc: 'Registrierdatum aufsteigend',
        id_desc: 'ID absteigend',
        id_asc: 'ID aufsteigend'
      };
      const currentSortLabel = sortLabelMap[currentSort] || sortLabelMap.registered_desc;
    %>

    <!-- Status-Filter Buttons -->
    <div class="mb-3">
      <a href="<%= buildQuery({ status: 'all', page: null }) %>" class="btn <%= status==='all' ? 'btn-primary' : 'btn-outline-primary' %> me-2">
        Alle
      </a>
      <a href="<%= buildQuery({ status: 'active', page: null }) %>" class="btn <%= status==='active' ? 'btn-primary' : 'btn-outline-primary' %> me-2">
        Aktive
      </a>
      <a href="<%= buildQuery({ status: 'inactive', page: null }) %>" class="btn <%= (status==='inactive' || status==='expired') ? 'btn-primary' : 'btn-outline-primary' %>">
        Inaktive
      </a>
    </div>

    <div class="mb-3">
      <a href="<%= buildQuery({ package: null, page: null }) %>"
        class="btn <%= !packageFilter ? 'btn-primary' : 'btn-outline-primary' %> me-2">
        Alle Pakete
      </a>
      <% allPackages.forEach(pkg => { %>
        <a href="<%= buildQuery({ package: pkg.package_id, page: null }) %>"
          class="btn <%= packageFilter === String(pkg.package_id) ? 'btn-primary' : 'btn-outline-primary' %> me-2">
          <%= pkg.package_id %>
        </a>
      <% }) %>
    </div>

    <div class="mb-3">
      <a href="<%= buildQuery({ entity: null, page: null }) %>"
        class="btn <%= !entityFilter ? 'btn-primary' : 'btn-outline-primary' %> me-2">
        Alle Entitäten
      </a>
      <% allEntities.forEach(ent => { %>
        <a href="<%= buildQuery({ entity: ent.id, page: null }) %>"
          class="btn <%= entityFilter === String(ent.id) ? 'btn-primary' : 'btn-outline-primary' %> me-2">
          <%= ent.name %>
        </a>
      <% }) %>
    </div>




    <div class="mb-3">
      <div class="fw-semibold mb-1">Sortierung</div>
      <div class="small text-muted mb-2">Aktuell: <%= currentSortLabel %></div>
      <div class="d-flex flex-wrap gap-2">
        <a href="<%= buildQuery({ sort: 'registered_desc', page: null }) %>"
          class="btn <%= currentSort === 'registered_desc' ? 'btn-primary' : 'btn-outline-primary' %>">
          Registrierdatum <i class="bi bi-arrow-down ms-1"></i>
        </a>
        <a href="<%= buildQuery({ sort: 'registered_asc', page: null }) %>"
          class="btn <%= currentSort === 'registered_asc' ? 'btn-primary' : 'btn-outline-primary' %>">
          Registrierdatum <i class="bi bi-arrow-up ms-1"></i>
        </a>
        <a href="<%= buildQuery({ sort: 'id_desc', page: null }) %>"
          class="btn <%= currentSort === 'id_desc' ? 'btn-primary' : 'btn-outline-primary' %>">
          ID <i class="bi bi-arrow-down ms-1"></i>
        </a>
        <a href="<%= buildQuery({ sort: 'id_asc', page: null }) %>"
          class="btn <%= currentSort === 'id_asc' ? 'btn-primary' : 'btn-outline-primary' %>">
          ID <i class="bi bi-arrow-up ms-1"></i>
        </a>
        <a href="<%= buildQuery({ search_name: null, search_company: null, search_email: null, search_id: null, search_address: null, status: null, package: null, entity: null, sort: null, page: null }) %>"
          class="btn btn-outline-secondary">
          Zurücksetzen
        </a>
      </div>
    </div>


    <!-- Suche -->
    <form method="get" class="mb-4">
      <input
        type="hidden"
        name="status"
        value="<%= status %>"
      >
      <input
        type="hidden"
        name="package"
        value="<%= packageFilter || '' %>"
      >
      <input
        type="hidden"
        name="entity"
        value="<%= entityFilter || '' %>"
      >
      <input
        type="hidden"
        name="sort"
        value="<%= currentSort %>"
      >
      <div class="row g-2">
        <div class="col-md-3">
          <input
            type="text"
            name="search_name"
            class="form-control"
            placeholder="Vorname / Nachname"
            value="<%= searchName || '' %>"
          >
        </div>
        <div class="col-md-3">
          <input
            type="text"
            name="search_company"
            class="form-control"
            placeholder="Firmenname"
            value="<%= searchCompany || '' %>"
          >
        </div>
        <div class="col-md-3">
          <input
            type="text"
            name="search_email"
            class="form-control"
            placeholder="E-Mail"
            value="<%= searchEmail || '' %>"
          >
        </div>
        <div class="col-md-3">
          <input
            type="text"
            name="search_id"
            class="form-control"
            placeholder="ID"
            value="<%= searchId || '' %>"
            inputmode="numeric"
          >
        </div>
        <div class="col-md-6">
          <input
            type="text"
            name="search_address"
            class="form-control"
            placeholder="Straße / PLZ / Stadt"
            value="<%= searchAddress || '' %>"
          >
        </div>
        <div class="col-12 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Suchen</button>
          <a href="<%= buildQuery({ search_name: null, search_company: null, search_email: null, search_id: null, search_address: null, page: null }) %>" class="btn btn-outline-secondary">
            Suche leeren
          </a>
        </div>
      </div>
    </form>

    <!-- Grid mit exakt 4 Spalten -->
<div class="card-grid">
  <% users.forEach(u => { %>
    <% 
      const isRenew = renewals && renewals.some(r => r.id === u.id);
      const isConfirmed = Number(u.confirmed) === 1;
      const isLoginStopped = Number(u.logging) === 0;
      const canLogin = isConfirmed && !isLoginStopped;
      const isUserActive = isConfirmed;
      const listingsTotal = Number(u.listings_drafts || 0) + Number(u.listings_online || 0) + Number(u.listings_paused || 0);
      const hasListings = listingsTotal > 0;
    %>
    <div class="card-grid-item" data-user-card data-user-id="<%= u.id %>">
      <div class="card h-100 shadow-sm card-hover <%= isRenew ? 'border border-danger' : '' %>">
        <div class="card-body">

          <% if (isRenew) { %>
            <p>
              <span class="badge bg-danger mb-2">läuft diesen Monat ab</span>
            </p>
          <% } %>

          <p>
            <span data-user-badge-active class="badge <%= isUserActive ? 'bg-success' : 'bg-secondary' %> mb-2">
              <%= isUserActive ? 'aktiv' : 'inaktiv' %>
            </span>
            <span data-user-badge-email class="badge <%= isConfirmed ? 'bg-success' : 'bg-warning text-dark' %> mb-2">
              <%= isConfirmed ? 'E-Mail bestätigt' : 'E-Mail offen' %>
            </span>
            <span data-user-badge-login class="badge <%= isLoginStopped ? 'bg-danger' : 'bg-info text-dark' %> mb-2">
              <%= isLoginStopped ? 'Login gesperrt' : 'Login erlaubt' %>
            </span>
          </p>

          <p class="mb-2">
            <i class="bi bi-person-fill me-2 text-primary"></i>
            <% if (u.gender === 1 || u.gender === 2) { %>
              Herr <%= u.firstname %> <%= u.lastname %>
            <% } else if (u.gender === 3) { %>
              Frau <%= u.firstname %> <%= u.lastname %>
            <% } else { %>
              <%= u.firstname %> <%= u.lastname %>
            <% } %>
          </p>
          <p class="mb-2">
            <i class="bi bi-person-badge me-2 text-success"></i>
            Kundennummer:
            <a href="/admin/users/<%= u.id %>/activity" class="customer-id-link">
              <%= u.id || '–' %>
            </a>
          </p>
          <p class="mb-2">
            <i class="bi bi-building me-2 text-success"></i>
            <%= u.company || '–' %>
          </p>
          <p class="mb-2">
            <i class="bi bi-telephone-fill me-2 text-warning"></i>
            <%= u.phone || '–' %>
            <% if (u.mobile) { %>
              <span class="ms-3">
                <i class="bi bi-phone-fill me-1 text-danger"></i><%= u.mobile %>
              </span>
            <% } %>
          </p>
          <% if (u.fax) { %>
            <p class="mb-0">
              <i class="bi bi-printer-fill me-2 text-muted"></i>
              <%= u.fax %>
            </p>
          <% } %>
          <p class="mb-2">
            <i class="bi bi-house-fill me-2 text-info"></i>
            <%= u.street || '–' %> <%= u.housenumber || '' %>
          </p>
          <p class="mb-2">
            <i class="bi bi-geo-alt-fill me-2 text-secondary"></i>
            <%= u.city || '–' %>, <%= u.postcode || '' %>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope-fill me-2 text-danger"></i>
            <%= u.email %>
          </p>
          <% const website = (u.website || '').trim(); %>
          <% if (website) { %>
            <% const websiteHref = /^https?:\/\//i.test(website) ? website : `https://${website}`; %>
            <p class="mb-2">
              <i class="bi bi-globe2 me-2 text-secondary"></i>
              Website:
              <a href="<%= websiteHref %>" target="_blank" rel="noopener noreferrer"><%= website %></a>
            </p>
          <% } %>
          <p class="mb-2">
            <i class="bi bi-box-seam me-2 text-primary"></i>
            Pakete (<%= u.ordered_packages_count || 0 %>): <%= u.package_names || '–' %>
          </p>
          <p class="mb-2">
            <i class="bi bi-diagram-3-fill me-2 text-success"></i>
            Entitäten bestellt: <%= u.ordered_entities_count || 0 %>
            <% if (u.ordered_entity_names) { %>
              <br><small class="text-muted"><%= u.ordered_entity_names %></small>
            <% } %>
          </p>
          <div class="small border rounded p-2 mb-2 bg-light">
            <div>Entwürfe: <strong><%= u.listings_drafts || 0 %></strong> (visible 0 / status 0)</div>
            <div>Online: <strong><%= u.listings_online || 0 %></strong> (status 3 / visible 1)</div>
            <div>Pausiert: <strong><%= u.listings_paused || 0 %></strong> (status 4 / visible 0)</div>
          </div>

          <div class="mt-auto d-grid gap-2">
            <% if (canLogin) { %>
              <form action="/admin/users/<%= u.id %>/expire" method="post" class="js-user-toggle-form" data-user-id="<%= u.id %>" data-action-type="expire">
                <button type="submit" class="btn btn-sm btn-danger w-100 js-user-toggle-btn">
                  <i class="bi bi-x-circle me-1"></i> Stoppen
                </button>
              </form>
            <% } else { %>
              <form action="/admin/users/<%= u.id %>/activate" method="post" class="js-user-toggle-form" data-user-id="<%= u.id %>" data-action-type="activate">
                <button type="submit" class="btn btn-sm btn-success w-100 js-user-toggle-btn">
                  <i class="bi bi-check-circle me-1"></i> Aktivieren
                </button>
              </form>
            <% } %>

            <a href="/admin/users/<%= u.id %>/activity"
              class="btn btn-sm btn-outline-primary w-100">
              <i class="bi bi-activity me-1"></i> Aktivität
            </a>

            <a href="/admin/users/<%= u.id %>/edit" 
              class="btn btn-sm btn-secondary w-100">
              <i class="bi bi-pencil-fill me-1"></i> Bearbeiten
            </a>

            <% if (hasListings) { %>
              <a href="/admin/users/<%= u.id %>/overview"
                class="btn btn-sm btn-primary w-100">
                <i class="bi bi-eye me-1"></i> Overview
              </a>
            <% } %>

            <a href="/admin/listings/users/<%= u.id %>/new-listing"
                class="btn btn-sm btn-success w-100">
              <i class="bi bi-plus-circle me-1"></i> Neues Inserat
            </a>
          </div>

        </div>
      </div>
    </div> 
  <% }) %>
</div>


    <!-- Elliptische Pagination -->
    <% if (totalPages > 1) {
         const max = 5, half = Math.floor(max/2);
         let start = Math.max(1, page-half);
         let end   = Math.min(totalPages, start+max-1);
         if (end-start < max-1) start = Math.max(1, end-max+1);
    %>
      <nav aria-label="Seiten-Navigation" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= page===1?'disabled':'' %>">
            <a class="page-link" href="<%= buildQuery({ page: 1 }) %>">« Erste</a>
          </li>
          <li class="page-item <%= page===1?'disabled':'' %>">
            <a class="page-link" href="<%= buildQuery({ page: page - 1 }) %>">‹ Zurück</a>
          </li>

          <% if (start>1) { %>
            <li class="page-item disabled"><span class="page-link">…</span></li>
          <% } %>

          <% for (let p=start; p<=end; p++) { %>
            <li class="page-item <%= p===page?'active':'' %>">
              <a class="page-link" href="<%= buildQuery({ page: p }) %>"><%= p %></a>
            </li>
          <% } %>

          <% if (end<totalPages) { %>
            <li class="page-item disabled"><span class="page-link">…</span></li>
          <% } %>

          <li class="page-item <%= page===totalPages?'disabled':'' %>">
            <a class="page-link" href="<%= buildQuery({ page: page + 1 }) %>">Weiter ›</a>
          </li>
          <li class="page-item <%= page===totalPages?'disabled':'' %>">
            <a class="page-link" href="<%= buildQuery({ page: totalPages }) %>">Letzte »</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </main>
</div>
<script>
  (() => {
    const currentStatusFilter = '<%= status || "all" %>';

    function updateToggleForm(card, canLogin, userId) {
      const container = card.querySelector('.mt-auto.d-grid');
      const currentForm = container && container.querySelector('.js-user-toggle-form');
      if (!container || !currentForm) return;

      const nextAction = canLogin ? 'expire' : 'activate';
      const actionUrl = `/admin/users/${userId}/${nextAction}`;
      const btnClass = canLogin ? 'btn-danger' : 'btn-success';
      const icon = canLogin ? 'bi-x-circle' : 'bi-check-circle';
      const label = canLogin ? 'Stoppen' : 'Aktivieren';

      currentForm.setAttribute('action', actionUrl);
      currentForm.dataset.actionType = nextAction;
      currentForm.innerHTML = `
        <button type="submit" class="btn btn-sm ${btnClass} w-100 js-user-toggle-btn">
          <i class="bi ${icon} me-1"></i> ${label}
        </button>
      `;
    }

    function updateBadges(card, { confirmed, logging }) {
      const isConfirmed = Number(confirmed) === 1;
      const isLoginStopped = Number(logging) === 0;
      const isUserActive = isConfirmed;

      const activeBadge = card.querySelector('[data-user-badge-active]');
      const emailBadge = card.querySelector('[data-user-badge-email]');
      const loginBadge = card.querySelector('[data-user-badge-login]');

      if (activeBadge) {
        activeBadge.className = `badge ${isUserActive ? 'bg-success' : 'bg-secondary'} mb-2`;
        activeBadge.textContent = isUserActive ? 'aktiv' : 'inaktiv';
      }
      if (emailBadge) {
        emailBadge.className = `badge ${isConfirmed ? 'bg-success' : 'bg-warning text-dark'} mb-2`;
        emailBadge.textContent = isConfirmed ? 'E-Mail bestätigt' : 'E-Mail offen';
      }
      if (loginBadge) {
        loginBadge.className = `badge ${isLoginStopped ? 'bg-danger' : 'bg-info text-dark'} mb-2`;
        loginBadge.textContent = isLoginStopped ? 'Login gesperrt' : 'Login erlaubt';
      }
    }

    function maybeHideByFilter(card, { confirmed }) {
      const isActive = Number(confirmed) === 1;
      if (currentStatusFilter === 'active' && !isActive) {
        card.style.display = 'none';
      }
      if ((currentStatusFilter === 'inactive' || currentStatusFilter === 'expired') && isActive) {
        card.style.display = 'none';
      }
    }

    document.addEventListener('submit', async (event) => {
      const form = event.target.closest('.js-user-toggle-form');
      if (!form) return;

      event.preventDefault();

      const button = form.querySelector('.js-user-toggle-btn');
      const card = form.closest('[data-user-card]');
      const userId = form.dataset.userId;
      if (!button || !card || !userId) return;

      const originalHtml = button.innerHTML;
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Speichern...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          credentials: 'same-origin'
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) {
          throw new Error(data.error || 'Aktion konnte nicht gespeichert werden.');
        }

        updateBadges(card, data);
        updateToggleForm(card, Boolean(data.canLogin), userId);
        maybeHideByFilter(card, data);
      } catch (err) {
        alert(err.message || 'Fehler bei der Aktion.');
      } finally {
        const latestButton = form.querySelector('.js-user-toggle-btn');
        if (latestButton) {
          latestButton.disabled = false;
          if (latestButton.innerHTML.includes('spinner-border')) {
            latestButton.innerHTML = originalHtml;
          }
        }
      }
    });
  })();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

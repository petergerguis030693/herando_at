<%- include('../../partials/header-admin') %>
<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width:250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <main class="p-4 flex-fill">
    <h1 class="h4 mb-4">
      <%= data.id ? 'Benutzer bearbeiten' : 'Neuen Benutzer anlegen' %>
    </h1>

    <% if (errors && errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(e => { %>
            <li><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <% if (successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } %>
    <% if (errorMessage) { %>
      <div class="alert alert-danger"><%= errorMessage %></div>
    <% } %>

    <form method="POST" enctype="multipart/form-data">
      <!-- Anrede & Name -->
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Anrede &amp; Name</legend>
        <div class="row g-3">
          <div class="col-md-2">
            <label for="gender" class="form-label">Anrede *</label>
            <select id="gender" name="gender" class="form-select form-select-sm" required>
              <option value="">– Bitte wählen –</option>
              <option value="2" <%= data.gender=='2'?'selected':'' %>>Herr</option>
              <option value="3" <%= data.gender=='3'?'selected':'' %>>Frau</option>
              <option value="1" <%= data.gender=='1'?'selected':'' %>>Herr (Legacy)</option>
            </select>
          </div>
          <div class="col-md-5">
            <label for="firstname" class="form-label">Vorname *</label>
            <input type="text" id="firstname" name="firstname"
                   class="form-control form-control-sm"
                   value="<%= data.firstname||'' %>" required>
          </div>
          <div class="col-md-5">
            <label for="lastname" class="form-label">Nachname *</label>
            <input type="text" id="lastname" name="lastname"
                   class="form-control form-control-sm"
                   value="<%= data.lastname||'' %>" required>
          </div>
        </div>
      </fieldset>

      <!-- Kontakt -->
      <div class="form-check mb-4">
        <input type="checkbox" id="contact" name="contact"
               class="form-check-input" <%= data.contact?'checked':'' %>>
        <label for="contact" class="form-check-label">Kontakt möglich</label>
      </div>

      <!-- Firma & USt-ID -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label for="company" class="form-label">Firma</label>
          <input type="text" id="company" name="company"
                 class="form-control form-control-sm"
                 value="<%= data.company||'' %>">
        </div>
        <div class="col-md-6">
          <label for="vatid" class="form-label">USt-ID</label>
          <input type="text" id="vatid" name="vatid"
                 class="form-control form-control-sm"
                 value="<%= data.vatid||'' %>">
        </div>
      </div>

      <!-- Adresse -->
      <div class="row g-3 mb-4">
        <div class="col-md-5">
          <label for="street" class="form-label">Straße</label>
          <input type="text" id="street" name="street"
                 class="form-control form-control-sm"
                 value="<%= data.street||'' %>">
        </div>
        <div class="col-md-2">
          <label for="housenumber" class="form-label">Nr.</label>
          <input type="text" id="housenumber" name="housenumber"
                 class="form-control form-control-sm"
                 value="<%= data.housenumber||'' %>">
        </div>
        <div class="col-md-2">
          <label for="postcode" class="form-label">PLZ</label>
          <input type="text" id="postcode" name="postcode"
                 class="form-control form-control-sm"
                 value="<%= data.postcode||'' %>">
        </div>
        <div class="col-md-3">
          <label for="city" class="form-label">Ort</label>
          <input type="text" id="city" name="city"
                 class="form-control form-control-sm"
                 value="<%= data.city||'' %>">
        </div>
      </div>

      <!-- Land -->
      <div class="mb-4">
        <label for="country_id" class="form-label">Land *</label>
        <select id="country_id" name="country_id" class="form-select form-select-sm" required>
          <option value="">– Bitte wählen –</option>
          <% countries.forEach(c => { %>
            <option value="<%= c.id %>" <%= data.country_id==c.id?'selected':'' %>>
              <%= c.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Kontaktdaten -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <label for="phone" class="form-label">Telefon</label>
          <input type="text" id="phone" name="phone"
                 class="form-control form-control-sm"
                 value="<%= data.phone||'' %>">
        </div>
        <div class="col-md-4">
          <label for="mobile" class="form-label">Mobil</label>
          <input type="text" id="mobile" name="mobile"
                 class="form-control form-control-sm"
                 value="<%= data.mobile||'' %>">
        </div>
        <div class="col-md-4">
          <label for="fax" class="form-label">Fax</label>
          <input type="text" id="fax" name="fax"
                 class="form-control form-control-sm"
                 value="<%= data.fax||'' %>">
        </div>
      </div>

      <!-- Email & Website -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label for="email" class="form-label">E-Mail *</label>
          <input type="email" id="email" name="email"
                 class="form-control form-control-sm"
                 value="<%= data.email||'' %>" required>
        </div>
        <div class="col-md-6">
          <label for="website" class="form-label">Webseite</label>
          <input type="text" id="website" name="website"
                 class="form-control form-control-sm"
                 value="<%= data.website||'' %>">
        </div>
      </div>

      <!-- Passwort (optional beim Bearbeiten) -->
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Passwort vergeben</legend>
        <div class="row g-3">
          <div class="col-md-6">
            <label for="new_password" class="form-label">Neues Passwort</label>
            <input type="password" id="new_password" name="new_password"
                   class="form-control form-control-sm"
                   autocomplete="new-password"
                   placeholder="mind. 8 Zeichen">
          </div>
          <div class="col-md-6">
            <label for="new_password_repeat" class="form-label">Passwort wiederholen</label>
            <input type="password" id="new_password_repeat" name="new_password_repeat"
                   class="form-control form-control-sm"
                   autocomplete="new-password"
                   placeholder="Passwort wiederholen">
          </div>
        </div>
        <small class="text-muted d-block mt-2">
          Leer lassen, wenn das bestehende Passwort unverändert bleiben soll.
        </small>
      </fieldset>

      <!-- Sichtbarkeit -->
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Im Inserat anzeigen</legend>
        <div class="form-check mb-2">
          <input type="checkbox" id="showName" name="showName"
                 class="form-check-input" <%= data.showName?'checked':'' %>>
          <label for="showName" class="form-check-label">Name anzeigen</label>
        </div>
        <div class="form-check mb-2">
          <input type="checkbox" id="showEmail" name="showEmail"
                 class="form-check-input" <%= data.showEmail?'checked':'' %>>
          <label for="showEmail" class="form-check-label">E-Mail anzeigen</label>
        </div>
        <div class="form-check">
          <input type="checkbox" id="showPhone" name="showPhone"
                 class="form-check-input" <%= data.showPhone?'checked':'' %>>
          <label for="showPhone" class="form-check-label">Telefon anzeigen</label>
        </div>
      </fieldset>

      <!-- Firmenlogo -->
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Firmenlogo</legend>
        <input type="file" name="logo" class="form-control form-control-sm">
      </fieldset>

      <!-- Impressum -->
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Impressum</legend>
        <textarea name="imprint" class="form-control" rows="4"><%= data.imprint||'' %></textarea>
      </fieldset>

      <!-- Paket & Kategorie (mehrfach) -->
      <%
        const packageAssignments = Array.isArray(data.package_assignments) && data.package_assignments.length
          ? data.package_assignments
          : [{ package_id: '', category_id: '' }];
      %>
      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Pakete &amp; Kategorien</legend>
        <p class="text-muted mb-3">Mehrere Paket/Kategorie-Zuweisungen sind möglich.</p>

        <div id="package-assignment-list">
          <% packageAssignments.forEach((assignment, index) => { %>
            <div class="row g-2 align-items-end mb-2 js-package-assignment-row">
              <div class="col-md-5">
                <label class="form-label js-assignment-label">Zuweisung <%= index + 1 %> - Paket</label>
                <select name="assignment_package_id[]" class="form-select form-select-sm">
                  <option value="">– Bitte wählen –</option>
                  <% packages.forEach(pkg => { %>
                    <option value="<%= pkg.id %>" <%= String(assignment.package_id || '') === String(pkg.id) ? 'selected' : '' %>>
                      <%= pkg.name %> - €<%= Number(pkg.price || 0).toFixed(2) %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-5">
                <label class="form-label">Kategorie</label>
                <select name="assignment_category_id[]" class="form-select form-select-sm">
                  <option value="">– Bitte wählen –</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= String(assignment.category_id || '') === String(cat.id) ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-outline-danger btn-sm js-remove-assignment">Entfernen</button>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="mt-2">
          <button type="button" id="add-package-assignment" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Weitere Zuweisung
          </button>
        </div>

        <template id="package-assignment-template">
          <div class="row g-2 align-items-end mb-2 js-package-assignment-row">
            <div class="col-md-5">
              <label class="form-label js-assignment-label">Zuweisung - Paket</label>
              <select name="assignment_package_id[]" class="form-select form-select-sm">
                <option value="">– Bitte wählen –</option>
                <% packages.forEach(pkg => { %>
                  <option value="<%= pkg.id %>">
                    <%= pkg.name %> - €<%= Number(pkg.price || 0).toFixed(2) %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-5">
              <label class="form-label">Kategorie</label>
              <select name="assignment_category_id[]" class="form-select form-select-sm">
                <option value="">– Bitte wählen –</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2 d-grid">
              <button type="button" class="btn btn-outline-danger btn-sm js-remove-assignment">Entfernen</button>
            </div>
          </div>
        </template>
      </fieldset>

      <fieldset class="border rounded p-3 mb-4">
        <legend class="w-auto px-2">Zusatzleistungen &amp; Inserat-Auswahl</legend>
        <p class="text-muted mb-3">
          Diese Zuordnung wird auf einer separaten Seite verwaltet, damit die Benutzerbearbeitung übersichtlich bleibt.
        </p>
        <% if (data.id) { %>
          <a href="/admin/users/<%= data.id %>/addons" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-grid-3x3-gap"></i> Zusatzleistungen öffnen
          </a>
        <% } else { %>
          <div class="alert alert-secondary mb-0">
            Bitte zuerst den Benutzer speichern. Danach kannst du Zusatzleistungen und Inserate separat zuordnen.
          </div>
        <% } %>
      </fieldset>

      <% if (data.id) { %>
        <fieldset class="border rounded p-3 mb-4">
          <legend class="w-auto px-2">Login-Sperre</legend>
          <% const _failedAttempts = Number(data.admin_login_failed_attempts || 0); %>
          <% const _locked = Number(data.admin_login_locked || 0) === 1; %>

          <div class="d-flex flex-wrap align-items-center gap-3">
            <% if (_locked) { %>
              <span class="badge text-bg-danger">Gesperrt</span>
            <% } else { %>
              <span class="badge text-bg-success">Nicht gesperrt</span>
            <% } %>

            <span class="text-muted">
              Fehlversuche: <strong><%= _failedAttempts %></strong>
            </span>

            <div class="ms-auto">
              <button type="submit"
                      class="btn btn-outline-warning btn-sm"
                      formaction="/admin/users/<%= data.id %>/unlock-admin-login"
                      formmethod="POST"
                      formnovalidate
                      onclick="return confirm('Login-Sperre für diesen Benutzer wirklich aufheben?')"
                      <%= (!_locked && _failedAttempts === 0) ? 'disabled' : '' %>>
                <i class="bi bi-unlock"></i> Login entsperren
              </button>
            </div>
          </div>

          <div class="small text-muted mt-2">
            Hebt die temporäre Login-Sperre auf und setzt den Fehlversuchs-Zähler zurück.
          </div>
        </fieldset>
      <% } %>


      <button type="submit" class="btn btn-primary">
        <%= data.id ? 'Änderungen speichern' : 'Benutzer anlegen' %>
      </button>
    </form>

    <% const selectedPackageRows = Array.isArray(selectedPackagesForActions) ? selectedPackagesForActions : []; %>
    <% if (data.id) { %>
      <section class="border rounded p-3 mt-4">
        <h2 class="h6 mb-3">Paket-Laufzeiten verwalten</h2>
        <% if (!selectedPackageRows.length) { %>
          <div class="text-muted small mb-0">Keine aktiven oder deaktivierten Paketzuordnungen vorhanden.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th>Paket</th>
                  <th>Kategorie</th>
                  <th>Start</th>
                  <th>Ende</th>
                  <th>Status</th>
                  <th>Aktion</th>
                </tr>
              </thead>
              <tbody>
                <% selectedPackageRows.forEach((sp) => { %>
                  <tr>
                    <td><%= sp.package_name || ('ID ' + sp.package_id) %></td>
                    <td><%= sp.category_name || ('ID ' + sp.category_id) %></td>
                    <td><%= sp.start_date_display || '–' %></td>
                    <td><%= sp.effective_end_date_display || '–' %></td>
                    <td>
                      <% if (sp.is_deactivated) { %>
                        <span class="badge text-bg-secondary">Deaktiviert</span>
                      <% } else { %>
                        <span class="badge text-bg-success">Aktiv</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="d-flex flex-wrap gap-2">
                        <% if (sp.is_deactivated) { %>
                          <form method="POST" action="/admin/users/<%= data.id %>/selected-packages/<%= sp.id %>/reactivate">
                            <button type="submit" class="btn btn-outline-success btn-sm"
                                    onclick="return confirm('Paket wirklich reaktivieren?')">
                              Reaktivieren
                            </button>
                          </form>
                        <% } else { %>
                          <form method="POST" action="/admin/users/<%= data.id %>/selected-packages/<%= sp.id %>/deactivate">
                            <button type="submit" class="btn btn-outline-warning btn-sm"
                                    onclick="return confirm('Paket wirklich deaktivieren?')">
                              Deaktivieren
                            </button>
                          </form>
                        <% } %>

                        <form method="POST" action="/admin/users/<%= data.id %>/selected-packages/<%= sp.id %>/extend">
                          <button type="submit" class="btn btn-outline-primary btn-sm"
                                  onclick="return confirm('Paket automatisch um 12 Monate verlängern?')">
                            +12 Monate
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>
</div>

<script>
  (() => {
    const wrapper = document.getElementById('package-assignment-list');
    const addBtn = document.getElementById('add-package-assignment');
    const template = document.getElementById('package-assignment-template');
    if (!wrapper || !addBtn || !template) return;

    const updateLabels = () => {
      wrapper.querySelectorAll('.js-package-assignment-row').forEach((row, idx) => {
        const label = row.querySelector('.js-assignment-label');
        if (label) label.textContent = `Zuweisung ${idx + 1} - Paket`;
      });
    };

    const bindRemove = (row) => {
      const btn = row.querySelector('.js-remove-assignment');
      if (!btn) return;
      btn.addEventListener('click', () => {
        row.remove();
        if (!wrapper.querySelector('.js-package-assignment-row')) {
          const clone = template.content.firstElementChild.cloneNode(true);
          wrapper.appendChild(clone);
          bindRemove(clone);
        }
        updateLabels();
      });
    };

    wrapper.querySelectorAll('.js-package-assignment-row').forEach(bindRemove);
    updateLabels();

    addBtn.addEventListener('click', () => {
      const clone = template.content.firstElementChild.cloneNode(true);
      wrapper.appendChild(clone);
      bindRemove(clone);
      updateLabels();
    });
  })();
</script>

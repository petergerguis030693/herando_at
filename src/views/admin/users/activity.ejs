<%- include('../../partials/header-admin') %>

<style>
  .activity-table td {
    vertical-align: top;
  }

  .activity-path {
    max-width: 360px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.82rem;
    word-break: break-word;
  }
</style>

<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <main class="flex-fill p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <h1 class="mb-1">Kundenaktivität</h1>
        <div class="text-muted">
          <strong><%= user.firstname || '' %> <%= user.lastname || '' %></strong>
          (<%= user.email || 'keine E-Mail' %>) | Kundennummer #<%= user.id %>
        </div>
      </div>
      <div class="d-flex gap-2">
        <a href="/admin/users" class="btn btn-outline-secondary btn-sm">Zur Kundenliste</a>
        <a href="/admin/users/<%= user.id %>/edit" class="btn btn-secondary btn-sm">Kunde bearbeiten</a>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body">
            <div class="small text-muted">Firma</div>
            <div class="fw-semibold mb-2"><%= user.company || '–' %></div>
            <div class="small text-muted">Letzter Login</div>
            <div class="fw-semibold"><%= user.last_online || '–' %></div>
          </div>
        </div>
      </div>
      <div class="col-md-8">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body row g-3">
            <div class="col-sm-4">
              <div class="small text-muted">Alle Einträge</div>
              <div class="fs-4 fw-bold"><%= paging.totalCount %></div>
            </div>
            <div class="col-sm-4">
              <div class="small text-muted">Seiten/Formular-Aktionen</div>
              <div class="fs-4 fw-bold"><%= stats.requestCount %></div>
            </div>
            <div class="col-sm-4">
              <div class="small text-muted">Button-/Link-Klicks</div>
              <div class="fs-4 fw-bold"><%= stats.clickCount %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%
      const buildQuery = (patch = {}) => {
        const merged = {
          from: query.from || '',
          to: query.to || '',
          path: query.path || '',
          per_page: query.per_page || 50,
          page: paging.page || 1,
          ...patch
        };
        const params = new URLSearchParams();
        Object.entries(merged).forEach(([key, value]) => {
          if (value === null || value === undefined || value === '') return;
          params.set(key, String(value));
        });
        const qs = params.toString();
        return qs ? `?${qs}` : '?';
      };
    %>

    <form method="get" class="card shadow-sm border-0 mb-4">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label for="from" class="form-label fw-semibold">Von</label>
            <input id="from" name="from" type="date" class="form-control" value="<%= query.from || '' %>">
          </div>
          <div class="col-md-3">
            <label for="to" class="form-label fw-semibold">Bis</label>
            <input id="to" name="to" type="date" class="form-control" value="<%= query.to || '' %>">
          </div>
          <div class="col-md-4">
            <label for="path" class="form-label fw-semibold">Seite enthält</label>
            <input id="path" name="path" type="text" class="form-control" placeholder="/admin/listings" value="<%= query.path || '' %>">
          </div>
          <div class="col-md-2">
            <label for="per_page" class="form-label fw-semibold">Pro Seite</label>
            <select id="per_page" name="per_page" class="form-select">
              <option value="25" <%= Number(query.per_page) === 25 ? 'selected' : '' %>>25</option>
              <option value="50" <%= Number(query.per_page) === 50 ? 'selected' : '' %>>50</option>
              <option value="100" <%= Number(query.per_page) === 100 ? 'selected' : '' %>>100</option>
              <option value="200" <%= Number(query.per_page) === 200 ? 'selected' : '' %>>200</option>
            </select>
          </div>
          <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter anwenden</button>
            <a href="/admin/users/<%= user.id %>/activity" class="btn btn-outline-secondary">Filter zurücksetzen</a>
          </div>
        </div>
      </div>
    </form>

    <div class="card shadow-sm border-0">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Aktivitätsverlauf</span>
        <span class="badge text-bg-light"><%= paging.totalCount %> Einträge</span>
      </div>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0 activity-table">
          <thead>
            <tr>
              <th style="width: 170px;">Zeitpunkt</th>
              <th style="width: 120px;">Typ</th>
              <th>Was wurde gemacht?</th>
              <th style="width: 170px;">Bereich</th>
              <th style="width: 360px;">Seite</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% if (!events || !events.length) { %>
              <tr>
                <td colspan="6" class="text-muted">Keine Aktivitäten im gewählten Zeitraum gefunden.</td>
              </tr>
            <% } else { %>
              <% events.forEach((row) => { %>
                <tr>
                  <td><%= row.created_at_label || '–' %></td>
                  <td>
                    <span class="badge <%= row.source_type === 'click' ? 'text-bg-info' : 'text-bg-primary' %>">
                      <%= row.source_label %>
                    </span>
                  </td>
                  <td><strong><%= row.action_text || '–' %></strong></td>
                  <td><%= row.area_text || '–' %></td>
                  <td class="activity-path"><%= row.path || '–' %></td>
                  <td><%= row.detail_text || '–' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (paging.totalPages > 1) { %>
      <nav aria-label="Aktivitaets-Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= paging.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= buildQuery({ page: 1 }) %>">« Erste</a>
          </li>
          <li class="page-item <%= paging.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= buildQuery({ page: paging.page - 1 }) %>">‹ Zurück</a>
          </li>

          <% for (let p = Math.max(1, paging.page - 2); p <= Math.min(paging.totalPages, paging.page + 2); p++) { %>
            <li class="page-item <%= p === paging.page ? 'active' : '' %>">
              <a class="page-link" href="<%= buildQuery({ page: p }) %>"><%= p %></a>
            </li>
          <% } %>

          <li class="page-item <%= paging.page >= paging.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= buildQuery({ page: paging.page + 1 }) %>">Weiter ›</a>
          </li>
          <li class="page-item <%= paging.page >= paging.totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="<%= buildQuery({ page: paging.totalPages }) %>">Letzte »</a>
          </li>
        </ul>
      </nav>
    <% } %>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

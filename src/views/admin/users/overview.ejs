     <%- include('../../partials/header-admin') %>

<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar text-white p-3" style="width: 250px; min-height: 100vh;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Content -->
  <div class="container-fluid py-4">

    <!-- Kundenprofil -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body d-flex align-items-center">
        <img src="<%= user.avatar || 'https://via.placeholder.com/80' %>" 
             alt="Profilbild" class="rounded-circle me-3" width="80" height="80">
        <div>
          <h4 class="mb-1 fw-bold">
            <%= user.firstname %> <%= user.lastname %> 
            <small class="text-muted">(#<%= user.id %>)</small>
          </h4>
          <div class="text-muted small">
            <i class="bi bi-envelope"></i> <%= user.email %> &nbsp;|&nbsp;
            <% if (user.phone) { %><i class="bi bi-telephone"></i> <%= user.phone %> &nbsp;|&nbsp;<% } %>
            <% if (user.company) { %><i class="bi bi-building"></i> <%= user.company %><% } %>
          </div>
          <div class="mt-2">
            <span class="badge bg-<%= user.confirmed ? 'success' : 'danger' %>">
              <%= user.confirmed ? 'Bestätigt' : 'Nicht bestätigt' %>
            </span>
            <small class="text-muted ms-3">Letzter Login: <%= last_online || '—' %></small>
          </div>
        </div>
        <div class="ms-auto">
          <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary btn-sm">Bearbeiten</a>
          <a href="#" class="btn btn-danger btn-sm">Deaktivieren</a>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="userTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="inserate-tab" data-bs-toggle="tab" data-bs-target="#tab-inserate" type="button" role="tab" aria-controls="tab-inserate" aria-selected="true">
          Inserate
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="stats-tab" data-bs-toggle="tab" data-bs-target="#tab-stats" type="button" role="tab" aria-controls="tab-stats" aria-selected="false">
          Statistiken
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- Tab: Inserate -->
      <div class="tab-pane fade show active" id="tab-inserate" role="tabpanel" aria-labelledby="inserate-tab">

        <!-- Filter -->
        <div class="card mb-4 shadow-sm">
          <div class="card-body">
            <form method="GET" class="row g-3 align-items-end">
              <div class="col-md-3">
                <label for="status" class="form-label fw-bold">Status</label>
                <select name="status" id="status" class="form-select">
                  <option value="" <%= !query.status ? 'selected' : '' %>>Alle</option>
                  <option value="online" <%= query.status === 'online' ? 'selected' : '' %>>Online</option>
                  <option value="offline" <%= query.status === 'offline' ? 'selected' : '' %>>Offline</option>
                </select>
              </div>
              <div class="col-md-3">
                <label for="visits" class="form-label fw-bold">Besucher</label>
                <select name="visits" id="visits" class="form-select">
                  <option value="" <%= !query.visits ? 'selected' : '' %>>Alle</option>
                  <option value="0" <%= query.visits === '0' ? 'selected' : '' %>>0 Besucher</option>
                  <option value="10plus" <%= query.visits === '10plus' ? 'selected' : '' %>>ab 10 Besucher</option>
                  <option value="100plus" <%= query.visits === '100plus' ? 'selected' : '' %>>ab 100 Besucher</option>
                </select>
              </div>
              <div class="col-md-3">
                <label for="minPrice" class="form-label fw-bold">Mindestpreis (€)</label>
                <input type="number" step="1" min="0" name="minPrice" id="minPrice" 
                       value="<%= query.minPrice || '' %>" class="form-control">
              </div>
              <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                  <i class="bi bi-funnel"></i> Filtern
                </button>
                <a href="/admin/users/<%= user.id %>/overview" class="btn btn-secondary flex-fill">
                  <i class="bi bi-x-circle"></i> Zurücksetzen
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Kategorien -->
        <div class="card mb-4">
          <div class="card-header fw-bold">Ausgewählte Kategorien</div>
          <div class="card-body">
            <% let selectedCategories = listingsByEntity.filter(ent => ent.rows && ent.rows.length > 0); %>
            <% if (!selectedCategories.length) { %>
              <div class="text-muted">Keine Kategorien ausgewählt.</div>
            <% } else { %>
              <% selectedCategories.forEach(ent => { %>
                <span class="badge bg-secondary me-1 mb-1">
                  <%= ent.entitie_name %> (<%= ent.count %>)
                </span>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Inserate -->
        <h5 class="fw-bold mb-3">Inserate</h5>
        <% if (!selectedCategories.length) { %>
          <div class="alert alert-secondary">Keine Inserate gefunden.</div>
        <% } else { %>
          <% selectedCategories.forEach(function(ent){ %>
            <h6 class="fw-bold mb-3"><%= ent.entitie_name %> <span class="badge bg-secondary"><%= ent.count %></span></h6>
            <div class="row g-3 mb-4">
              <% ent.rows.forEach(function(r){ %>
                <div class="col-md-4 col-lg-3">
                  <div class="card shadow-sm">
                    <% if (r.thumb) { %>
                      <img src="<%= r.thumb %>" class="card-img-top" alt="">
                    <% } else { %>
                      <img src="https://via.placeholder.com/300x160?text=Kein+Bild" class="card-img-top" alt="">
                    <% } %>
                    <div class="card-body">
                      <h6 class="card-title mb-1"><%= r.title %></h6>
                      <p class="fw-bold text-success mb-1">
                        <% if (r.price) { %>
                          <%= new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(r.price) %>
                        <% } else { %>
                          —
                        <% } %>
                      </p>
                      <% if (r.status == 3 && r.visible == 1) { %>
                        <span class="badge bg-success">Online</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Offline</span>
                      <% } %>
                      <% if (r.visits != null) { %>
                        <div class="mt-2">
                          <span class="badge bg-info"><%= r.visits %> Besucher</span>
                        </div>
                      <% } %>
                      <div class="mt-2 d-flex">
                        <a href="/admin/listings/<%= ent.route %>/<%= r.id %>/edit" class="btn btn-sm btn-primary me-1">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <a href="https://herando.at/<%= ent.route %>/<%= r.id %>/<%= r.title %>" class="btn btn-sm btn-warning me-1">
                          <i class="bi bi-eye-slash"></i>
                        </a>
                        <a href="#" class="btn btn-sm btn-danger">
                          <i class="bi bi-trash"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Tab: Statistiken -->
      <div class="tab-pane fade" id="tab-stats" role="tabpanel" aria-labelledby="stats-tab">
        <%
          let totalListings = 0;
          let visibleListings = 0;
          let hiddenListings = 0;
          let onlineListings = 0;
          let offlineListings = 0;
          let totalValue = 0;
          selectedCategories.forEach(ent => {
            totalListings += ent.count;
            ent.rows.forEach(r => {
              if (r.visible == 1) visibleListings++;
              else hiddenListings++;
              if (r.status == 3 && r.visible == 1) onlineListings++;
              else offlineListings++;
              if (r.price) totalValue += Number(r.price);
            });
          });
        %>
        <div class="card">
          <div class="card-header fw-bold">Kunden-Statistiken</div>
          <div class="card-body">
            <div class="row text-center">
              <div class="col-md-2"><strong><%= totalListings %></strong><br>Inserate gesamt</div>
              <div class="col-md-2"><strong><%= visibleListings %></strong><br>Sichtbar</div>
              <div class="col-md-2"><strong><%= hiddenListings %></strong><br>Versteckt</div>
              <div class="col-md-2"><strong><%= onlineListings %></strong><br>Online</div>
              <div class="col-md-2"><strong><%= offlineListings %></strong><br>Offline</div>
              <div class="col-md-2"><strong><%= totalValue.toLocaleString('de-DE') %> €</strong><br>Gesamtwert Inserate</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

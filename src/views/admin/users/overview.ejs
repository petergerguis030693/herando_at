     <%- include('../../partials/header-admin') %>

<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar text-white p-3" style="width: 250px; min-height: 100vh;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Content -->
  <div class="container-fluid py-4">

    <!-- Kundenprofil -->
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body d-flex align-items-center">
        <img src="<%= user.avatar || 'https://via.placeholder.com/80' %>" 
             alt="Profilbild" class="rounded-circle me-3" width="80" height="80">
        <div>
          <h4 class="mb-1 fw-bold">
            <%= user.firstname %> <%= user.lastname %> 
            <small class="text-muted">(#<%= user.id %>)</small>
          </h4>
          <div class="text-muted small">
            <i class="bi bi-envelope"></i> <%= user.email %> &nbsp;|&nbsp;
            <% if (user.phone) { %><i class="bi bi-telephone"></i> <%= user.phone %> &nbsp;|&nbsp;<% } %>
            <% if (user.company) { %><i class="bi bi-building"></i> <%= user.company %><% } %>
          </div>
          <div class="mt-2">
            <span class="badge bg-<%= user.confirmed ? 'success' : 'danger' %>">
              <%= user.confirmed ? 'Bestätigt' : 'Nicht bestätigt' %>
            </span>
            <small class="text-muted ms-3">Letzter Login: <%= last_online || '—' %></small>
          </div>
        </div>
        <div class="ms-auto">
          <a href="/admin/users/<%= user.id %>/edit" class="btn btn-primary btn-sm">Bearbeiten</a>
          <a href="#" class="btn btn-danger btn-sm">Deaktivieren</a>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="userTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="inserate-tab" data-bs-toggle="tab" data-bs-target="#tab-inserate" type="button" role="tab" aria-controls="tab-inserate" aria-selected="true">
          Inserate
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="stats-tab" data-bs-toggle="tab" data-bs-target="#tab-stats" type="button" role="tab" aria-controls="tab-stats" aria-selected="false">
          Statistiken
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- Tab: Inserate -->
      <div class="tab-pane fade show active" id="tab-inserate" role="tabpanel" aria-labelledby="inserate-tab">

        <!-- Filter -->
        <div class="card mb-4 shadow-sm">
          <div class="card-body">
            <%
              function buildOverviewQuery(overrides = {}) {
                const params = new URLSearchParams();
                const next = {
                  state: (typeof state === 'string' && state) ? state : 'active',
                  entity: filters?.entity || '',
                  search: filters?.search || '',
                  searchId: filters?.searchId || '',
                  searchTitle: filters?.searchTitle || '',
                  visits: filters?.visits || '',
                  minPrice: filters?.minPrice || '',
                  maxPrice: filters?.maxPrice || '',
                  sort: filters?.sort || '',
                  ...overrides
                };

                Object.entries(next).forEach(([key, value]) => {
                  if (value === null || value === undefined || value === '') return;
                  params.set(key, String(value));
                });

                const queryString = params.toString();
                return `/admin/users/${user.id}/overview${queryString ? `?${queryString}` : ''}`;
              }
            %>

            <div class="d-flex flex-wrap gap-2 mb-3">
              <% (overviewStates || []).forEach((st) => { %>
                <% if (st !== 'all') { %>
                  <a href="<%= buildOverviewQuery({ state: st }) %>"
                     class="btn btn-sm <%= state === st ? 'btn-primary' : 'btn-outline-primary' %>">
                    <%= (stateLabels && stateLabels[st]) || st %> (<%= (stateCounts && stateCounts[st]) || 0 %>)
                  </a>
                <% } %>
              <% }) %>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
              <% const totalEntityCount = (entityOptions || []).reduce((sum, opt) => sum + Number(opt.count || 0), 0); %>
              <% if ((entityOptions || []).length) { %>
                <a href="<%= buildOverviewQuery({ entity: 'all' }) %>"
                   class="btn btn-sm <%= String(filters?.entity || 'all') === 'all' ? 'btn-dark' : 'btn-outline-dark' %>">
                  Alle (<%= totalEntityCount %>)
                </a>
              <% } %>
              <% (entityOptions || []).forEach((opt) => { %>
                <a href="<%= buildOverviewQuery({ entity: opt.route }) %>"
                   class="btn btn-sm <%= String(filters?.entity || '') === String(opt.route) ? 'btn-dark' : 'btn-outline-dark' %>">
                  <%= opt.name %> (<%= opt.count %>)
                </a>
              <% }) %>
            </div>

            <form method="GET" class="row g-3 align-items-end">
              <input type="hidden" name="state" value="<%= state || 'active' %>">
              <input type="hidden" name="entity" value="<%= filters?.entity || '' %>">
              <div class="col-md-3">
                <label for="search" class="form-label fw-bold">Suche</label>
                <input type="text" name="search" id="search" class="form-control"
                       value="<%= filters?.search || '' %>" placeholder="ID oder Titel">
              </div>
              <div class="col-md-3">
                <label for="searchId" class="form-label fw-bold">Inserat-ID</label>
                <input type="text" name="searchId" id="searchId" class="form-control"
                       value="<%= filters?.searchId || '' %>" placeholder="z. B. 12345">
              </div>
              <div class="col-md-3">
                <label for="searchTitle" class="form-label fw-bold">Titel</label>
                <input type="text" name="searchTitle" id="searchTitle" class="form-control"
                       value="<%= filters?.searchTitle || '' %>" placeholder="Titel enthält ...">
              </div>
              <div class="col-md-3">
                <label for="visits" class="form-label fw-bold">Besucher</label>
                <select name="visits" id="visits" class="form-select">
                  <option value="" <%= !filters?.visits ? 'selected' : '' %>>Alle</option>
                  <option value="0" <%= filters?.visits === '0' ? 'selected' : '' %>>0 Besucher</option>
                  <option value="10plus" <%= filters?.visits === '10plus' ? 'selected' : '' %>>ab 10 Besucher</option>
                  <option value="100plus" <%= filters?.visits === '100plus' ? 'selected' : '' %>>ab 100 Besucher</option>
                </select>
              </div>
              <div class="col-md-2">
                <label for="minPrice" class="form-label fw-bold">Preis min (€)</label>
                <input type="number" step="1" min="0" name="minPrice" id="minPrice" 
                       value="<%= filters?.minPrice || '' %>" class="form-control">
              </div>
              <div class="col-md-2">
                <label for="maxPrice" class="form-label fw-bold">Preis max (€)</label>
                <input type="number" step="1" min="0" name="maxPrice" id="maxPrice" 
                       value="<%= filters?.maxPrice || '' %>" class="form-control">
              </div>
              <div class="col-md-3">
                <label for="sort" class="form-label fw-bold">Sortierung</label>
                <select name="sort" id="sort" class="form-select">
                  <option value="" <%= !filters?.sort ? 'selected' : '' %>>Standard</option>
                  <option value="price_asc" <%= filters?.sort === 'price_asc' ? 'selected' : '' %>>Preis aufsteigend</option>
                  <option value="price_desc" <%= filters?.sort === 'price_desc' ? 'selected' : '' %>>Preis absteigend</option>
                  <option value="created_desc" <%= filters?.sort === 'created_desc' ? 'selected' : '' %>>Neueste zuerst</option>
                  <option value="created_asc" <%= filters?.sort === 'created_asc' ? 'selected' : '' %>>Älteste zuerst</option>
                  <option value="modified_desc" <%= filters?.sort === 'modified_desc' ? 'selected' : '' %>>Zuletzt geändert</option>
                  <option value="visits_desc" <%= filters?.sort === 'visits_desc' ? 'selected' : '' %>>Besucher absteigend</option>
                </select>
              </div>
              <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                  <i class="bi bi-funnel"></i> Filtern
                </button>
                <a href="<%= buildOverviewQuery({ search: '', searchId: '', searchTitle: '', visits: '', minPrice: '', maxPrice: '', sort: '' }) %>" class="btn btn-secondary flex-fill">
                  <i class="bi bi-x-circle"></i> Zurücksetzen
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Kategorien -->
        <div class="card mb-4">
          <div class="card-header fw-bold">Ausgewählte Kategorien</div>
          <div class="card-body">
            <% let selectedCategories = listingsByEntity.filter(ent => ent.rows && ent.rows.length > 0); %>
            <% if (!selectedCategories.length) { %>
              <div class="text-muted">Keine Kategorien ausgewählt.</div>
            <% } else { %>
              <% selectedCategories.forEach(ent => { %>
                <span class="badge bg-secondary me-1 mb-1">
                  <%= ent.entitie_name %> (<%= ent.count %>)
                </span>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Inserate -->
        <h5 class="fw-bold mb-3">Inserate</h5>
        <% if (!selectedCategories.length) { %>
          <div class="alert alert-secondary">Keine Inserate gefunden.</div>
        <% } else { %>
          <% selectedCategories.forEach(function(ent){ %>
            <h6 class="fw-bold mb-3"><%= ent.entitie_name %> <span class="badge bg-secondary"><%= ent.count %></span></h6>
            <div class="row g-3 mb-4">
              <% ent.rows.forEach(function(r){ %>
                <div class="col-md-4 col-lg-3">
                  <div class="card shadow-sm">
                    <% if (r.thumb) { %>
                      <img src="<%= r.thumb %>" class="card-img-top" alt="">
                    <% } else { %>
                      <img src="https://via.placeholder.com/300x160?text=Kein+Bild" class="card-img-top" alt="">
                    <% } %>
                    <div class="card-body">
                      <h6 class="card-title mb-1"><%= r.title %></h6>
                      <p class="fw-bold text-success mb-1">
                        <% if (r.price) { %>
                          <%= new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(r.price) %>
                        <% } else { %>
                          —
                        <% } %>
                      </p>
                      <%
                        const createdAt = r.created ? new Date(r.created) : null;
                        const modifiedAt = r.modified ? new Date(r.modified) : null;
                        const createdText = createdAt && !Number.isNaN(createdAt.getTime())
                          ? createdAt.toLocaleDateString('de-DE')
                          : '—';
                        const modifiedText = modifiedAt && !Number.isNaN(modifiedAt.getTime())
                          ? modifiedAt.toLocaleDateString('de-DE')
                          : '—';
                      %>
                      <p class="small text-muted mb-1">Erstellt: <%= createdText %></p>
                      <p class="small text-muted mb-2">Aktualisiert: <%= modifiedText %></p>
                      <% const isOnline = Boolean(r._is_online); %>
                      <% if (isOnline) { %>
                        <span class="badge bg-success">Online</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Offline</span>
                      <% } %>
                      <% if (r.visits != null) { %>
                        <div class="mt-2">
                          <span class="badge bg-info"><%= r.visits %> Besucher</span>
                        </div>
                      <% } %>
                      <% const rowState = r._overview_state || 'all'; %>
                      <form method="POST" action="/admin/listings/<%= ent.route %>/<%= r.id %>/action" class="mt-2">
                        <input type="hidden" name="state" value="<%= rowState %>">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                          <% if (!isOnline && rowState !== 'deleted') { %>
                            <button type="submit" name="action" value="approve" class="btn btn-link p-0" title="Freigeben">
                              <i class="bi bi-check-circle fs-2 text-success"></i>
                            </button>
                          <% } %>
                          <% if (rowState === 'toapprove') { %>
                            <button type="submit" name="action" value="reject" class="btn btn-link p-0" title="Ablehnen">
                              <i class="bi bi-x-circle fs-2 text-danger"></i>
                            </button>
                          <% } %>
                          <% if (rowState !== 'pending') { %>
                            <button type="submit" name="action" value="pend" class="btn btn-link p-0" title="Warten">
                              <i class="bi bi-clock fs-2 text-secondary"></i>
                            </button>
                          <% } %>
                          <% if (rowState !== 'stopped') { %>
                            <button type="submit" name="action" value="stop" class="btn btn-link p-0" title="Stoppen">
                              <i class="bi bi-stop-circle fs-2 text-secondary"></i>
                            </button>
                          <% } %>
                          <% if (rowState !== 'deleted') { %>
                            <button type="submit" name="action" value="delete" class="btn btn-link p-0" title="Löschen">
                              <i class="bi bi-trash fs-2 text-danger"></i>
                            </button>
                          <% } else { %>
                            <button type="submit" name="action" value="restore" class="btn btn-link p-0" title="Wiederherstellen">
                              <i class="bi bi-arrow-counterclockwise fs-2 text-primary"></i>
                            </button>
                          <% } %>

                          <button type="button" class="btn btn-link p-0" title="Vorschau"
                                  onclick="window.open('/<%= ent.route %>/<%= r.id %>/<%= encodeURIComponent(r.title || '') %>','_blank')">
                            <i class="bi bi-eye fs-2 text-secondary"></i>
                          </button>

                          <button type="button" class="btn btn-link p-0" title="Bearbeiten"
                                  onclick="window.open('/admin/listings/<%= ent.route %>/<%= r.id %>/edit','_blank')">
                            <i class="bi bi-pencil fs-2 text-warning"></i>
                          </button>

                          <button type="button" class="btn btn-link p-0" title="In /listings öffnen"
                                  onclick="window.open('/admin/listings?category=<%= encodeURIComponent(ent.route) %>&state=<%= encodeURIComponent(rowState) %>&searchId=<%= encodeURIComponent(r.id) %>','_blank')">
                            <i class="bi bi-list-ul fs-2 text-info"></i>
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Tab: Statistiken -->
      <div class="tab-pane fade" id="tab-stats" role="tabpanel" aria-labelledby="stats-tab">
        <%
          let totalListings = 0;
          let visibleListings = 0;
          let hiddenListings = 0;
          let onlineListings = 0;
          let offlineListings = 0;
          let totalValue = 0;
          selectedCategories.forEach(ent => {
            totalListings += ent.count;
            ent.rows.forEach(r => {
              if (r.visible == 1) visibleListings++;
              else hiddenListings++;
              if (r.status == 3 && r.visible == 1) onlineListings++;
              else offlineListings++;
              if (r.price) totalValue += Number(r.price);
            });
          });
        %>
        <div class="card">
          <div class="card-header fw-bold">Kunden-Statistiken</div>
          <div class="card-body">
            <div class="row text-center">
              <div class="col-md-2"><strong><%= totalListings %></strong><br>Inserate gesamt</div>
              <div class="col-md-2"><strong><%= visibleListings %></strong><br>Sichtbar</div>
              <div class="col-md-2"><strong><%= hiddenListings %></strong><br>Versteckt</div>
              <div class="col-md-2"><strong><%= onlineListings %></strong><br>Online</div>
              <div class="col-md-2"><strong><%= offlineListings %></strong><br>Offline</div>
              <div class="col-md-2"><strong><%= totalValue.toLocaleString('de-DE') %> €</strong><br>Gesamtwert Inserate</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

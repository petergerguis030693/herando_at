<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin – Inserate: <%= category %></title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Dein eigenes Admin‑CSS -->
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="bg-light">
  <div class="d-flex">
    <!-- Sidebar -->
    <%- include('./sidebar', { active }) %>

    <!-- Main Content -->
    <main class="main-content flex-fill">
      <!-- Optional: Dein Header‑Partial -->
      <%- include('admin/_header', { role }) %>

      <div class="content">
        <h2>Aktive Inserate: <%= category.charAt(0).toUpperCase() + category.slice(1) %></h2>
        <a href="/admin/listings" class="btn btn-sm btn-secondary mb-3">← Zur Übersicht</a>

        <% if (rows.length === 0) { %>
          <p class="text-muted">Keine aktiven Inserate gefunden.</p>
        <% } else { %>
          <div class="row">
            <% rows.forEach(item => { %>
              <div class="col-md-4 mb-4">
                <div class="card h-100">
                  <% if (item.mainpicture) { %>
                    <img src="<%= item.mainpicture %>" class="card-img-top" alt="<%= item.name %>">
                  <% } %>
                  <div class="card-body">
                    <h5 class="card-title"><%= item.name %></h5>
                    <p class="card-text">
                      <strong><%= Number(item.price).toLocaleString() %> <%= item.currency %></strong><br>
                      Stopdatum: <%= item.stopdate
                                        ? item.stopdate.toISOString().slice(0,10)
                                        : '–' %>
                    </p>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

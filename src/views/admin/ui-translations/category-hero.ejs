<!-- views/admin/ui-translations/category-hero.ejs -->
<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width:250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <main class="flex-grow-1 p-3">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
      <h1 class="h4 mb-0"><%= headerTitle %></h1>
      <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/ui">UI-Texte öffnen</a>
    </div>

    <p class="text-muted mb-3">
      Für jede Kategorie kann hier das Hero-Bild gesetzt werden. Die Seite `category.ejs` liest den Pfad dynamisch
      über den Key <code>category_hero_image_[route]</code> (z. B. <code>category_hero_image_cars</code>).
    </p>

    <% if (saved) { %>
      <div class="alert alert-success py-2">Kategorie-Hero-Bilder wurden gespeichert.</div>
    <% } %>

    <form method="post" action="/admin/ui/category-hero" enctype="multipart/form-data">
      <div class="row g-3">
        <% categories.forEach((cat) => { %>
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-lg-4">
                    <label class="form-label fw-semibold mb-1"><%= cat.name %></label>
                    <div class="small text-muted mb-2">
                      Route: <code><%= cat.route %></code>
                      <% if (cat.isCustom) { %><span class="badge bg-success ms-1">Custom</span><% } %>
                    </div>
                    <div class="border rounded p-2 bg-light">
                      <img
                        src="<%= cat.currentPath %>"
                        alt="<%= cat.name %>"
                        class="img-fluid rounded"
                        style="max-height:180px; width:100%; object-fit:cover;"
                        onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');"
                      >
                      <div class="small text-danger d-none">Vorschau konnte nicht geladen werden.</div>
                    </div>
                    <div class="small mt-2 text-muted">Aktuell: <code><%= cat.currentPath %></code></div>
                    <div class="small text-muted">Key: <code><%= cat.key %></code></div>
                  </div>

                  <div class="col-lg-8">
                    <div class="mb-3">
                      <label class="form-label">Neues Bild hochladen</label>
                      <input type="file" class="form-control" name="<%= cat.fileField %>" accept="image/*">
                      <div class="form-text">Upload überschreibt Pfad/Reset für diese Kategorie.</div>
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Oder Bildpfad / URL setzen</label>
                      <input
                        type="text"
                        class="form-control"
                        name="<%= cat.pathField %>"
                        value="<%= cat.currentPath %>"
                        placeholder="/uploads/category-hero/datei.webp oder https://..."
                      >
                      <div class="form-text">Lokaler Pfad (mit <code>/</code>) oder externe URL.</div>
                    </div>

                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        value="1"
                        id="reset-category-<%= cat.id %>"
                        name="<%= cat.resetField %>"
                      >
                      <label class="form-check-label" for="reset-category-<%= cat.id %>">
                        Auf Standardbild zurücksetzen (<code><%= cat.fallback %></code>)
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="d-flex gap-2 mt-3 flex-wrap">
        <button class="btn btn-primary" type="submit">Kategorie-Hero-Bilder speichern</button>
        <a class="btn btn-outline-secondary" href="/admin/ui">Zurück zu UI-Texten</a>
      </div>
    </form>
  </main>
</div>

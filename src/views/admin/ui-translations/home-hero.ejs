<!-- views/admin/ui-translations/home-hero.ejs -->
<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width:250px;">
    <%- include('../sidebar', { active: active }) %>
  </aside>

  <main class="flex-grow-1 p-3">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
      <h1 class="h4 mb-0"><%= headerTitle %></h1>
      <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/ui">UI-Texte öffnen</a>
    </div>

    <p class="text-muted mb-3">
      Hier kannst du die 4 Bilder im Homepage-Carousel dynamisch ändern. Die Texte bleiben weiterhin unter
      <code>UI-Texte</code> (Keys wie <code>carousel_slide1_title</code>).
    </p>

    <% if (saved) { %>
      <div class="alert alert-success py-2">Slider-Bilder wurden gespeichert.</div>
    <% } %>

    <div class="card mb-3">
      <div class="card-body">
        <h2 class="h6 mb-2">Direkt zu den Startseiten-Übersetzungen</h2>
        <p class="text-muted mb-2">
          Klick auf einen Button und du landest direkt bei der passenden Übersetzung.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <% slides.forEach((slide) => { const titleKey = `carousel_slide${slide.index}_title`; %>
            <a class="btn btn-outline-primary btn-sm" href="/admin/ui?q_key=<%= encodeURIComponent(titleKey) %>">
              Slide <%= slide.index %> Text
            </a>
          <% }) %>
          <a class="btn btn-outline-primary btn-sm" href="/admin/ui?q_key=<%= encodeURIComponent('all_categories_title') %>">Button/Headline Kategorien</a>
          <a class="btn btn-outline-primary btn-sm" href="/admin/ui?q_key=<%= encodeURIComponent('index.top_offer.sell_now') %>">Button „Jetzt verkaufen“</a>
        </div>
      </div>
    </div>

    <form method="post" action="/admin/ui/home-hero" enctype="multipart/form-data">
      <div class="card mb-3">
        <div class="card-body">
          <h2 class="h6 mb-2">Startseite Reihenfolge (dynamisch)</h2>
          <p class="text-muted mb-2">
            Reihenfolge mit den Pfeilen ändern. Diese Sortierung gilt nur für die Startseite.
          </p>
          <div class="row g-2">
            <div class="col-lg-8">
              <select id="homeEntityOrderList" class="form-select" size="<%= Math.max(4, (homepageEntityOrderItems || []).length) %>">
                <% (homepageEntityOrderItems || []).forEach((item) => { %>
                  <option value="<%= item.route %>"><%= item.name %> (<%= item.route %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="col-lg-4 d-grid gap-2">
              <button type="button" class="btn btn-outline-secondary" id="homeOrderUpBtn">Nach oben</button>
              <button type="button" class="btn btn-outline-secondary" id="homeOrderDownBtn">Nach unten</button>
            </div>
          </div>
          <input type="hidden" id="homeEntityOrderInput" name="home_entity_order" value="<%= homepageEntityOrderValue || '' %>">
          <div class="form-text mt-2">
            Config-Key: <code><%= homepageEntityOrderKey %></code>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <% slides.forEach((slide) => { %>
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <div class="row g-3">
                  <div class="col-lg-4">
                    <label class="form-label fw-semibold"><%= slide.label %></label>
                    <div class="border rounded p-2 bg-light">
                      <img
                        src="<%= slide.currentPath %>"
                        alt="<%= slide.label %>"
                        class="img-fluid rounded"
                        style="max-height:180px; width:100%; object-fit:cover;"
                        onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');"
                      >
                      <div class="small text-danger d-none">Vorschau konnte nicht geladen werden.</div>
                    </div>
                    <div class="small mt-2 text-muted">
                      Aktuell: <code><%= slide.currentPath %></code>
                    </div>
                    <div class="small text-muted">
                      Key: <code><%= slide.key %></code>
                      <% if (slide.isCustom) { %><span class="badge bg-success ms-1">Custom</span><% } %>
                    </div>
                    <div class="small text-muted">
                      Text-Key: <code>carousel_slide<%= slide.index %>_title</code>
                      <a class="btn btn-link btn-sm p-0 ms-1" href="/admin/ui?q_key=<%= encodeURIComponent(`carousel_slide${slide.index}_title`) %>">Bearbeiten</a>
                    </div>
                  </div>

                  <div class="col-lg-8">
                    <div class="mb-3">
                      <label class="form-label">Neues Bild hochladen</label>
                      <input
                        type="file"
                        class="form-control"
                        name="<%= slide.fileField %>"
                        accept="image/*"
                      >
                      <div class="form-text">Upload überschreibt Pfad/Reset für diesen Slot.</div>
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Oder Bildpfad / URL setzen</label>
                      <input
                        type="text"
                        class="form-control"
                        name="<%= slide.pathField %>"
                        value="<%= slide.currentPath %>"
                        placeholder="/uploads/home-hero/datei.webp oder https://..."
                      >
                      <div class="form-text">Erlaubt lokale Pfade (beginnend mit <code>/</code>) oder externe URLs.</div>
                    </div>

                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        value="1"
                        id="reset-<%= slide.index %>"
                        name="<%= slide.resetField %>"
                      >
                      <label class="form-check-label" for="reset-<%= slide.index %>">
                        Auf Standardbild zurücksetzen (<code><%= slide.fallback %></code>)
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="d-flex gap-2 mt-3 flex-wrap">
        <button class="btn btn-primary" type="submit">Slider-Bilder speichern</button>
        <a class="btn btn-outline-secondary" href="/admin/ui">Zurück zu UI-Texten</a>
      </div>
    </form>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const list = document.getElementById('homeEntityOrderList');
        const hiddenInput = document.getElementById('homeEntityOrderInput');
        const upBtn = document.getElementById('homeOrderUpBtn');
        const downBtn = document.getElementById('homeOrderDownBtn');

        const syncOrder = () => {
          if (!list || !hiddenInput) return;
          hiddenInput.value = Array.from(list.options).map((option) => option.value).join(',');
        };

        const moveSelected = (direction) => {
          if (!list) return;
          const currentIndex = list.selectedIndex;
          if (currentIndex < 0) return;
          const targetIndex = direction === 'up' ? currentIndex - 1 : currentIndex + 1;
          if (targetIndex < 0 || targetIndex >= list.options.length) return;

          const currentOption = list.options[currentIndex];
          const swapWith = list.options[targetIndex];

          if (direction === 'up') {
            list.insertBefore(currentOption, swapWith);
          } else {
            list.insertBefore(swapWith, currentOption);
          }

          list.selectedIndex = targetIndex;
          syncOrder();
        };

        upBtn?.addEventListener('click', () => moveSelected('up'));
        downBtn?.addEventListener('click', () => moveSelected('down'));

        if (list && list.options.length && list.selectedIndex < 0) {
          list.selectedIndex = 0;
        }
        syncOrder();
      });
    </script>
  </main>
</div>

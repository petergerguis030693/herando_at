<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active, role: role  }) %>
  </aside>

  <!-- Main Content -->
  <main class="flex-fill p-4">
    <div class="container-fluid">
      <div class="card shadow-sm rounded-2">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h2 class="mb-0">Kategorien</h2>
          <a href="/admin/entieties/new" class="btn btn-outline-light btn-sm">Neue Kategorie</a>
        </div>
        <div class="card-body">
          <% if (flash?.success?.length) { %>
            <div class="alert alert-success"><%= flash.success[0] %></div>
          <% } %>
          <% if (flash?.error?.length) { %>
            <div class="alert alert-danger"><%= flash.error[0] %></div>
          <% } %>

          <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Name</th>
                  <th scope="col">Route</th>
                  <th scope="col" class="text-end">Aktionen</th>
                </tr>
              </thead>
              <tbody>
                <% entieties.forEach(e => { %>
                  <tr>
                    <td><%= e.id %></td>
                    <td><%= e.name %></td>
                    <td><%= e.route %></td>
                    <td class="text-end">
                      <a href="/admin/entieties/<%= e.id %>/attributes" class="btn btn-sm btn-info me-1" title="Attribute verwalten">Attribute</a>
                      <a href="/admin/entieties/<%= e.route %>/options" class="btn btn-sm btn-info me-1" title="Optionen verwalten">Optionen</a>

                      <a href="/admin/entieties/<%= e.id %>/edit" class="btn btn-sm btn-secondary me-1">Bearbeiten</a>
                      <form action="/admin/entieties/<%= e.id %>/delete" method="post" class="d-inline">
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Wirklich löschen?')">
                          Löschen
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </div>
  </main>
</div>

<!-- views/admin/entieties/attributes/form.ejs -->
<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../../sidebar', { active: active, role: role  }) %>
  </aside>

  <!-- Main Content -->
  <main class="flex-fill p-4">
    <div class="container-fluid">
      <div class="card shadow-sm rounded-2">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h2 class="mb-0">Neues Attribut für "<%= ent.route %>"</h2>
          <a href="/admin/entieties/<%= ent.id %>/attributes" class="btn btn-outline-light btn-sm">Zurück zur Übersicht</a>
        </div>
        <div class="card-body">
          <% if (errors && errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% errors.forEach(err => { %>
                  <li><%= err.msg %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <form method="post" class="row g-3">
            <div class="col-md-4">
              <label for="column_name" class="form-label">Spaltenname</label>
              <input name="column_name" id="column_name" class="form-control" value="<%= attribute.column_name || '' %>" placeholder="z.B. 'accident_free'">
            </div>
            <div class="col-md-4">
              <label for="label" class="form-label">Label</label>
              <input name="label" id="label" class="form-control" value="<%= attribute.label || '' %>" placeholder="z.B. 'Unfallfrei'">
            </div>
            <div class="col-md-4">
              <label for="field_type" class="form-label">Typ</label>
              <select name="field_type" id="field_type" class="form-select">
                <option value="boolean">Boolean</option>
                <option value="select">Select</option>
                <option value="text">Text</option>
                <option value="number">Number</option>
                <option value="date">Date</option>
                <option value="relation">Relation</option>
              </select>
            </div>
            <div class="col-12">
              <label for="config_json" class="form-label">Konfiguration (JSON)</label>
              <textarea name="config_json" id="config_json" class="form-control" rows="3" placeholder='z.B. ["Ja","Nein"] oder {"table":"brands","key":"id","display":"name"}'><%= attribute.config_json || '' %></textarea>
            </div>
            <div class="col-12 d-flex justify-content-end">
              <button type="submit" class="btn btn-success me-2">Anlegen</button>
              <a href="/admin/entieties/<%= ent.id %>/attributes" class="btn btn-secondary">Abbrechen</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

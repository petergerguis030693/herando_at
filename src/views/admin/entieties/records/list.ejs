<!-- Diese Datei liegt unter views/admin/entieties/records/list.ejs -->
<div class="d-flex">
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../../sidebar', { active: active, role: role  }) %>
  </aside>
  <div class="flex-fill p-3">

    <h1>
      Optionen für <%= entityRoute.replace(/^.*\/options\//, '') %>
      in Entität <%= entityRoute.split('/')[0] %>
    </h1>

    <table class="table table-striped">
      <thead>
        <tr>
          <% columns.forEach(col => { %>
            <th><%= col.charAt(0).toUpperCase() + col.slice(1) %></th>
          <% }) %>
          <th>Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length) { %>
          <% rows.forEach(row => { %>
            <tr>
              <% columns.forEach(col => { %>
                <td><%= row[col] %></td>
              <% }) %>
              <td>
                <a href="/admin/entieties/<%= entityRoute %>/<%= row.id %>/edit"
                   class="btn btn-sm btn-primary">Bearbeiten</a>
                <form action="/admin/entieties/<%= entityRoute %>/<%= row.id %>/delete"
                      method="post"
                      style="display:inline">
                  <button type="submit"
                          class="btn btn-sm btn-danger"
                          onclick="return confirm('Wirklich löschen?')">
                    Löschen
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="<%= columns.length+1 %>" class="text-center text-muted">
              Noch keine Optionen angelegt.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <a href="/admin/entieties/<%= entityRoute %>/new"
       class="btn btn-success">
      Neue Option anlegen
    </a>

  </div>
</div>

<div class="d-flex">
  <!-- Sidebar -->
  <aside class="sidebar bg-light p-3" style="width: 250px;">
    <%- include('../sidebar', { active: active, role: role  }) %>
  </aside>

  <!-- Main Content -->
  <main class="flex-fill p-4">
    <div class="container-fluid">
      <div class="card shadow-sm rounded-2">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
          <h2 class="mb-0">
            <%= isNew ? 'Neue Kategorie' : 'Kategorie bearbeiten' %>
            <% if (!isNew) { %>
              <span class="badge bg-light text-dark ms-2">ID: <%= entitie.id %></span>
            <% } %>
          </h2>
          <a href="/admin/entieties" class="btn btn-outline-light btn-sm">Zurück zur Übersicht</a>
        </div>
        <div class="card-body">
          <% if (errors && errors.length) { %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% errors.forEach(err => { %>
                  <li><%= err.msg %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          <form action="<%= isNew ? '/admin/entieties/new' : '/admin/entieties/' + entitie.id + '/edit' %>"
                method="post" class="row g-3">
            
            <!-- Bestehende Felder -->
            <div class="col-md-6">
              <label for="name" class="form-label">Name</label>
              <input name="name" id="name" class="form-control"
                     value="<%= entitie.name || '' %>"
                     placeholder="z.B. 'Autos'">
            </div>
            <div class="col-md-6">
              <label for="route" class="form-label">Route</label>
              <input name="route" id="route" class="form-control"
                     value="<%= entitie.route || '' %>"
                     placeholder="z.B. 'cars'">
            </div>
            <div class="col-md-6">
              <label for="table_name" class="form-label">Tabellenname</label>
              <input name="table_name" id="table_name" class="form-control"
                     value="<%= entitie.table_name || '' %>"
                     placeholder="z.B. 'cars'">
              <div class="form-text">Soll auf den DB-Namen verweisen.</div>
            </div>

            <!-- Neues Feld: Beschreibung mit CKEditor 5 -->
            <div class="col-12">
              <label for="description" class="form-label">Beschreibung</label>
              <!-- Wir nutzen einen Hidden-Textarea plus einen Editor-Container -->
              <textarea id="description" name="description" class="d-none"><%= entitie.description || '' %></textarea>
              <div id="editor" style="min-height:200px;"></div>
            </div>

            <!-- Buttons -->
            <div class="col-12 d-flex justify-content-end">
              <button type="submit" class="btn btn-success me-2">
                <%= isNew ? 'Anlegen' : 'Speichern' %>
              </button>
              <a href="/admin/entieties" class="btn btn-secondary">Abbrechen</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- CKEditor 5 Classic via CDN -->
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
<script>
  // Editor initialisieren, Inhalt aus der textarea laden
  ClassicEditor
    .create(document.querySelector('#editor'))
    .then(editor => {
      // Set initial data
      editor.setData(document.querySelector('#description').value);

      // Vor dem Abschicken: HTML zurück in die textarea schreiben
      const form = editor.sourceElement.closest('form');
      form.addEventListener('submit', () => {
        document.querySelector('#description').value = editor.getData();
      });
    })
    .catch(error => {
      console.error('Fehler beim Initialisieren des Editors:', error);
    });
</script>

<script>
(function () {
  const form = document.getElementById('quickFilters');
  if (!form) return;

  const countrySelect = form.querySelector('#fCountryParent');
  const regionSelect = form.querySelector('#fRegion');
  const regionContainer = regionSelect ? regionSelect.closest('.fi') : null;
  const hiddenCountry = form.querySelector('#fCountry');
  const treeNode = form.querySelector('#countryTreeData');
  if (!countrySelect || !regionSelect || !hiddenCountry || !treeNode) return;

  let countryTree = [];
  try {
    countryTree = JSON.parse(treeNode.textContent || '[]');
  } catch (_) {
    countryTree = [];
  }

  const asId = (value) => {
    const parsed = Number.parseInt(String(value || ''), 10);
    return Number.isInteger(parsed) && parsed > 0 ? String(parsed) : '';
  };

  const byId = new Map();
  const byParentId = new Map();
  countryTree.forEach((entry) => {
    const id = asId(entry?.id);
    if (!id) return;
    const parentId = entry?.parentId == null ? '' : asId(entry.parentId);
    const label = String(entry?.label || id);
    const row = { id, parentId, label };
    byId.set(id, row);
    if (!parentId) return;
    if (!byParentId.has(parentId)) byParentId.set(parentId, []);
    byParentId.get(parentId).push(row);
  });

  const anyLabel = String(regionSelect.dataset.anyLabel || 'Beliebig');

  function hasCountryOption(id) {
    return Array.from(countrySelect.options).some((opt) => String(opt.value) === String(id));
  }

  function renderRegions(parentId, selectedRegionId) {
    const regions = (byParentId.get(parentId) || [])
      .slice()
      .sort((a, b) => a.label.localeCompare(b.label, 'de'));

    if (regionContainer) {
      regionContainer.style.display = regions.length ? '' : 'none';
    }

    regionSelect.innerHTML = '';
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = anyLabel;
    regionSelect.appendChild(placeholder);

    regions.forEach((region) => {
      const option = document.createElement('option');
      option.value = region.id;
      option.textContent = region.label;
      regionSelect.appendChild(option);
    });

    regionSelect.disabled = regions.length === 0;
    if (selectedRegionId && regions.some((region) => region.id === selectedRegionId)) {
      regionSelect.value = selectedRegionId;
    } else {
      regionSelect.value = '';
    }
  }

  function syncHiddenCountry() {
    const selectedRegion = asId(regionSelect.value);
    const selectedCountry = asId(countrySelect.value);
    hiddenCountry.value = selectedRegion || selectedCountry || '';
  }

  function initializeCountryRegionSelection() {
    const selectedCountry = asId(hiddenCountry.value);
    const selectedRow = selectedCountry ? byId.get(selectedCountry) : null;
    const parentId = selectedRow && selectedRow.parentId ? selectedRow.parentId : selectedCountry;

    if (parentId && hasCountryOption(parentId)) {
      countrySelect.value = parentId;
    } else {
      countrySelect.value = '';
    }

    const selectedRegionId = selectedRow && selectedRow.parentId ? selectedCountry : '';
    renderRegions(asId(countrySelect.value), selectedRegionId);
    syncHiddenCountry();
  }

  countrySelect.addEventListener('change', () => {
    renderRegions(asId(countrySelect.value), '');
    syncHiddenCountry();
  });

  regionSelect.addEventListener('change', syncHiddenCountry);
  initializeCountryRegionSelection();
})();
</script>




        const activeLangCode = String(
          (typeof activeLang !== 'undefined' && activeLang) ||
          (typeof lang !== 'undefined' && lang) ||
          (locals && locals.activeLang) ||
          'de'
        ).split('-')[0];
        const regionLabelFallbacks = {
          de: 'Bundesland / Region',
          en: 'State / Region',
          fr: 'Region',
          it: 'Regione',
          tr: 'Bölge',
          ja: '地域',
          cs: 'Region',
          ru: 'Регион',
          es: 'Region',
          nl: 'Regio',
          pl: 'Region'
        };
        const rawRegionLabel = t('filter.region', regionLabelFallbacks[activeLangCode] || 'Region');
        const regionLabel = (typeof rawRegionLabel === 'string')
          ? rawRegionLabel
          : (rawRegionLabel && typeof rawRegionLabel === 'object'
              ? (
                  rawRegionLabel[activeLangCode] ||
                  rawRegionLabel.de ||
                  rawRegionLabel.label ||
                  rawRegionLabel.name ||
                  regionLabelFallbacks[activeLangCode] ||
                  'Region'
                )
              : (regionLabelFallbacks[activeLangCode] || 'Region'));
        const parentCountries = countryRows;
        const countryTreeData = countryRows.map((c) => ({
          id: Number(c.id),
          parentId: null,
          label: t('country.' + c.id, c.name || c.de || c.en || c.code || String(c.id))
        }));

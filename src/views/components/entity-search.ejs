             { id: '255', name: t('category.watches.sonstiges', 'Sonstige Uhren') }
           ];
           const watchTypeOptions = (() => {
             const merged = [];
             const seen = new Set();
             const pushOption = (opt) => {
               const id = String(opt?.id ?? '').trim();
               if (!id || seen.has(id)) return;
               seen.add(id);
               merged.push({
                 id,
                 name: String(opt?.name || opt?.label || id)
               });
             };
             (filters.watchTypes || []).forEach(pushOption);
             watchTypeFallback.forEach(pushOption);
             return merged;
           })();

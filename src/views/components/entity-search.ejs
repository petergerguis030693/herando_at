<style>
.active-filters.product-container {
  margin-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.filter-tag {
padding: 10px !important;
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  background: #f4f4f4;           /* hellgrau wie Screenshot */
  border: 1px solid #1d2a44;      /* dunkelblauer Rahmen */
  border-radius: 5px;
  color: #1d2a44;                 /* dunkelblauer Text */
  text-decoration: none;
  font-weight: 500;
  transition: all .2s ease;
}

.filter-tag:hover {
  background: #1d2a44;
  color: #fff;
}

.filter-tag .x {
  margin-left: 8px;
  font-weight: bold;
  font-size: 16px;
  color: #1d2a44;
  transition: color .2s ease;
}

.filter-tag:hover .x {
  color: #fff;
}

/* Wrapper */
.fi-check {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  color: #1A253C;
}

/* Native Checkbox verstecken */
.fi-check input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border: 1px solid #cfcfcf;
  border-radius: 4px;
  background: #fff;
  display: inline-grid;
  place-content: center;
  cursor: pointer;
  transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
}

/* Hover */
.fi-check input[type="checkbox"]:hover {
  border-color: #c98d4a;
}

/* Checked */
.fi-check input[type="checkbox"]:checked {
  background-color: #c98d4a; /* GOLD */
  border-color: #c98d4a;
}

/* Haken */
.fi-check input[type="checkbox"]::after {
  content: "";
  width: 6px;
  height: 10px;
  border-right: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(45deg);
  display: none;
}

/* Haken anzeigen */
.fi-check input[type="checkbox"]:checked::after {
  display: block;
}

/* Focus (Keyboard) */
.fi-check input[type="checkbox"]:focus-visible {
  box-shadow: 0 0 0 2px #c98d4a;
}

/* FOCUS: Herando Gold */
.fi input:focus,
.fi select:focus,
.filter-input:focus,
.search-form input:focus,
.fi-range input:focus {
  border-color: #c98d4a;
  box-shadow:
    0 2px 6px rgba(26,37,60,.15);
}

select,
input,
textarea {
  border: 1px solid #ccc;
}



</style>


<section class="filter-bar shell" data-entity="<%= currentEntity.route %>">
  <form method="get" action="" class="filter-form" id="quickFilters">
    <div class="filter-grid" style="padding: 20px;">

      <!-- Marke / Modell – für cars, watches, yachts -->
      <% if (['cars','watches'].includes(currentEntity.route)) { %>
      <div class="fi">
        <label class="fi-label"><%= t('filter.brand') %></label>
        <div class="fi-select">
          <select name="brand" id="fBrand">
            <option value=""><%= t('common.any') %></option>
            <% (filters.brands||[]).forEach(b => { %>
              <option value="<%= b.id %>"
                <%= (selectedFilters.brand||[]).map(String).includes(String(b.id)) ? 'selected' : '' %>>
                <%= b.name %>
              </option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down"></i>
        </div>
      </div>

      <div class="fi">
        <label class="fi-label"><%= t('filter.model') %></label>
        <div class="fi-select">
          <select name="model" id="fModel" <%= !(filters.models && filters.models.length) ? 'disabled' : '' %>>
            <option value=""><%= t('common.any') %></option>
            <% (filters.models||[]).forEach(m => { %>
              <option value="<%= m.id %>"
                <%= (selectedFilters.model||[]).map(String).includes(String(m.id)) ? 'selected' : '' %>>
                <%= m.name %>
              </option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down"></i>
        </div>
      </div>
      <% } %>

      <!-- cars: Erstzulassung, Kilometer -->
      <% if (currentEntity.route === 'cars') { %>
      <div class="fi">
        <label class="fi-label"><%= t('filter.first_reg_from') %></label>
        <div class="fi-select">
          <select name="yearMin" id="fYearMin">
            <option value=""><%= t('common.any') %></option>
            <% (filters.registrationYears || []).forEach(y => { 
                const val = (y && typeof y === 'object' && 'year' in y) ? y.year : y; %>
              <option value="<%= val %>"
                <%= (selectedFilters.yearMin||[]).map(String).includes(String(val)) ? 'selected' : '' %>>
                <%= val %>
              </option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down"></i>
        </div>
      </div>

      <div class="fi">
        <label class="fi-label"><%= t('filter.km_upto') %></label>
        <div class="fi-select">
          <select name="mileageMax" id="fMileageMax">
            <option value=""><%= t('common.any') %></option>
            <% [5000,10000,20000,30000,50000,75000,100000,150000,200000,300000].forEach(km => { %>
              <option value="<%= km %>" <%= (selectedFilters.mileageMax||[]).map(String).includes(String(km)) ? 'selected' : '' %>><%= km.toLocaleString('de-DE') %></option>
            <% }) %>
          </select>
          <i class="bi bi-chevron-down"></i>
        </div>
      </div>
      <% } %>

      <!-- properties: Art, Fläche, Zimmer, Bäder -->

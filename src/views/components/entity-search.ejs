<style>
.active-filters.product-container {
  margin-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.filter-tag {
padding: 10px !important;
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  background: #f4f4f4;           /* hellgrau wie Screenshot */
  border: 1px solid #1d2a44;      /* dunkelblauer Rahmen */
  border-radius: 5px;
  color: #1d2a44;                 /* dunkelblauer Text */
  text-decoration: none;
  font-weight: 500;
  transition: all .2s ease;
}

.filter-tag:hover {
  background: #1d2a44;
  color: #fff;
}

.filter-tag .x {
  margin-left: 8px;
  font-weight: bold;
  font-size: 16px;
  color: #1d2a44;
  transition: color .2s ease;
}

.filter-tag:hover .x {
  color: #fff;
}

/* Wrapper */
.fi-check {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  color: #1A253C;
}

/* Native Checkbox verstecken */
.fi-check input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border: 1px solid #cfcfcf;
  border-radius: 4px;
  background: #fff;
  display: inline-grid;
  place-content: center;
  cursor: pointer;
  transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
}

/* Hover */
.fi-check input[type="checkbox"]:hover {
  border-color: #c98d4a;
}

/* Checked */
.fi-check input[type="checkbox"]:checked {
  background-color: #c98d4a; /* GOLD */
  border-color: #c98d4a;
}

/* Haken */
.fi-check input[type="checkbox"]::after {
  content: "";
  width: 6px;
  height: 10px;
  border-right: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(45deg);
  display: none;
}

/* Haken anzeigen */
.fi-check input[type="checkbox"]:checked::after {
  display: block;
}

/* Focus (Keyboard) */
.fi-check input[type="checkbox"]:focus-visible {
  box-shadow: 0 0 0 2px #c98d4a;
}

/* FOCUS: Herando Gold */
.fi input:focus,
.fi select:focus,
.filter-input:focus,
.search-form input:focus,
.fi-range input:focus {
  border-color: #c98d4a;
  box-shadow:
    0 2px 6px rgba(26,37,60,.15);
}

select,
input,
textarea {
  border: 1px solid #ccc;
}

/* Einheitliche Schriftfarbe (außer Modelle-Felder) */
.filter-tag,
.filter-tag .x,
.fi-check,
.filter-bar .fi-label,
.filter-bar .fi-input input:not([name="model"]),
.filter-bar .filter-input:not([name="model"]),
.filter-bar .fi-select select:not([name="model"]),
.filter-bar .fi-select select:not([name="model"]) option,
.filter-bar .dropdown-toggle,
.filter-bar .dropdown-toggle i,
.filter-bar .dropdown-item,
.filter-bar .dropdown-item i {
  color: #0f172a !important;
}

/* Aktionen (Reset/Anzeigen/Weitere Filter/Sortieren) immer rechts ausrichten */
.fi.fi-actions {
  grid-column: 1 / -1;
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}



</style>



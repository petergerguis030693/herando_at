           const watchTypeFallback = [
             { id: '1',   name: t('category.watches.wristwatch', 'Armbanduhr') },
             { id: '2',   name: t('category.watches.pocketwatch', 'Taschenuhr') },
             { id: '3',   name: t('category.watches.tableclock', 'Tischuhr') },
             { id: '4',   name: t('category.watches.antique', 'Antike Uhr') },

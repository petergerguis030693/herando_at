<!--Entdecken Sie Herando /api/catalog_ads/:entitieId-->
<section class="my-prod-section background topOffersWrapper-desktop" id="myUniqueProducts" style="padding-top: 30px; padding-bottom: 30px">
  <div class="container">
    <h3 class="section-title mb-3"><%= t('all_categories_title','Entdecken Sie Herando') %></h3>
    <div class="my-carousel">
      <div class="my-carousel-slides"></div>
      <div class="my-carousel-nav-dots"></div>
      <button class="my-carousel-prev">‹</button>
      <button class="my-carousel-next">›</button>
    </div>
  </div>
</section>


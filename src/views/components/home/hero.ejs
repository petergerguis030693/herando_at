<section>
  <div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="0" class="active"
        aria-current="true" aria-label="Slide 1"></button>
      <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="1" aria-label="Slide 2"></button>
      <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="2" aria-label="Slide 3"></button>
      <button type="button" data-bs-target="#carouselExample" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>

    <div class="carousel-inner">
      <div class="carousel-item active" data-bs-interval="10000">
        <img src="<%= t('home_hero_slide1_image', '/assets/herando-home-slider-luxusimmobilien.webp') %>" class="d-block w-100" alt="<%= t('alt_carousel_real_estate','Top-Immobilien') %>">
        <div class="carousel-caption">
          <h2><%- t('carousel_slide1_title','Top-Immobilien an den schönsten <br> Orten der Welt') %></h2>
        </div>
      </div>

      <div class="carousel-item" data-bs-interval="2000">
        <img src="<%= t('home_hero_slide2_image', '/assets/herando-home-slider-luxusautos.webp') %>" class="d-block w-100" alt="<%= t('alt_carousel_cars','Luxusautos') %>">
        <div class="carousel-caption">
          <h2><%- t('carousel_slide2_title','Tausende erlesene und exklusive <br> Autos und Oldtimer') %></h2>
        </div>
      </div>

      <div class="carousel-item">
        <img src="<%= t('home_hero_slide3_image', '/assets/herando-home-slider-luxusuhren.webp') %>" class="d-block w-100" alt="<%= t('alt_carousel_watches','Luxusuhren') %>">
        <div class="carousel-caption">
          <h2><%- t('carousel_slide3_title','Luxusuhren aus aller Welt<br>Finden Sie Ihr Wunschmodell') %></h2>
        </div>
      </div>

      <div class="carousel-item">
        <img src="<%= t('home_hero_slide4_image', '/assets/herando-home-slider-luxusyachten.webp') %>" class="d-block w-100" alt="<%= t('alt_carousel_yachts','Luxusyachten') %>">
        <div class="carousel-caption">
          <h2><%- t('carousel_slide4_title','Unser Angebot: stilvolle Yachten, <br>Katamarane & Boote') %></h2>
        </div>
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden"><%= t('previous_button','Previous') %></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden"><%= t('next_button','Next') %></span>
    </button>
  </div>
</section>

<!--Magazin-->
<section class="magazinSection">
  <h2 class="sectionTitle" style="text-align: center;">
    <%= t('magazin_title','The Journal') %>
  </h2>

  <div class="magazinLayout">
    <!-- Hauptartikel links -->
    <% if (magazinPosts && magazinPosts.length) { %>
      <div class="magazinMain">
        <a href="/magazin/<%= magazinPosts[0].slug %>">
          <% const m0 = magazinPosts[0].coverImg || { src: magazinPosts[0].image, srcset: null, sizes: '100vw', width: 1200, height: 675 }; %>
          <img src="<%= m0.src %>"
            <% if (m0.srcset) { %>srcset="<%= m0.srcset %>" sizes="<%= m0.sizes %>"<% } %>
            alt="<%= magazinPosts[0].title %>"
            width="<%= m0.width %>"
            height="<%= m0.height %>"
            loading="lazy"
            decoding="async">
          <div class="magazinOverlay">
            <p class="magazinDate"><%= magazinPosts[0].dateFormatted %></p>
            <h2 class="magazinMainTitle"><%= magazinPosts[0].title %></h2>
            <p class="magazinExcerpt"><%= magazinPosts[0].excerpt %></p>
          </div>
        </a>
      </div>
    <% } %>

    <!-- Weitere Artikel rechts -->
    <div class="magazinSide">
      <% magazinPosts.slice(1,5).forEach(post => { %>
        <a href="/magazin/<%= post.slug %>" class="magazinSideItem">
          <% const ms = post.coverImg || { src: post.image, srcset: null, sizes: '(max-width: 1024px) 45vw, 120px', width: 120, height: 80 }; %>
          <img src="<%= ms.src %>"
            <% if (ms.srcset) { %>srcset="<%= ms.srcset %>" sizes="<%= ms.sizes %>"<% } %>
            alt="<%= post.title %>"
            width="<%= ms.width %>"
            height="<%= ms.height %>"
            loading="lazy"
            decoding="async">
          <div>
            <p class="magazinDate"><%= post.dateFormatted %></p>
            <h4><%= post.title %></h4>
            <p class="magazinExcerpt"><%= post.excerpt %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  /* Nur Hauptartikel links: Overlay-Text fix unten positionieren */
  .magazinMain > a {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
  }

  .magazinMain > a::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.22) 58%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .magazinMain .magazinOverlay {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 12px;
    bottom: 12px;
    padding: 0 2px;
    z-index: 2;
    transform: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .magazinMain .magazinDate,
  .magazinMain .magazinMainTitle,
  .magazinMain .magazinExcerpt {
    color: #fff;
    margin: 0 0 2px;
  }

  .magazinMain .magazinExcerpt {
    display: -webkit-box;
    line-clamp: 3;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0;
    text-align: justify;
    text-justify: inter-word;
    line-height: 1.35;
    hyphens: auto;
  }
}
</style>

<%# Logik liegt in public/js/home-page.js; nach Änderungen: npm run build:min %>
<script type="application/json" id="herando-home-bootstrap">
<%- JSON.stringify({
  entityRouteMap: Object.fromEntries(
    (entieties || []).map((e) => [
      e.route,
      (typeof localizedEntityRoute === 'function'
        ? localizedEntityRoute(e.route, (typeof currentLang !== 'undefined' ? currentLang : lang))
        : e.route)
    ])
  ),
  homeEntityOrder: Array.isArray(homeEntityOrder) ? homeEntityOrder : [],
  ui: ui || {},
  categories: (entieties || []).map(e => ({ id: e.id, route: e.route })),
  entieties: entieties || [],
  strings: {
    labelPopular: t('label_popular','BELIEBT'),
    errLoadingOffers: t('error_loading_offers','Fehler beim Laden der Angebote.'),
    errLoadingCarousel: t('error_loading_carousel', 'Fehler beim Laden der Angebote.')
  },
  lang: (typeof lang !== 'undefined' && lang) ? lang : 'de',
  currency: (typeof currency !== 'undefined' && currency) ? String(currency).toUpperCase() : 'EUR'
}) %>
</script>
<script src="/js/home-page.min.js?v=20260427a" defer></script>

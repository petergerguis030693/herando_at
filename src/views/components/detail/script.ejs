    <script>
  function magnify(imgID, zoom) {
    const img = document.getElementById(imgID);
    if (!img || !img.parentElement) return;

    const glass = img.parentElement.querySelector('.img-magnifier-glass');
    if (!glass) return;

    // Hintergrund neu setzen (wird auch nach src-Change korrekt)
    function setGlassBG() {
      glass.style.backgroundImage = `url('${img.src}')`;
      glass.style.backgroundSize  = (img.width * zoom) + 'px ' + (img.height * zoom) + 'px';
    }

    function moveGlass(e) {
      const rect = img.getBoundingClientRect();
      let x = e.clientX - rect.left;
      let y = e.clientY - rect.top;

      const w = glass.offsetWidth  / 2;
      const h = glass.offsetHeight / 2;

      x = Math.max(w, Math.min(x, img.width - w));
      y = Math.max(h, Math.min(y, img.height - h));

      glass.style.left = (x - w) + 'px';
      glass.style.top  = (y - h) + 'px';

      // Hintergrundposition
      const bgX = -((x * zoom) - w);
      const bgY = -((y * zoom) - h);
      glass.style.backgroundPosition = `${bgX}px ${bgY}px`;
    }

    // Eventlistener
    img.addEventListener('mouseenter', e => {
      setGlassBG();
      glass.style.display = 'block';
    });
    img.addEventListener('mousemove', moveGlass);
    img.addEventListener('mouseleave', () => {
      glass.style.display = 'none';
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    magnify('mainImage', 1.3); // Zoom-Faktor nach Belieben anpassen
  });

  // Beispiel changeImage-Funktion, um Hauptbild zu tauschen
  function changeImage(thumb) {
    const main = document.getElementById('mainImage');
    if (!main || !thumb) return;
    main.src = thumb.src;
    // Hintergrund der Lupe frisch setzen
    const event = new Event('mouseenter');
    main.dispatchEvent(event);
  }
</script>

<script>
(function(){
  // 1) Bild-URLs sammeln
  const pics = Array.from(
    document.querySelectorAll('.product-single-thumbnails img')
  ).map(img => img.src);

  // Fallback: Hauptbild, falls keine Thumbnails
  const mainImg = document.getElementById('mainImage');
  if (!pics.length && mainImg) {
    pics.push(mainImg.src);
  }

  let currentIndex = 0;
  const overlay  = document.getElementById('lightboxOverlay');
  const imgEl    = document.getElementById('lightboxImage');
  const btnPrev  = document.getElementById('lightboxPrev');
  const btnNext  = document.getElementById('lightboxNext');
  const btnClose = document.getElementById('lightboxClose');
  if (!overlay || !imgEl || !btnPrev || !btnNext || !btnClose || !pics.length) return;

  function showLightbox(idx) {
    currentIndex = idx;
    imgEl.src = pics[currentIndex];
    overlay.style.display = 'flex';
  }
  function hideLightbox()    { overlay.style.display = 'none'; }
  function showPrev()        { showLightbox((currentIndex - 1 + pics.length) % pics.length); }
  function showNext()        { showLightbox((currentIndex + 1) % pics.length); }

  // 2) Klick auf Hauptbild: öffne an der aktuell angezeigten Stelle
  if (mainImg) {
    mainImg.style.cursor = 'zoom-in';
    mainImg.addEventListener('click', () => {
      const idx = pics.findIndex(src => src === mainImg.src);
      showLightbox(idx >= 0 ? idx : 0);
    });
  }

  // 3) Overlay-Klick schließt, Pfeile und X wie gehabt
  overlay.addEventListener('click', e => e.target === overlay && hideLightbox());
  btnPrev.addEventListener('click', e => { e.stopPropagation(); showPrev(); });
  btnNext.addEventListener('click', e => { e.stopPropagation(); showNext(); });
  btnClose.addEventListener('click', hideLightbox);

  // 4) Tastatur-Navigation
  document.addEventListener('keydown', e => {
    if (overlay.style.display === 'flex') {
      if (e.key === 'Escape') hideLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    }
  });
})();
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const mainImg   = document.getElementById("mainImage");
  const thumbsCtn = document.querySelector(".product-single-thumbnails");
  const thumbs    = Array.from(thumbsCtn.querySelectorAll("img"));
  const prevBtn   = document.getElementById("prevThumb");
  const nextBtn   = document.getElementById("nextThumb");
  let currentIdx  = 0;

  // 1) Scrollbar per JS ausblenden
  thumbsCtn.style.overflowX = "auto";
  thumbsCtn.style.overflowY = "hidden";
  thumbsCtn.style.scrollbarWidth = "none";        // Firefox
  thumbsCtn.style.msOverflowStyle = "none";        // IE 10+
  // Webkit:
  const style = document.createElement("style");
  style.textContent = `
    .product-single-thumbnails::-webkit-scrollbar { display: none; }
  `;
  document.head.appendChild(style);

  // 2) Highlight-Funktion
  function highlightActive() {
    thumbs.forEach((thumb, i) => {
      if (i === currentIdx) {
        thumb.style.borderRadius = "4px";
        thumb.style.opacity      = "0.8";
        thumb.style.transform    = "scale(1.05)";
        thumb.style.transition   = "transform .2s, opacity .2s";
      } else {
        thumb.style.border       =
        thumb.style.borderRadius =
        thumb.style.opacity      =
        thumb.style.transform    =
        thumb.style.transition   = "";
      }
    });
  }

  // 3) Pfeil-Buttons aktiv/deaktiv
  function updateButtons() {
    prevBtn.disabled = currentIdx === 0;
    nextBtn.disabled = currentIdx === thumbs.length - 1;
  }

  // 4) Thumbnail-Anzeige + zentrieren
  function showThumbnail(i) {
    if (i < 0 || i >= thumbs.length) return;
    currentIdx = i;
    // Hauptbild tauschen
    changeImage(thumbs[i]);   
    const thumb = thumbs[i];
    const offset = thumb.offsetLeft - (thumbsCtn.clientWidth - thumb.clientWidth) / 2;
    thumbsCtn.scrollTo({ left: offset, behavior: "smooth" });
    highlightActive();
    updateButtons();
  }

  // 5) Event-Listener
  thumbs.forEach((thumb, i) => {
    thumb.style.cursor = "pointer";
    thumb.addEventListener("click", () => showThumbnail(i));
  });
  prevBtn.addEventListener("click", () => showThumbnail(currentIdx - 1));
  nextBtn.addEventListener("click", () => showThumbnail(currentIdx + 1));

  // 6) Initialisierung
  // Finde den Index des Main-Bildes
let startIndex = thumbs.findIndex(t => t.src === mainImg.src);
if (startIndex < 0) startIndex = 0;

// Starte mit dem richtigen Bild
showThumbnail(startIndex);
});
</script>


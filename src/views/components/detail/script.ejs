      9: '<%= t("attribute.properties.investmenttype.9", "Grundstück") %>',
      255: '<%= t("common.other", "Sonstige") %>'
    };

    const mapEnumValue = (raw, map) => {
      if (!isRenderableValue(raw)) return '';
      const keyNum = Number(raw);
      if (Number.isFinite(keyNum) && Object.prototype.hasOwnProperty.call(map, keyNum)) {
        return map[keyNum];
      }
      const keyStr = String(raw).trim();
      if (Object.prototype.hasOwnProperty.call(map, keyStr)) {
        return map[keyStr];
      }
      return '';
    };

    // Flagge
    const iso2 = (name='') => {
      const n = norm(name);
      const map = {
        'österreich':'at','austria':'at',
        'deutschland':'de','germany':'de',
        'schweiz':'ch','switzerland':'ch',
        'italien':'it','italy':'it',
        'frankreich':'fr','france':'fr',
        'spanien':'es','spain':'es',
        'portugal':'pt','niederlande':'nl','netherlands':'nl',
        'belgien':'be','luxemburg':'lu',

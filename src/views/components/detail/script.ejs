        </div>` : '',
      iconCol('compass',        LY.type   || 'Typ',       IDX.type),
      iconCol('rulers',         LY.length || 'Länge',     IDX.length),
      iconCol('arrows-expand',  LY.beam   || 'Breite',    IDX.beam),
      iconCol('water',          LY.draft  || 'Tiefgang',  IDX.draft),
      iconCol('gear-wide',      LY.engines|| 'Motor',     IDX.engines),
      iconCol('speedometer',    LY.power  || 'Leistung',  IDX.power),
      iconCol('fuel-pump',      LY.fuel   || 'Kraftstoff',IDX.fuel),
      iconCol('door-closed',    LY.cabins || 'Kabinen',   IDX.cabins),
      iconCol('person',         LY.berths || 'Kojen',     IDX.berths),
      iconCol('calendar3',      LY.year   || 'Baujahr',   IDX.year),
      country ? `
        <div class="col">
          <div class="d-flex align-items-start gap-3">
            ${flag}
            <div>
              <div class="small text-muted">${LY.country || 'Land'}</div>
              <div class="fw-semibold">${country}</div>
            </div>
          </div>
        </div>` : '',
      iconCol('cash-coin',      LY.price  || 'Preis',     price)
    ];
    return renderGrid(cols);
  }
});
</script>


<script>
  document.addEventListener("DOMContentLoaded", function() {
    const toggleBtn = document.getElementById("toggleDescription");
    const descShort = document.getElementById("descriptionShort");
    const fadeOverlay = document.getElementById("fadeOverlay");
    const descriptionContainer = descShort ? descShort.closest(".description-container") : null;
    const descriptionSection = descriptionContainer ? (descriptionContainer.closest(".p-3") || descriptionContainer) : null;

    if (!toggleBtn || !descShort || !fadeOverlay || !descriptionSection) return;

    let expanded = !descShort.classList.contains("collapsed-text");

    // 🔸 Texte aus Übersetzungen holen
    const showMoreText = "<%= t('offers.details.show_more', { fallback: 'Mehr anzeigen' }) %>";
    const showLessText = "<%= t('offers.details.show_less', { fallback: 'Weniger anzeigen' }) %>";

    const getScrollOffset = () => {
      const fixedHeader = document.querySelector("header.fixed-top, .navbar.fixed-top, .fixed-top, .sticky-top");
      return fixedHeader ? fixedHeader.getBoundingClientRect().height + 16 : 16;
    };

    const getDescriptionTop = () => {
      const targetTop = descriptionSection.getBoundingClientRect().top + window.scrollY - getScrollOffset();
      return Math.max(targetTop, 0);
    };

    const jumpToDescriptionAnchor = () => {
      window.scrollTo(0, getDescriptionTop());
    };

    const setExpandedState = () => {
      descShort.classList.remove("collapsed-text");
      fadeOverlay.style.display = "none";
      toggleBtn.textContent = showLessText;
      expanded = true;
    };

    const setCollapsedState = () => {
      descShort.classList.add("collapsed-text");
      fadeOverlay.style.display = "block";
      toggleBtn.textContent = showMoreText;
      expanded = false;
    };

    // Stabiler Anker für "Beschreibung", damit immer dorthin gescrollt wird.
    if (!descriptionSection.id) {
      descriptionSection.id = "description-anchor";
    }

    toggleBtn.addEventListener("click", function() {
      if (!expanded) {
        setExpandedState();
      } else {
        jumpToDescriptionAnchor();
        setCollapsedState();
      }
    });
  });
</script>

<script>
/**
 * Berechnet die vertikale Mitte der Produktbilder in den Carousels 
 * und positioniert die Navigationspfeile dort.
 */
function centerCarouselArrowsDynamically() {
    
    // Zielt auf alle Carousels (similar, moreItems) ab
    document.querySelectorAll('[id^="carousel-"]').forEach(carousel => {
        
        // Sucht die erste Karte im Carousel, um die Bildhöhe zu messen
        const firstCardImageWrapper = carousel.querySelector('.card .position-relative');
        const prevBtn = carousel.querySelector('.my-carousel-prev');
        const nextBtn = carousel.querySelector('.my-carousel-next');

        if (!firstCardImageWrapper || !prevBtn || !nextBtn) return;

        // 1. Höhe des Bild-Wrappers messen (das ist der Bereich, den wir zentrieren wollen)
        const imageHeight = firstCardImageWrapper.offsetHeight;
        
        // 2. Vertikale Mitte berechnen (Hälfte der Bildhöhe)
        // Wir verwenden diesen Wert für 'top', da der Pfeil selbst 
        // bereits mit transform: translateY(-50%) auf seine eigene Höhe korrigiert wird.
        const verticalCenterPx = imageHeight / 2;

        // 3. Position anwenden
        if (verticalCenterPx > 30) { // Nur anwenden, wenn das Bild gerendert ist (Höhe > 0)
            prevBtn.style.top = `${verticalCenterPx}px`;
            nextBtn.style.top = `${verticalCenterPx}px`;
            
            // Stellen Sie sicher, dass die absolute Positionierung korrekt ist
            prevBtn.style.position = 'absolute';
            nextBtn.style.position = 'absolute';
            prevBtn.style.transform = 'translateY(-50%)'; // Erneut anwenden
            nextBtn.style.transform = 'translateY(-50%)'; // Erneut anwenden
        }
    });
}

// 4. Events für Laden, Resize und nach dem Laden von Bildern auslösen
document.addEventListener("DOMContentLoaded", centerCarouselArrowsDynamically);
window.addEventListener("resize", centerCarouselArrowsDynamically);
// Fügen Sie window.addEventListener("load", ...) hinzu, um sicherzustellen, dass alle Bilder geladen sind
window.addEventListener("load", centerCarouselArrowsDynamically); 
</script>

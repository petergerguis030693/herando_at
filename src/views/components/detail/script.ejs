<script>
const sellerContactForm = document.getElementById("sellerContactForm");
if (sellerContactForm) sellerContactForm.addEventListener("submit", async function (e) {
    e.preventDefault();

    // Daten sammeln
    const payload = {
        firstName: document.getElementById("modalFirstName").value,
        lastName:  document.getElementById("modalLastName").value,
        email:     document.getElementById("modalEmail").value,
        phone: document.getElementById("modalPhoneCode").value + " " + document.getElementById("modalPhone").value,
        message:   document.getElementById("modalMessage").value,
        hp_field:  document.getElementById("hp_field").value, // Honeypot
        listingUrl: document.getElementById("listingUrl").value,
    };

    try {
        // Anfrage senden
        const res = await fetch("/send-contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        const result = await res.json();

        if (result.success) {
            // Modal schließen
            const modalEl = document.getElementById("contactModal");
            const bsModal = bootstrap.Modal.getInstance(modalEl);
            bsModal.hide();

            alert('<%= t("common.message_sent", "Ihre Nachricht wurde gesendet!") %>');
            e.target.reset();
        } else {
          alert(result.error || '<%= t("common.error_send", "Fehler beim Senden.") %>');
        }

    } catch (err) {
        console.error("Kontaktformular Fehler:", err);
        alert('<%= t("common.error_generic", "Es ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.") %>');
    }
});
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const shareBtn = document.getElementById("shareBtn");
  const shareModal = new bootstrap.Modal(document.getElementById("shareModal"));
  const copyBtn = document.getElementById("copyLinkBtn");

  const url = window.location.href;
  const text = document.title;

  // Button → Modal öffnen
  shareBtn.addEventListener("click", () => {
    shareModal.show();
  });
 
  // Copy-Link
  copyBtn.addEventListener("click", async (e) => {
    e.preventDefault();
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.innerHTML = '<i class="bi bi-check2"></i>';
      setTimeout(() => {
        copyBtn.innerHTML = '<i class="bi bi-link-45deg"></i>';
      }, 2000);
    } catch {
      alert('<%= t("common.copy_fallback", "Bitte den Link manuell kopieren:") %> ' + url);
    }
  });

  // Social Media Links dynamisch setzen
  document.getElementById("shareFacebook").href = 
    `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
  document.getElementById("shareTwitter").href = 
    `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`;
  document.getElementById("sharePinterest").href = 
    `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(text)}`;
  document.getElementById("shareWhatsApp").href = 
    `https://api.whatsapp.com/send?text=${encodeURIComponent(text + " " + url)}`;
});
</script>



<script>
  document.addEventListener("DOMContentLoaded", () => {
    const BOOKMARK_KEY = 'herandoBookmarks';
    const btn          = document.getElementById('bookmarkBtn');
    const itemId       = '<%= item.id %>';  // bleibt so
    // FALLBACK: Entity-Route entweder aus EJS, oder aus der URL ziehen
    let entityRoute = '<%= (currentEntity && currentEntity.route) || item.entityRoute || "" %>';
    if (!entityRoute) {
      // window.location.pathname → "/cars/123/...". Zerlegen:
      const segments = window.location.pathname.split('/').filter(Boolean);
      // segments[0] == "cars"
      entityRoute = segments[0] || '';
    }

    // Hilfsfunktionen
    const getBookmarks = () => {
      try {
        return JSON.parse(localStorage.getItem(BOOKMARK_KEY)) || [];
      } catch {
        return [];
      }
    };
    const saveBookmarks = arr => {
      localStorage.setItem(BOOKMARK_KEY, JSON.stringify(arr));
    };
    const isBookmarked = (route, id) =>
      getBookmarks().some(b => b.route === route && b.id === id);

    // Button initialisieren
    const i18n = (window.I18N && window.I18N.common) || {};
    const savedTxt  = i18n.saved   || 'Gespeichert ✓';
    const markTxt   = i18n.bookmark|| 'Merken';

    const updateButton = () => {
      if (isBookmarked(entityRoute, itemId)) {
        btn.textContent = savedTxt;
        btn.classList.add('active');
      } else {
        btn.textContent = markTxt;
        btn.classList.remove('active');
      }
    };

    btn.addEventListener('click', () => {
      let list = getBookmarks();
      if (isBookmarked(entityRoute, itemId)) {
        list = list.filter(b => !(b.route === entityRoute && b.id === itemId));
      } else {
        list.push({ route: entityRoute, id: itemId });
      }
      saveBookmarks(list);
      updateButton();
      console.log('Bookmarks now:', list);
    });

    updateButton();
  });
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".custom-carousel").forEach(carousel => {
    const inner = carousel.querySelector(".carousel-inner");
    if (!inner) return;

    // Mobile: jedes Item einzeln
    if (window.innerWidth < 768) {
      const cards = inner.querySelectorAll(".col-md-3");
      const slides = [];

      cards.forEach((card, idx) => {
        const item = document.createElement("div");
        item.classList.add("carousel-item");
        if (idx === 0) item.classList.add("active");

        const row = document.createElement("div");
        row.classList.add("row", "g-3");

        card.classList.remove("col-md-3");
        card.classList.add("col-12");

        row.appendChild(card);
        item.appendChild(row);
        slides.push(item);
      });

      inner.innerHTML = "";
      slides.forEach(slide => inner.appendChild(slide));

      // Indikatoren auf Mobile entfernen
      const indicators = carousel.querySelector(".carousel-indicators");
      if (indicators) indicators.remove();
    }

    // Initialisieren
    new bootstrap.Carousel(carousel, {
      interval: false,
      wrap: true,
      touch: true
    });
  });
});
</script>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const canonicalRoute = '<%= String((currentEntity && currentEntity.route) || "").toLowerCase() %>';
    if (canonicalRoute === 'watches') {
      const detailCol = document.querySelector('.product-single-container .row > .col-md-5');
      if (detailCol) detailCol.style.marginTop = '30px';
    }

    const form = document.getElementById('sellerContactForm');
    if (!form || form.dataset.herandoContactBound === '1') return;
    form.dataset.herandoContactBound = '1';

    const MSG_PHONE = <%- JSON.stringify(t('product.contact.phone_need_country', 'Bitte wählen Sie für Ihre Telefonnummer ein Land (Vorwahl) aus.')) %>;
    const MSG_OK = <%- JSON.stringify(t('common.message_sent', 'Danke! Ihre Anfrage wurde gesendet.')) %>;
    const MSG_ERR = <%- JSON.stringify(t('common.error_send', 'Fehler beim Senden. Bitte später erneut versuchen.')) %>;
    const MSG_GENERIC = <%- JSON.stringify(t('common.error_generic', 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut.')) %>;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (form.dataset.herandoContactSubmitting === '1') return;
      form.dataset.herandoContactSubmitting = '1';

      const codeEl = document.getElementById('modalPhoneCode');
      const numEl = document.getElementById('modalPhone');
      const code = (codeEl && codeEl.value || '').trim();
      const num = (numEl && numEl.value || '').replace(/\s+/g, ' ').trim();
      if (num !== '' && code === '') {
        alert(MSG_PHONE);
        codeEl && codeEl.focus();
        form.dataset.herandoContactSubmitting = '0';
        return;
      }

      const phoneHidden = document.getElementById('modalPhoneFull');
      const fullPhone = (phoneHidden && phoneHidden.value && phoneHidden.value.trim())
        ? phoneHidden.value.trim()
        : ((code && num) ? (code + ' ' + num).trim() : (code || num));

      const firstEl = document.getElementById('modalFirstName');
      const lastEl = document.getElementById('modalLastName');
      const emailEl = document.getElementById('modalEmail');
      const msgEl = document.getElementById('modalMessage');
      const hpEl = document.getElementById('hp_field');
      const urlEl = document.getElementById('listingUrl');

      const params = new URLSearchParams();
      params.set('firstName', firstEl ? firstEl.value : '');
      params.set('lastName', lastEl ? lastEl.value : '');
      params.set('email', emailEl ? emailEl.value : '');
      params.set('phone', fullPhone);
      params.set('message', msgEl ? msgEl.value : '');
      params.set('hp_field', hpEl ? hpEl.value : '');
      params.set('listingUrl', urlEl ? urlEl.value : '');

      const action = (form.getAttribute('action') || '/send-contact').trim() || '/send-contact';

      try {
        const res = await fetch(action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString()
        });
        const data = await res.json().catch(function () { return {}; });
        if (res.ok && data.success) {
          alert(MSG_OK);
          form.reset();
          const modalEl = document.getElementById('contactModal');
          if (modalEl && window.bootstrap) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.hide();
          }
        } else {
          alert(data.error || MSG_ERR);
        }
      } catch (err) {
        console.error('Kontaktformular Fehler:', err);
        alert(MSG_GENERIC);
      } finally {
        form.dataset.herandoContactSubmitting = '0';
      }
    });
  });
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const shareBtn = document.getElementById("shareBtn");
  const shareModal = new bootstrap.Modal(document.getElementById("shareModal"));
  const copyBtn = document.getElementById("copyLinkBtn");

  const url = window.location.href;
  const text = document.title;

  // Button → Modal öffnen
  shareBtn.addEventListener("click", () => {
    shareModal.show();
  });
 
  // Copy-Link
  copyBtn.addEventListener("click", async (e) => {
    e.preventDefault();
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.innerHTML = '<i class="bi bi-check2"></i>';
      setTimeout(() => {
        copyBtn.innerHTML = '<i class="bi bi-link-45deg"></i>';
      }, 2000);
    } catch {
      alert('<%= t("common.copy_fallback", "Bitte den Link manuell kopieren:") %> ' + url);
    }
  });

  // Social Media Links dynamisch setzen
  document.getElementById("shareFacebook").href = 
    `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
  document.getElementById("shareTwitter").href = 
    `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`;
  document.getElementById("sharePinterest").href = 
    `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(text)}`;
  document.getElementById("shareWhatsApp").href = 
    `https://api.whatsapp.com/send?text=${encodeURIComponent(text + " " + url)}`;
});
</script>



<script>
  document.addEventListener("DOMContentLoaded", () => {
    const BOOKMARK_KEY = 'herandoBookmarks';
    const btn          = document.getElementById('bookmarkBtn');
    const itemId       = '<%= item.id %>';  // bleibt so
    // FALLBACK: Entity-Route entweder aus EJS, oder aus der URL ziehen
    let entityRoute = '<%= (currentEntity && currentEntity.route) || item.entityRoute || "" %>';
    if (!entityRoute) {
      // window.location.pathname → "/cars/123/...". Zerlegen:
      const segments = window.location.pathname.split('/').filter(Boolean);
      // segments[0] == "cars"
      entityRoute = segments[0] || '';
    }

    // Hilfsfunktionen
    const getBookmarks = () => {
      try {
        return JSON.parse(localStorage.getItem(BOOKMARK_KEY)) || [];
      } catch {
        return [];
      }
    };
    const saveBookmarks = arr => {
      localStorage.setItem(BOOKMARK_KEY, JSON.stringify(arr));
    };
    const isBookmarked = (route, id) =>
      getBookmarks().some(b => b.route === route && b.id === id);

    // Button initialisieren
    const i18n = (window.I18N && window.I18N.common) || {};
    const savedTxt  = i18n.saved   || 'Gespeichert ✓';
    const markTxt   = i18n.bookmark|| 'Merken';

    const updateButton = () => {
      if (isBookmarked(entityRoute, itemId)) {
        btn.textContent = savedTxt;
        btn.classList.add('active');
      } else {
        btn.textContent = markTxt;
        btn.classList.remove('active');
      }
    };

    btn.addEventListener('click', () => {
      let list = getBookmarks();
      if (isBookmarked(entityRoute, itemId)) {
        list = list.filter(b => !(b.route === entityRoute && b.id === itemId));
      } else {
        list.push({ route: entityRoute, id: itemId });
      }
      saveBookmarks(list);
      updateButton();
      console.log('Bookmarks now:', list);
    });

    updateButton();
  });
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".custom-carousel").forEach(carousel => {
    const inner = carousel.querySelector(".carousel-inner");
    if (!inner) return;

    // Mobile: jedes Item einzeln
    if (window.innerWidth < 768) {
      const cards = inner.querySelectorAll(".col-md-3");
      const slides = [];

      cards.forEach((card, idx) => {
        const item = document.createElement("div");
        item.classList.add("carousel-item");
        if (idx === 0) item.classList.add("active");

        const row = document.createElement("div");
        row.classList.add("row", "g-3");

        card.classList.remove("col-md-3");
        card.classList.add("col-12");

        row.appendChild(card);
        item.appendChild(row);
        slides.push(item);
      });

      inner.innerHTML = "";
      slides.forEach(slide => inner.appendChild(slide));

      // Indikatoren auf Mobile entfernen
      const indicators = carousel.querySelector(".carousel-indicators");
      if (indicators) indicators.remove();
    }

    // Initialisieren
    new bootstrap.Carousel(carousel, {
      interval: false,
      wrap: true,
      touch: true
    });
  });
});
</script>


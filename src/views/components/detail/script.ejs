<script>
document.addEventListener("DOMContentLoaded", () => {
  const data = <%- JSON.stringify({
    id: item.id,
    title: item.title,
    price: item.price ?? null,
    imageUrl: item.imageUrl,
    route: currentEntity.route
  }) %>;

  const slug = String(data.title).toLowerCase().replace(/\s+/g,"-").replace(/[^\w-]/g,"");
  const viewedItem = {
    id: data.id,
    title: data.title,
    price: data.price,
    imageUrl: data.imageUrl,
    route: data.route,
    url: `/${data.route}/${slug}-${data.id}`
  };

  let list = [];
  try { list = JSON.parse(localStorage.getItem("recentlyViewed")) || []; } catch {}
  list = list.filter(x => String(x.id) !== String(viewedItem.id) || x.route !== viewedItem.route);
  list.unshift(viewedItem);
  if (list.length > 10) list = list.slice(0, 10);
  localStorage.setItem("recentlyViewed", JSON.stringify(list));
});
</script>




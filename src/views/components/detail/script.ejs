      price:   'preis'
    };
    const IDX = makeSpecIndex(ITEM.specs, dict, deFB);

    const iso2 = (name='') => {
      const n = norm(name);
      const map = {
        'österreich':'at','austria':'at','deutschland':'de','germany':'de','schweiz':'ch','switzerland':'ch',
        'italien':'it','italy':'it','frankreich':'fr','france':'fr','spanien':'es','spain':'es','portugal':'pt',
        'niederlande':'nl','netherlands':'nl','vereinigtes königreich':'gb','großbritannien':'gb','united kingdom':'gb','uk':'gb',
        'irland':'ie','usa':'us','vereinigte staaten':'us','united states':'us','vereinigte arabische emirate':'ae','uae':'ae',
        'kroatien':'hr','griechenland':'gr','monaco':'mc','polen':'pl','tschechien':'cz','ungarn':'hu','türkei':'tr'

    const brand = IDX.brand || IDX.manufacturer || ''; // falls als Spec vorhanden
    const country = IDX.country || '';
    const flag = country && iso2(country)
      ? `<img src="https://flagcdn.com/h20/${iso2(country)}.png" alt="${country}" width="24" height="16" class="me-2" />`
      : '';
    const price = ITEM.priceFormatted || IDX.price || '';

    const cols = [
      brand ? `
        <div class="col">
          <div class="d-flex align-items-start gap-3">
            <i class="bi bi-circle-half icon-xl text-muted"></i>
            <div>
              <div class="small text-muted">${LW.brand || 'Marke'}</div>
              <div class="fw-semibold">${brand}</div>
            </div>

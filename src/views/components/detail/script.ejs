    <script>
  function magnify(imgID, zoom) {
    const img = document.getElementById(imgID);
    if (!img || !img.parentElement) return;

    const glass = img.parentElement.querySelector('.img-magnifier-glass');
    if (!glass) return;

    // Hintergrund neu setzen (wird auch nach src-Change korrekt)
    function setGlassBG() {
      glass.style.backgroundImage = `url('${img.src}')`;
      glass.style.backgroundSize  = (img.width * zoom) + 'px ' + (img.height * zoom) + 'px';
    }

    function moveGlass(e) {
      const rect = img.getBoundingClientRect();
      let x = e.clientX - rect.left;
      let y = e.clientY - rect.top;

      const w = glass.offsetWidth  / 2;
      const h = glass.offsetHeight / 2;

      x = Math.max(w, Math.min(x, img.width - w));
      y = Math.max(h, Math.min(y, img.height - h));

      glass.style.left = (x - w) + 'px';
      glass.style.top  = (y - h) + 'px';

      // Hintergrundposition
      const bgX = -((x * zoom) - w);
      const bgY = -((y * zoom) - h);
      glass.style.backgroundPosition = `${bgX}px ${bgY}px`;
    }

    // Eventlistener
    img.addEventListener('mouseenter', e => {
      setGlassBG();
      glass.style.display = 'block';
    });
    img.addEventListener('mousemove', moveGlass);
    img.addEventListener('mouseleave', () => {
      glass.style.display = 'none';
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    magnify('mainImage', 1.3); // Zoom-Faktor nach Belieben anpassen
  });

  // Legacy-Helfer: immer die zentrale Wechsel-Logik verwenden
  function changeImage(thumb) {
    if (!thumb) return;
    if (typeof window.changeImage === 'function') {
      window.changeImage(thumb);
      return;
    }
    const main = document.getElementById('mainImage');
    if (!main) return;
    main.src = thumb.src;
  }
</script>


<div class="row g-2 mt-2 mb-4">
  <div class="col-6">
    <button class="btn action-btn w-100" id="bookmarkBtn">
      <%= T('common.bookmark','Merken') %>
    </button>
  </div>

  <div class="col-6">
    <button id="shareBtn" class="btn action-btn w-100">
      <%= t('offers.details.share.button', { fallback: 'Inserat teilen' }) %>
    </button>

    <!-- Share Modal -->
    <div class="modal fade" id="shareModal" tabindex="-1"
         aria-labelledby="shareModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3 text-center">
          <button type="button" class="btn-close ms-auto"
                  data-bs-dismiss="modal" aria-label="Close"></button>

          <h5 class="fw-bold mt-2">
            <%= t('offers.details.share.title', { fallback: 'Inserat teilen' }) %>
          </h5>
          <p class="text-muted">
            <%= t('offers.details.share.subtitle', { fallback: 'Teilen Sie dieses Inserat mit Familie und Freunden' }) %>
          </p>

          <div class="d-flex justify-content-center gap-4 my-3">
            <div>
              <a href="#" id="copyLinkBtn" class="share-circle">
                <i class="bi bi-link-45deg"></i>
              </a>
              <div class="mt-2 small">
                <%= t('offers.details.share.copy_link', { fallback: 'Link kopieren' }) %>
              </div>
            </div>
            <div>
              <a href="#" id="shareWhatsApp" class="share-circle">
                <i class="bi bi-whatsapp"></i>
              </a>
              <div class="mt-2 small">WhatsApp</div>
            </div>
            <div>
              <a href="mailto:?subject=Inserat&body=Schau dir dieses Inserat an: "
                 id="shareEmail" class="share-circle">
                <i class="bi bi-envelope"></i>
              </a>
              <div class="mt-2 small">E-Mail</div>
            </div>
          </div>

          <hr>

          <div class="d-flex justify-content-center gap-4 mb-2">
            <a href="#" id="shareFacebook" class="social-icon">
              <i class="bi bi-facebook"></i>
            </a>
            <a href="#" id="shareTwitter" class="social-icon">
              <i class="bi bi-twitter-x"></i>
            </a>
            <a href="#" id="sharePinterest" class="social-icon">
              <i class="bi bi-pinterest"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="col">
    <button class="btn action-btn w-100"
            data-bs-toggle="modal" data-bs-target="#contactModal">
      <%= T('product.actions.contact_seller','Verkäufer kontaktieren') %>
    </button>
  </div>
</div>

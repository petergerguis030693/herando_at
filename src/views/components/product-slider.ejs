<%
  // Funktion zum Bereinigen von Titeln für URLs
  const slugify = (str) => {
    return str
      .replace(/<\/?[^>]+(>|$)/g, "")   // HTML-Tags wie </h1> entfernen
      .replace(/&/g, "und")             // & → "und"
      .replace(/[^a-zA-Z0-9äöüÄÖÜß\s-]/g, "") // Sonderzeichen löschen
      .trim()
      .replace(/\s+/g, "-");            // Leerzeichen zu Bindestrichen
  };
%>

<section class="product-scroller my-prod-section">
<h1 id="dynamicTitle" class="content-title section-title" style="font-size:40px;">
  <%= pageTitle %>
</h1>

<% if (slider && slider.length > 4) { %>
  <h2 class="section-title">
    <%= t('offers.section.top_offers.title', { fallback: 'Aktuelle Top Angebote' }) %>
  </h2>
<% } %>

<style>
#carousel-categoryProduct {
  overflow: hidden;
  touch-action: pan-x;
}

#carousel-categoryProduct .my-carousel-slides {
  display: flex;
  transition: transform 0.35s ease;
  will-change: transform;
  touch-action: pan-x;
}


#carousel-categoryProduct .my-carousel-slide {
  display: grid;
  gap: 16px;
  min-width: 100%;
  flex: 0 0 100%;
  grid-template-columns: 1fr;
}

#carousel-categoryProduct .my-carousel-prev,
#carousel-categoryProduct .my-carousel-next {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

@media (hover: hover) {
  #carousel-categoryProduct:hover .my-carousel-prev,
  #carousel-categoryProduct:hover .my-carousel-next,
  #carousel-categoryProduct .my-carousel-prev:focus-visible,
  #carousel-categoryProduct .my-carousel-next:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
}

@media (hover: none) {
  #carousel-categoryProduct .my-carousel-prev,
  #carousel-categoryProduct .my-carousel-next {
    opacity: 1;
    pointer-events: auto;
  }
}

#carousel-categoryProduct .my-carousel-slide .card-peter {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0;
  margin: 0;
}

#carousel-categoryProduct .my-carousel-slide .product-item {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0;
  height: auto !important;
}

#carousel-categoryProduct .my-carousel-slide .product-item.prItem {
  height: auto !important;
}

#carousel-categoryProduct .my-carousel-slide .product-item img {
  width: 100%;
  height: clamp(180px, 20vw, 250px);
  object-fit: cover;
  object-position: center;
  border-radius: 10px !important;
  display: block;
}

@media (max-width: 766px) {
  #carousel-categoryProduct .my-carousel-slide .product-item img {
    height: 350px !important;
  }
}

@media (min-width: 520px) {
  #carousel-categoryProduct .my-carousel-slide {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  #carousel-categoryProduct .my-carousel-slide {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 768px) and (max-width: 1099px) {
  #carousel-categoryProduct .my-carousel-slide .product-item img {
    object-fit: contain;
    background: #fff;
  }
}

@media (min-width: 1100px) {
  #carousel-categoryProduct .my-carousel-slides {
    gap: 0;
  }

  #carousel-categoryProduct .my-carousel-slide {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    min-width: 100%;
  }
}

@media (max-width: 1099px) {
  #carousel-categoryProduct .my-carousel-slides {
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    padding: 0 14px;
  }

  #carousel-categoryProduct .my-carousel-slides::-webkit-scrollbar {
    display: none;
  }

  #carousel-categoryProduct .my-carousel-slide {
    min-width: calc(100% - 150px);
    scroll-snap-align: center;
  }

  #carousel-categoryProduct .category-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }

  #carousel-categoryProduct .category-carousel-controls .my-carousel-nav-dots {
    margin-top: 0;
    display: none;
  }

  #carousel-categoryProduct .category-carousel-controls .my-carousel-prev,
  #carousel-categoryProduct .category-carousel-controls .my-carousel-next {
    position: static !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    width: 46px;
    height: 40px;
    padding: 0;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
}
</style>


  <% if (slider && slider.length) { %>
  <div class="my-carousel" id="carousel-categoryProduct">
    <div class="my-carousel-slides" id="categoryProductSlides"></div>
    <div class="category-carousel-controls">
      <button class="my-carousel-prev" id="categoryProductPrev" aria-label="Zurück">‹</button>
      <div class="my-carousel-nav-dots" id="categoryProductDots"></div>
      <button class="my-carousel-next" id="categoryProductNext" aria-label="Weiter">›</button>
    </div>
  </div>

  <div id="categoryProductSource" class="d-none">
      <% slider.forEach(item => { 
     const safeTitle = slugify(item.title);

     /* ---- Mappings mit bestehenden Keys ---- */

     // === Cars ===
     const cartypeLabels = {
       1: t('cars.gear.manual', 'Schaltgetriebe'),
       2: t('cars.gear.automatic', 'Automatik'),
       3: t('cars.gear.automatic', 'Automatik'),
       6: t('cars.gear.automatic', 'Automatik'),
       255: t('cars.gear.manual', 'Schaltgetriebe')
     };
     const fuelLabels = {
       1: t('cars.fuel.petrol', 'Benzin'),
       2: t('cars.fuel.diesel', 'Diesel'),
       3: t('cars.fuel.electric', 'Elektro'),
       4: t('cars.fuel.hybrid', 'Hybrid')
     };
     const gearboxValue = item.gearbox ?? item.transmission ?? item.cartype;
     const cartypeName = cartypeLabels[gearboxValue] || null;
     const fuelName = fuelLabels[item.fuel] || item.fuel;

     let firstReg = null;
     if (item.firstregistration) {
       const mm = item.firstregistration_month ? String(item.firstregistration_month).padStart(2, "0") : "01";
       firstReg = `${mm}/${item.firstregistration}`;
     }

     // === Watches ===
     const watchTypeLabels = {
       1: t('watches.type.armband', 'Armbanduhr'),
       2: t('watches.type.taschen', 'Taschenuhr'),
       3: t('watches.type.smart', 'Smartwatch')
     };
     const genderLabels = {
       1: t('watches.gender.men', 'Herren'),
       2: t('watches.gender.women', 'Damen'),
       3: t('watches.gender.unisex', 'Unisex')
     };
     const movementLabels = {
       1: t('watches.movement.auto', 'Automatik'),
       2: t('watches.movement.hand', 'Handaufzug'),
       3: t('watches.movement.quartz', 'Quarz')
     };
     const caseMaterialLabels = {
       1: t('watches.case.steel', 'Edelstahl'),
       2: t('watches.case.gold', 'Gold'),
       3: t('watches.case.titan', 'Titan'),
       4: t('watches.case.keramik', 'Keramik')
     };
     const watchTypeName = watchTypeLabels[item.watchtype] || null;
     const genderName = genderLabels[item.gender] || null;
     const movementName = movementLabels[item.movement] || null;
     const caseMaterialName = caseMaterialLabels[item.case_material] || null;

     // === Yachts ===
     const yachtTypeLabels = {
       1: t('yachts.type.motor', 'Motoryacht'),
       2: t('yachts.type.sail', 'Segelyacht'),
       3: t('yachts.type.catamaran', 'Katamaran')
     };
     const yachtTypeName = yachtTypeLabels[item.yachttype] || null;

     // === Properties ===
     const propertyTypeLabels = {
       10: t('properties.type.finca', 'Finca'),
       5:  t('properties.type.penthouse', 'Penthouse'),
       11: t('properties.type.private_island', 'Privatinsel'),
       6:  t('properties.type.villa', 'Villa/Haus'),
       8:  t('properties.type.maisonette', 'Maisonette'),
       4:  t('properties.type.apartment', 'Wohnung'),
       12: t('properties.type.castle', 'Schloss/Herrenhaus'),
       255:t('properties.type.other', 'Sonstige')
     };
     const investmentTypeLabels = {
       1: t('properties.invest.living', 'Wohnen'),
       2: t('properties.invest.commercial', 'Gewerbe'),
       3: t('properties.invest.hotel', 'Hotel'),
       4: t('properties.invest.care', 'Pflegeimmobilie'),
       5: t('properties.invest.gastro', 'Gastronomie'),
       6: t('properties.invest.other', 'Sonstiges'),
       9: t('properties.invest.land', 'Grundstück')
     };

     const propertyTypeName = propertyTypeLabels[item.propertytype] || null;
     const roomsVal = (typeof item.rooms !== "undefined" ? item.rooms : item.bedrooms);
     const detailHref = item.detailPath || ((typeof entityPath === 'function')
       ? entityPath(currentEntity.route, `${safeTitle}-${item.id}`)
       : `/${currentEntity.route}/${safeTitle}-${item.id}`);
%>
      <div class="slider-source-card" data-item-id="<%= item.id %>">
        <a href="<%= detailHref %>" class="product-link" style="text-decoration:none; color:inherit;">
          <div class="product-item prItem" style="height:100%;">
            <img src="<%= item.imageUrl %>" alt="<%= item.title %>" width="580" height="440" loading="lazy" decoding="async">
              <h3 title="<%= item.title %>" style="font-size: 14pt; margin-top: 12px">
                <b><%= (item.title && item.title.length > 20) ? item.title.substring(0, 20) + "..." : item.title %></b>
              </h3>



            <% /* ============ CARS ============ */ %>
            <% if (currentEntity.route === 'cars') { %>
              <p class="cartype-box" style="font-size:12pt; margin-top:8px;">
                <% if (cartypeName) { %>
                  <span class="info-item">
                    <i class="bi bi-gear-fill"></i>
                    <%= t(
                      'cars.gear.' + 
                      (Number(gearboxValue) === 1 ? 'manual' :
                      Number(gearboxValue) === 2 ? 'automatic' :
                      Number(gearboxValue) === 3 ? 'automatic' :
                      Number(gearboxValue) === 6 ? 'automatic' :
                      'manual'),
                      cartypeName
                    ) %>
                  </span>
                <% } %>

                <% if (item.mileage) { %>
                  <span class="info-item">
                    <i class="bi bi-speedometer2"></i>
                    <%= new Intl.NumberFormat('de-DE').format(item.mileage) %> km
                  </span>
                <% } %>

                <% if (fuelName) { %>
                  <span class="info-item">
                    <i class="bi bi-fuel-pump"></i>
                    <%= t(
                      'cars.fuel.' +
                      (item.fuel === 1 ? 'petrol' :
                      item.fuel === 2 ? 'diesel' :
                      item.fuel === 3 ? 'electric' :
                      'hybrid'),
                      fuelName
                    ) %>
                  </span>
                <% } %>

                <% if (firstReg) { %>
                  <span class="info-item">
                    <i class="bi bi-calendar-event"></i>
                    <%= t('cars.first_registration', 'Erstzulassung') %> <%= firstReg %>
                  </span>
                <% } %>
              </p>
            <% } %>


            <% /* ============ WATCHES ============ */ %>
            <% if (currentEntity.route === 'watches') { %>
              <p class="cartype-box" style="font-size:12pt; margin-top:8px;">
                <% if (watchTypeName) { %>
                  <span class="info-item">
                    <i class="bi bi-watch"></i> 
                    <%= t('watches.type.' + (item.watchtype === 1 ? 'armband' : item.watchtype === 2 ? 'taschen' : 'smart'), watchTypeName) %>
                  </span>
                <% } %>

                <% if (genderName) { %>
                  <span class="info-item">
                    <i class="bi bi-person"></i> 
                    <%= t('watches.gender.' + (item.gender === 1 ? 'men' : item.gender === 2 ? 'women' : 'unisex'), genderName) %>
                  </span>
                <% } %>

                <% if (movementName) { %>
                  <span class="info-item">
                    <i class="bi bi-cpu"></i> 
                    <%= t('watches.movement.' + (item.movement === 1 ? 'auto' : item.movement === 2 ? 'hand' : 'quartz'), movementName) %>
                  </span>
                <% } %>

                <% if (caseMaterialName) { %>
                  <span class="info-item">
                    <i class="bi bi-gem"></i> 
                    <%= t('watches.case.' + (
                          item.case_material === 1 ? 'steel' :
                          item.case_material === 2 ? 'gold' :
                          item.case_material === 3 ? 'titan' :
                          'keramik'
                        ), caseMaterialName) %>
                  </span>
                <% } %>
              </p>
            <% } %>


            <% /* ============ YACHTS ============ */ %>
            <% if (currentEntity.route === 'yachts') { %>
              <p class="cartype-box" style="font-size:12pt; margin-top:8px;">
                <% if (yachtTypeName) { %>
                  <span class="info-item">
                    <i class="bi bi-water"></i>
                    <%= t(
                      'yachts.type.' + 
                      (item.yachttype === 1 ? 'motor' : item.yachttype === 2 ? 'sail' : 'catamaran'),
                      yachtTypeName
                    ) %>
                  </span>
                <% } %>

                <% if (item.length) { %>
                  <span class="info-item">
                    <i class="bi bi-rulers"></i>
                    <%= item.length %> m
                  </span>
                <% } %>

                <% if (item.beam) { %>
                  <span class="info-item">
                    <i class="bi bi-arrows"></i>
                    <%= item.beam %> m <%= t('yachts.width', 'Breite') %>
                  </span>
                <% } %>

                <% if (item.draft) { %>
                  <span class="info-item">
                    <i class="bi bi-arrow-down"></i>
                    <%= item.draft %> m <%= t('yachts.draft', 'Tiefgang') %>
                  </span>
                <% } %>

                <% if (item.berths) { %>
                  <span class="info-item">
                    <i class="bi bi-person"></i>
                    <%= item.berths %> <%= t('yachts.berths', 'Kojen') %>
                  </span>
                <% } %>

                <% if (item.year) { %>
                  <span class="info-item">
                    <i class="bi bi-calendar-event"></i>
                    <%= t('yachts.year', 'Baujahr') %> <%= item.year %>
                  </span>
                <% } %>
              </p>
            <% } %>


            <% /* ============ PROPERTIES ============ */ %>
            <% if (currentEntity.route === 'properties') { %>
            <p class="cartype-box" style="font-size:12pt; margin-top:8px;">
              <% if (propertyTypeName) { %>
                <span class="info-item">
                  <i class="bi bi-building"></i>
                  <%= t(
                    'properties.type.' +
                    (item.propertytype === 10 ? 'finca' :
                    item.propertytype === 5  ? 'penthouse' :
                    item.propertytype === 11 ? 'private_island' :
                    item.propertytype === 6  ? 'villa' :
                    item.propertytype === 8  ? 'maisonette' :
                    item.propertytype === 4  ? 'apartment' :
                    item.propertytype === 12 ? 'castle' :
                    'other'),
                    propertyTypeName
                  ) %>
                </span>
              <% } %>

              <% if (roomsVal) { %>
                <span class="info-item">
                  <i class="bi bi-door-closed"></i>
                  <%= roomsVal %> <%= t('properties.rooms', 'Zimmer') %>
                </span>
              <% } %>

              <% if (item.bathrooms) { %>
                <span class="info-item">
                  <i class="bi bi-droplet"></i>
                  <%= item.bathrooms %> <%= t('properties.bathrooms', 'Bäder') %>
                </span>
              <% } %>

              <% if (item.livingarea) { %>
                <span class="info-item">
                  <i class="bi bi-aspect-ratio"></i>
                  <%= new Intl.NumberFormat('de-DE').format(item.livingarea) %> m²
                </span>
              <% } %>
            </p>

            <% } %>
            <p class="price" style="font-size: 14pt; margin-top: 12px;">
              <%= item.priceFormatted || t('common.price_on_request') %>
            </p>
          </div>
        </a>
      </div>
      <% }) %>
  </div>
  <% } else { %>
    <div></div>
  <% } %>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const carousel = document.getElementById("carousel-categoryProduct");
  if (!carousel) return;
  const section = carousel.closest(".my-prod-section");

  if (section) {
    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          section.classList.toggle("is-active", entry.isIntersecting);
        });
      }, { threshold: 0.25 });
      obs.observe(section);
    } else {
      section.classList.add("is-active");
    }
  }

  const slides = carousel.querySelector(".my-carousel-slides");
  const source = document.getElementById("categoryProductSource");
  const dotsWrap = document.getElementById("categoryProductDots");
  const prevBtn = document.getElementById("categoryProductPrev");
  const nextBtn = document.getElementById("categoryProductNext");
  if (!slides || !source || !dotsWrap || !prevBtn || !nextBtn) return;

  const rawCards = Array.from(source.children);
  const seenCardIds = new Set();
  const cards = rawCards.filter((card) => {
    const cardId = String(card?.dataset?.itemId || "").trim();
    if (!cardId) return true;
    if (seenCardIds.has(cardId)) return false;
    seenCardIds.add(cardId);
    return true;
  });
  if (!cards.length) return;

  let current = 0;
  let currentGroupSize = 0;
  let isDesktopMode = window.innerWidth >= 1100;
  /** Avoid layout thrash: step width only changes after rebuild/resize */
  let stepWidthCache = null;

  function invalidateStepWidth() {
    stepWidthCache = null;
  }

  function getStepWidth() {
    if (stepWidthCache != null && stepWidthCache > 0) return stepWidthCache;
    let w;
    if (isDesktopMode) {
      w = carousel.clientWidth || 0;
    } else {
      const first = slides.querySelector(".my-carousel-slide");
      if (!first) w = carousel.clientWidth || 0;
      else {
        const styles = window.getComputedStyle(slides);
        const gap = parseFloat(styles.columnGap || styles.gap || "0") || 0;
        w = first.getBoundingClientRect().width + gap;
      }
    }
    stepWidthCache = w;
    return w;
  }

  function goTo(index, behavior = "smooth") {
    const total = slides.children.length;
    if (!total) return;
    current = (index + total) % total;
    const step = getStepWidth();
    if (isDesktopMode) {
      slides.style.transform = `translateX(-${current * step}px)`;
    } else {
      slides.scrollTo({ left: current * step, behavior });
    }
    Array.from(dotsWrap.querySelectorAll("button[data-slide]"))
      .forEach((dot, i) => dot.classList.toggle("active", i === current));
  }

  function getGroupSize() {
    const w = window.innerWidth;
    if (w >= 1100) return 5;
    if (w >= 768) return 3;
    if (w >= 520) return 2;
    return 1;
  }

  function rebuildSlides(force = false) {
    const groupSize = getGroupSize();
    if (!force && groupSize === currentGroupSize) {
      invalidateStepWidth();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => goTo(current, "auto"));
      });
      return;
    }
    currentGroupSize = groupSize;

    invalidateStepWidth();
    slides.innerHTML = "";
    dotsWrap.innerHTML = "";

    for (let i = 0; i < cards.length; i += groupSize) {
      const slide = document.createElement("div");
      slide.className = "my-carousel-slide";
      slide.dataset.slide = String(Math.floor(i / groupSize));

      cards.slice(i, i + groupSize).forEach((card) => {
        const wrapper = document.createElement("div");
        wrapper.className = "card-peter";
        wrapper.appendChild(card.cloneNode(true));
        slide.appendChild(wrapper);
      });

      slides.appendChild(slide);

      const dot = document.createElement("button");
      dot.type = "button";
      dot.dataset.slide = String(Math.floor(i / groupSize));
      dotsWrap.appendChild(dot);
    }

    const total = slides.children.length;
    const multi = total > 1;
    isDesktopMode = window.innerWidth >= 1100;
    prevBtn.style.display = multi ? "" : "none";
    nextBtn.style.display = multi ? "" : "none";
    dotsWrap.style.display = (multi && isDesktopMode) ? "" : "none";

    current = Math.min(current, Math.max(0, total - 1));
    if (isDesktopMode) {
      slides.scrollLeft = 0;
    } else {
      slides.style.transform = "translateX(0px)";
    }
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        goTo(current, "auto");
      });
    });
  }

  dotsWrap.addEventListener("click", (e) => {
    const dot = e.target.closest("button[data-slide]");
    if (!dot) return;
    goTo(Number(dot.dataset.slide || 0));
  });

  prevBtn.addEventListener("click", () => goTo(current - 1));
  nextBtn.addEventListener("click", () => goTo(current + 1));

  slides.addEventListener("scroll", () => {
    if (isDesktopMode) return;
    const step = getStepWidth();
    if (!step) return;
    const total = slides.children.length;
    if (!total) return;
    const idx = Math.max(0, Math.min(total - 1, Math.round(slides.scrollLeft / step)));
    current = idx;
  }, { passive: true });

  let resizeTimer = null;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      invalidateStepWidth();
      rebuildSlides();
    }, 120);
  });

  rebuildSlides(true);
});
</script>

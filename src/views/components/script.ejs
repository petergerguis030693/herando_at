<script>
document.addEventListener("DOMContentLoaded", () => {

  const titleEl = document.getElementById("dynamicTitle");
  if (!titleEl) return;

  window.herandoLoadTranslateFiltersData()
    .then(data => {

      // * nur echte Labels verwenden *
      let parts = [];

      Object.entries(data).forEach(([key, label]) => {

        if (["hp", "page", "limit", "sort", "view"].includes(key)) return;
        if (!label || !String(label).trim()) return;
        if (label == "0") return;

        parts.push(label);
      });

      // Wenn keine Filter → originaler pageTitle
      if (parts.length === 0) return;

      // Entity-Name anhängen (Autos, Yachten, Lifestyle…)
      const entityName = "<%= currentEntity.name %>";

      // Titel zusammenbauen
      const newTitle = parts.join("  ");

      titleEl.textContent = newTitle;
    });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const track = document.querySelector(".slider-track");
  const btnLeft = document.querySelector(".scroll-btn.left");
  const btnRight = document.querySelector(".scroll-btn.right");

  if (!track || !btnLeft || !btnRight) return;

  function getCardWidth() {
    const card = track.querySelector(".product-item");
    if (!card) return 350;

    const style = window.getComputedStyle(card);
    const marginRight = parseInt(style.marginRight) || 20;

    return card.offsetWidth + marginRight;
  }

  btnRight.addEventListener("click", () => {
    track.scrollBy({ left: getCardWidth(), behavior: "smooth" });
  });

  btnLeft.addEventListener("click", () => {
    track.scrollBy({ left: -getCardWidth(), behavior: "smooth" });
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const lifeType = document.getElementById('fLifeType');
  const subSelect = document.getElementById('fLifeSub');

  if (!lifeType || !subSelect) return;

  lifeType.addEventListener('change', async function () {
    const brandId = this.value;

    subSelect.innerHTML = '<option value="">Beliebig</option>';
    subSelect.disabled = true;

    if (!brandId) return;

    const res = await fetch(`/api/lifestyle-subcategories?brand_id=${brandId}`);
    const data = await res.json();

    data.forEach(sc => {
      const opt = document.createElement('option');
      opt.value = sc.id;
      opt.textContent = sc.name;
      subSelect.appendChild(opt);
    });

    subSelect.disabled = false;
  });
});
</script>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const form = document.querySelector(".filter-form"); // ✅ richtiges Formular!
  const resultCountEl = document.querySelector("#resultCount");
  const submitBtn = document.querySelector("#filterSubmitBtn");

  if (!form || !submitBtn || !resultCountEl) return;

  let abortCtrl = null;
  let timer = null;
  const actionPath = (() => {
    const raw = String(form.getAttribute("action") || "").trim();
    if (!raw) return window.location.pathname;
    try { return new URL(raw, window.location.origin).pathname; }
    catch { return raw.startsWith("/") ? raw : window.location.pathname; }
  })();
  const entityRoute = String(form.dataset.entityRoute || "").trim()
    || (window.location.pathname.split("/").filter(Boolean)[0] || "");

  async function updateCountOnly() {
    const params = new URLSearchParams(new FormData(form));
    const url = `/api/${entityRoute}/count?${params.toString()}`;

    console.log("🚀 [updateCountOnly] Starte Fetch:", url);

    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();

    try {
      const res = await fetch(url, { signal: abortCtrl.signal });
      const data = await res.json();
      console.log("✅ [updateCountOnly] Antwort:", data);

      if (data.count !== undefined) {
        resultCountEl.textContent = data.count;
      }
    } catch (err) {
      if (err.name === "AbortError") {
        console.log("⚠️ [updateCountOnly] Abgebrochen");
      } else {
        console.error("❌ [updateCountOnly] Fehler:", err);
      }
    }
  }

  async function reloadResults() {
    const params = new URLSearchParams(new FormData(form));

    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();

    try {
      const htmlRes = await fetch(`${actionPath}?${params.toString()}`, {
        signal: abortCtrl.signal
      });
      const html = await htmlRes.text();

      const temp = document.createElement("div");
      temp.innerHTML = html;

      const newList = temp.querySelector(".listing-container");
      const oldList = document.querySelector(".listing-container");

      if (newList && oldList) {
        const buttonHTML = submitBtn?.outerHTML || "";
        oldList.innerHTML = newList.innerHTML;
        if (!document.querySelector("#filterSubmitBtn")) {
          oldList.insertAdjacentHTML("beforebegin", buttonHTML);
        }
        console.log("✅ Inserate aktualisiert!");
      }
    } catch (err) {
      if (err.name !== "AbortError") console.error("❌ Fehler beim Reload:", err);
    }
  }

  // 🔹 Live-Update bei jeder Filteränderung
  form.querySelectorAll("input, select").forEach(el => {
    el.addEventListener("change", () => {
      clearTimeout(timer);
      updateCountOnly();
      timer = setTimeout(reloadResults, 400);
    });

    el.addEventListener("input", () => {
      clearTimeout(timer);
      updateCountOnly();
      timer = setTimeout(reloadResults, 600);
    });
  });

  // 🔹 Direkt beim ersten Laden Count holen
  updateCountOnly();
});

</script>


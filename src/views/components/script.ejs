<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.querySelector(".active-filters");
  if (!container) return;

  window.herandoLoadTranslateFiltersData()
    .then(data => {

      Object.entries(data).forEach(([key, label]) => {

        // 🔥 Keine technischen Felder anzeigen
        if (["hp", "page", "limit", "sort", "view"].includes(key)) return;

        // 🔥 Leere Labels ignorieren
        if (!label || label === "" || label === null || label === undefined) return;

        // 🔥 Zahlen ignorieren die NULL-Filter repräsentieren
        if (label === "0" || label === 0) return;

        // 🔥 Wenn label nur whitespace ist → ignorieren
        if (String(label).trim().length === 0) return;

        // URL ohne diesen Filter erstellen
        const url = new URL(window.location.href);
        url.searchParams.delete(key);

        const tag = document.createElement("a");
        tag.href = url.toString();
        tag.className = "btn btn-search";
        tag.innerHTML = `${label} <span class="x">×</span>`;
        container.appendChild(tag);
      });

    });
});
</script>


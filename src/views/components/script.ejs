<script>
document.addEventListener("DOMContentLoaded", async () => {
  const brandSelect = document.getElementById("fBrand");
  const modelSelect = document.getElementById("fModel");

  if (!brandSelect || !modelSelect) return;

  async function loadModels(brandId, preselectModel = null) {
    modelSelect.innerHTML = `<option value="">${"<%= t('common.any') %>"}</option>`;
    modelSelect.disabled = true;

    if (!brandId) return;

    const entity = "<%= currentEntity.route %>";

    try {
      const response = await fetch(`/api/${entity}/models?brand=${brandId}`);
      const models = await response.json();

      models.forEach(m => {
        const opt = document.createElement("option");
        opt.value = m.id;
        opt.textContent = m.name;

        if (preselectModel && String(preselectModel) === String(m.id)) {
          opt.selected = true;
        }

        modelSelect.appendChild(opt);
      });

      modelSelect.disabled = models.length === 0;
      document.dispatchEvent(new CustomEvent('filters:modelsLoaded'));

    } catch (err) {
      console.error("Model loader:", err);
    }
  }

  // 🔥 beim Ändern
  brandSelect.addEventListener("change", () => {
    loadModels(brandSelect.value);
  });

  // 🔥 beim Laden (Watches-Fix!)
  if (brandSelect.value) {
    loadModels(brandSelect.value, "<%= selectedFilters.model?.[0] || '' %>");
  }
});
</script>


<script>
  $(function(){
    const $grid = $('.productGrid');
    const fallbackCount = 12;

    if ($grid.children().length === 0) {
      $('<div>')
        .addClass('no-results-message text-center py-4')
        .text('Leider wurden keine Ergebnisse für die Suche gefunden!')
        .insertBefore('.productContainer');

      const $all = $('.product-scroller .product-item').toArray();

      for (let i = $all.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [$all[i], $all[j]] = [$all[j], $all[i]];
      }

      $all.slice(0, fallbackCount).forEach(elem => {
        const $clone = $(elem).clone();

        const route = '<%= currentEntity.route %>';
        const title = encodeURIComponent($clone.find('p').first().text().trim());
        const id    = $clone.data('id') || '';

        const href  = `/${route}/${title}-${id}`;
        const $card = $('<div>')
          .addClass('cardPeter mb-4 me-4')
          .append($clone.html());

        $('<a>')
          .attr('href', href)
          .append($card)
          .appendTo($grid);
      });
    }
  });
</script>

<script>
(function () {
  const btn = document.getElementById('openFilterPage');
  if (!btn) return;

  btn.addEventListener('click', () => {
    const entity = document.querySelector('.filter-bar')?.dataset?.entity;
    if (!entity) return;

    const params = new URLSearchParams();
    const form = document.getElementById('quickFilters');
    if (form) {
      const fd = new FormData(form);
      for (const [key, value] of fd.entries()) {
        const v = String(value == null ? '' : value).trim();
        if (!v) continue;
        params.append(key, v);
      }
    }

    const current = new URLSearchParams(window.location.search);
    ['limit', 'sort', 'view'].forEach((key) => {
      if (params.has(key)) return;
      const v = String(current.get(key) || '').trim();
      if (!v) return;
      params.set(key, v);
    });
    params.set('hp', '1');

    const qs = params.toString();
    window.location.href = qs ? `/${entity}/filters?${qs}` : `/${entity}/filters`;
  });
})();
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const propertySelect = document.getElementById("fPropertyType");
  const investmentSelect = document.getElementById("fInvestmentType");

  if (!propertySelect || !investmentSelect) return;

  function updateFilters() {
    const propertyValue = propertySelect.value.trim();
    const investmentValue = investmentSelect.value.trim();

    investmentSelect.disabled = propertyValue !== "";
    propertySelect.disabled = investmentValue !== "";
  }

  propertySelect.addEventListener("change", updateFilters);
  investmentSelect.addEventListener("change", updateFilters);

  updateFilters();
});
</script>




<%
  const watchTypeLabels = {
    1: t('watches.type.armband', 'Armbanduhr'),
    2: t('watches.type.taschen', 'Taschenuhr'),
    3: t('watch.type.tableclock', 'Tischuhr'),
    4: t('watch.type.antiqueclock', 'Antike Uhr'),
    5: t('watch.type.grandfatherclock', 'Standuhr'),
    6: t('watch.type.wallclock', 'Wanduhr'),
    255: t('common.other', 'Sonstige')
  };

  const genderLabels = {
    1: t('watch.gender.men', 'Herren/Unisex'),
    2: t('watches.gender.men', 'Herren/Unisex'),
    3: t('watches.gender.women', 'Damen')
  };

  const movementLabels = {
    1: t('watches.movement.auto', 'Automatik'),
    2: t('watches.movement.hand', 'Handaufzug'),
    3: t('watches.movement.quartz', 'Quarz')
  };

  const caseMaterialLabels = {
    1: t('watch.case.rose_gold', 'Roségold'),
    2: t('watch.case.steel', 'Edelstahl'),
    3: t('watch.case.white_gold', 'Weißgold'),
    4: t('watch.case.yellow_gold', 'Gelbgold'),
    5: t('watch.case.platinum', 'Platin'),
    6: t('watch.case.red_gold', 'Rotgold'),
    7: t('watch.case.titanium', 'Titan'),
    8: t('watch.case.gold_steel', 'Gold/Stahl'),
    9: t('watch.case.ceramic', 'Keramik'),
    10: t('watch.case.palladium', 'Palladium'),
    11: t('watch.case.silver', 'Silber'),
    12: t('watch.case.aluminium', 'Aluminium'),
    13: t('watch.case.pvd', 'PVD-beschichtet'),
    14: t('watch.case.plastic', 'Kunststoff'),
    15: t('watch.case.bronze', 'Bronze'),
    16: t('watch.case.carbon', 'Carbon'),
    17: t('watch.case.tantalum', 'Tantal'),
    18: t('watch.case.tungsten', 'Wolfram'),
    255: t('common.other', 'Sonstige')
  };

  const watchTypeName = watchTypeLabels[item.watchtype] || null;
  const genderName = genderLabels[item.gender] || null;
  const movementName = movementLabels[item.movement] || null;
  const caseMaterialName = caseMaterialLabels[item.case_material] || null;
%>

<a href="<%= detailHref %>"
   class="lux-card lux-watch-card">

  <!-- Responsive listing variants (srcset) oder *_largex2 -->
  <div class="lux-card-img">
    <% const _fallback = item.imageUrl || '/assets/herando-weblogo.png'; %>
    <% const _cardSrc = item.imageSrcset ? item.imageUrl : (item.imageUrlLarge || _fallback); %>
    <img src="<%= _cardSrc %>"
      <% if (item.imageSrcset) { %>srcset="<%= item.imageSrcset %>" sizes="<%= item.imageSizes %>"<% } %>
      alt="<%= item.title %>"
      width="580"
      height="440"
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null;this.src='/assets/herando-weblogo.png';">
  </div>

  <!-- BODY -->
  <div class="lux-card-body">

    <h3 class="lux-card-title">
      <%= item.title.length > 38 ? item.title.substring(0, 38) + "…" : item.title %>
    </h3>

<p class="cartype-box" style="font-size:12pt; margin-top:8px;">

  <% if (watchTypeName) { %>
    <span class="info-item">
      <i class="bi bi-watch"></i>
      <%= watchTypeName %>
    </span>
  <% } %>

  <% if (genderName) { %>
    <span class="info-item">
      <i class="bi bi-person"></i>
      <%= genderName %>
    </span>
  <% } %>

  <% if (movementName) { %>
    <span class="info-item">
      <i class="bi bi-cpu"></i>
      <%= movementName %>
    </span>
  <% } %>

  <% if (caseMaterialName) { %>
    <span class="info-item">
      <i class="bi bi-gem"></i>
      <%= caseMaterialName %>
    </span>
  <% } %>

  <% if (item.diameter) { %>
    <span class="info-item">
      <i class="bi bi-circle"></i>
      <%= item.diameter %> mm
    </span>
  <% } %>

</p>


    <div class="lux-card-price">
      <%= item.priceFormatted || t('common.price_on_request', 'Preis auf Anfrage') %>
    </div>

    <% if (item.countryCode || item.countryName) { %>
      <div class="lux-card-country">
        <% if (item.countryCode) { %>
          <img
            class="lux-card-flag"
            src="https://flagcdn.com/24x18/<%= String(item.countryCode).toLowerCase() %>.png"
            alt="<%= item.countryName || item.countryCode %>"
            width="24"
            height="18"
            loading="lazy">
        <% } %>
        <span><%= item.countryName || item.countryCode %></span>
      </div>
      <!-- Alte Standort-Icon/Kürzel-Anzeige deaktiviert -->
    <% } %>

  </div>
</a>

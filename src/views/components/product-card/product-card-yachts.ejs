<%
  const yachtTypeLabels = {
    1: t('yachts.type.motor', 'Motoryacht'),
    2: t('yachts.type.sail', 'Segelyacht'),
    3: t('yachts.type.catamaran', 'Katamaran')
  };

  const yachtType = yachtTypeLabels[item.yachttype] || null;
%>

<a href="<%= detailHref %>"
   class="lux-card lux-yacht-card">

  <!-- Responsive listing variants (srcset) oder *_largex2 -->
  <div class="lux-card-img">
    <% const _fallback = item.imageUrl || '/assets/herando-weblogo.png'; %>
    <% const _cardSrc = item.imageSrcset ? item.imageUrl : (item.imageUrlLarge || _fallback); %>
    <img src="<%= _cardSrc %>"
      <% if (item.imageSrcset) { %>srcset="<%= item.imageSrcset %>" sizes="<%= item.imageSizes %>"<% } %>
      alt="<%= item.title %>"
      width="580"
      height="440"
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null;this.src='/assets/herando-weblogo.png';">
  </div>

  <!-- BODY -->
  <div class="lux-card-body">

    <!-- TITLE -->
    <h3 class="lux-card-title">
      <%= item.title.length > 40 ? item.title.substring(0, 40) + "…" : item.title %>
    </h3>

    <!-- SPECS -->
    <p class="cartype-box" style="font-size:12pt; margin-top:8px;">

      <% if (yachtType) { %>
        <span class="info-item">
          <i class="bi bi-water"></i>
          <%= yachtType %>
        </span>
      <% } %>

      <% if (item.length) { %>
        <span class="info-item">
          <i class="bi bi-rulers"></i>
          <%= item.length %> m
        </span>
      <% } %>

      <% if (item.beam) { %>
        <span class="info-item">
          <i class="bi bi-arrows"></i>
          <%= item.beam %> m Breite
        </span>
      <% } %>

      <% if (item.draft) { %>
        <span class="info-item">
          <i class="bi bi-arrow-down"></i>
          <%= item.draft %> m Tiefgang
        </span>
      <% } %>

      <% if (item.berths) { %>
        <span class="info-item">
          <i class="bi bi-person"></i>
          <%= item.berths %> Kojen
        </span>
      <% } %>

      <% if (item.year) { %>
        <span class="info-item">
          <i class="bi bi-calendar-event"></i>
          Baujahr <%= item.year %>
        </span>
      <% } %>

      <% if (item.location) { %>
        <span class="info-item">
          <i class="bi bi-geo-alt"></i>
          <%= item.location %>
        </span>
      <% } %>

    </p>


    <!-- PRICE -->
    <div class="lux-card-price">
      <%= item.priceFormatted || t('common.price_on_request', 'Preis auf Anfrage') %>
    </div>

    <% if (item.countryCode || item.countryName) { %>
      <div class="lux-card-country">
        <% if (item.countryCode) { %>
          <img
            class="lux-card-flag"
            src="/direct/flags/4x3/<%= encodeURIComponent(String(item.countryCode).toLowerCase()) %>.svg"
            alt="<%= item.countryName || item.countryCode %>"
            width="24"
            height="18"
            style="border-radius:0 !important;"
            loading="lazy">
        <% } %>
        <span><%= item.countryName || item.countryCode %></span>
      </div>
      <!-- Alte Standort-Icon/Kürzel-Anzeige deaktiviert -->
    <% } %>

  </div>
</a>

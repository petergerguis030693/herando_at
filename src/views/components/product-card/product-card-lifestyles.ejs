<a href="<%= detailHref %>"
   class="lux-card">

  <!-- Responsive listing variants (srcset) oder *_largex2 -->
  <div class="lux-card-img">
    <% const _fallback = item.imageUrl || '/assets/herando-weblogo.png'; %>
    <% const _cardSrc = item.imageSrcset ? item.imageUrl : (item.imageUrlLarge || _fallback); %>
    <img src="<%= _cardSrc %>"
      <% if (item.imageSrcset) { %>srcset="<%= item.imageSrcset %>" sizes="<%= item.imageSizes %>"<% } %>
      alt="<%= item.title %>"
      width="580"
      height="440"
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null;this.src='/assets/herando-weblogo.png';">
  </div>

  <!-- BODY -->
  <div class="lux-card-body">

    <!-- TITLE -->
    <h3 class="lux-card-title">
      <%= item.title.length > 40 ? item.title.substring(0, 40) + "…" : item.title %>
    </h3>

    <!-- SPECS (falls vorhanden – bei Lifestyle oft optional) -->
    <div class="lux-card-specs">

      <% if (item.categoryname) { %>
        <span><i class="bi bi-bookmark-heart"></i> <%= item.categoryname %></span>
      <% } %>

      <% if (item.brand) { %>
        <span><i class="bi bi-star"></i> <%= item.brand %></span>
      <% } %>

      <% if (item.material) { %>
        <span><i class="bi bi-box"></i> <%= item.material %></span>
      <% } %>

      <% if (item.condition) { %>
        <span><i class="bi bi-award"></i> <%= item.condition %></span>
      <% } %>

      <% if (item.year) { %>
        <span><i class="bi bi-calendar-event"></i> <%= item.year %></span>
      <% } %>

    </div>

    <!-- PRICE -->
    <div class="lux-card-price">
      <%= item.priceFormatted || t('common.price_on_request', 'Preis auf Anfrage') %>
    </div>

    <% if (item.countryCode || item.countryName) { %>
      <div class="lux-card-country">
        <% if (item.countryCode) { %>
          <img
            class="lux-card-flag"
            src="/direct/flags/4x3/<%= encodeURIComponent(String(item.countryCode).toLowerCase()) %>.svg"
            alt="<%= item.countryName || item.countryCode %>"
            width="24"
            height="18"
            style="border-radius:0 !important;"
            loading="lazy">
        <% } %>
        <span><%= item.countryName || item.countryCode %></span>
      </div>
      <!-- Alte Standort-Icon/Kürzel-Anzeige deaktiviert -->
    <% } %>

  </div>
</a>
